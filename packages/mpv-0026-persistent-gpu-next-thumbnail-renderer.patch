 filters/user_filters.h           |   1 +
 meson.build                      |   1 +
 video/filter/vf_gpu_next_thumb.c | 302 +++++++++++++++++++++++++++++++
 4 files changed, 305 insertions(+)
 create mode 100644 video/filter/vf_gpu_next_thumb.c

