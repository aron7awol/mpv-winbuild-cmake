@@ -2964,11 +2964,68 @@ error:
     return NULL;
 }
 
+// Use the exact first-stage curve/headroom calculation to measure detail
+// that could not be brightened. Low-pass only this nonnegative budget and
+// its PQ(P) guide; never feed recovered output back into the source features.
+static pl_tex get_p_recovery_map(struct pass_state *pass,
+                                struct pl_color_space dst, bool linear,
+                                pl_tex feature_map)
+{
+    const struct pl_color_map_params *cp = pass->params->color_map_params;
+    pl_renderer rr = pass->rr;
+    float peak, avg;
+    if (!feature_map || !cp || cp->contrast_recovery <= 0 ||
+        cp->tone_mapping_metric != PL_TONE_MAP_METRIC_BT2020_RGB ||
+        !pl_get_detected_tone_map_range(rr->tone_map_state,
+                                       cp->tone_mapping_metric, &peak, &avg))
+        return NULL;
+
+    pl_tex src = img_tex(pass, &pass->img);
+    if (!src)
+        return NULL;
+    pl_tex measured = get_fbo(pass, src->params.w, src->params.h, NULL, 2, PL_DEBUG_TAG);
+    pl_tex out = get_fbo(pass, feature_map->params.w, feature_map->params.h,
+                         NULL, 2, PL_DEBUG_TAG);
+    pl_shader sh = NULL;
+    if (!measured || !out)
+        goto error;
+    sh = pl_dispatch_begin(rr->dp);
+    pl_shader_sample_direct(sh, pl_sample_src(.tex = src));
+    bool supported = false;
+    pl_shader_color_map_ex(sh, cp, pl_color_map_args(
+        .src = pass->image.color, .dst = dst, .prelinearized = linear,
+        .state = &rr->tone_map_state, .feature_map = feature_map,
+        .measure_p_recovery = &supported));
+    if (!supported) {
+        // Identity, inverse and unavailable-P paths keep ordinary recovery.
+        pl_dispatch_abort(rr->dp, &sh);
+        return NULL;
+    }
+    if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(.shader = &sh, .target = measured)))
+        goto error;
+    const struct pl_sample_src sample = {
+        .tex = measured, .address_mode = PL_TEX_ADDRESS_MIRROR, .components = 2,
+        .rect = {0, 0, measured->params.w, measured->params.h},
+        .new_w = out->params.w, .new_h = out->params.h,
+    };
+    sh = pl_dispatch_begin(rr->dp);
+    sh_describe(sh, "P recovery local budget lowpass");
+    dispatch_sampler(pass, sh, &rr->sampler_contrast, SAMPLER_LOWPASS, out, &sample);
+    if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(.shader = &sh, .target = out)))
+        goto error;
+    return out;
+
+error:
+    pl_dispatch_abort(rr->dp, &sh);
+    PL_ERR(rr, "P recovery budget unavailable; retaining ordinary bounded recovery");
+    return NULL;
+}
+
 // Exact same-frame reduction. Never infer post-map peak from unrelated
 // source maxima and never use filtered/downsampled samples that miss highlights.
 static pl_tex measure_rgb_ray_peak(struct pass_state *pass,
