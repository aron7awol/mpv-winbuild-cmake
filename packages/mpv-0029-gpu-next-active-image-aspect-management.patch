From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mpv-ht development <development@mpv-ht.local>
Date: Mon, 31 Aug 2026 12:00:00 -0400
Subject: [PATCH] gpu-next: detect and manage active image aspect ratio

Measure native luma rows asynchronously on prefetched frames, publish the
active image bounds, and optionally fit the detected image on wide fullscreen
canvases without adding a presentation wait.
---
diff --git a/player/command.c b/player/command.c
index 178ff54296c9eb4debcf1f43953a6ce15d12d617..2695babbde34467d85f8096e4352bb192b4fd86f 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2755,6 +2755,35 @@ static int mp_property_gpu_render_formats(void *ctx, struct m_property *prop,
     return m_property_read_sub(props, action, arg);
 }
 
+static int mp_property_video_active_image(void *ctx, struct m_property *prop,
+                                          int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct voctrl_active_image image = {0};
+    if (!mpctx->video_out ||
+        vo_control(mpctx->video_out, VOCTRL_GET_ACTIVE_IMAGE, &image) <= 0 ||
+        !image.available || image.active_w < 1 || image.active_h < 1)
+        return M_PROPERTY_UNAVAILABLE;
+
+    double ratio = (double) image.active_w / image.active_h;
+    char *summary = mp_tprintf(128, "%dx%d (%.3f:1)",
+                               image.active_w, image.active_h, ratio);
+    struct m_sub_property props[] = {
+        {"width",               SUB_PROP_INT(image.active_w)},
+        {"height",              SUB_PROP_INT(image.active_h)},
+        {"ratio",               SUB_PROP_DOUBLE(ratio)},
+        {"source-width",        SUB_PROP_INT(image.source_w)},
+        {"source-height",       SUB_PROP_INT(image.source_h)},
+        {"top",                 SUB_PROP_INT(image.top)},
+        {"bottom",              SUB_PROP_INT(image.bottom)},
+        {"frame-id",            SUB_PROP_INT64(image.frame_id)},
+        {"automatic-effective", SUB_PROP_BOOL(image.automatic_effective)},
+        {"summary",             SUB_PROP_STR(summary)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
 static int mp_property_tgt_imgparams(void *ctx, struct m_property *prop,
                                      int action, void *arg)
 {
@@ -4834,6 +4863,7 @@ static const struct m_property mp_properties_base[] = {
     {"video-target-params", mp_property_tgt_imgparams},
     {"video-out-params", mp_property_vo_imgparams},
     {"gpu-render-formats", mp_property_gpu_render_formats},
+    {"video-active-image", mp_property_video_active_image},
     {"video-dec-params", mp_property_dec_imgparams},
     {"video-params", mp_property_vd_imgparams},
     {"video-frame-info", mp_property_video_frame_info},
