 static void analyzer_xy_prepare(struct priv *p, struct pl_frame *target, struct pl_color_space osd)
 {
     struct async_probe *a=p->async_probe;
-    if(!a || p->next_opts->analyzer_async!=3 || !p->next_opts->analyzer_cursor ||
+    if(!a || p->next_opts->analyzer_async!=3 ||
         p->next_opts->analyzer_xy_size<=0)return;
     pl_color_space_infer(&osd);
     float code=p->next_opts->analyzer_xy_intensity/255.f;
     float light=code<=.04045f ? code/12.92f : powf((code+.055f)/1.055f,2.4f);
     float cap=fmaxf(.0001f,osd.hdr.max_luma*light);
