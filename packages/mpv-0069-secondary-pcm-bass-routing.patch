diff --git a/test/audio_lfe.c b/test/audio_lfe.c
new file mode 100644
--- /dev/null
+++ b/test/audio_lfe.c
@@ -0,0 +1,90 @@
+#include <string.h>
+
+#include "audio/aframe.h"
+#include "audio/chmap.h"
+#include "audio/format.h"
+#include "test_utils.h"
+
+static void check(int format, struct mp_chmap channels, int samples, int lfe)
+{
+    struct mp_aframe_pool *pool = mp_aframe_pool_create(NULL);
+    struct mp_aframe *src = mp_aframe_create();
+    assert_true(mp_aframe_set_format(src, format));
+    assert_true(mp_aframe_set_chmap(src, &channels));
+    assert_true(mp_aframe_set_rate(src, 48000));
+    assert_true(mp_aframe_pool_allocate(pool, src, samples) >= 0);
+    mp_aframe_set_pts(src, 12.25);
+    mp_aframe_set_speed(src, 1.002);
+    int bytes = af_fmt_to_bytes(format);
+    bool planar = af_fmt_is_planar(format);
+    uint8_t **data = mp_aframe_get_data_rw(src);
+    for (int n = 0; n < samples; n++) {
+        for (int c = 0; c < channels.num; c++) {
+            uint8_t *p = data[planar ? c : 0] +
+                (planar ? n : n * channels.num + c) * bytes;
+            for (int b = 0; b < bytes; b++)
+                p[b] = 1 + (n * 7 + c * 23 + b) % 126;
+        }
+    }
+    // Keep a reference to detect inadvertent input mutation and exercise COW.
+    struct mp_aframe *retained = mp_aframe_new_ref(src);
+    bool found = lfe < 0;
+    struct mp_aframe *out = mp_aframe_lfe_stereo(pool, src, &found);
+    assert_true(out);
+    assert_true(found == (lfe >= 0));
+    assert_int_equal(mp_aframe_get_format(out), format);
+    assert_int_equal(mp_aframe_get_size(out), samples);
+    assert_int_equal(mp_aframe_get_rate(out), 48000);
+    assert_true(mp_aframe_get_pts(out) == 12.25);
+    assert_true(mp_aframe_get_speed(out) == 1.002);
+    struct mp_chmap actual, stereo = MP_CHMAP2(FL, FR);
+    mp_aframe_get_chmap(out, &actual);
+    assert_true(mp_chmap_equals(&actual, &stereo));
+    uint8_t **r = mp_aframe_get_data_ro(out);
+    for (int n = 0; n < samples; n++) {
+        for (int c = 0; c < 2; c++) {
+            uint8_t *p = r[planar ? c : 0] + (planar ? n : n * 2 + c) * bytes;
+            for (int b = 0; b < bytes; b++) {
+                int expected = lfe < 0 ? (af_fmt_is_unsigned(format) ? 128 : 0) :
+                               1 + (n * 7 + lfe * 23 + b) % 126;
+                assert_int_equal(p[b], expected);
+            }
+        }
+    }
+    data = mp_aframe_get_data_ro(src);
+    for (int n = 0; n < samples; n++) {
+        for (int c = 0; c < channels.num; c++) {
+            uint8_t *p = data[planar ? c : 0] +
+                (planar ? n : n * channels.num + c) * bytes;
+            for (int b = 0; b < bytes; b++)
+                assert_int_equal(p[b], 1 + (n * 7 + c * 23 + b) % 126);
+        }
+    }
+    talloc_free(retained);
+    talloc_free(src);
+    talloc_free(out);
+    talloc_free(pool);
+}
+
+int main(void)
+{
+    for (int format = 1; format < AF_FORMAT_COUNT; format++) {
+        if (!af_fmt_is_pcm(format))
+            continue;
+        check(format, (struct mp_chmap)MP_CHMAP6(FL, FR, FC, LFE, BL, BR), 257, 3);
+        check(format, (struct mp_chmap)MP_CHMAP8(FL, FR, FC, LFE, BL, BR, SL, SR), 33, 3);
+        check(format, (struct mp_chmap)MP_CHMAP3(LFE, FL, FR), 17, 0);
+        check(format, (struct mp_chmap)MP_CHMAP2(FL, FR), 31, -1);
+        check(format, (struct mp_chmap)MP_CHMAP5(FL, FR, FC, BL, BR), 31, -1);
+        struct mp_chmap unknown;
+        mp_chmap_set_unknown(&unknown, 6);
+        check(format, unknown, 11, -1);
+    }
+    struct mp_aframe_pool *pool = mp_aframe_pool_create(NULL);
+    struct mp_aframe *empty = mp_aframe_create();
+    bool found;
+    assert_true(!mp_aframe_lfe_stereo(pool, empty, &found));
+    talloc_free(empty);
+    talloc_free(pool);
+    return 0;
+}
diff --git a/test/audio_bass.c b/test/audio_bass.c
new file mode 100644
--- /dev/null
+++ b/test/audio_bass.c
@@ -0,0 +1,193 @@
+#include <math.h>
+#include <libavutil/opt.h>
+#include <libswresample/swresample.h>
+
+#include "audio/aframe.h"
+#include "audio/bass_redirect.h"
+#include "audio/chmap.h"
+#include "audio/format.h"
+#include "test_utils.h"
+
+static struct mp_aframe *input(struct mp_aframe_pool *pool, int rate, int count,
+                              struct mp_chmap channels)
+{
+    struct mp_aframe *f = mp_aframe_create();
+    assert_true(mp_aframe_set_format(f, AF_FORMAT_FLOAT));
+    assert_true(mp_aframe_set_chmap(f, &channels));
+    assert_true(mp_aframe_set_rate(f, rate));
+    assert_true(mp_aframe_pool_allocate(pool, f, count) >= 0);
+    assert_true(mp_aframe_set_silence(f, 0, count));
+    mp_aframe_set_pts(f, 5.25);
+    return f;
+}
+
+static void response_and_bound(void)
+{
+    void *pool = mp_aframe_pool_create(NULL);
+    const double gain = pow(10, -MP_BASS_HEADROOM_DB / 20.0);
+    int rates[] = {8000, 32000, 44100, 48000, 96000, 192000, 384000};
+    int cutoffs[] = {20, 80, 250};
+    double largest = 0;
+    for (int r = 0; r < MP_ARRAY_SIZE(rates); r++) {
+        for (int c = 0; c < MP_ARRAY_SIZE(cutoffs); c++) {
+            int rate = rates[r], fc = cutoffs[c], count = rate * 12 / fc;
+            struct mp_aframe *f = input(pool, rate, count,
+                (struct mp_chmap)MP_CHMAP8(FL, FR, FC, LFE, BL, BR, SL, SR));
+            float *p = (float *)mp_aframe_get_data_rw(f)[0];
+            p[0] = 1;
+            struct mp_bass_redirect state = {0};
+            struct mp_aframe *out = mp_bass_redirect_frame(&state, pool, f, fc, false);
+            assert_true(out);
+            float *a = (float *)mp_aframe_get_data_ro(out)[0];
+            double norm = 0;
+            for (int n = 0; n < count; n++) {
+                assert_true(a[2*n] == a[2*n+1]);
+                norm += fabs(a[2*n]) / gain;
+            }
+            // Twelve crossover periods leave an exponentially negligible tail.
+            assert_true(norm < 1.2);
+            largest = MPMAX(largest, norm);
+            talloc_free(out);
+            // Drive the seven speakers coherently, with a full-scale LFE.
+            for (int n = 0; n < count * 8; n++) p[n] = 1;
+            state = (struct mp_bass_redirect){0};
+            out = mp_bass_redirect_frame(&state, pool, f, fc, false);
+            a = (float *)mp_aframe_get_data_ro(out)[0];
+            assert_true(fabs(a[2*(count-1)] - (7 + sqrt(10)) * gain) < 1e-5);
+            // No limiter: filter transient overshoot is allowed, not silently
+            // clipped or normalized. The settled coherent channel sum fits.
+            assert_true(fabs(a[2*(count-1)]) < 1);
+            for (int n = 0; n < count; n++) assert_true(isfinite(a[2*n]));
+            assert_true(mp_aframe_get_pts(out) == 5.25);
+            assert_int_equal(mp_aframe_get_size(out), count);
+            talloc_free(out);
+            // Each of all seven mains must contribute at the same DC gain.
+            for (int ch = 0; ch < 8; ch++) {
+                assert_true(mp_aframe_set_silence(f, 0, count));
+                for (int n = 0; n < count; n++) p[n*8+ch] = 1;
+                state = (struct mp_bass_redirect){0};
+                out = mp_bass_redirect_frame(&state, pool, f, fc, false);
+                a = (float *)mp_aframe_get_data_ro(out)[0];
+                double expected = gain * (ch == 3 ? sqrt(10) : 1);
+                assert_true(fabs(a[2*(count-1)] - expected) < 1e-5);
+                talloc_free(out);
+            }
+            // LR4's amplitude is one half at the selected crossover.
+            assert_true(mp_aframe_set_silence(f, 0, count));
+            for (int n = 0; n < count; n++) p[n*8] = sin(2*M_PI*fc*n/rate);
+            state = (struct mp_bass_redirect){0};
+            out = mp_bass_redirect_frame(&state, pool, f, fc, false);
+            a = (float *)mp_aframe_get_data_ro(out)[0];
+            double power = 0;
+            for (int n = count/2; n < count; n++) power += a[2*n]*a[2*n];
+            assert_true(fabs(sqrt(power/(count-count/2)*2)/gain - .5) < .005);
+            talloc_free(out);
+            talloc_free(f);
+        }
+    }
+    printf("LR4 maximum measured impulse L1 norm: %.9f (< 1.2)\n", largest);
+    assert_true(fabs(MP_BASS_HEADROOM_DB - 20.2) < 1e-9);
+    printf("Fixed 20.2 dB: settled coherent 7.1 peak %.9f\n", (7+sqrt(10))*gain);
+    talloc_free(pool);
+}
+
+static void resampled_peaks(void)
+{
+    void *pool = mp_aframe_pool_create(NULL);
+    int rates[] = {8000, 32000, 44100, 48000, 96000, 192000};
+    double largest = 0;
+    for (int r = 0; r < MP_ARRAY_SIZE(rates); r++) {
+        int rate = rates[r], count = rate / 2;
+        struct mp_aframe *f = input(pool, rate, count,
+            (struct mp_chmap)MP_CHMAP8(FL, FR, FC, LFE, BL, BR, SL, SR));
+        float *p = (float *)mp_aframe_get_data_rw(f)[0];
+        for (int n = 0; n < count; n++) {
+            for (int ch = 0; ch < 8; ch++)
+                p[n*8+ch] = ((n / MPMAX(1, rate/100) + ch/4) & 1) ? 1 : -1;
+        }
+        struct mp_bass_redirect state = {0};
+        struct mp_aframe *mixed = mp_bass_redirect_frame(&state, pool, f, 250, false);
+        for (int dst = 0; dst < MP_ARRAY_SIZE(rates); dst++) {
+            for (int speed = -1; speed <= 1; speed++) {
+                SwrContext *swr = NULL;
+                AVChannelLayout stereo = AV_CHANNEL_LAYOUT_STEREO;
+                assert_true(swr_alloc_set_opts2(&swr, &stereo, AV_SAMPLE_FMT_FLT,
+                    rates[dst], &stereo, AV_SAMPLE_FMT_FLT,
+                    lrint(rate * (1 + speed*.005)), 0, NULL) >= 0);
+                av_opt_set_int(swr, "filter_size", 16, 0);
+                av_opt_set_int(swr, "phase_shift", 10, 0);
+                av_opt_set_double(swr, "cutoff", .8, 0);
+                assert_true(swr_init(swr) >= 0);
+                int capacity = swr_get_out_samples(swr, count) + 1024;
+                float *out = talloc_array(NULL, float, capacity*2);
+                const uint8_t *in = mp_aframe_get_data_ro(mixed)[0];
+                uint8_t *buf = (uint8_t *)out;
+                int produced = swr_convert(swr, &buf, capacity, &in, count);
+                assert_true(produced >= 0);
+                produced += swr_convert(swr, (uint8_t *[]){buf + produced*2*sizeof(float)},
+                                        capacity-produced, NULL, 0);
+                for (int n = 0; n < produced; n++) {
+                    assert_true(out[2*n] == out[2*n+1]);
+                    assert_true(isfinite(out[2*n]));
+                    largest = MPMAX(largest, fabs(out[2*n]));
+                }
+                talloc_free(out);
+                swr_free(&swr);
+            }
+        }
+        talloc_free(mixed);
+        talloc_free(f);
+    }
+    printf("108 resampling/rate-drift cases: peak %.9f\n", largest);
+    talloc_free(pool);
+}
+
+static void split_routing(void)
+{
+    void *pool = mp_aframe_pool_create(NULL);
+    struct mp_chmap layouts[] = {
+        MP_CHMAP2(FL, FR), MP_CHMAP8(FL, FR, FC, BL, BR, SL, SR, LFE),
+    };
+    for (int c = 0; c < MP_ARRAY_SIZE(layouts); c++) {
+        struct mp_chmap map = layouts[c];
+        struct mp_bass_redirect both_state = {0}, split_state = {0};
+        for (int chunk = 0; chunk < 3; chunk++) {
+            struct mp_aframe *f = input(pool, 48000, 1337, map);
+            float *p = (float *)mp_aframe_get_data_rw(f)[0];
+            for (int n = 0; n < 1337; n++)
+                for (int ch = 0; ch < map.num; ch++)
+                    p[n*map.num+ch] = .4*sin((n+chunk*1337)*(ch+1)*.004);
+            struct mp_aframe *both = mp_bass_redirect_frame(&both_state, pool, f, 80, false);
+            struct mp_aframe *split = mp_bass_redirect_frame(&split_state, pool, f, 80, true);
+            bool has_lfe = false;
+            struct mp_aframe *raw = mp_aframe_lfe_stereo(pool, f, &has_lfe);
+            assert_true(both && split && raw);
+            assert_true(has_lfe == (map.num == 8));
+            const float *a = (float *)mp_aframe_get_data_ro(both)[0];
+            const float *b = (float *)mp_aframe_get_data_ro(split)[0];
+            const float *lfe = (float *)mp_aframe_get_data_ro(raw)[0];
+            bool right_has_audio = false;
+            for (int n = 0; n < 1337; n++) {
+                assert_true(b[2*n] == lfe[2*n]);
+                assert_true(b[2*n+1] == a[2*n+1]);
+                right_has_audio |= b[2*n+1] != 0;
+            }
+            assert_true(right_has_audio);
+            assert_true(mp_aframe_get_pts(split) == mp_aframe_get_pts(f));
+            talloc_free(raw);
+            talloc_free(split);
+            talloc_free(both);
+            talloc_free(f);
+        }
+    }
+    talloc_free(pool);
+    printf("Split routing: raw LFE left, identical bass-managed right, no-LFE silence passed\n");
+}
+
+int main(void)
+{
+    response_and_bound();
+    resampled_peaks();
+    split_routing();
+    return 0;
+}
