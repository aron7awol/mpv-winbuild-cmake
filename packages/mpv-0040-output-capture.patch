+    {"output-capture", mp_property_output_capture},
     {"analyzer-async-result", mp_property_async_probe},
     {"analyzer-chromaticity", mp_property_analyzer_chromaticity},
     {"video-dec-params", mp_property_dec_imgparams},
@@ -7727,6 +7748,21 @@ static void cmd_flush_status_line(void *p)
     mp_msg_flush_status_line(mpctx->log, cmd->args[0].v.b);
 }
 
+static void cmd_capture_output(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct voctrl_capture_output_request request = {
+        .path = cmd->args[0].v.s,
+        .redraw = cmd->args[1].v.b,
+    };
+    struct vo *vo = cmd->mpctx->video_out;
+    cmd->success = vo && vo_control(vo, VOCTRL_CAPTURE_OUTPUT, &request) == VO_TRUE;
+    if (cmd->success) {
+        cmd->result = (mpv_node){.format = MPV_FORMAT_INT64,
+                                .u.int64 = request.sequence};
+    }
+}
