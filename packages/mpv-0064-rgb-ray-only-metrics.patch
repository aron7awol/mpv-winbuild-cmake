From: mpv-ht <mpv-ht@localhost>
Date: Fri, 25 Sep 2026 14:00:00 -0400
Subject: [PATCH] Always apply Perceptual and maxRGB along the RGB ray

Remove the private ITP and adaptive-chroma rendering branches and strength
control. Keep Standard, RGB-ray math, recovery and overflow behavior intact.
mpv accepts legacy metric names as canonical RGB aliases. Retain the enum
IDs and a reserved libplacebo struct slot for existing binary clients.

---
diff --git a/video/out/gpu/video.h b/video/out/gpu/video.h
index 77ae980..73f423e 100644
--- a/video/out/gpu/video.h
+++ b/video/out/gpu/video.h
@@ -102,13 +102,9 @@ enum tone_mapping {
 };
 
 enum tone_mapping_metric {
-    TONE_MAPPING_METRIC_STANDARD,
-    TONE_MAPPING_METRIC_BT2020_ITP,
-    TONE_MAPPING_METRIC_BT2020_ADAPTIVE,
-    TONE_MAPPING_METRIC_BT2020_RGB,
-    TONE_MAPPING_METRIC_MAXRGB_ITP,
-    TONE_MAPPING_METRIC_MAXRGB_ADAPTIVE,
-    TONE_MAPPING_METRIC_MAXRGB_RGB,
+    TONE_MAPPING_METRIC_STANDARD = 0,
+    TONE_MAPPING_METRIC_BT2020_RGB = 3,
+    TONE_MAPPING_METRIC_MAXRGB_RGB = 6,
 };
 
 enum gamut_mode {
@@ -131,7 +127,6 @@ struct gl_tone_map_opts {
     int metric;
     float hstm_strength, hstm_overbrightening;
     bool hstm_near_black_protection;
-    float adaptive_chroma_strength;
     bool auto_pq_second_pass;
     bool p_constrained_curve;
     float ambient_gamma;
diff --git a/video/out/gpu/video.c b/video/out/gpu/video.c
