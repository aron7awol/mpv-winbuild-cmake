 struct pl_buf_d3d11 {
     ID3D11Buffer *buf;
     ID3D11Buffer *staging;
+    bool host_read_poll, read_pending, read_ready, read_failed;
     ID3D11ShaderResourceView *raw_srv;
     ID3D11UnorderedAccessView *raw_uav;
     ID3D11ShaderResourceView *texel_srv;
@@ -110,6 +111,7 @@ struct pl_buf_d3d11 {
     bool dirty;
 };
 
+bool pl_d3d11_buf_poll(pl_gpu gpu, pl_buf buf, uint64_t timeout);
 void pl_d3d11_buf_destroy(pl_gpu gpu, pl_buf buf);
 pl_buf pl_d3d11_buf_create(pl_gpu gpu, const struct pl_buf_params *params);
 void pl_d3d11_buf_write(pl_gpu gpu, pl_buf buf, size_t offset, const void *data,
diff --git a/src/d3d11/gpu_buf.c b/src/d3d11/gpu_buf.c
index 955e6e19..1488a47a 100644
--- a/src/d3d11/gpu_buf.c
+++ b/src/d3d11/gpu_buf.c
@@ -47,6 +47,7 @@ pl_buf pl_d3d11_buf_create(pl_gpu gpu, const struct pl_buf_params *params)
 
     struct pl_buf_d3d11 *buf_p = PL_PRIV(buf);
 
+    buf_p->host_read_poll = params->host_read_poll;
     D3D11_BUFFER_DESC desc = { .ByteWidth = params->size };
 
     if (params->uniform && !params->format &&
@@ -211,6 +212,7 @@ void pl_d3d11_buf_write(pl_gpu gpu, pl_buf buf, size_t offset, const void *data,
     struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
     struct pl_buf_d3d11 *buf_p = PL_PRIV(buf);
 
+    buf_p->read_pending = buf_p->read_ready = buf_p->read_failed = false;
     if (buf_p->data) {
         memcpy(buf_p->data + offset, data, size);
         buf_p->dirty = true;
@@ -239,6 +241,36 @@ void pl_d3d11_buf_resolve(pl_gpu gpu, pl_buf buf)
         0, NULL, buf_p->data, 0, 0);
 }
 
+// Submit a staged read once. A poll may return early for any timeout;
+// never wait for GPU completion here, including when timeout is zero.
+bool pl_d3d11_buf_poll(pl_gpu gpu, pl_buf buf, uint64_t timeout)
+{
+    struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
+    struct pl_buf_d3d11 *bp = PL_PRIV(buf);
+    (void) timeout;
+    if (!bp->host_read_poll || !bp->staging) return false;
+    if (bp->read_ready || bp->read_failed) return false;
+    if (!bp->read_pending) {
+        ID3D11DeviceContext_CopyResource(p->imm, (ID3D11Resource *) bp->staging,
+            (ID3D11Resource *) bp->buf);
+        bp->read_pending = true;
+        // Paused playback also needs progress without a future Present.
+        ID3D11DeviceContext_Flush(p->imm);
+    }
+    D3D11_MAPPED_SUBRESOURCE lock;
+    HRESULT hr = ID3D11DeviceContext_Map(p->imm, (ID3D11Resource *) bp->staging,
+        0, D3D11_MAP_READ, D3D11_MAP_FLAG_DO_NOT_WAIT, &lock);
+    if (hr == DXGI_ERROR_WAS_STILL_DRAWING) return true;
+    if (FAILED(hr)) {
+        PL_ERR(gpu, "Staged buffer poll failed: 0x%lx", (unsigned long) hr);
+        bp->read_failed = true;
+        return false;
+    }
+    ID3D11DeviceContext_Unmap(p->imm, (ID3D11Resource *) bp->staging, 0);
+    bp->read_ready = true;
+    return false;
+}
+
 bool pl_d3d11_buf_read(pl_gpu gpu, pl_buf buf, size_t offset, void *dest,
                        size_t size)
 {
@@ -252,18 +284,21 @@ bool pl_d3d11_buf_read(pl_gpu gpu, pl_buf buf, size_t offset, void *dest,
         return true;
     }
 
-    ID3D11DeviceContext_CopyResource(p->imm, (ID3D11Resource *) buf_p->staging,
-        (ID3D11Resource *) buf_p->buf);
+    if (buf_p->read_failed) return false;
+    if (!buf_p->read_pending)
+        ID3D11DeviceContext_CopyResource(p->imm, (ID3D11Resource *) buf_p->staging,
+            (ID3D11Resource *) buf_p->buf);
 
     D3D11_MAPPED_SUBRESOURCE lock;
     D3D(ID3D11DeviceContext_Map(p->imm, (ID3D11Resource *) buf_p->staging, 0,
-                                D3D11_MAP_READ, 0, &lock));
+                                D3D11_MAP_READ, buf_p->read_ready ? D3D11_MAP_FLAG_DO_NOT_WAIT : 0, &lock));
 
     char *csrc = lock.pData;
     memcpy(dest, csrc + offset, size);
 
     ID3D11DeviceContext_Unmap(p->imm, (ID3D11Resource *) buf_p->staging, 0);
 
+    buf_p->read_pending = buf_p->read_ready = buf_p->read_failed = false;
     pl_d3d11_flush_message_queue(ctx, "After buffer read");
 
     return true;
@@ -279,6 +314,7 @@ void pl_d3d11_buf_copy(pl_gpu gpu, pl_buf dst, size_t dst_offset, pl_buf src,
     struct d3d11_ctx *ctx = p->ctx;
     struct pl_buf_d3d11 *src_p = PL_PRIV(src);
     struct pl_buf_d3d11 *dst_p = PL_PRIV(dst);
+    dst_p->read_pending = dst_p->read_ready = dst_p->read_failed = false;
 
     // Handle system memory copies in case one or both of the buffers has a
     // system memory mirror
