From: mpv-ht <mpv-ht@localhost>
Date: Fri, 25 Sep 2026 14:00:00 -0400
Subject: [PATCH] Always apply Perceptual and maxRGB along the RGB ray

Remove the private ITP and adaptive-chroma rendering branches and strength
control. Keep Standard, RGB-ray math, recovery and overflow behavior intact.
mpv accepts legacy metric names as canonical RGB aliases. Retain the enum
IDs and a reserved libplacebo struct slot for existing binary clients.

---
diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index a35e106..dda6c92 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -129,12 +129,9 @@ PL_API void pl_shader_unsigmoidize(pl_shader sh, const struct pl_sigmoid_params
 // Public HDR metadata and CIE Y/maxRGB measurements stay physical.
 enum pl_tone_map_metric {
     PL_TONE_MAP_METRIC_STANDARD = 0,
-    PL_TONE_MAP_METRIC_BT2020_ITP,
-    PL_TONE_MAP_METRIC_BT2020_ADAPTIVE,
-    PL_TONE_MAP_METRIC_BT2020_RGB,
-    PL_TONE_MAP_METRIC_MAXRGB_ITP,
-    PL_TONE_MAP_METRIC_MAXRGB_ADAPTIVE,
-    PL_TONE_MAP_METRIC_MAXRGB_RGB,
+    // Keep the existing numeric IDs for telemetry and shared-library clients.
+    PL_TONE_MAP_METRIC_BT2020_RGB = 3,
+    PL_TONE_MAP_METRIC_MAXRGB_RGB = 6,
 };
 
 struct pl_peak_detect_params {
@@ -390,9 +387,9 @@ struct pl_color_map_params {
     // result is present. They are intentionally ignored for authored metadata.
     enum pl_tone_map_metric tone_mapping_metric;
 
-    // Global strength of the private adaptive-chroma correction, from 0.0
-    // (normal ITP hull processing) to 1.0 (full adaptive formula).
-    float adaptive_chroma_strength;
+    // Retired private metric field. Preserve the shared-library struct layout;
+    // this slot has no behavior and must not be used by callers.
+    float _reserved_metric;
 
     // Exponent applied to the mapped target-PQ I coordinate, normalized so
     // that black and the configured output peak remain fixed. Values below
@@ -468,7 +465,6 @@ struct pl_color_map_params {
     .gamut_constants        = { PL_GAMUT_MAP_CONSTANTS },       \
     .tone_constants         = { PL_TONE_MAP_CONSTANTS },        \
     .metadata               = PL_HDR_METADATA_ANY,              \
-    .adaptive_chroma_strength = 0.5f,                           \
     .hstm_near_black_protection = true,                         \
     .ambient_gamma          = 1.0f,                             \
     .lut3d_size             = {48, 32, 256},                    \
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index a9ac0b3..0d9db79 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -2081,9 +2081,7 @@ bool pl_shader_detect_peak(pl_shader sh, struct pl_color_space csp,
 
     const bool use_histogram = params->percentile > 0 && params->percentile < 100;
     const bool use_metric = params->metric != PL_TONE_MAP_METRIC_STANDARD;
-    const bool use_maxrgb = params->metric == PL_TONE_MAP_METRIC_MAXRGB_ITP ||
-                            params->metric == PL_TONE_MAP_METRIC_MAXRGB_ADAPTIVE ||
-                            params->metric == PL_TONE_MAP_METRIC_MAXRGB_RGB;
+    const bool use_maxrgb = params->metric == PL_TONE_MAP_METRIC_MAXRGB_RGB;
     size_t shmem_req = (use_metric ? 8 : 6) * sizeof(uint32_t);
     if (use_histogram)
         shmem_req += (use_metric ? 3 : 2) * sizeof(uint32_t[HIST_BINS]);
@@ -3580,8 +3578,6 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
 
         if (metric_active) {
             bool maxrgb_metric =
-                params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_ITP ||
-                params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_ADAPTIVE ||
                 params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_RGB;
             ident_t pixel_metric = maxrgb_metric
                 ? emit_maxrgb_metric(sh)
@@ -3628,8 +3624,8 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
                      SH_FLOAT_DYN(1.0f + hstm_clamp(params->hstm_overbrightening, 0, 1)));
             }
 
-            if (params->tone_mapping_metric == PL_TONE_MAP_METRIC_BT2020_RGB ||
-                params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_RGB) {
+            {
+                // Both private metrics always use the linear RGB ray.
                 // Homogeneity makes this the exact fixed-hue inverse:
                 // P(scale * RGB) == scale * P(RGB).
                 // Measure BEFORE gamut mapping, ambient lift and hard clipping.
@@ -3711,19 +3707,6 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
                  SH_MAT3(rgb2lms),
                  PL_COLOR_SDR_WHITE / 10000, PQ_M1, PQ_C1, PQ_C2, PQ_C3,
                  PQ_M2, lms2ipt);
-            } else {
-                // Apply the metric-derived linear compression to I, retaining
-                // libplacebo's existing ITP chroma and gamut processing.
-                GLSL("float i_v = pow(clamp(i_orig, 0.0, 1.0),           \n"
-                     "                    1.0/78.84375);                  \n"
-                     "float i_lin = pow(max(i_v-.8359375,0.0)            \n"
-                     "    / max(18.8515625-18.6875*i_v,1e-6),            \n"
-                     "      1.0/.1593017578125) * metric_scale;          \n"
-                     "float i_m = pow(clamp(i_lin, 0.0, 1.0),            \n"
-                     "                    .1593017578125);                \n"
-                     "i_m = (.8359375 + 18.8515625*i_m)                  \n"
-                     "    / (1.0 + 18.6875*i_m);                         \n"
-                     "ipt.x = pow(i_m, 78.84375);                        \n");
             }
         }
 
@@ -3734,43 +3717,11 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         // visibly desaturates colors that remain inside the larger target
         // gamut. Preserve P/T there and let the output-gamut stage constrain
         // only colors that actually cross its boundary.
-        if (!inverse_expansion && (!metric_active ||
-            params->tone_mapping_metric == PL_TONE_MAP_METRIC_BT2020_ITP ||
-            params->tone_mapping_metric == PL_TONE_MAP_METRIC_BT2020_ADAPTIVE ||
-            params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_ITP ||
-            params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_ADAPTIVE)) {
+        if (!inverse_expansion && !metric_active) {
             GLSL("vec2 hull = vec2(i_orig, ipt.x);                       \n"
                  "hull = ((hull - 6.0) * hull + 9.0) * hull;             \n"
                  "float chroma_scale = min(i_orig / max(ipt.x, 1e-6),   \n"
                  "                         hull.y / max(hull.x, 1e-6));  \n");
-            if (metric_active &&
-                (params->tone_mapping_metric == PL_TONE_MAP_METRIC_BT2020_ADAPTIVE ||
-                 params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_ADAPTIVE)) {
-                const float adaptive_strength =
-                    PL_CLAMP(params->adaptive_chroma_strength, 0.0f, 1.0f);
-                // MPC-SK-inspired adaptive chroma retention. Keep the
-                // metric-derived I coordinate, but pull the conservative
-                // libplacebo hull result toward source IPT chroma according
-                // to saturation intent and compression strength. The normal
-                // gamut mapper remains the final output-gamut constraint.
-                GLSL("float rgb_max = max(max(color.r, color.g), color.b); \n"
-                     "float rgb_min = min(min(color.r, color.g), color.b); \n"
-                     "float rgb_sat = rgb_max > 1e-7                       \n"
-                     "    ? clamp((rgb_max-rgb_min)/rgb_max, 0.0, 1.0)    \n"
-                     "    : 0.0;                                           \n"
-                     "float rel_chroma = clamp(length(ipt.yz) /            \n"
-                     "    max(i_orig, 1e-6), 0.0, 1.0);                    \n"
-                     "float sat_intent = clamp(max(rgb_sat,                 \n"
-                     "    0.35*rel_chroma), 0.0, 1.0);                      \n"
-                     "float compression = clamp(1.0-metric_scale,          \n"
-                     "    0.0, 1.0);                                       \n"
-                     "float chroma_keep = clamp(0.50+0.38*sat_intent       \n"
-                     "    - 0.18*compression, 0.0, 1.0);                   \n"
-                     "chroma_keep = max(chroma_keep, 0.68*rgb_sat);        \n"
-                     "chroma_keep *= "$";                                  \n"
-                     "chroma_scale = mix(chroma_scale, 1.0, chroma_keep);  \n",
-                     SH_FLOAT(adaptive_strength));
-            }
             GLSL("ipt.yz *= chroma_scale;                              \n");
         }
     }
diff --git a/src/tests/gpu_tests.c b/src/tests/gpu_tests.c
index b7d72b8..cb5a2cf 100644
--- a/src/tests/gpu_tests.c
+++ b/src/tests/gpu_tests.c
@@ -2406,7 +2406,7 @@ static void pl_causal_temporal_fixture_test(pl_gpu gpu)
     struct pl_peak_detect_params peak = pl_peak_detect_default_params;
     peak.force = true;
     peak.allow_delayed = false;
-    peak.metric = PL_TONE_MAP_METRIC_BT2020_ITP;
+    peak.metric = PL_TONE_MAP_METRIC_BT2020_RGB;
     struct pl_render_params p = pl_render_default_params;
     p.peak_detect_params = &peak;
     p.causal_scene_detection = true;
