From: mpv-ht <mpv-ht@localhost>
Date: Sat, 19 Sep 2026 18:00:00 -0400
Subject: [PATCH] Recover constrained highlight detail with bounded local darkening

Measure blocked positive PQ(P) detail with the actual first-stage curve,
filter a same-frame local budget, and suppress hard-edge borrowing.
Bound extra loss to 10% of ordinary recovered P times recovery strength.
Keep existing upper bounds, inactive paths and fixed RGB chromaticity.
Use the same budget before overflow measurement and final rendering.

---
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 1194551..a9ac0b3 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -2710,11 +2710,11 @@ void sh_extract_p_features(pl_shader sh, struct pl_color_space csp)
 
 // Use the ordinary low-pass sampler and bicubic reconstruction, in PQ(P).
 static void emit_p_recovery(pl_shader sh, const struct pl_color_map_params *params,
-                            pl_tex feature, struct pl_color_space src,
+                            const struct pl_color_map_args *args, struct pl_color_space src,
                             struct pl_color_space dst, float output_max)
 {
     ident_t pos, pt;
-    ident_t tex = sh_bind(sh, feature, PL_TEX_ADDRESS_CLAMP, PL_TEX_SAMPLE_LINEAR,
+    ident_t tex = sh_bind(sh, args->feature_map, PL_TEX_ADDRESS_CLAMP, PL_TEX_SAMPLE_LINEAR,
                          "p_recovery_feature", NULL, &pos, &pt);
     GLSL("{ vec2 lpos = "$"; vec2 lpt = "$"; \n"
          "vec2 lsize = vec2(textureSize("$",0)); \n"
@@ -2750,13 +2750,70 @@ static void emit_p_recovery(pl_shader sh, const struct pl_color_map_params *para
          "cap *= min(1.0,"$"/max(source_max,1e-12)); \n"
          "cap = pow(max(cap,0.0),%f); \n"
          "cap = pow((%f+%f*cap)/(1.0+%f*cap),%f); \n"
-         "float upper = max(metric_out,min(metric_in,cap)); \n"
-         "float room = delta >= 0.0 ? upper-metric_out : max(metric_out-%f,0.0); \n"
-         "metric_out += room*tanh(clamp(delta/max(room,1e-8),-16.0,16.0)); \n"
-         "} \n",
+         "float upper = max(metric_out,min(metric_in,cap)); \n",
          SH_MAT3(to_dst), PQ_M2, PQ_C1, PQ_C2, PQ_C3, PQ_M1,
-         SH_FLOAT_DYN(target_max), PQ_M1, PQ_C1, PQ_C2, PQ_C3, PQ_M2,
+         SH_FLOAT_DYN(target_max), PQ_M1, PQ_C1, PQ_C2, PQ_C3, PQ_M2);
+
+    if (args->measure_p_recovery) {
+        // Smooth onset, exact zero with enough headroom (including a constant
+        // field). Do not feed a soft limiter's ordinary compression back into
+        // recovery, or even well below the ceiling the whole frame would dim.
+        GLSL("float lost = max(delta-(upper-metric_out),0.0); \n"
+             "lost = lost*lost/(lost+1e-5); \n"
+             "lost *= 1.0-smoothstep(0.008,0.02,abs(metric_in-low)); \n"
+             "color = vec4(lost,metric_in,0.0,1.0); } \n");
+        *args->measure_p_recovery = true;
+        sh_describe(sh, "P recovery blocked-detail measurement");
+        return;
+    }
+
+    GLSL("float room = delta >= 0.0 ? upper-metric_out : max(metric_out-%f,0.0); \n"
+         "float recovered = metric_out+room*tanh(clamp(delta/max(room,1e-8),-16.0,16.0)); \n",
          powf(PQ_C1, PQ_M2));
+    if (args->p_recovery_map) {
+        ident_t bp, bpt;
+        ident_t budget = sh_bind(sh, args->p_recovery_map, PL_TEX_ADDRESS_CLAMP,
+            PL_TEX_SAMPLE_LINEAR, "p_recovery_budget", NULL, &bp, &bpt);
+        // A compact, positive filter spreads blocked bright detail over its
+        // own neighborhood. Reject dissimilar PQ levels to avoid spreading
+        // the bias across a strong edge. There is no temporal accumulator.
+        GLSL("float lost_sum=0.0, weight_sum=0.0, edge=0.0; \n"
+             "for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) { \n"
+             " vec2 b=textureLod("$", "$"+vec2(x,y)*"$",0.0).rg; \n"
+             " float w=float((2-abs(x))*(2-abs(y))); \n"
+             " edge=max(edge,abs(b.g-metric_in)); \n"
+             " w*=1.0-smoothstep(0.01,0.03,abs(b.g-metric_in)); \n"
+             " lost_sum+=w*max(b.r,0.0); weight_sum+=w; } \n"
+             // Look just outside the budget footprint too. A bright side's
+             // averaged guide can already look flat while its budget still
+             // contains blocked corrections from the adjacent hard edge.
+             "for(int i=0;i<4;i++) { \n"
+             " vec2 o=i==0 ? vec2(-3,0) : i==1 ? vec2(3,0) : i==2 ? vec2(0,-3) : vec2(0,3); \n"
+             " float q=textureLod("$", "$"+o*"$",0.0).g; \n"
+             " edge=max(edge,abs(q-metric_in)); } \n"
+             "float bias=2.0*lost_sum/max(weight_sum,1e-8); \n"
+             "bias*=1.0-smoothstep(0.01,0.03,edge); \n"
+             // Bound ADDITIONAL dimming relative to ordinary recovery, in
+             // linear P: at most 10% at strength 1, 2.5% at strength .25.
+             // The existing recovery curve is 1-Lipschitz in delta on either
+             // side of zero, so limiting the PQ bias also bounds its output.
+             "float rv=pow(clamp(recovered,0.0,1.0),1.0/%f); \n"
+             "float floor_p=pow(max(rv-%f,0.0)/max(%f-%f*rv,1e-9),1.0/%f); \n"
+             "floor_p*=1.0-"$"; \n"
+             "floor_p=pow(max(floor_p,0.0),%f); \n"
+             "floor_p=pow((%f+%f*floor_p)/(1.0+%f*floor_p),%f); \n"
+             "float allowance=max(recovered-floor_p,0.0); \n"
+             "bias=allowance*tanh(clamp(bias/max(allowance,1e-8),0.0,16.0)); \n"
+             "delta-=bias; \n"
+             "room=delta>=0.0 ? upper-metric_out : max(metric_out-%f,0.0); \n"
+             "float shifted=metric_out+room*tanh(clamp(delta/max(room,1e-8),-16.0,16.0)); \n"
+             "recovered=min(recovered,max(shifted,min(floor_p,recovered))); \n",
+             budget, bp, bpt, budget, bp, bpt, PQ_M2, PQ_C1, PQ_C2, PQ_C3, PQ_M1,
+             SH_FLOAT(0.10f * PL_CLAMP(params->contrast_recovery, 0.0f, 1.0f)),
+             PQ_M1, PQ_C1, PQ_C2, PQ_C3, PQ_M2, powf(PQ_C1, PQ_M2));
+        sh_describe(sh, "P recovery bounded local darkening");
+    }
+    GLSL("metric_out=recovered; } \n");
     sh_describe(sh, "P contrast recovery (bounded)");
 }
 
