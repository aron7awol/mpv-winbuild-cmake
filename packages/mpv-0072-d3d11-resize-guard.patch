     HRESULT hr;
@@ -373,15 +429,55 @@ static bool resize(struct ra_ctx *ctx)
         return false;
     }
 
-    blackout_call(ctx, BO_RESIZE_BEGIN, S_OK, 0, 0);
-    hr = IDXGISwapChain_ResizeBuffers(p->swapchain, 0, ctx->vo->dwidth,
-        ctx->vo->dheight, DXGI_FORMAT_UNKNOWN, 0);
-    blackout_call(ctx, BO_RESIZE_END, hr, 0, 0);
-    log_result(ctx, RESULT_RESIZE, hr, -1);
-    if (FAILED(hr)) {
-        return false;
+    enum resize_guard_decision decision = RG_DISABLED;
+    if (p->resize_trace) {
+        struct w32_resize_info empty = {0};
+        if (!info) info = &empty;
+        struct resize_state current;
+        bool queried = query_resize_state(ctx, &current);
+        bool same = queried && p->resize_valid &&
+                    same_resize_state(ctx, &current, &p->resize_state);
+        bool healthy = SUCCEEDED(p->resize_last_present) &&
+                       ID3D11Device_GetDeviceRemovedReason(p->device) == S_OK;
+        decision = resize_guard_decide(p->opts->skip_redundant_resize, force,
+                                       info->reasons, queried, same, healthy);
+        MP_VERBOSE(ctx, "resize-guard decision=%s origin=%d reasons=0x%x messages=%u "
+                   "serial=%"PRIu64"..%"PRIu64" requested=%dx%d actual=%ux%u "
+                   "query=%d equal=%d healthy=%d setting=0x%x area=\"%s\"\n",
+                   resize_guard_name(decision), origin, info->reasons, info->messages,
+                   info->first_serial, info->last_serial, ctx->vo->dwidth, ctx->vo->dheight,
+                   current.desc.BufferDesc.Width, current.desc.BufferDesc.Height,
+                   queried, same, healthy, info->setting_action, info->setting_area);
+        if (p->blackout) {
+            struct bo_record r = blackout_base(ctx, BO_RESIZE_DECISION);
+            r.u.resize.info = *info;
+            r.u.resize.decision = decision;
+            r.u.resize.origin = origin;
+            r.u.resize.width = ctx->vo->dwidth;
+            r.u.resize.height = ctx->vo->dheight;
+            r.u.resize.actual_width = current.desc.BufferDesc.Width;
+            r.u.resize.actual_height = current.desc.BufferDesc.Height;
+            r.u.resize.queried = queried;
+            r.u.resize.equal = same;
+            r.u.resize.healthy = healthy;
+            bo_record(p->blackout, r);
+        }
+    }
+    if (decision != RG_SKIP) {
+        p->resize_valid = false;
+        blackout_call(ctx, BO_RESIZE_BEGIN, S_OK, 0, 0);
+        hr = IDXGISwapChain_ResizeBuffers(p->swapchain, 0, ctx->vo->dwidth,
