+    if (!fmt || !gpu->limits.compute_queues || !gpu->limits.max_ssbo_size)
+        return;
+    enum { W = 8, H = 8 };
+    float src[W * H * 4], ref[W * H * 4], out[W * H * 4];
+    for (int i = 0; i < W * H; i++) {
+        src[4*i+0] = (float) i / (W * H - 1) * (10000.0f / PL_COLOR_SDR_WHITE);
+        src[4*i+1] = 0.2f * src[4*i+0]; src[4*i+2] = 0.1f * src[4*i+0];
+        src[4*i+3] = 1.0f;
+    }
+    pl_tex st = pl_tex_create(gpu, pl_tex_params(.w=W, .h=H, .format=fmt,
+        .sampleable=true, .initial_data=src));
