+#define BAR_ANALYSIS_MAX_ROWS 4320
+#define BAR_ANALYSIS_SLOTS 8
+#define BAR_RESULT_CACHE 16
+#define BAR_TIMING_SAMPLES 256
+#define BAR_ANALYSIS_TILES 32
+
+struct bar_gpu_data {
+    // min, max, sum, sample count in normalized unsigned 16-bit luma.
+    uint32_t rows[BAR_ANALYSIS_MAX_ROWS][4];
+    // Pixels materially above nominal black, used to distinguish sparse codec
+    // residue from an established row of picture content.
+    uint32_t bright[BAR_ANALYSIS_MAX_ROWS];
+    // Bright pixels in the outer horizontal eighths. Real picture content
+    // normally reaches these regions; centered titles and credits do not.
+    uint32_t edge_bright[BAR_ANALYSIS_MAX_ROWS];
+    // Min, max, sum, and sample count for narrow strips at the left and right
+    // edges. These establish actual side-matte evidence; they never define a
+    // horizontal crop.
+    uint32_t side[BAR_ANALYSIS_MAX_ROWS][2][4];
+    // Packed normalized 16-bit min/max values for horizontal regions in each
+    // row. These preserve spatial matte structure without reading back a full
+    // per-pixel mask: low 16 bits are min, high 16 bits are max.
+    uint32_t tiles[BAR_ANALYSIS_MAX_ROWS][BAR_ANALYSIS_TILES];
+};
+
+struct bar_analysis_slot {
+    pl_buf buf;
+    bool pending;
+    uint64_t tag;
+    int width, height;
+};
+
+struct bar_result {
+    uint64_t tag;
+    int source_w, source_h;
+    int top, bottom;
+    uint32_t black;
+    uint8_t side_matte_mask;
+    bool valid, indeterminate, width_spanning, breakout, boundary_exact;
+    bool faint_structured;
+};
+
