 {
     const struct pl_color_map_params *cp = pass->params->color_map_params;
     pl_renderer rr = pass->rr;
@@ -3005,7 +3062,7 @@ static pl_tex measure_rgb_ray_peak(struct pass_state *pass,
         .src = pass->image.color, .dst = dst, .prelinearized = linear,
         .state = &rr->tone_map_state, .measure_rgb_ray = true,
         .measure_p_curve = p_curve,
-        .feature_map = feature_map));
+        .feature_map = feature_map, .p_recovery_map = p_recovery_map));
     if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(.shader = &sh, .target = prev)))
         goto error;
 
@@ -3163,7 +3220,9 @@ static void pass_convert_colors(struct pass_state *pass)
 
         // generate HDR feature map if required
         pl_tex feature_map = get_feature_map(pass);
-        pl_tex ray_peak = measure_rgb_ray_peak(pass, target_csp, prelinearized, feature_map);
+        pl_tex p_recovery_map = get_p_recovery_map(pass, target_csp, prelinearized, feature_map);
+        pl_tex ray_peak = measure_rgb_ray_peak(pass, target_csp, prelinearized,
+                                              feature_map, p_recovery_map);
         sh = img_sh(pass, img); // Feature/peak extraction may dispatch the input.
 
         // current -> target
@@ -3175,6 +3234,7 @@ static void pass_convert_colors(struct pass_state *pass)
             .tone_curve    = params->color_map_params && params->color_map_params->report_tone_curve
                                 ? &rr->tone_curve : NULL,
             .feature_map   = feature_map,
+            .p_recovery_map = p_recovery_map,
             .rgb_ray_peak  = params->color_map_params && params->color_map_params->p_constrained_curve ? NULL : ray_peak,
             .p_curve       = params->color_map_params && params->color_map_params->p_constrained_curve ? ray_peak : NULL,
         ));
