index 0000000..41f5bfb
--- /dev/null
+++ b/src/shaders/hstm.h
@@ -0,0 +1,120 @@
+/* Private mpv-ht histogram-shaped P mapping. No spatial filtering or SEP.
+ * SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PL_SHADERS_HSTM_H_
+#define PL_SHADERS_HSTM_H_
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#define HSTM_BINS 256
+#define HSTM_FLOOR 0.01f
+#define HSTM_LOG_MAX 19.931570012f /* log2(1 + 10000 / 0.01) */
+
+static inline float hstm_coord(float nits)
+{
+    return log2f(1.0f + fmaxf(nits, 0.0f) / HSTM_FLOOR);
+}
+
+static inline float hstm_nits(float coord)
+{
+    return HSTM_FLOOR * expm1f(coord * 0.69314718056f);
+}
+
+static inline float hstm_clamp(float x, float lo, float hi)
+{
+    return fminf(hi, fmaxf(lo, x));
+}
+
+/* Normalize before smoothing so proportional sample populations and excluded
+ * black pixels cannot change strength. Only consume completed measurements. */
+static inline bool hstm_update_histogram(float state[HSTM_BINS], bool valid,
+                                        const uint64_t counts[HSTM_BINS],
+                                        float temporal, bool cut)
+{
+    double total = 0;
+    for (int i = 0; i < HSTM_BINS; i++) total += counts[i];
+    if (!(total > 0)) return false;
+    float raw[HSTM_BINS], smooth[HSTM_BINS], sum = 0, tv = 0;
+    for (int i = 0; i < HSTM_BINS; i++) raw[i] = counts[i] / total;
+    for (int i = 0; i < HSTM_BINS; i++) {
+        float v = 0, norm = 0;
+        for (int j = -3; j <= 3; j++) {
+            const int k = i + j;
+            if (k < 0 || k >= HSTM_BINS) continue;
+            const float w = expf(-0.5f * j*j / 2.25f);
+            v += w * raw[k]; norm += w;
+        }
+        smooth[i] = v / norm;
+        sum += smooth[i];
+    }
+    for (int i = 0; i < HSTM_BINS; i++) {
+        smooth[i] /= sum;
+        if (valid) tv += fabsf(smooth[i] - state[i]) * 0.5f;
+    }
+    // Distribution changes can identify a cut even when peak and mean match.
+    const float alpha = !valid || cut || tv > 0.65f ? 1.0f
+        : hstm_clamp(temporal, 0.0f, 1.0f);
+    for (int i = 0; i < HSTM_BINS; i++)
+        state[i] = valid ? state[i] + alpha * (smooth[i] - state[i]) : smooth[i];
+    return true;
+}
+
+static inline float hstm_density(const float hist[HSTM_BINS], float nits)
+{
+    const float p = hstm_clamp(hstm_coord(nits) / HSTM_LOG_MAX * HSTM_BINS - 0.5f,
+                               0.0f, HSTM_BINS - 1.0f);
+    const int lo = (int)p, hi = lo + 1 < HSTM_BINS ? lo + 1 : lo;
+    return (hist[lo] + (p - lo) * (hist[hi] - hist[lo])) * HSTM_BINS;
+}
+
+/* input/base/out contain linear P in nits on the same monotonic input grid.
+ * Redistribute the base curve's log-brightness increments, then normalize its
+ * endpoints. Positive bounded weights preserve order. Near-black is anchored.
+ * Above-source retention is a separate final operation and never affects an
+ * already dimmed value. At 100%, maximum above-source gain is 2x (one stop).
+ * The caller supplies scratch[n] and may alias base and out. */
+static inline void hstm_shape_curve(const float hist[HSTM_BINS],
+                                    const float *input, const float *base,
+                                    float *out, float *scratch, int n,
+                                    float strength, float brightening)
+{
+    if (n < 2) return;
+    strength = hstm_clamp(strength, 0, 1);
+    brightening = hstm_clamp(brightening, 0, 1);
+    if (strength == 0) {
+        for (int i = 0; i < n; i++) out[i] = base[i];
+        return;
+    }
+    int anchor = 0;
+    while (anchor + 1 < n && input[anchor + 1] <= 0.1f) anchor++;
+    const float lower = hstm_coord(base[anchor]);
+    const float upper = hstm_coord(base[n - 1]);
+    scratch[anchor] = 0;
+    float previous = lower;
+    for (int i = anchor + 1; i < n; i++) {
+        const float current = fmaxf(previous, hstm_coord(base[i]));
+        const float p = sqrtf(fmaxf(input[i - 1], 0) * fmaxf(input[i], 0));
+        const float density = hstm_density(hist, p);
+        // Log softens large populations; clamp bounds local slope allocation.
+        const float weight = hstm_clamp(0.5f + log1pf(8.0f*density) / logf(9.0f),
+                                        0.5f, 4.0f);
+        scratch[i] = scratch[i - 1] + (current - previous) * weight;
+        previous = current;
+    }
+    const float scale = scratch[n - 1] > 1e-12f
+        ? (upper - lower) / scratch[n - 1] : 0;
+    const float ceiling = base[n - 1];
+    for (int i = 0; i < n; i++) {
+        float candidate = base[i];
+        if (i > anchor) {
+            const float target = lower + scratch[i] * scale;
+            candidate = hstm_nits(hstm_coord(base[i]) * (1 - strength)
+                                  + strength * target);
+        }
+        candidate = fminf(candidate, 2.0f * input[i]);
+        const float below = fminf(candidate, input[i]);
+        out[i] = fminf(ceiling, below + brightening * fmaxf(candidate - input[i], 0));
+        if (input[i] <= 0) out[i] = 0;
+    }
+}
+#endif
