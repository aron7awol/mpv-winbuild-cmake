diff --git a/player/audio.c b/player/audio.c
index 64e5326f4..7e55b4fb2 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -633,9 +633,18 @@ double written_audio_pts(struct MPContext *mpctx)
 double playing_audio_pts(struct MPContext *mpctx)
 {
     double pts = written_audio_pts(mpctx);
+    bool trace = mpctx->video_out && mpctx->video_out->ht_timing;
+    if (trace) mpctx->ht_audio = (struct ht_audio_sample){0};
     if (pts == MP_NOPTS_VALUE || !mpctx->ao)
         return pts;
-    return pts - mpctx->audio_speed * ao_get_delay(mpctx->ao);
+    int64_t before = trace ? ht_timing_qpc() : 0;
+    double delay = ao_get_delay(mpctx->ao);
+    double playing = pts - mpctx->audio_speed * delay;
+    if (trace) mpctx->ht_audio = (struct ht_audio_sample){
+        .valid = 1, .begin = before, .end = ht_timing_qpc(),
+        .written = pts, .delay = delay, .speed = mpctx->audio_speed, .playing = playing,
+    };
+    return playing;
 }
 
