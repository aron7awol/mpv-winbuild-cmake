+#define BAR_ANALYSIS_MAX_ROWS 4320
+#define BAR_ANALYSIS_SLOTS 8
+#define BAR_RESULT_CACHE 16
+
+struct bar_gpu_data {
+    // min, max, sum, sample count in normalized unsigned 16-bit luma.
+    uint32_t rows[BAR_ANALYSIS_MAX_ROWS][4];
+};
+
+struct bar_analysis_slot {
+    pl_buf buf;
+    bool pending;
+    uint64_t tag;
+    int width, height;
+};
+
+struct bar_result {
+    uint64_t tag;
+    int source_w, source_h;
+    int top, bottom;
+    bool valid, indeterminate;
+};
+
 struct cache {
     struct mp_log *log;
     struct mpv_global *global;
@@ -130,6 +155,11 @@ struct priv {
     pl_gpu gpu;
     pl_renderer rr;
     pl_queue queue;
+    pl_dispatch bar_dispatch;
+    struct bar_analysis_slot bar_slots[BAR_ANALYSIS_SLOTS];
+    struct bar_result bar_results[BAR_RESULT_CACHE];
+    int bar_result_next;
+    struct bar_gpu_data bar_readback;
     pl_swapchain sw;
     pl_fmt osd_fmt[SUBBITMAP_COUNT];
     pl_tex *sub_tex;
@@ -148,6 +178,9 @@ struct priv {
     bool frame_pending;
     bool paused;
     uint64_t causal_scene_last_logged_tag;
+    struct bar_result active_image;
+    bool active_image_available;
