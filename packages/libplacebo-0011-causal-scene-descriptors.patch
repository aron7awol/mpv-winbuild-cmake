+    enum pl_tone_map_metric active_metric_branch;
+    int readback_latency_frames;
+    float histogram_tv, tile_mad, shifted_tile_mad;
+    float translated_motion_fraction, global_motion_residual, cut_score;
+};
+
+PL_API bool pl_renderer_get_causal_scene_diagnostics(
+    pl_renderer rr, struct pl_causal_scene_diagnostics *diagnostics);
