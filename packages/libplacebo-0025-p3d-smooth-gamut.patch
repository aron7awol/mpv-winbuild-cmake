         const struct pl_gamut_map_function *fun = gamut.function;
         sh_describef(sh, "gamut map (%s)", fun->name);
 
@@ -3422,6 +3425,12 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         }
     }
 
+    if (p3d) {
+        emit_p3d_brightness_restore(sh, &gamut, p3d_metric, p3d_brightness,
+                                   ipt2lms, lms2ipt);
+        gamut.function = &pl_gamut_map_ipt_path;
+    }
+
     if (ambient_active) {
         // Apply ambient compensation after the ordinary tone/chroma and gamut
         // reconstruction. Preserve the resulting P/T exactly when the lifted
