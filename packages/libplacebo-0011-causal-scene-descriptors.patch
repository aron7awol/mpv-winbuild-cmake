+    PL_CAUSAL_SCENE_WITHHELD_DISCONTINUITY,
+    PL_CAUSAL_SCENE_WITHHELD_UNSUPPORTED,
+};
+
+struct pl_causal_scene_diagnostics {
+    bool effective_allow_delayed, descriptor_valid, visual_trigger;
+    bool acceleration_applied;
+    uint64_t submitted_tag, consumed_tag, last_trigger_tag, visual_trigger_count;
