From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mpv-ht <mpv-ht@localhost>
Date: Tue, 24 Nov 2026 12:00:00 -0500
Subject: [PATCH] gpu-next: blend only the first refresh of each new frame

diff --git a/player/command.c b/player/command.c
index 2c201f4..dd9e2ad 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2778,6 +2778,24 @@ static int mp_property_vo_imgparams(void *ctx, struct m_property *prop,
     return property_imgparams(&p, action, arg);
 }
 
+static int mp_property_motion_blur(void *ctx, struct m_property *prop,
+                                   int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct voctrl_motion_blur v = {0};
+    if (!mpctx->video_out || vo_control(mpctx->video_out,
+            VOCTRL_GET_MOTION_BLUR, &v) != VO_TRUE)
+        return M_PROPERTY_UNAVAILABLE;
+    struct m_sub_property props[] = {
+        {"active", SUB_PROP_BOOL(v.active)},
+        {"display-hz", SUB_PROP_DOUBLE(v.hz)},
+        {"source-fps", SUB_PROP_DOUBLE(v.fps)},
+        {"previous-weight", SUB_PROP_DOUBLE(v.previous_weight)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
 static int mp_property_gpu_render_formats(void *ctx, struct m_property *prop,
                                           int action, void *arg)
 {
@@ -5111,6 +5129,7 @@ static const struct m_property mp_properties_base[] = {
     {"video-target-params", mp_property_tgt_imgparams},
     {"video-out-params", mp_property_vo_imgparams},
     {"gpu-render-formats", mp_property_gpu_render_formats},
+    {"motion-blur-status", mp_property_motion_blur},
     {"video-active-image", mp_property_video_active_image},
     {"output-capture", mp_property_output_capture},
     {"analyzer-async-result", mp_property_async_probe},
diff --git a/video/out/motion_blur_response.h b/video/out/motion_blur_response.h
new file mode 100644
index 0000000..ece32ca
--- /dev/null
+++ b/video/out/motion_blur_response.h
@@ -0,0 +1,12 @@
+// Single-refresh Motion blur. Percentage is the previous-frame contribution.
+#ifndef MPV_HT_MOTION_BLUR_RESPONSE_H
+#define MPV_HT_MOTION_BLUR_RESPONSE_H
+#include <math.h>
+
+static inline double motion_blur_response_weight(double previous_percent, int slot)
+{
+    if (slot != 0 || !isfinite(previous_percent) || previous_percent <= 0)
+        return 0;
+    return fmin(previous_percent, 100.0) / 100.0;
+}
+#endif
