+    // Restrict the mix to the scheduled current frame and its immediate
+    // predecessor. Never introduce a future motion position or blend a drop,
+    // authored scene boundary, seek, pause, or changed aperture.
+    const struct pl_frame *motion_blur_images[2];
+    uint64_t motion_blur_signatures[2];
+    float motion_blur_timestamps[2];
+    float motion_blur_weight = -1.0f;
+    if (motion_blur && mix.num_frames) {
+        int cur = -1, prev = -1;
+        for (int i = 0; i < mix.num_frames; i++) {
+            const struct mp_image *mpi = mix.frames[i]->user_data;
+            const struct frame_priv *fp = mpi->priv;
+            if (fp->causal_scene_tag == frame->frame_id + 1) cur = i;
+            if (fp->causal_scene_tag == frame->frame_id) prev = i;
+        }
+        double dt = frame->ideal_frame_vsync_duration;
+        int slot = dt > 0 ? (int) llround((frame->ideal_frame_vsync - p->motion_blur_first_vsync) / dt) : -1;
+        // Model the light emitted throughout each physical refresh interval.
+        // The source clock identifies the slot; wall time sets pixel settling.
+        double interval_ms = frame->vsync_interval * 1000.0;
+        float weight = motion_blur_response_weight(p->next_opts->motion_blur_strength,
+            p->next_opts->motion_blur_settle_ms, p->next_opts->motion_blur_curve,
+            slot * interval_ms, interval_ms);
+        bool pair = cur >= 0 && prev >= 0 && weight > 0 &&
+                    !((struct frame_priv *) ((struct mp_image *) mix.frames[cur]->user_data)->priv)->authored_scene_cut;
+        if (cur >= 0) {
+            int indices[2] = {pair ? prev : cur, cur};
+            int count = pair ? 2 : 1;
+            for (int i = 0; i < count; i++) {
+                int n = indices[i];
+                motion_blur_images[i] = mix.frames[n];
+                motion_blur_signatures[i] = mix.signatures[n];
+                motion_blur_timestamps[i] = mix.timestamps[n];
+            }
+            mix.num_frames = count;
+            mix.frames = motion_blur_images;
+            mix.signatures = motion_blur_signatures;
+            mix.timestamps = motion_blur_timestamps;
+            if (pair) motion_blur_weight = weight;
+        }
+        MP_DBG(vo, "Motion blur frame=%"PRIu64" slot=%d previous=%.6f hz=%.3f fps=%.5f\n",
+               frame->frame_id, slot, motion_blur_weight >= 0 ? motion_blur_weight : 0.0f, motion_blur_hz, motion_blur_fps);
+    }
