+        .active_image_detection = true,
         .border_background = BACKGROUND_COLOR,
         .background_blur_radius = 16.0f,
         .inter_preserve = true,
@@ -1025,6 +1093,941 @@ static bool upload_planes_sw(struct vo *vo, pl_gpu gpu, struct mp_image *mpi,
     return true;
 }
 
+static bool bar_tile_is_matte(uint32_t packed, uint32_t black)
+{
+    uint32_t mn = packed & 0xffffu;
+    uint32_t mx = packed >> 16;
+    if (mx < mn || mx - mn > 512)
+        return false;
+    uint32_t midpoint = (mn + mx) / 2;
+    return abs((int) midpoint - (int) black) <= 128;
+}
+
+static bool bar_outer_black_baseline(const struct bar_gpu_data *data,
+                                     int height, uint32_t *baseline)
+{
+    uint32_t candidates[BAR_ANALYSIS_TILES * 2];
+    int num = 0;
+    for (int edge = 0; edge < 2; edge++) {
+        int y = edge ? height - 1 : 0;
+        for (int tile = 0; tile < BAR_ANALYSIS_TILES; tile++) {
+            uint32_t packed = data->tiles[y][tile];
+            uint32_t mn = packed & 0xffffu;
+            uint32_t mx = packed >> 16;
+            uint32_t midpoint = (mn + mx) / 2;
+            if (mx >= mn && mx - mn <= 512 && midpoint <= 6000)
+                candidates[num++] = midpoint;
+        }
+    }
+    // Localized overflow may contaminate much of an outer row, but require at
+    // least one quarter of the paired edge regions to agree that a plausible
+    // black population still exists before replacing the whole-row mean.
+    if (num < BAR_ANALYSIS_TILES / 2)
+        return false;
+    for (int i = 1; i < num; i++) {
+        uint32_t value = candidates[i];
+        int j = i;
+        while (j > 0 && candidates[j - 1] > value) {
+            candidates[j] = candidates[j - 1];
+            j--;
+        }
+        candidates[j] = value;
+    }
+    *baseline = candidates[(num - 1) / 2];
+    return true;
+}
+
+static int bar_paired_matte_tiles(const struct bar_gpu_data *data, int y,
+                                  int height, uint32_t black)
+{
+    int matte = 0;
+    for (int tile = 0; tile < BAR_ANALYSIS_TILES; tile++) {
+        matte += bar_tile_is_matte(data->tiles[y][tile], black);
+        matte += bar_tile_is_matte(data->tiles[height - 1 - y][tile], black);
+    }
+    return matte;
+}
+
+static bool find_spatial_bar_boundary(const struct bar_gpu_data *data,
+                                      int height, uint32_t black,
+                                      int *boundary, int *support)
+{
+    // A real horizontal aperture ends across most of the encoded width. A
+    // frame-breaking effect only contaminates a minority of otherwise matte
+    // horizontal regions. Require two adjacent mirrored row pairs with at
+    // least 60% non-matte support before accepting the boundary.
+    const int samples = BAR_ANALYSIS_TILES * 2;
+    int run = 0;
+    for (int y = 0; y < height / 2; y++) {
+        int non_matte = samples -
+            bar_paired_matte_tiles(data, y, height, black);
+        if ((uint64_t) non_matte * 5 >= (uint64_t) samples * 3) {
+            if (++run >= 2) {
+                int first = y - run + 1;
+                *boundary = (first + 1) & ~1;
+                *support = non_matte;
+                return true;
+            }
+        } else {
+            run = 0;
+        }
+    }
+    return false;
+}
+
+static void store_bar_result(struct priv *p, uint64_t tag, int width, int height,
+                             const struct bar_gpu_data *data)
+{
+    struct bar_result result = {
+        .tag = tag,
+        .source_w = width,
+        .source_h = height,
+        .valid = true,
+        .width_spanning = true,
+    };
+    if (height < 4 || height > BAR_ANALYSIS_MAX_ROWS)
+        return;
+
+    uint64_t edge_sum = (uint64_t) data->rows[0][2] +
+                        data->rows[height - 1][2];
+    uint64_t edge_n = (uint64_t) data->rows[0][3] +
+                      data->rows[height - 1][3];
+    if (!edge_n)
+        return;
+    uint32_t black = edge_sum / edge_n;
+    uint32_t spatial_black = 0;
+    if (bar_outer_black_baseline(data, height, &spatial_black))
+        black = spatial_black;
+    result.black = black;
+
+    bool outer_breakout_hold = false;
+    if (black > 6000 && p->active_image_available &&
+        p->active_image.source_w == width &&
+        p->active_image.source_h == height &&
+        p->active_image.top > 0 && p->active_image.breakout)
+    {
+        // Once a localized excursion has established that picture is breaking
+        // out of a stable aperture, retain that aperture through frames where
+        // the excursion momentarily covers every outer tile. Otherwise the
+        // middle of one continuous effect would masquerade as a fresh AR cut.
+        result.top = result.bottom = p->active_image.top;
+        result.black = p->active_image.black;
+        result.breakout = true;
+        outer_breakout_hold = true;
+    } else if (black > 6000 && p->active_image_available &&
+        p->active_image.source_w == width &&
+        p->active_image.source_h == height &&
+        p->active_image.top > 0 && p->active_image.black <= 6000)
+    {
+        int previous = p->active_image.top;
+        int first = MPMAX(0, previous - 8);
+        int matte = 0, samples = 0;
+        for (int y = first; y < previous; y++) {
+            matte += bar_paired_matte_tiles(
+                data, y, height, p->active_image.black);
+            samples += BAR_ANALYSIS_TILES * 2;
+        }
+        if (samples && (uint64_t) matte * 20 >=
+                       (uint64_t) samples * 7)
+        {
+            result.top = result.bottom = previous;
+            result.black = p->active_image.black;
+            result.breakout = true;
+            outer_breakout_hold = true;
+            MP_TRACE(p, "Active image outer breakout hold frame=%" PRIu64
+                     " previous=%d matte=%d/%d.\n",
+                     tag - 1, previous, matte, samples);
+        }
+    }
+
+    // Nominal limited-range black is about 6.25% of the normalized texture.
+    // Reject brighter outer rows before considering them an encoded matte.
+    // This is deliberately a gate, not the boundary threshold.
+    if (!outer_breakout_hold && black <= 6000) {
+        uint32_t matte_ceiling = black + 2048;
+        uint32_t noise_pixels = MPMAX(4, width / 200);
+        int exact_top = 0, exact_bottom = 0;
+        for (int y = 0; y < height / 2; y++) {
+            const uint32_t *row = data->rows[y];
+            uint32_t mean = row[3] ? row[2] / row[3] : UINT32_MAX;
+            if (row[1] - row[0] > 4 || abs((int) mean - (int) black) > 4)
+                break;
+            exact_top++;
+        }
+        for (int y = height - 1; y >= height / 2; y--) {
+            const uint32_t *row = data->rows[y];
+            uint32_t mean = row[3] ? row[2] / row[3] : UINT32_MAX;
+            if (row[1] - row[0] > 4 || abs((int) mean - (int) black) > 4)
+                break;
+            exact_bottom++;
+        }
+
+        // The exact seed is preferred, but the final rows of a shrinking
+        // encoded matte can acquire small block residue before the matte
+        // disappears. Recover a seed only while paired outer rows remain
+        // tightly clustered around this frame's measured black baseline and
+        // contain no material population of bright pixels.
+        int seed_top = exact_top, seed_bottom = exact_bottom;
+        if (seed_top < 2) {
+            seed_top = 0;
+            for (int y = 0; y < height / 2; y++) {
+                const uint32_t *row = data->rows[y];
+                uint32_t mean = row[3] ? row[2] / row[3] : UINT32_MAX;
+                if (row[1] - row[0] > 2048 ||
+                    abs((int) mean - (int) black) > 512 ||
+                    data->bright[y] > noise_pixels)
+                    break;
+                seed_top++;
+            }
+        }
+        if (seed_bottom < 2) {
+            seed_bottom = 0;
+            for (int y = height - 1; y >= height / 2; y--) {
+                const uint32_t *row = data->rows[y];
+                uint32_t mean = row[3] ? row[2] / row[3] : UINT32_MAX;
+                if (row[1] - row[0] > 2048 ||
+                    abs((int) mean - (int) black) > 512 ||
+                    data->bright[y] > noise_pixels)
+                    break;
+                seed_bottom++;
+            }
+        }
+
+        // A fully black/faded frame has no observable image boundary. Keep it
+        // explicitly indeterminate so the presentation side can hold the last
+        // confident geometry instead of manufacturing a new aspect ratio.
+        int near_black = 0;
+        uint64_t bright_pixels = 0, edge_bright_pixels = 0;
+        for (int y = 0; y < height; y++) {
+            const uint32_t *row = data->rows[y];
+            uint32_t mean = row[3] ? row[2] / row[3] : UINT32_MAX;
+            near_black += mean <= black + 512;
+            bright_pixels += data->bright[y];
+            edge_bright_pixels += data->edge_bright[y];
+        }
+        // Sparse credits, logos, and fade remnants on black do not reveal an
+        // authored aperture. Treat them like a fully black frame and retain
+        // the last geometry that was established by an observable picture.
+        uint64_t pixels = (uint64_t) width * height;
+        // Whole-frame coverage rejects credits, logos, and tiny fade remnants.
+        // Do not also require bright pixels in the outer eighths: the measured
+        // baseline-relative side strips below are the authoritative test for
+        // whether observable picture actually spans the encoded width.
+        bool sparse = bright_pixels <= pixels / 10;
+        int spatial_boundary = 0, spatial_support = 0;
+        bool spatial_found = find_spatial_bar_boundary(
+            data, height, black, &spatial_boundary, &spatial_support);
+        bool faint_structured = sparse && spatial_found &&
+            bright_pixels * 40 > pixels * 3;
+        if (near_black >= height * 95 / 100 ||
+            (sparse && !faint_structured)) {
+            MP_TRACE(p, "Active image sparse evidence frame=%" PRIu64
+                     " black=%u near=%d/%d bright=%" PRIu64 "/%" PRIu64
+                     " edge=%" PRIu64 "/%" PRIu64 " seed=%d/%d.\n",
+                     tag - 1, black, near_black, height, bright_pixels,
+                     pixels / 10, edge_bright_pixels, pixels / 200,
+                     seed_top, seed_bottom);
+            result.valid = false;
+            result.indeterminate = true;
+        } else if (spatial_found || (seed_top >= 2 && seed_bottom >= 2)) {
+            // Codec blocks can perturb otherwise black matte rows by a few
+            // luma code values. Extend the perfectly uniform core only while
+            // every value in both mirrored rows remains near this frame's
+            // measured black baseline. The first genuine non-black value is
+            // content; this tolerance exists solely for encoded matte noise.
+            int core = MPMIN(seed_top, seed_bottom);
+            int centered = core;
+            bool boundary_found = false;
+            int legacy_centered = core;
+            bool legacy_found = false;
+            if (seed_top >= 2 && seed_bottom >= 2) {
+                for (int n = 0; n < 64; n++) {
+                    int y = core + n;
+                    if (y >= height / 2) {
+                        legacy_found = true;
+                        break;
+                    }
+                    const uint32_t *top = data->rows[y];
+                    const uint32_t *bottom = data->rows[height - 1 - y];
+                    bool top_content = top[1] > matte_ceiling &&
+                                       data->bright[y] > noise_pixels;
+                    bool bottom_content = bottom[1] > matte_ceiling &&
+                        data->bright[height - 1 - y] > noise_pixels;
+                    if (top_content || bottom_content) {
+                        legacy_found = true;
+                        break;
+                    }
+                    legacy_centered = y + 1;
+                }
+            }
+            legacy_centered = (legacy_centered + 1) & ~1;
+            if (spatial_found) {
+                centered = spatial_boundary;
+                boundary_found = true;
+                // Keep the row detector's finer boundary when both methods
+                // describe the same aperture. Spatial consensus exists to
+                // reject localized excursions, not to introduce 2-4 pixel
+                // quantization noise at an otherwise stable matte edge.
+                if (legacy_found && abs(centered - legacy_centered) <= 8)
+                    centered = legacy_centered;
+                result.breakout = centered > 0 &&
+                    (centered > legacy_centered + 2 ||
+                     seed_top < 2 || seed_bottom < 2);
+                MP_TRACE(p, "Active image spatial evidence frame=%" PRIu64
+                         " black=%u boundary=%d support=%d/%d legacy=%d "
+                         "breakout=%d.\n", tag - 1, black, centered,
+                         spatial_support, BAR_ANALYSIS_TILES * 2,
+                         legacy_found ? legacy_centered : -1,
+                         result.breakout);
+            } else {
+                centered = legacy_centered;
+                boundary_found = legacy_found;
+            }
+            result.boundary_exact = legacy_found;
+            if (result.breakout && p->active_image_available &&
+                p->active_image.source_w == width &&
+                p->active_image.source_h == height)
+            {
+                centered = p->active_image.top;
+            }
+            // When a candidate expands outward, test the narrow band directly
+            // outside the established aperture. A centered AR change removes
+            // that matte on both sides across the width. Breakout effects leave
+            // a substantial portion of the old matte line intact, even when
+            // their total envelope reaches the encoded frame edges.
+            if (boundary_found && p->active_image_available &&
+                p->active_image.source_w == width &&
+                p->active_image.source_h == height &&
+                centered < p->active_image.top)
+            {
+                int previous = p->active_image.top;
+                if (result.breakout)
+                    centered = previous;
+                int first = MPMAX(centered, previous - 8);
+                int matte = 0, samples = 0;
+                for (int y = first; y < previous; y++) {
+                    matte += bar_paired_matte_tiles(data, y, height, black);
+                    samples += BAR_ANALYSIS_TILES * 2;
+                }
+                if (samples && (uint64_t) matte * 20 >=
+                               (uint64_t) samples * 7)
+                {
+                    MP_TRACE(p, "Active image breakout hold frame=%" PRIu64
+                             " candidate=%d previous=%d matte=%d/%d.\n",
+                             tag - 1, centered, previous, matte, samples);
+                    centered = previous;
+                    result.breakout = true;
+                }
+            }
+            // 4:2:0 encodes vertical chroma on an even-row grid. Snap a
+            // one-row inward ambiguity to that grid so codec residue cannot
+            // toggle a stable authored boundary between adjacent rows.
+            centered = (centered + 1) & ~1;
+            int active_h = height - 2 * centered;
+            if (!boundary_found) {
+                // The refinement limit is a safety boundary, not evidence of
+                // picture. Holding avoids publishing the limit itself as a
+                // false aperture when codec noise shortens one exact core.
+                result.valid = false;
+                result.indeterminate = true;
+            } else if (active_h > 0 && (double) width / active_h <= 3.0) {
+                // A vertical aperture only defines an aspect ratio while the
+                // observable picture spans the encoded width. A credible
+                // matte on either horizontal side makes width/active_h
+                // ambiguous (windowboxing, an offset graphic, or a wipe).
+                // Keep this as a confidence veto only: never crop side bars.
+                int content_rows = 0, left_inset_rows = 0;
+                int right_inset_rows = 0;
+                for (int y = centered; y < height - centered; y++) {
+                    if (data->bright[y] <= noise_pixels)
+                        continue;
+                    content_rows++;
+                    const uint32_t *left = data->side[y][0];
+                    const uint32_t *right = data->side[y][1];
+                    uint32_t left_mean = left[3] ? left[2] / left[3] : UINT32_MAX;
+                    uint32_t right_mean = right[3] ? right[2] / right[3] : UINT32_MAX;
+                    left_inset_rows += left[3] && left[1] - left[0] <= 512 &&
+                        abs((int) left_mean - (int) black) <= 128;
+                    right_inset_rows += right[3] && right[1] - right[0] <= 512 &&
+                        abs((int) right_mean - (int) black) <= 128;
+                }
+                bool enough_rows = content_rows >= MPMAX(4, active_h / 4);
+                bool left_matte = enough_rows &&
+                    (uint64_t) left_inset_rows * 20 >=
+                    (uint64_t) content_rows * 19;
+                bool right_matte = enough_rows &&
+                    (uint64_t) right_inset_rows * 20 >=
+                    (uint64_t) content_rows * 19;
+                result.side_matte_mask = left_matte | (right_matte << 1);
+                result.width_spanning = !left_matte && !right_matte;
+                result.faint_structured = faint_structured;
+                result.top = result.bottom = centered;
+                MP_TRACE(p, "Active image side evidence frame=%" PRIu64
+                         " black=%u active=%dx%d rows=%d left=%d right=%d "
+                         "matte=%d/%d.\n", tag - 1, black, width, active_h,
+                         content_rows, left_inset_rows, right_inset_rows,
+                         left_matte, right_matte);
+            } else {
+                // Sparse logos and fades can have a centered internal edge,
+                // but do not establish a credible authored image aperture.
+                result.valid = false;
+                result.indeterminate = true;
+            }
+        } else {
+            // A few low-level codec values can remove the exact seed from an
+            // otherwise black outer row. Without materially bright pixels at
+            // either edge, this is not evidence that picture became full
+            // frame; retain the preceding confident aperture.
+            const uint32_t *top = data->rows[0];
+            const uint32_t *bottom = data->rows[height - 1];
+            bool top_content = top[1] > matte_ceiling &&
+                               data->bright[0] > noise_pixels;
+            bool bottom_content = bottom[1] > matte_ceiling &&
+                data->bright[height - 1] > noise_pixels;
+            if (!top_content && !bottom_content) {
+                result.valid = false;
+                result.indeterminate = true;
+            }
+        }
+    }
+
+    p->bar_results[p->bar_result_next] = result;
+    p->bar_result_next = (p->bar_result_next + 1) % BAR_RESULT_CACHE;
+}
+
+static void consume_bar_analysis(struct priv *p)
+{
+    for (uint64_t ns; (ns = pl_timer_query(p->gpu, p->bar_timer));) {
+        p->bar_timings[p->bar_timing_next] = ns;
+        p->bar_timing_next = (p->bar_timing_next + 1) % BAR_TIMING_SAMPLES;
+        p->bar_timing_count = MPMIN(p->bar_timing_count + 1,
+                                    BAR_TIMING_SAMPLES);
+    }
+    for (int i = 0; i < BAR_ANALYSIS_SLOTS; i++) {
+        struct bar_analysis_slot *slot = &p->bar_slots[i];
+        if (!slot->pending || pl_buf_poll(p->gpu, slot->buf, 0))
+            continue;
+        if (pl_buf_read(p->gpu, slot->buf, 0, &p->bar_readback,
+                        sizeof(p->bar_readback)))
+        {
+            store_bar_result(p, slot->tag, slot->width, slot->height,
+                             &p->bar_readback);
+        }
+        slot->pending = false;
+    }
+}
+
+static const struct bar_result *find_bar_result(struct priv *p, uint64_t tag)
+{
+    for (int i = 0; i < BAR_RESULT_CACHE; i++) {
+        if (p->bar_results[i].tag == tag)
+            return &p->bar_results[i];
+    }
+    return NULL;
+}
+
+static bool comparable_bar_result(const struct bar_result *a,
+                                  const struct bar_result *b)
+{
+    return a && b && a->valid && b->valid &&
+           a->source_w == b->source_w && a->source_h == b->source_h;
+}
+
+static int bar_change_direction(const struct bar_result *from,
+                                const struct bar_result *to)
+{
+    if (!comparable_bar_result(from, to))
+        return 0;
+    int top = to->top - from->top;
+    int bottom = to->bottom - from->bottom;
+    if (top <= 0 && bottom <= 0 && (top < 0 || bottom < 0))
+        return -1;
+    if (top >= 0 && bottom >= 0 && (top > 0 || bottom > 0))
+        return 1;
+    return 0;
+}
+
+static bool strong_bar_boundary(const struct bar_result *result)
+{
+    return result && result->valid &&
+           (result->boundary_exact || (!result->top && !result->bottom));
+}
+
+static bool coherent_bar_motion(struct priv *p,
+                                const struct bar_result *anchor,
+                                const struct bar_result *current,
+                                const struct bar_result *next,
+                                const struct bar_result *later)
+{
+    if (!comparable_bar_result(anchor, current) ||
+        !comparable_bar_result(current, next) ||
+        !comparable_bar_result(next, later) || !strong_bar_boundary(anchor) ||
+        !strong_bar_boundary(current) || !strong_bar_boundary(next) ||
+        !strong_bar_boundary(later))
+        return false;
+
+    int first = bar_change_direction(anchor, current);
+    int second = bar_change_direction(current, next);
+    int third = bar_change_direction(next, later);
+    if (!first || second != first || (third && third != first))
+        return false;
+
+    // A genuine centered aperture animation advances both edges by a similar
+    // amount on consecutive frames. Matte-boundary residue instead plateaus,
+    // reverses, or changes step size as different encoded blocks cross the
+    // threshold. Allow one row of measurement variation per edge.
+    int at = current->top - anchor->top;
+    int ab = current->bottom - anchor->bottom;
+    int bt = next->top - current->top;
+    int bb = next->bottom - current->bottom;
+    int ct = later->top - next->top;
+    int cb = later->bottom - next->bottom;
+    if (!third && (abs(at - p->active_motion_top_step) > 2 ||
+                   abs(ab - p->active_motion_bottom_step) > 2 ||
+                   (!p->active_motion_top_step &&
+                    !p->active_motion_bottom_step)))
+        return false;
+    return abs(at - ab) <= 1 && abs(bt - bb) <= 1 && abs(ct - cb) <= 1 &&
+           abs(at - bt) <= 2 && (!third || abs(bt - ct) <= 2);
+}
+
+static const struct bar_result *stable_bar_result(struct priv *p, uint64_t tag)
+{
+    const struct bar_result *result = find_bar_result(p, tag);
+    if (!result || !result->valid || !p->active_image_available)
+        return result;
+
+    const struct bar_result *next = find_bar_result(p, tag + 1);
+    const struct bar_result *later = find_bar_result(p, tag + 2);
+    if (!comparable_bar_result(&p->active_image, result))
+        return result;
+
+    int top_delta = abs(result->top - p->active_image.top);
+    int bottom_delta = abs(result->bottom - p->active_image.bottom);
+    if (!top_delta && !bottom_delta)
+        return result;
+
+    // About 0.56% of source height per edge: 12 rows at 2160p, 6 at
+    // 1080p. This is an ambiguity envelope, not output quantization. A raw
+    // sequence that moves coherently escapes it on its matching frame.
+    int micro = MPMAX(2, result->source_h / 180);
+    bool future_available = comparable_bar_result(result, next) &&
+                            comparable_bar_result(next, later);
+    bool motion_endpoint = future_available && strong_bar_boundary(result) &&
+        strong_bar_boundary(next) && strong_bar_boundary(later) &&
+        result->top == next->top &&
+        result->bottom == next->bottom && result->top == later->top &&
+        result->bottom == later->bottom &&
+        abs((result->top - p->active_image.top) -
+            p->active_motion_top_step) <= 2 &&
+        abs((result->bottom - p->active_image.bottom) -
+            p->active_motion_bottom_step) <= 2 &&
+        (p->active_motion_top_step || p->active_motion_bottom_step);
+    if (top_delta <= micro && bottom_delta <= micro &&
+        (!future_available || !motion_endpoint) &&
+        !coherent_bar_motion(p, &p->active_image, result, next, later))
+    {
+        MP_TRACE(p, "Active image micro hold frame=%" PRIu64
+                 " candidate=%d/%d anchor=%d/%d limit=%d.\n", tag - 1,
+                 result->top, result->bottom, p->active_image.top,
+                 p->active_image.bottom, micro);
+        return &p->active_image;
+    }
+    return result;
+}
+
+static bool confirmed_faint_width_change(struct priv *p,
+                                         const struct bar_result *result)
+{
+    if (!result || !result->valid || !result->faint_structured ||
+        (result->side_matte_mask != 1 && result->side_matte_mask != 2) ||
+        !result->top || result->breakout)
+        return false;
+
+    const struct bar_result *next = find_bar_result(p, result->tag + 1);
+    const struct bar_result *later = find_bar_result(p, result->tag + 2);
+    return comparable_bar_result(result, next) &&
+           comparable_bar_result(next, later) &&
+           next->top == result->top && next->bottom == result->bottom &&
+           later->top == result->top && later->bottom == result->bottom &&
+           next->side_matte_mask == result->side_matte_mask &&
+           later->width_spanning && !next->breakout && !later->breakout;
+}
+
+static bool ambiguous_width_change(struct priv *p,
+                                   const struct bar_result *result)
+{
+    if (!result || !result->valid || result->width_spanning ||
+        (result->top == 0 && result->bottom == 0) ||
+        confirmed_faint_width_change(p, result))
+        return false;
+    if (!p->active_image_available ||
+        p->active_image.source_w != result->source_w ||
+        p->active_image.source_h != result->source_h)
+        return true;
+    return p->active_image.top != result->top ||
+           p->active_image.bottom != result->bottom;
+}
+
+static void commit_active_image(struct priv *p, uint64_t tag,
+                                int source_w, int source_h)
+{
+    const struct bar_result *result = stable_bar_result(p, tag);
+    if (result && tag != p->bar_last_commit_tag) {
+        if (!p->bar_first_commit_tag)
+            p->bar_first_commit_tag = tag;
+        p->bar_last_commit_tag = tag;
+        p->bar_commit_count++;
+        p->bar_indeterminate_count += result->indeterminate;
+    }
+    bool ambiguous = ambiguous_width_change(p, result);
+    if (result && result->valid && !ambiguous) {
+        if (!p->active_image_available ||
+            p->active_image.top != result->top ||
+            p->active_image.bottom != result->bottom)
+        {
+            MP_VERBOSE(p, "Active image frame=%" PRIu64 " source=%dx%d "
+                       "top=%d bottom=%d active=%dx%d.\n", tag - 1,
+                       result->source_w, result->source_h, result->top,
+                       result->bottom, result->source_w,
+                       result->source_h - result->top - result->bottom);
+        }
+        if (p->active_image_available && result != &p->active_image) {
+            p->active_motion_top_step = result->top - p->active_image.top;
+            p->active_motion_bottom_step =
+                result->bottom - p->active_image.bottom;
+        }
+        p->active_image = *result;
+        p->active_image_available = true;
+    } else if (ambiguous) {
+        MP_TRACE(p, "Holding active image frame=%" PRIu64 " candidate="
+                 "%dx%d top=%d bottom=%d: picture does not span width.\n",
+                 tag - 1, result->source_w, result->source_h, result->top,
+                 result->bottom);
+    } else if (!p->active_image_available && source_w > 0 && source_h > 0) {
+        // Startup fallback until the first asynchronous result is ready.
+        p->active_image = (struct bar_result) {
+            .tag = tag,
+            .source_w = source_w,
+            .source_h = source_h,
+            .valid = true,
+        };
+        p->active_image_available = true;
+    }
+}
+
+static struct mp_rect active_source_rect(struct priv *p, uint64_t tag,
+                                         int width, int height)
+{
+    const struct bar_result *result = stable_bar_result(p, tag);
+    if (!result || !result->valid || ambiguous_width_change(p, result))
+        result = p->active_image_available ? &p->active_image : NULL;
+    int top = result && result->source_w == width && result->source_h == height
+            ? result->top : 0;
+    int bottom = result && result->source_w == width && result->source_h == height
+               ? result->bottom : 0;
+    return (struct mp_rect) {0, top, width, height - bottom};
+}
+
+static struct mp_rect fit_active_destination(struct mp_rect canvas,
+                                             int active_w, int active_h,
+                                             float align_x, float align_y)
+{
+    int cw = mp_rect_w(canvas), ch = mp_rect_h(canvas);
+    if (cw < 1 || ch < 1 || active_w < 1 || active_h < 1)
+        return canvas;
+    double source_ar = (double) active_w / active_h;
+    double canvas_ar = (double) cw / ch;
+    int w, h;
+    if (source_ar >= canvas_ar) {
+        w = cw;
+        h = lrint(cw / source_ar);
+    } else {
+        h = ch;
+        w = lrint(ch * source_ar);
+    }
+    int x = canvas.x0 + lrint((cw - w) * (MPCLAMP(align_x, -1, 1) + 1) / 2);
+    int y = canvas.y0 + lrint((ch - h) * (MPCLAMP(align_y, -1, 1) + 1) / 2);
+    return (struct mp_rect) {x, y, x + w, y + h};
+}
+
+static struct mp_rect map_source_to_active_destination(
+    struct mp_rect active_dst, struct mp_rect source, int source_w,
+    int source_h, int top, int bottom)
+{
+    int active_h = source_h - top - bottom;
+    if (source_w < 1 || active_h < 1)
+        return active_dst;
+
+    int sx0 = MPMIN(source.x0, source.x1);
+    int sx1 = MPMAX(source.x0, source.x1);
+    int sy0 = MPMIN(source.y0, source.y1);
+    int sy1 = MPMAX(source.y0, source.y1);
+    double scale_x = (double) mp_rect_w(active_dst) / source_w;
+    double scale_y = (double) mp_rect_h(active_dst) / active_h;
+    return (struct mp_rect) {
+        active_dst.x0 + lrint(sx0 * scale_x),
+        active_dst.y0 + lrint((sy0 - top) * scale_y),
+        active_dst.x0 + lrint(sx1 * scale_x),
+        active_dst.y0 + lrint((sy1 - top) * scale_y),
+    };
+}
+
