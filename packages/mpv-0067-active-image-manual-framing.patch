From: mpv-ht development <mpv-ht@localhost>
Date: Wed, 30 Sep 2026 12:00:00 -0400
Subject: [PATCH] gpu-next: reject asymmetric mattes and compose manual framing

Veto a centered crop when independent edge evidence proves a full-width
matte opposite full-width picture. Preserve localized breakout handling.

Intersect detected and explicit source crops before rotation and fitting.
Honor unscaled, pan, stretch, scale and margins without double-applying
the ordinary pre-clipped source rectangle. Share live/screenshot geometry.
Depends on the existing Fill/zoom geometry fixes; follows patch 0066.

---
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 30a0a9b..ae28e12 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1193,6 +1193,57 @@ static int bar_paired_matte_tiles(const struct bar_gpu_data *data, int y,
     return matte;
 }
 
+static bool bar_asymmetric_mattes(struct priv *p,
+                                  const struct bar_gpu_data *data, int height,
+                                  int boundary, uint32_t black)
+{
+    // A paired vote alone can mistake a one-sided matte for two matching bars.
+    // Reject that aperture when either edge independently shows a full-width
+    // matte opposite full-width picture. Localized subtitles/breakouts do not
+    // meet this deliberately strong veto. Two adjacent rows avoid single-row
+    // codec noise; this is spatial evidence, not a temporal debounce.
+    // Both outer edges can be genuine matte while a few rows at the picture
+    // boundary differ because of codec residue or a tiny authored offset.
+    // Keep the existing eight-row boundary tolerance in that case. Do not
+    // grant it to one-sided mattes, even very thin ones.
+    bool common_outer_matte = true;
+    for (int y = 0; y < 2; y++) {
+        for (int edge = 0; edge < 2; edge++) {
+            int matte = 0;
+            for (int t = 0; t < BAR_ANALYSIS_TILES; t++)
+                matte += bar_tile_is_matte(
+                    data->tiles[edge ? height - 1 - y : y][t], black);
+            common_outer_matte &= matte * 10 >= BAR_ANALYSIS_TILES * 9;
+        }
+    }
+    int end = common_outer_matte ? MPMAX(0, boundary - 8) : boundary;
+    int run[2] = {0};
+    for (int y = 0; y < end; y++) {
+        int matte[2] = {0}, picture[2] = {0};
+        for (int t = 0; t < BAR_ANALYSIS_TILES; t++) {
+            for (int edge = 0; edge < 2; edge++) {
+                uint32_t tile = data->tiles[edge ? height - 1 - y : y][t];
+                matte[edge] += bar_tile_is_matte(tile, black);
+                // Failing the tight matte test is not proof of picture:
+                // compressed black can be nonuniform while remaining dark.
+                picture[edge] += (tile & 0xffffu) > black + 2048;
+            }
+        }
+        for (int edge = 0; edge < 2; edge++) {
+            bool asymmetric = matte[edge] * 10 >= BAR_ANALYSIS_TILES * 9 &&
+                              picture[1 - edge] * 10 >= BAR_ANALYSIS_TILES * 9;
+            run[edge] = asymmetric ? run[edge] + 1 : 0;
+            if (run[edge] >= 2) {
+                MP_TRACE(p, "Active image asymmetric matte veto edge=%d "
+                         "rows=%d..%d boundary=%d.\n",
+                         edge, y - run[edge] + 1, y, boundary);
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
