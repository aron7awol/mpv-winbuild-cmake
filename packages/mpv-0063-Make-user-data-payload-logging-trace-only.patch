From a5635ca9dc626ece6c339357a8408b8462eae24d Mon Sep 17 00:00:00 2001
From: Aaron <aaronmedeiros@gmail.com>
Date: Tue, 22 Sep 2026 23:01:45 -0400
Subject: [PATCH] Make user-data payload logging trace-only

---
 player/command.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/player/command.c b/player/command.c
index 3505a102f..dde9f9729 100644
--- a/player/command.c
+++ b/player/command.c
@@ -5314,6 +5314,11 @@ static bool is_property_set(int action, void *val)
     }
 }
 
+static bool is_user_data_property(const char *name)
+{
+    return strcmp(name, "user-data") == 0 || strncmp(name, "user-data/", 10) == 0;
+}
+
 int mp_property_do(const char *name, int action, void *val,
                    struct MPContext *ctx)
 {
@@ -5321,6 +5326,11 @@ int mp_property_do(const char *name, int action, void *val,
     int r = m_property_do(ctx->log, cmd->properties, name, action, val, ctx);
 
     if (mp_msg_test(ctx->log, MSGL_V) && is_property_set(action, val)) {
+        // Script state can contain an entire enriched media library. Do not
+        // serialize it merely for the default debug-level file log. Explicit
+        // trace logging retains the full payload for targeted diagnostics.
+        if (is_user_data_property(name) && !mp_msg_test(ctx->log, MSGL_TRACE))
+            return r;
         struct m_property *property = m_property_list_find(cmd->properties, name);
         if (property && property->is_noisy && !mp_msg_test(ctx->log, MSGL_TRACE))
             return r;
@@ -6230,7 +6240,9 @@ void run_command(struct MPContext *mpctx, struct mp_cmd *cmd,
     ctx->seek_msg_osd = auto_osd ? opts->osd_on_seek & 2 : ctx->msg_osd;
     ctx->seek_bar_osd = auto_osd ? opts->osd_on_seek & 1 : ctx->bar_osd;
 
-    bool noise = cmd->def->is_noisy || cmd->mouse_move;
+    bool noise = cmd->def->is_noisy || cmd->mouse_move ||
+        (strcmp(cmd->name, "set") == 0 && cmd->nargs >= 1 &&
+         is_user_data_property(cmd->args[0].v.s));
     mp_cmd_dump(mpctx->log, noise ? MSGL_TRACE : MSGL_DEBUG, "Run command:", cmd);
 
     if (cmd->flags & MP_EXPAND_PROPERTIES) {
-- 
