From b485c7b9115313b6f928690c8b0f74d9d2598cfa Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:52:56 -0500
Subject: [PATCH] colorspace: use PQ signal black for tone input


diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 703822aef1d32925ed40791692be36d1e86e85f2..4969cbc918bf29e564e7e3799979ec72bf8b3e2f 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -1835,6 +1835,15 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         .out_avg    = &tone.input_avg,
     ));
 
+    // HDR10 mastering-display minimum luminance describes the mastering
+    // display, not the darkest representable PQ signal. Do not use MinMDL as
+    // a hard lower bound for the tone-mapping curve: PQ code zero is absolute
+    // black. Keep src.hdr.min_luma intact for metadata propagation.
+    if (src.transfer == PL_COLOR_TRC_PQ) {
+        tone.input_min = pl_hdr_rescale(PL_HDR_NITS, tone.input_scaling,
+                                        PL_COLOR_HDR_BLACK);
+    }
+
     pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
         .color      = &dst,
         .metadata   = PL_HDR_METADATA_HDR10,
