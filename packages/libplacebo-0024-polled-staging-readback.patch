             buf_p = PL_PRIV(buf);
+            buf_p->read_pending = buf_p->read_ready = buf_p->read_failed = false;
             uavs[i] = buf_p->raw_uav;
             break;
         case PL_DESC_STORAGE_IMG:
@@ -1015,6 +1016,7 @@ static void fill_uavs(pl_pass pass, const struct pl_pass_run_params *params,
         case PL_DESC_BUF_TEXEL_STORAGE:
             buf = params->desc_bindings[binding].object;
