From: mpv-ht <mpv-ht@localhost>
Date: Sat, 19 Sep 2026 12:00:00 -0400
Subject: [PATCH] Report the actual scalar video tone curve without changing mapping

Retain the actual uploaded base/shaped LUT samples and analytic fast path,
with live frame metadata. Collect only for the Analyzer tone-curve view.
Keep playback mapping, histogram eligibility and measured RGB unchanged.

---
diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index e8bbc73..72e485e 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -432,6 +432,9 @@ struct pl_color_map_params {
     // faster pure GLSL replacements (e.g. clip, linear, saturation).
     bool force_tone_mapping_lut;
 
+    // Retain CPU samples for the optional Analyzer; never changes mapping.
+    bool report_tone_curve;
+
     // Visualize the tone-mapping LUT and gamut mapping 3DLUT, in IPT space.
     bool visualize_lut;
 
@@ -480,6 +483,21 @@ PL_API extern const struct pl_color_map_params pl_color_map_high_quality_params;
 // Execution arguments for the `pl_shader_color_map_ex` call. Distinct from
 // `pl_color_map_params` because it is filled by internally-provided execution
 // metadata, instead of user-tunable aesthetic parameters.
+// Scalar mapping stage, before spatial detail recovery, ambient, overflow and
+// gamut mapping. Nits are P, maxRGB or equivalent IPT intensity according to
+// metric. Samples are taken from the actual uploaded LUT (PQ interpolation),
+// or from the exact analytic fast path. This is not a final RGB transfer curve.
+#define PL_TONE_CURVE_SAMPLES 256
+struct pl_tone_curve {
+    bool valid, identity, hstm_active;
+    enum pl_tone_map_metric metric;
+    const char *function;
+    float source_peak, target_peak, strength, overbrightening;
+    float input[PL_TONE_CURVE_SAMPLES];
+    float base[PL_TONE_CURVE_SAMPLES];
+    float output[PL_TONE_CURVE_SAMPLES];
+};
+
 struct pl_color_map_args {
     // Input/output color space for the mapping.
     struct pl_color_space src;
@@ -496,6 +514,9 @@ struct pl_color_map_args {
     // provided, tone/gamut mapping are disabled.
     pl_shader_obj *state;
 
+    // Optional output, used only for the main video conversion.
+    struct pl_tone_curve *tone_curve;
+
     // Low-resolution intensity feature map, as generated by
     // `pl_shader_extract_features`. Optional. No effect if
     // `params->contrast_recovery` is disabled.
diff --git a/src/include/libplacebo/renderer.h b/src/include/libplacebo/renderer.h
index 758da31..6047f88 100644
--- a/src/include/libplacebo/renderer.h
+++ b/src/include/libplacebo/renderer.h
@@ -778,6 +778,10 @@ PL_API void pl_renderer_flush_cache(pl_renderer rr);
 // Mirrors `pl_get_detected_hdr_metadata`, giving you the current internal peak
 // detection HDR metadata (when peak detection is active). Returns false if no
 // information is available (e.g. not HDR source, peak detection disabled).
+// Most recently rendered scalar video curve. False for conversion-LUT paths.
+// Enable color_map_params.report_tone_curve to collect it.
+PL_API bool pl_renderer_get_tone_curve(pl_renderer rr, struct pl_tone_curve *out);
+
 PL_API bool pl_renderer_get_hdr_metadata(pl_renderer rr,
                                          struct pl_hdr_metadata *metadata);
 
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 4f83d9c..22c8b8e 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -1238,6 +1238,9 @@ struct sh_color_map_obj {
         struct pl_tone_map_params params;
         pl_shader_obj lut;
         uint64_t hstm_signature;
+        bool curve_valid;
+        float curve_base[PL_TONE_CURVE_SAMPLES];
+        float curve_output[PL_TONE_CURVE_SAMPLES];
     } tone;
 
     // Gamut map state
@@ -2938,14 +2941,26 @@ struct hstm_lut_data {
     const struct pl_tone_map_params *tone;
     const float *hist;
     float strength, brightening;
+    struct sh_color_map_obj *record;
 };
 
+static void sample_tone_lut(float *dst, const float *src, int n)
+{
+    for (int i = 0; i < PL_TONE_CURVE_SAMPLES; i++) {
+        float pos = (float) i * (n - 1) / (PL_TONE_CURVE_SAMPLES - 1);
+        int lo = (int) pos, hi = PL_MIN(lo + 1, n - 1);
+        dst[i] = PL_MIX(src[lo], src[hi], pos - lo);
+    }
+}
+
 static void fill_tone_lut(void *data, const struct sh_lut_params *params)
 {
     const struct hstm_lut_data *ctx = params->priv;
     const struct pl_tone_map_params *lut_params = ctx->tone;
     pl_tone_map_generate(data, lut_params);
-    if (!ctx->hist) return;
+    if (ctx->record)
+        sample_tone_lut(ctx->record->tone.curve_base, data, params->width);
+    if (!ctx->hist) goto recorded;
     const int n = params->width;
     float *tmp = pl_alloc(NULL, 3 * n * sizeof(float));
     float *input = tmp, *base = tmp + n, *scratch = tmp + 2*n;
@@ -2961,6 +2976,54 @@ static void fill_tone_lut(void *data, const struct sh_lut_params *params)
     for (int i = 0; i < n; i++)
         out[i] = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, base[i]);
     pl_free(tmp);
+recorded:
+    if (ctx->record) {
+        sample_tone_lut(ctx->record->tone.curve_output, data, params->width);
+        ctx->record->tone.curve_valid = true;
+    }
+}
+
+static void record_tone_curve(struct pl_tone_curve *out,
+                             const struct pl_tone_map_params *tone,
+                             const struct sh_color_map_obj *obj,
+                             const struct pl_color_map_params *params,
+                             bool active, bool hstm, bool analytic)
+{
+    if (!out) return;
+    out->function = active ? tone->function->name : "identity";
+    out->identity = !active;
+    out->hstm_active = hstm;
+    out->strength = params->hstm_strength;
+    out->overbrightening = params->hstm_overbrightening;
+    out->source_peak = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, tone->input_max);
+    out->target_peak = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, tone->output_max);
+    for (int i = 0; i < PL_TONE_CURVE_SAMPLES; i++) {
+        float x = PL_MIX(tone->input_min, tone->input_max,
+                        (float) i / (PL_TONE_CURVE_SAMPLES - 1));
+        float base = x, mapped = x;
+        if (active && analytic) {
+            if (tone->function == &pl_tone_map_clip) {
+                base = PL_CLAMP(x, tone->input_min, tone->input_max);
+            } else {
+                float t = tone->constants.exposure *
+                    (x - tone->input_min) / (tone->input_max - tone->input_min);
+                base = PL_MIX(tone->output_min, tone->output_max, PL_CLAMP(t, 0, 1));
+            }
+            mapped = base;
+        } else if (active) {
+            if (!obj || !obj->tone.curve_valid) return;
+            base = obj->tone.curve_base[i];
+            mapped = obj->tone.curve_output[i];
+        }
+        out->input[i] = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, x);
+        out->base[i] = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, base);
+        out->output[i] = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, mapped);
+        if (hstm) {
+            out->output[i] = PL_MIN(out->output[i], out->input[i] *
+                (1.0f + hstm_clamp(params->hstm_overbrightening, 0, 1)));
+        }
+    }
+    out->valid = true;
 }
 
 static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
@@ -2992,6 +3055,8 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
     if (!sh_require(sh, PL_SHADER_SIG_COLOR, 0, 0))
         return;
 
+    struct pl_tone_curve *curve = args->tone_curve;
+    if (curve) *curve = (struct pl_tone_curve) {0};
     struct pl_color_space src = args->src, dst = args->dst;
     struct sh_color_map_obj *obj = NULL;
     if (args->state) {
@@ -3016,6 +3081,16 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
     if (pl_color_space_equal(&src, &dst) && !ambient_requested && !hstm_requested &&
         params->gamut_mapping != &pl_gamut_map_ipt_path &&
         !args->measure_rgb_ray && !args->rgb_ray_peak && !args->p_curve) {
+        if (curve) {
+            float peak;
+            pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
+                .color = &src, .metadata = PL_HDR_METADATA_HDR10,
+                .scaling = PL_HDR_PQ, .out_max = &peak));
+            struct pl_tone_map_params identity = {
+                .input_max = peak, .output_max = peak,
+            };
+            record_tone_curve(curve, &identity, obj, params, false, false, true);
+        }
 #ifdef PL_BLACK_LEVEL_DIAGNOSTICS
         blkdiag_identity(sh, obj, &src, &dst);
 #endif
@@ -3243,6 +3318,12 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
                     need_tone_map, need_gamut_map, can_fast);
 #endif
 
+    if (curve) {
+        curve->metric = metric_active ? params->tone_mapping_metric : PL_TONE_MAP_METRIC_STANDARD;
+        if (!need_tone_map)
+            record_tone_curve(curve, &tone, obj, params, false, false, true);
+    }
+
     // Fast path: simply convert between primaries (if needed)
     if (!need_tone_map && !need_gamut_map) {
         if (src.primaries != dst.primaries) {
@@ -3316,10 +3397,15 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         } else {
 
             pl_assert(obj);
+            bool update = !pl_tone_map_params_equal(&tone, &obj->tone.params) ||
+                          obj->tone.hstm_signature != hstm_signature ||
+                          (curve && !obj->tone.curve_valid);
+            if (update) obj->tone.curve_valid = false;
             struct hstm_lut_data lut_data = {
                 .tone = &tone, .hist = hstm_active ? obj->peak.hstm_hist : NULL,
                 .strength = params->hstm_strength,
                 .brightening = params->hstm_overbrightening,
+                .record = curve ? obj : NULL,
             };
             if (hstm_active) sh_describe(sh, "HSTM(P)");
             ident_t lut = sh_lut(sh, sh_lut_params(
@@ -3329,8 +3415,7 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
                 .method     = SH_LUT_LINEAR,
                 .width      = tone.lut_size,
                 .comps      = 1,
-                .update     = !pl_tone_map_params_equal(&tone, &obj->tone.params) ||
-                              obj->tone.hstm_signature != hstm_signature,
+                .update     = update,
                 .dynamic    = tone.input_avg > 0 || hstm_active,
                 .fill       = fill_tone_lut,
                 .priv       = &lut_data,
@@ -3349,6 +3434,9 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
 
         }
 
+        record_tone_curve(curve, &tone, obj, params, true, hstm_active,
+                          can_fast && (fun == &pl_tone_map_clip || fun == &pl_tone_map_linear));
+
         if (ambient_active) {
             ident_t ambient_map = sh_fresh(sh, "ambient_map");
             ident_t ambient_ipt_to_rgb = sh_fresh(sh, "ambient_ipt_to_rgb");
diff --git a/src/renderer.c b/src/renderer.c
index 635b09a..a81bb3a 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -37,6 +37,7 @@ struct cached_frame {
     pl_tex tex;
     int comps;
     bool evict; // for garbage collection
+    struct pl_tone_curve tone_curve;
 };
 
 struct sampler {
@@ -73,6 +74,7 @@ struct pl_renderer_t {
     // Shader resource objects and intermediate textures (FBOs)
     pl_shader_obj tone_map_state;
     struct pcurve_state p_curve_state;
+    struct pl_tone_curve tone_curve;
     // Forced HLG measurements must not become color-map metadata. Keeping
     // them separate preserves reference HLG rendering while exposing stats.
     pl_shader_obj hlg_measure_state;
@@ -226,6 +228,7 @@ void pl_renderer_load(pl_renderer rr, const uint8_t *cache)
 
 void pl_renderer_flush_cache(pl_renderer rr)
 {
+    rr->tone_curve.valid = false;
     rr->p_curve_state.valid = false;
     for (int i = 0; i < rr->frames.num; i++)
         pl_tex_destroy(rr->gpu, &rr->frames.elem[i].tex);
@@ -1478,6 +1481,12 @@ cleanup:
     pl_reset_detected_peak(rr->hlg_measure_state);
 }
 
+bool pl_renderer_get_tone_curve(pl_renderer rr, struct pl_tone_curve *out)
+{
+    *out = rr->tone_curve;
+    return out->valid;
+}
+
 bool pl_renderer_get_hdr_metadata(pl_renderer rr,
                                   struct pl_hdr_metadata *metadata)
 {
@@ -3061,6 +3070,7 @@ static void pass_convert_colors(struct pass_state *pass)
     struct img *img = &pass->img;
     pl_shader sh = img_sh(pass, img);
 
+    rr->tone_curve.valid = false;
     bool prelinearized = false;
     bool need_conversion = true;
     assert(image->color.primaries == img->color.primaries);
@@ -3162,6 +3172,8 @@ static void pass_convert_colors(struct pass_state *pass)
             .dst           = target_csp,
             .prelinearized = prelinearized,
             .state         = &rr->tone_map_state,
+            .tone_curve    = params->color_map_params && params->color_map_params->report_tone_curve
+                                ? &rr->tone_curve : NULL,
             .feature_map   = feature_map,
             .rgb_ray_peak  = params->color_map_params && params->color_map_params->p_constrained_curve ? NULL : ray_peak,
             .p_curve       = params->color_map_params && params->color_map_params->p_constrained_curve ? ray_peak : NULL,
@@ -4397,8 +4409,10 @@ bool pl_render_image(pl_renderer rr, const struct pl_frame *pimage,
 {
     params = PL_DEF(params, &pl_render_default_params);
     pl_dispatch_mark_dynamic(rr->dp, params->dynamic_constants);
-    if (!pimage)
+    if (!pimage) {
+        rr->tone_curve.valid = false;
         return draw_empty_overlays(rr, ptarget, params);
+    }
 
     struct pass_state pass = {
         .rr = rr,
@@ -4843,6 +4857,7 @@ retry:
             f->repr = inter_pass.img.repr;
             f->comps = inter_pass.img.comps;
             f->profile = target->profile;
+            f->tone_curve = rr->tone_curve;
             // fall through
 
 inter_pass_error:
@@ -4897,6 +4912,9 @@ inter_pass_error:
     // With a single frame there is nothing to mix, so we can skip the
     // linearize/delinearize roundtrip.
     bool mixing = fidx > 1;
+    // A cached single frame keeps its own mapping snapshot. A mixture of
+    // independently mapped frames has no single scalar curve to report.
+    rr->tone_curve = mixing ? (struct pl_tone_curve) {0} : frames[0].tone_curve;
     struct pl_color_space mix_csp = target->color;
     if (mixing) {
         mix_csp.transfer = PL_COLOR_TRC_LINEAR;
