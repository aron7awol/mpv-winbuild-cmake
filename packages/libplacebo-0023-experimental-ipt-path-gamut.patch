From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mpv-ht <mpv-ht@local>
Date: Sat, 12 Sep 2026 12:00:00 -0400
Subject: [PATCH] gamut: add experimental original-IPT path with Perceptual P

Experimental opt-in only; existing gamut-mapping defaults are unchanged.
The direct GPU path avoids hard-boundary interpolation errors in a 3D LUT.
See analysis/ipt-path-gamut in the mpv-ht packaging repository for tests.

---
diff --git a/src/gamut_mapping.c b/src/gamut_mapping.c
index 516cce0f..9efbcc6a 100644
--- a/src/gamut_mapping.c
+++ b/src/gamut_mapping.c
@@ -22,6 +22,7 @@
 #include "pl_thread.h"
 
 #include <libplacebo/gamut_mapping.h>
+#include "gamut_mapping_pipt.h"
 
 #define fclampf(x, lo, hi) fminf(fmaxf(x, lo), hi)
 static void fix_constants(struct pl_gamut_map_constants *c)
@@ -67,6 +68,11 @@ bool pl_gamut_map_params_noop(const struct pl_gamut_map_params *params)
     if (!pl_primaries_compatible(&dst, &src))
         return true;
 
+    // Explicit experimental mapping also handles upper-channel overflow when
+    // the signal gamuts match. In-gamut pixels remain identity.
+    if (params->function == &pl_gamut_map_ipt_path)
+        return false;
+
     bool need_map = !pl_primaries_superset(&dst, &src);
     need_map |= !pl_cie_xy_equal(&src.white, &dst.white);
     if (FUN(params).bidirectional)
@@ -738,6 +744,36 @@ static void perceptual(float *lut, const struct pl_gamut_map_params *params)
     }
 }
 
+static void ipt_path(float *lut, const struct pl_gamut_map_params *params)
+{
+    struct cache cache;
+    struct gamut working;
+    struct pl_gamut_map_params work = *params;
+    const struct pl_raw_primaries *bt2020 = pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    work.output_gamut = *bt2020;
+    get_gamuts(&working, NULL, &cache, &work);
+    pl_matrix3x3 m = pl_get_color_mapping_matrix(bt2020, &params->output_gamut,
+                                                PL_INTENT_RELATIVE_COLORIMETRIC);
+    hp_mat target;
+    for (int i=0;i<3;i++) for (int j=0;j<3;j++) target.m[i][j]=m.m[i][j];
+    hp_ctx ctx=hp_context(target, pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, params->max_luma)/10000.0);
+    FOREACH_LUT(lut, ipt) {
+        struct RGB raw=ipt2rgb(ipt, working);
+        // Keep the original IPT direction at off-source-gamut LUT nodes.
+        // Clipping those nodes first biases interpolation near saturated
+        // source boundaries. hp_p defines the nonnegative metric extension.
+        hp_vec rgb={{raw.R,raw.G,raw.B}};
+        hp_vec mapped=hp_map(ctx,rgb);
+        ipt=rgb2ipt((struct RGB){mapped.v[0],mapped.v[1],mapped.v[2]},working);
+    }
+}
+
+const struct pl_gamut_map_function pl_gamut_map_ipt_path = {
+    .name = "ipt-path",
+    .description = "Original-IPT path, Perceptual P (experimental)",
+    .map = ipt_path,
+};
+
 const struct pl_gamut_map_function pl_gamut_map_perceptual = {
     .name = "perceptual",
     .description = "Perceptual mapping",
@@ -979,6 +1015,7 @@ const struct pl_gamut_map_function pl_gamut_map_clip = {
 const struct pl_gamut_map_function * const pl_gamut_map_functions[] = {
     &pl_gamut_map_clip,
     &pl_gamut_map_perceptual,
+    &pl_gamut_map_ipt_path,
     &pl_gamut_map_softclip,
     &pl_gamut_map_relative,
     &pl_gamut_map_saturation,
