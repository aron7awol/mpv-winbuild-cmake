From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mpv-ht development <development@mpv-ht.local>
Date: Mon, 31 Aug 2026 14:00:00 -0400
Subject: [PATCH] gpu-next: harden active image transitions

Keep matte refinement out of established picture content, prevent temporal
mixing across aperture changes, and expose asynchronous GPU timing samples.
---
diff --git a/player/command.c b/player/command.c
index 2695babbde34467d85f8096e4352bb192b4fd86f..74eca01cc293ae209607a14d5b61935b88b5aae4 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2778,6 +2778,9 @@ static int mp_property_video_active_image(void *ctx, struct m_property *prop,
         {"bottom",              SUB_PROP_INT(image.bottom)},
         {"frame-id",            SUB_PROP_INT64(image.frame_id)},
         {"automatic-effective", SUB_PROP_BOOL(image.automatic_effective)},
+        {"gpu-ms-median",       SUB_PROP_DOUBLE(image.gpu_ns_median / 1e6)},
+        {"gpu-ms-p99",          SUB_PROP_DOUBLE(image.gpu_ns_p99 / 1e6)},
+        {"timing-samples",      SUB_PROP_INT(image.timing_samples)},
         {"summary",             SUB_PROP_STR(summary)},
         {0}
     };
diff --git a/video/out/vo.h b/video/out/vo.h
index a822c2326473ed46d26683dfc5035f9c4d9f6af7..5c22cf0c08db5c9e592eec49105a53ea2801ac48 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -156,6 +156,8 @@ struct voctrl_active_image {
     int active_w, active_h;
     int top, bottom;
     uint64_t frame_id;
+    uint64_t gpu_ns_median, gpu_ns_p99;
+    int timing_samples;
 };
 
 // Helper to expose what kind of content is currently playing to the VO.
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 1bb931a8d3f71b718b2d127156782cb93e317daf..bc050410f7e6349ba1cb02c3d4999d72b88a1dcb 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -102,6 +102,7 @@ struct frame_info {
 #define BAR_ANALYSIS_MAX_ROWS 4320
 #define BAR_ANALYSIS_SLOTS 8
 #define BAR_RESULT_CACHE 16
+#define BAR_TIMING_SAMPLES 256
 
 struct bar_gpu_data {
     // min, max, sum, sample count in normalized unsigned 16-bit luma.
@@ -156,10 +157,13 @@ struct priv {
     pl_renderer rr;
     pl_queue queue;
     pl_dispatch bar_dispatch;
+    pl_timer bar_timer;
     struct bar_analysis_slot bar_slots[BAR_ANALYSIS_SLOTS];
     struct bar_result bar_results[BAR_RESULT_CACHE];
     int bar_result_next;
     struct bar_gpu_data bar_readback;
+    uint64_t bar_timings[BAR_TIMING_SAMPLES];
+    int bar_timing_count, bar_timing_next;
     pl_swapchain sw;
     pl_fmt osd_fmt[SUBBITMAP_COUNT];
     pl_tex *sub_tex;
@@ -1137,6 +1141,12 @@ static void store_bar_result(struct priv *p, uint64_t tag, int width, int height
                     continue;
                 uint32_t pair0 = ((uint64_t) tm0 + bm0) / 2;
                 uint32_t pair1 = ((uint64_t) tm1 + bm1) / 2;
+                // Refinement may traverse codec-contaminated matte rows, but
+                // never search onward through established picture content.
+                // In particular, this prevents a centered horizon or title
+                // edge from replacing an already exact matte boundary.
+                if (pair0 > black + 4096)
+                    break;
                 uint32_t rise = pair1 > pair0 ? pair1 - pair0 : 0;
                 if (rise > best_rise) {
                     best_rise = rise;
@@ -1162,6 +1172,12 @@ static void store_bar_result(struct priv *p, uint64_t tag, int width, int height
 
 static void consume_bar_analysis(struct priv *p)
 {
+    for (uint64_t ns; (ns = pl_timer_query(p->gpu, p->bar_timer));) {
+        p->bar_timings[p->bar_timing_next] = ns;
+        p->bar_timing_next = (p->bar_timing_next + 1) % BAR_TIMING_SAMPLES;
+        p->bar_timing_count = MPMIN(p->bar_timing_count + 1,
+                                    BAR_TIMING_SAMPLES);
+    }
     for (int i = 0; i < BAR_ANALYSIS_SLOTS; i++) {
         struct bar_analysis_slot *slot = &p->bar_slots[i];
         if (!slot->pending || pl_buf_poll(p->gpu, slot->buf, 0))
@@ -1362,6 +1378,7 @@ static bool submit_bar_analysis(struct priv *p, struct pl_frame *frame,
     }) && pl_dispatch_compute(p->bar_dispatch, pl_dispatch_compute_params(
         .shader = &sh,
         .dispatch_size = {1, height, 1},
+        .timer = p->bar_timer,
     ));
     talloc_free(body);
     if (!ok) {
@@ -2152,6 +2169,9 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     }
 
     struct pl_frame_mix mix = {0};
+    const struct pl_frame *bar_single_frame = NULL;
+    uint64_t bar_single_signature = 0;
+    float bar_single_timestamp = 0;
     if (frame->current) {
         // Update queue state
         struct pl_queue_params qparams = *pl_queue_params(
@@ -2271,6 +2291,33 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
             ((uint64_t *) mix.signatures)[i] ^= fp->osd_sync << 48;
         }
 
+        // Never temporally blend two different authored apertures. Around an
+        // AR transition, render the current frame alone; this keeps optional
+        // interpolation from softening or delaying an otherwise exact cut.
+        const struct pl_frame *current = pl_frame_mix_current(&mix);
+        if (p->automatic_aspect_effective && current && mix.num_frames > 1) {
+            bool mixed_apertures = false;
+            int current_index = -1;
+            for (int i = 0; i < mix.num_frames; i++) {
+                const struct pl_frame *image = mix.frames[i];
+                if (image == current)
+                    current_index = i;
+                if (image->crop.x0 != current->crop.x0 ||
+                    image->crop.y0 != current->crop.y0 ||
+                    image->crop.x1 != current->crop.x1 ||
+                    image->crop.y1 != current->crop.y1)
+                    mixed_apertures = true;
+            }
+            if (mixed_apertures && current_index >= 0) {
+                bar_single_frame = current;
+                bar_single_signature = mix.signatures[current_index];
+                mix.num_frames = 1;
+                mix.frames = &bar_single_frame;
+                mix.signatures = &bar_single_signature;
+                mix.timestamps = &bar_single_timestamp;
+            }
+        }
+
         // Update dynamic hook parameters
         for (int i = 0; i < pars->params.num_hooks; i++)
             update_hook_opts_dynamic(vo, p, p->hooks[i], frame->current);
@@ -2916,6 +2963,23 @@ static int control(struct vo *vo, uint32_t request, void *data)
             .available = p->active_image_available,
             .automatic_effective = p->automatic_aspect_effective,
         };
+        if (p->bar_timing_count) {
+            uint64_t sorted[BAR_TIMING_SAMPLES];
+            memcpy(sorted, p->bar_timings,
+                   p->bar_timing_count * sizeof(sorted[0]));
+            for (int i = 1; i < p->bar_timing_count; i++) {
+                uint64_t value = sorted[i];
+                int j = i;
+                while (j > 0 && sorted[j - 1] > value) {
+                    sorted[j] = sorted[j - 1];
+                    j--;
+                }
+                sorted[j] = value;
+            }
+            out->gpu_ns_median = sorted[(p->bar_timing_count - 1) / 2];
+            out->gpu_ns_p99 = sorted[((p->bar_timing_count - 1) * 99) / 100];
+            out->timing_samples = p->bar_timing_count;
+        }
         if (p->active_image_available) {
             out->source_w = p->active_image.source_w;
             out->source_h = p->active_image.source_h;
@@ -3175,6 +3239,7 @@ static void uninit(struct vo *vo)
     pl_queue_destroy(&p->queue); // destroy this first
     for (int i = 0; i < BAR_ANALYSIS_SLOTS; i++)
         pl_buf_destroy(p->gpu, &p->bar_slots[i].buf);
+    pl_timer_destroy(p->gpu, &p->bar_timer);
     pl_dispatch_destroy(&p->bar_dispatch);
     for (int i = 0; i < MP_ARRAY_SIZE(p->osd_state.entries); i++)
         pl_tex_destroy(p->gpu, &p->osd_state.entries[i].tex);
@@ -3272,6 +3337,7 @@ static int preinit(struct vo *vo)
     p->rr = pl_renderer_create(p->pllog, p->gpu);
     p->queue = pl_queue_create(p->gpu);
     p->bar_dispatch = pl_dispatch_create(p->pllog, p->gpu);
+    p->bar_timer = pl_timer_create(p->gpu);
     if (!p->rr || !p->queue || !p->bar_dispatch)
         goto err_out;
     p->osd_fmt[SUBBITMAP_LIBASS] = pl_find_named_fmt(p->gpu, "r8");
-- 
2.51.0.windows.1
