From c1baeef900d7e5313631a43eee82f1e906b44a40 Mon Sep 17 00:00:00 2001
From: Aaron <aaronmedeiros@gmail.com>
Date: Wed, 29 Jul 2026 16:57:59 -0400
Subject: [PATCH] video: expose raw peak detection metrics

---
 DOCS/man/input.rst      | 22 ++++++++++++++++++++++
 DOCS/man/options.rst    |  4 +++-
 player/command.c        |  9 +++++++++
 video/mp_image.h        | 12 ++++++++++++
 video/out/vo_gpu_next.c | 13 +++++++++++++
 5 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/DOCS/man/input.rst b/DOCS/man/input.rst
index 397be36..ed5ada5 100644
--- a/DOCS/man/input.rst
+++ b/DOCS/man/input.rst
@@ -2914,6 +2914,24 @@ Property list
     ``video-params/avg-pq-y``
         Average PQ luminance of a frame, as reported by peak detection (in PQ, 0-1)
 
+    ``video-params/raw-max-pq-y``
+        Unsmoothed CIE Y peak of the current measured frame (in PQ, 0-1).
+        This uses the configured ``--hdr-peak-percentile`` and peak-detection
+        black cutoff, but is reported before temporal smoothing.
+
+    ``video-params/raw-avg-pq-y``
+        Unsmoothed average CIE Y of the current measured frame (in PQ, 0-1).
+
+    ``video-params/raw-max-rgb-nits``
+        Unsmoothed peak of per-pixel max(R,G,B) for the current measured frame
+        (in cd/mÂ²). This uses the configured ``--hdr-peak-percentile``. It is
+        not static MaxCLL metadata.
+
+    ``video-params/raw-avg-rgb-nits``
+        Unsmoothed frame average of per-pixel max(R,G,B) (in cd/mÂ²), including
+        black pixels. It is independent of ``--hdr-peak-percentile`` and is
+        not static MaxFALL metadata.
+
     ``video-params/dolby-vision-el-type``
         Dolby Vision enhancement layer type of the current frame, as signalled
         by the RPU. Either ``fel`` (full enhancement layer: carries residual
@@ -2972,6 +2990,10 @@ Property list
             "scene-max-b"       MPV_FORMAT_DOUBLE
             "max-pq-y"          MPV_FORMAT_DOUBLE
             "avg-pq-y"          MPV_FORMAT_DOUBLE
+            "raw-max-pq-y"      MPV_FORMAT_DOUBLE
+            "raw-avg-pq-y"      MPV_FORMAT_DOUBLE
+            "raw-max-rgb-nits"  MPV_FORMAT_DOUBLE
+            "raw-avg-rgb-nits"  MPV_FORMAT_DOUBLE
             "dolby-vision-el-type" MPV_FORMAT_STRING
             "prim-red-x"        MPV_FORMAT_DOUBLE
             "prim-red-y"        MPV_FORMAT_DOUBLE
diff --git a/DOCS/man/options.rst b/DOCS/man/options.rst
index 09b9075..3fed8f0 100644
--- a/DOCS/man/options.rst
+++ b/DOCS/man/options.rst
@@ -7801,7 +7801,9 @@ them.
     Requires compute shaders, which is a fairly recent OpenGL feature, and will
     probably also perform horribly on some drivers, so enable at your own risk.
     The special value ``auto`` (default) will enable HDR peak computation
-    automatically if compute shaders and SSBOs are supported.
+    automatically if compute shaders and SSBOs are supported, but retains
+    source-provided dynamic CIE Y metadata when present. ``yes`` forces
+    measurement even when such metadata is present.
 
 ``--allow-delayed-peak-detect``
     When using ``--hdr-compute-peak``, allow delaying the detected peak by a
diff --git a/player/command.c b/player/command.c
index 98173f4..697fad5 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2510,6 +2510,7 @@ static int property_imgparams(const struct mp_image_params *p, int action, void
     }
 
     const struct pl_hdr_metadata *hdr = &p->color.hdr;
+    const struct mp_peak_detect_metrics *peak = &p->peak_detect;
     bool has_cie_y     = pl_hdr_metadata_contains(hdr, PL_HDR_METADATA_CIE_Y);
     bool has_hdr10     = pl_hdr_metadata_contains(hdr, PL_HDR_METADATA_HDR10);
     bool has_hdr10plus = pl_hdr_metadata_contains(hdr, PL_HDR_METADATA_HDR10PLUS);
@@ -2570,6 +2571,14 @@ static int property_imgparams(const struct mp_image_params *p, int action, void
         {"scene-avg",   SUB_PROP_FLOAT(hdr->scene_avg),    .unavailable = !has_hdr10plus},
         {"max-pq-y",    SUB_PROP_FLOAT(hdr->max_pq_y),     .unavailable = !has_cie_y},
         {"avg-pq-y",    SUB_PROP_FLOAT(hdr->avg_pq_y),     .unavailable = !has_cie_y},
+        {"raw-max-pq-y", SUB_PROP_FLOAT(peak->raw_max_pq_y),
+                            .unavailable = !peak->valid},
+        {"raw-avg-pq-y", SUB_PROP_FLOAT(peak->raw_avg_pq_y),
+                            .unavailable = !peak->valid},
+        {"raw-max-rgb-nits", SUB_PROP_FLOAT(peak->raw_max_rgb),
+                            .unavailable = !peak->valid},
+        {"raw-avg-rgb-nits", SUB_PROP_FLOAT(peak->raw_avg_rgb),
+                            .unavailable = !peak->valid},
         {"dolby-vision-el-type",
             SUB_PROP_STR(p->dovi_el_type == MP_DOVI_EL_FEL ? "fel" : "mel"),
             .unavailable = p->dovi_el_type == MP_DOVI_EL_NONE},
diff --git a/video/mp_image.h b/video/mp_image.h
index daf843e..550cc19 100644
--- a/video/mp_image.h
+++ b/video/mp_image.h
@@ -50,6 +50,17 @@ enum mp_dovi_el_type {
     MP_DOVI_EL_FEL,             // EL present, carries residual picture data
 };
 
+// Per-frame peak-detection measurements produced by the video output. These
+// are dynamic renderer results rather than source metadata, and therefore must
+// not participate in image-parameter equality or trigger a VO reconfigure.
+struct mp_peak_detect_metrics {
+    bool valid;
+    float raw_max_pq_y;         // percentile CIE Y peak, PQ 0-1
+    float raw_avg_pq_y;         // average CIE Y, PQ 0-1
+    float raw_max_rgb;          // percentile maxRGB peak, cd/m^2
+    float raw_avg_rgb;          // average maxRGB, cd/m^2
+};
+
 // Describes image parameters that usually stay constant.
 // New fields can be added in the future. Code changing the parameters should
 // usually copy the whole struct, so that fields added later will be preserved.
@@ -79,6 +90,7 @@ struct mp_image_params {
     // like color.hdr, so it is deliberately NOT part of
     // mp_image_params_equal() -- it must not trigger a VO reconfigure.
     enum mp_dovi_el_type dovi_el_type;
+    struct mp_peak_detect_metrics peak_detect;
     // Flags for f_enhancement_pair.c to not inherit flags from EL.
     bool no_dovi;
     bool no_enhancement_layer;
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index bf4f80b..114518f 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1643,6 +1643,18 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     if (vo->params) {
         // Augment metadata with peak detection max_pq_y / avg_pq_y
         vo->has_peak_detect_values = pl_renderer_get_hdr_metadata(p->rr, &vo->params->color.hdr);
+        struct pl_peak_detect_metrics metrics;
+        if (pl_renderer_get_peak_detect_metrics(p->rr, &metrics)) {
+            vo->params->peak_detect = (struct mp_peak_detect_metrics) {
+                .valid        = true,
+                .raw_max_pq_y = metrics.raw_max_pq_y,
+                .raw_avg_pq_y = metrics.raw_avg_pq_y,
+                .raw_max_rgb  = metrics.raw_max_rgb,
+                .raw_avg_rgb  = metrics.raw_avg_rgb,
+            };
+        } else {
+            vo->params->peak_detect = (struct mp_peak_detect_metrics) {0};
+        }
     }
     mp_mutex_unlock(&vo->params_mutex);
 
@@ -2776,6 +2788,7 @@ static void update_render_options(struct vo *vo)
     pars->peak_detect_params.scene_threshold_high = opts->tone_map.scene_threshold_high;
     pars->peak_detect_params.percentile = opts->tone_map.peak_percentile;
     pars->peak_detect_params.allow_delayed = p->next_opts->delayed_peak;
+    pars->peak_detect_params.force = opts->tone_map.compute_peak > 0;
 
     const struct pl_tone_map_function * const tone_map_funs[] = {
         [TONE_MAPPING_AUTO]     = &pl_tone_map_auto,
-- 
