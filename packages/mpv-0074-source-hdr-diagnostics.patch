@@ -908,6 +909,7 @@ void mp_image_params_update_dynamic(struct mp_image_params *dst,
     dst->dovi_el_type = src->dovi_el_type;
     dst->authored_scene_cut = src->authored_scene_cut;
     dst->hdr10plus_signature = src->hdr10plus_signature;
+    dst->source_hdr = src->source_hdr;
     // Don't overwrite peak-detected HDR metadata if available.
     float max_pq_y = dst->color.hdr.max_pq_y;
     float avg_pq_y = dst->color.hdr.avg_pq_y;
@@ -1192,6 +1194,31 @@ struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
         .dhp = (void *)(dhp ? dhp->data : NULL),
     });
 
+    // Keep the original side-data records, not the merged rendering metadata.
+    // In particular, DV source_min/max_pq are NOT Level 6 mastering metadata.
+    struct mp_source_hdr_metadata *sh = &dst->params.source_hdr;
+    sh->valid = true;
+    if (mdm) {
+        const AVMasteringDisplayMetadata *m = (const void *)mdm->data;
+        if (m->has_luminance) {
+            sh->bl_mdl = true;
+            sh->bl_min = av_q2d(m->min_luminance);
+            sh->bl_max = av_q2d(m->max_luminance);
+        }
+    }
+    if (clm) {
+        const AVContentLightMetadata *m = (const void *)clm->data;
+        sh->bl_cll = true;
+        sh->bl_max_cll = m->MaxCLL;
+        sh->bl_max_fall = m->MaxFALL;
+    }
+    if (dhp) {
+        sh->hdr10plus = true;
+        for (int i = 0; i < 3; i++)
+            sh->max_scl[i] = dst->params.color.hdr.scene_max[i];
+        sh->avg_maxrgb = dst->params.color.hdr.scene_avg;
+    }
+
     sd = av_frame_get_side_data(src, AV_FRAME_DATA_A53_CC);
     if (sd)
         dst->a53_cc = sd->buf;
@@ -1204,6 +1231,22 @@ struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
     if (sd) {
 #ifdef PL_HAVE_LAV_DOLBY_VISION
         const AVDOVIMetadata *metadata = (const AVDOVIMetadata *)sd->buf->data;
+        sh->dovi = true;
+        for (int i = 0; i < metadata->num_ext_blocks; i++) {
+            const AVDOVIDmData *ext = av_dovi_get_ext(metadata, i);
+            if (ext->level == 1) {
+                sh->dv.l1 = true;
+                sh->dv.min_pq = ext->l1.min_pq;
+                sh->dv.max_pq = ext->l1.max_pq;
+                sh->dv.avg_pq = ext->l1.avg_pq;
+            } else if (ext->level == 6) {
+                sh->dv.l6 = true;
+                sh->dv.min_mdl = ext->l6.min_luminance;
+                sh->dv.max_mdl = ext->l6.max_luminance;
+                sh->dv.max_cll = ext->l6.max_cll;
+                sh->dv.max_fall = ext->l6.max_fall;
+            }
+        }
         // MEL can carry LINEAR_DZ NLQ with trivial coefficients: zero
         // offsets, slopes and thresholds, and normalized vdr_in_max = 1
         // in all three components. NLQ presence alone does not imply FEL.
@@ -1251,6 +1294,9 @@ struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
 
     sd = av_frame_get_side_data(src, AV_FRAME_DATA_DOVI_RPU_BUFFER);
     if (sd) {
+        // A raw-only decoder cannot expose parsed L6/L1 here. Report presence
+        // without inventing values or borrowing the merged HDR record.
+        sh->dovi = true;
         pl_hdr_metadata_from_dovi_rpu(&dst->params.color.hdr, sd->buf->data,
                                       sd->buf->size);
     }
@@ -1259,6 +1305,14 @@ struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
     if (sd)
         dst->film_grain = sd->buf;
 
+    // mp_image_to_av_frame may have serialized already mapped/overridden
+    // metadata. Across an mpv-owned AVFrame round trip retain the originals.
+    if (src->opaque_ref) {
+        const struct mp_image_params *p = (const void *)src->opaque_ref->data;
+        if (p->source_hdr.valid)
+            *sh = p->source_hdr;
+    }
+
     for (int n = 0; n < src->nb_side_data; n++) {
         sd = src->side_data[n];
         struct mp_ff_side_data mpsd = {
diff --git a/video/mp_image.h b/video/mp_image.h
index 583e32a49..6a81593b9 100644
--- a/video/mp_image.h
+++ b/video/mp_image.h
@@ -56,11 +56,26 @@ enum mp_authored_scene_cut {
     MP_SCENE_CUT_HDR10PLUS = 1 << 1,
 };
 
+// Original authored metadata, captured before libplacebo combines authorities.
+// Diagnostics only: never used for rendering or parameter equality/reconfigure.
+struct mp_source_hdr_metadata {
+    bool valid, bl_mdl, bl_cll, hdr10plus, dovi;
+    double bl_min, bl_max;
+    unsigned bl_max_cll, bl_max_fall;
+    float max_scl[3], avg_maxrgb;
+    struct {
+        bool l1, l6;
+        unsigned min_pq, max_pq, avg_pq;
+        unsigned min_mdl, max_mdl, max_cll, max_fall;
+    } dv;
+};
+
 // Per-frame peak-detection measurements produced by the video output. These
 // are dynamic renderer results rather than source metadata, and therefore must
 // not participate in image-parameter equality or trigger a VO reconfigure.
 struct mp_peak_detect_metrics {
     bool valid;
+    int measured_metric;       // actual detector, not the configured request
     bool tone_metric_valid;
     bool scene_reset;
     unsigned scene_reset_source;
@@ -134,6 +149,7 @@ struct mp_image_params {
     unsigned authored_scene_cut;
     // Exact fingerprint of parsed AV_FRAME_DATA_DYNAMIC_HDR_PLUS side data.
     uint64_t hdr10plus_signature;
+    struct mp_source_hdr_metadata source_hdr;
     struct mp_peak_detect_metrics peak_detect;
     // Flags for f_enhancement_pair.c to not inherit flags from EL.
     bool no_dovi;
