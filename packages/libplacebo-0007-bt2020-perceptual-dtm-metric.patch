     @if (use_histogram) {                                                       \
@@ -1733,6 +1878,12 @@ retry_ssbo:
         int bin_rgb = int(rgb_pq) >> ${const int: PQ_BITS - HIST_BITS};         \
         bin_rgb -= ${const int: HIST_BIAS};                                     \
         bin_rgb = clamp(bin_rgb, 0, ${const int: HIST_BINS - 1});               \
