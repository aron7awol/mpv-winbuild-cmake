+static void resize_reason(struct vo_w32_state *w32, unsigned reason)
+{
+    if (w32->resize_diagnostics)
+        w32->resize_info.reasons |= reason;
+}
+
+static void resize_message(struct vo_w32_state *w32, unsigned reason,
+                           const char *name, WPARAM wp, LPARAM lp)
+{
+    if (!w32->resize_diagnostics)
+        return;
+    struct w32_resize_info *r = &w32->resize_info;
+    r->reasons |= reason;
+    r->messages++;
+    r->last_serial = ++w32->resize_serial;
+    if (!r->first_serial)
+        r->first_serial = r->last_serial;
+    if (reason == W32_R_SETTING) {
+        r->setting_action = (unsigned)wp;
+        memset(r->setting_area, 0, sizeof(r->setting_area));
+        if (lp) {
+            // Do not dereference an arbitrary notification pointer or retain it
+            // after dispatch. Read bounded code units from our own address space.
+            for (size_t i = 0; i < sizeof(r->setting_area) - 1; i++) {
+                WCHAR c = 0;
+                SIZE_T got = 0;
+                uintptr_t addr = (uintptr_t)lp + i * sizeof(c);
+                if (!ReadProcessMemory(GetCurrentProcess(), (void *)addr,
+                                       &c, sizeof(c), &got) || got != sizeof(c)) {
+                    r->reasons |= W32_R_OTHER;
+                    break;
+                }
+                if (!c) break;
+                r->setting_area[i] = c >= 32 && c <= 126 && c != '"' &&
+                                    c != '\\' ? (char)c : '?';
+            }
+        }
+    }
+    MP_VERBOSE(w32, "resize-origin serial=%"PRIu64" message=%s wparam=0x%"PRIxPTR
+               " area=\"%s\" (sender unknown)\n", r->last_serial, name,
+               (uintptr_t)wp, reason == W32_R_SETTING ? r->setting_area : "");
+}
