diff --git a/video/out/analyzer_xy_tiled_prototype.h b/video/out/analyzer_xy_tiled_prototype.h
new file mode 100644
index 000000000..8e9901c03
--- /dev/null
+++ b/video/out/analyzer_xy_tiled_prototype.h
@@ -0,0 +1,42 @@
+static bool analyzer_xy_tiled_reduce(struct priv *p,const struct pl_hook_params *hp,
+                                    pl_tex source,struct pl_shader_var *vars,
+                                    struct pl_shader_desc *desc,const char *bin_math,
+                                    int bins)
+{
+    // 32x32 source tiles; 64 invocations with 16 pixels each. A bounded shared
+    // hash combines coherent colors before global atomics. Full/colliding hash
+    // entries fall back to the SAME global reduction, never dropping a sample.
+    char *header=talloc_asprintf(NULL,"%s\n%s\nshared uint tags[256];shared uint values[256];",
+                                 frame_math,bin_math);
+    bool ok=true;
+    for(int pass=0;pass<2 && ok;pass++){
+        char *body=talloc_asprintf(NULL,
+            "int lane=int(gl_LocalInvocationID.x);ivec2 sz=textureSize(xy_source,0),origin=ivec2(gl_WorkGroupID.xy)*32;"
+            "for(int i=lane;i<256;i+=64){tags[i]=0xffffffffu;values[i]=%s;}barrier();"
+            "for(int i=lane;i<1024;i+=64){ivec2 pos=origin+ivec2(i%%32,i/32);if(any(greaterThanEqual(pos,sz)))continue;"
+            "vec3 c=to2020*texelFetch(xy_source,pos,0).rgb;int b=xy_bin(c);if(b<0)continue;"
+            "float value=max(perceptual_bt2020(c),0.);if(isnan(value)||isinf(value))continue;uint key=floatBitsToUint(value);%s"
+            "uint h=(uint(b)*2654435761u)&255u;int found=-1;"
+            "for(uint k=0u;k<8u;k++){uint at=(h+k)&255u;uint prev=atomicCompSwap(tags[at],0xffffffffu,uint(b));if(prev==0xffffffffu||prev==uint(b)){found=int(at);break;}}"
+            "%s}barrier();"
+            "for(int i=lane;i<256;i+=64){uint b=tags[i];if(b!=0xffffffffu){%s}}",
+            pass?"0xffffffffu":"0u",
+            pass?"if(key!=keys[b])continue;uint id=uint(pos.y*sz.x+pos.x);":"",
+            pass?"if(found>=0)atomicMin(values[found],id);else atomicMin(keys[XY_TILE_BINS+b],id);":
+                 "if(found>=0)atomicMax(values[found],key);else atomicMax(keys[b],key);",
+            pass?"if(values[i]!=0xffffffffu)atomicMin(keys[XY_TILE_BINS+b],values[i]);":
+                 "if(values[i]>0u)atomicMax(keys[b],values[i]);");
+        char *with_bins=talloc_asprintf(NULL,"#define XY_TILE_BINS %d\n%s",bins,header);
+        pl_shader sh=pl_dispatch_begin(hp->dispatch);
+        ok=pl_shader_custom(sh,&(struct pl_custom_shader){
+            .description=pass?"Analyzer tiled xy winning pixel":"Analyzer tiled xy peak P",
+            .header=with_bins,.body=body,.input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_NONE,
+            .variables=vars,.num_variables=3,.descriptors=desc,.num_descriptors=2,
+            .compute=true,.compute_group_size={64,1}}) &&
+            pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,
+                .dispatch_size={(source->params.w+31)/32,(source->params.h+31)/32,1}));
+        if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+        talloc_free(body);talloc_free(with_bins);
+    }
+    talloc_free(header);return ok;
+}
