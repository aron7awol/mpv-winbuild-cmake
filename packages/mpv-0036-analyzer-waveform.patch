diff --git a/video/out/analyzer_waveform_bridge.h b/video/out/analyzer_waveform_bridge.h
new file mode 100644
index 000000000..f73e9456e
--- /dev/null
+++ b/video/out/analyzer_waveform_bridge.h
@@ -0,0 +1,121 @@
+/* Source/output waveforms remain GPU-resident. No dense graph readback. */
+static bool analyzer_waveform_reduce(struct priv *p, const struct pl_hook_params *hp,
+                                    const struct pl_hook *hook, pl_tex tex, bool output)
+{
+    struct async_probe *a=p->async_probe;
+    if (!tex || !a->wave_tex || a->wave_w<1) return false;
+    int width=a->wave_w, rotation=a->wave_rotation;
+    int columns=(rotation==90 || rotation==270) ? tex->params.h : tex->params.w;
+    int rows=(rotation==90 || rotation==270) ? tex->params.w : tex->params.h;
+    float matrix[9], yc[3];
+    for(int i=0;i<9;i++){char n[40];snprintf(n,sizeof(n),"source_to_bt2020_%d",i);matrix[i]=frame_parameter(hook,n);}
+    for(int i=0;i<3;i++){char n[40];snprintf(n,sizeof(n),"source_cie_y_%d",i);yc[i]=frame_parameter(hook,n);}
+    float scale=frame_parameter(hook,"source_is_sdr") ? frame_parameter(hook,"sdr_reference_peak") :
+        (frame_parameter(hook,"source_is_absolute") || frame_parameter(hook,"source_is_hlg")) ? 203.f : 100.f;
+    if(output){
+        const struct pl_raw_primaries *prim=pl_raw_primaries_get(hp->color.primaries);
+        pl_matrix3x3 xyz=pl_get_rgb2xyz_matrix(prim);
+        pl_matrix3x3 map=pl_get_color_mapping_matrix(prim,pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020),PL_INTENT_RELATIVE_COLORIMETRIC);
+        for(int i=0;i<3;i++){yc[i]=xyz.m[1][i];for(int j=0;j<3;j++)matrix[3*j+i]=map.m[i][j];}
+        scale=203.f;
+    }
+    size_t bytes=(size_t)width*256*2*4;
+    if(a->wave_buf && a->wave_buf->params.size!=bytes) pl_buf_destroy(p->gpu,&a->wave_buf);
+    if(!a->wave_buf) a->wave_buf=pl_buf_create(p->gpu,pl_buf_params(.size=bytes,.storable=true,.memory_type=PL_BUF_MEM_DEVICE));
+    if(!a->wave_buf) return false;
+    float range[2]={(a->wave_x-a->wave_dst.x0)/pl_rect_w(a->wave_dst),1.f/pl_rect_w(a->wave_dst)};
+    struct pl_shader_var vars[]={
+        {.var={.name="to2020",.type=PL_VAR_FLOAT,.dim_v=3,.dim_m=3,.dim_a=1},.data=matrix,.dynamic=true},
+        {.var=pl_var_vec3("yc"),.data=yc,.dynamic=true},
+        {.var=pl_var_float("nits"),.data=&scale,.dynamic=true},
+        {.var=pl_var_vec2("xrange"),.data=range,.dynamic=true},
+    };
+    struct pl_buffer_var bv={.var={.name="counts",.type=PL_VAR_UINT,.dim_v=1,.dim_m=1,.dim_a=width*256*2},.layout={.offset=0,.stride=4,.size=bytes}};
+    struct pl_shader_desc desc[]={
+        {.desc={.name="wave_source",.type=PL_DESC_SAMPLED_TEX},.binding={.object=tex,.sample_mode=PL_TEX_SAMPLE_NEAREST}},
+        {.desc={.name="WaveCounts",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=a->wave_buf,.buffer_vars=&bv,.num_buffer_vars=1},
+    };
+    char *header=talloc_asprintf(NULL,"%s\nshared uint bins[256];\n",frame_math);
+    char *body=talloc_asprintf(NULL,
+        "int lane=int(gl_LocalInvocationID.x), col=int(gl_WorkGroupID.x);"
+        "for(int i=lane;i<256;i+=64)bins[i]=0u;barrier();"
+        "int lo=clamp(int(floor((xrange.x+col*xrange.y)*%d.0)),0,%d);"
+        "int hi=clamp(int(floor((xrange.x+(col+1)*xrange.y)*%d.0)),lo+1,%d);"
+        "for(int n=lane;n<(hi-lo)*%d;n+=64){int sx=lo+n/%d, sy=n%%%d;"
+        "ivec2 xy=ivec2(sx,sy);ivec2 sz=textureSize(wave_source,0);"
+        "if(%d==90)xy=ivec2(sy,sz.y-1-sx);"
+        "if(%d==180)xy=sz-1-ivec2(sx,sy);"
+        "if(%d==270)xy=ivec2(sz.x-1-sy,sx);"
+        "vec3 c=texelFetch(wave_source,xy,0).rgb;"
+        "float v=%d==1 ? perceptual_bt2020(to2020*c) : %d==2 ? dot(yc,c) : max(c.r,max(c.g,c.b));"
+        "int bin=int(clamp(pq_encode_nits(max(v*nits,0.0))*256.0,0.0,255.0));atomicAdd(bins[bin],1u);}barrier();"
+        "for(int i=lane;i<256;i+=64)counts[%d+col*256+i]=bins[i];",
+        columns,columns-1,columns,columns,rows,rows,rows,
+        rotation,rotation,rotation,p->next_opts->analyzer_waveform,p->next_opts->analyzer_waveform,output?width*256:0);
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description=output?"Analyzer output waveform":"Analyzer source waveform",
+        .header=header,.body=body,.input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_NONE,
+        .variables=vars,.num_variables=4,.descriptors=desc,.num_descriptors=2,
+        .compute=true,.compute_group_size={64,1}}) &&
+        pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={width,1,1}));
+    talloc_free(header);talloc_free(body);
+    if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    return ok;
+}
+
+static void analyzer_waveform_update(struct priv *p,const struct pl_hook_params *hp,
+                                    struct async_probe_slot *slot,const struct pl_hook *hook)
+{
+    struct async_probe *a=p->async_probe;
+    if(!a->wave_tex || !p->next_opts->analyzer_waveform || p->next_opts->analyzer_waveform_height<=0) return;
+    pl_tex source=pl_mpv_user_shader_saved_texture(hook,"ANALYZER_LINEAR");
+    if(!analyzer_waveform_reduce(p,hp,hook,source,false) ||
+       !analyzer_waveform_reduce(p,&a->output,hook,slot->output_linear,true)) return;
+    int width=a->wave_w, tint=p->next_opts->analyzer_waveform_tint;
+    float rgb[3]={((tint>>16)&255)/255.f,((tint>>8)&255)/255.f,(tint&255)/255.f};
+    struct pl_shader_var var={.var=pl_var_vec3("tint"),.data=rgb,.dynamic=true};
+    struct pl_buffer_var bv={.var={.name="counts",.type=PL_VAR_UINT,.dim_v=1,.dim_m=1,.dim_a=width*512},.layout={.offset=0,.stride=4,.size=(size_t)width*512*4}};
+    struct pl_shader_desc desc={.desc={.name="WaveCounts",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_READONLY},.binding.object=a->wave_buf,.buffer_vars=&bv,.num_buffer_vars=1};
+    char *body=talloc_asprintf(NULL,
+        "ivec2 q=ivec2(gl_FragCoord.xy);int bin=255-q.y;"
+        "float s=%d==2?0.0:float(counts[q.x*256+bin]);float o=%d==1?0.0:float(counts[%d+q.x*256+bin]);"
+        "s=s>0.0?clamp(.20+.13*log(1.0+s),0.0,1.0):0.0;o=o>0.0?clamp(.20+.13*log(1.0+o),0.0,1.0):0.0;"
+        "vec3 c=max(vec3(.18,.78,1)*s,vec3(1,.72,.32)*o)*tint;"
+        "color=vec4(c,.86);",p->next_opts->analyzer_waveform_layers,p->next_opts->analyzer_waveform_layers,width*256);
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description="Analyzer waveform density texture",.body=body,
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_COLOR,.variables=&var,.num_variables=1,.descriptors=&desc,.num_descriptors=1}) &&
+        pl_dispatch_finish(hp->dispatch,pl_dispatch_params(.shader=&sh,.target=a->wave_tex));
+    talloc_free(body);if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    if(ok)a->wave_sequence++;
+}
+
+static void analyzer_waveform_prepare(struct priv *p, struct pl_frame *target,
+                                     struct pl_color_space color, int rotation)
+{
+    struct async_probe *a=p->async_probe;
+    if(!a || p->next_opts->analyzer_async!=3 || !p->next_opts->analyzer_waveform ||
+       p->next_opts->analyzer_waveform_height<=0) return;
+    int frame_w=target->planes[0].texture->params.w, frame_h=target->planes[0].texture->params.h;
+    int x=MPCLAMP((int)ceilf(target->crop.x0),0,frame_w),right=MPCLAMP((int)floorf(target->crop.x1),0,frame_w);
+    int y=MPCLAMP(p->next_opts->analyzer_waveform_y,0,frame_h);
+    int height=MPCLAMP(p->next_opts->analyzer_waveform_height,0,frame_h-y);
+    int width=right-x;
+    if(width<1 || width>16384 || height<1) return;
+    if(width!=a->wave_w || memcmp(&target->crop,&a->wave_dst,sizeof(target->crop)) || rotation!=a->wave_rotation) {
+        a->last_stats_revision=0; // Geometry changes must rebuild even when paused.
+    }
+    a->wave_x=x;a->wave_y=y;a->wave_w=width;a->wave_h=height;
+    a->wave_dst=target->crop;a->wave_rotation=rotation;
+    pl_fmt fmt=pl_find_fmt(p->gpu,PL_FMT_UNORM,4,8,0,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE);
+    bool recreate=!a->wave_tex || a->wave_tex->params.w!=width;
+    if(!fmt || !pl_tex_recreate(p->gpu,&a->wave_tex,pl_tex_params(.w=width,.h=256,.format=fmt,.sampleable=true,.renderable=true,.blit_dst=true)))return;
+    if(recreate)pl_tex_clear(p->gpu,a->wave_tex,(float[4]){0});
+    a->wave_part=(struct pl_overlay_part){.src={0,0,width,256},.dst={x,y,right,y+height}};
+    MP_TARRAY_GROW(p,a->wave_overlays,target->num_overlays);
+    memcpy(a->wave_overlays+1,target->overlays,target->num_overlays*sizeof(*target->overlays));
+    a->wave_overlays[0]=(struct pl_overlay){.tex=a->wave_tex,.mode=PL_OVERLAY_NORMAL,
+        .repr={.alpha=PL_ALPHA_INDEPENDENT},.color=color,.coords=PL_OVERLAY_COORDS_DST_FRAME,
+        .parts=&a->wave_part,.num_parts=1};
+    target->overlays=a->wave_overlays;target->num_overlays++;
+}
