+
+static bool submit_bar_analysis(struct priv *p, struct pl_frame *frame,
+                                uint64_t tag)
+{
+    consume_bar_analysis(p);
+
+    struct pl_plane *luma = NULL;
+    int component = -1;
+    for (int n = 0; n < frame->num_planes && !luma; n++) {
+        for (int c = 0; c < frame->planes[n].components; c++) {
+            if (frame->planes[n].component_mapping[c] == 0) {
+                luma = &frame->planes[n];
+                component = c;
+                break;
+            }
+        }
+    }
+    if (!luma || !luma->texture || component < 0 || component > 3)
+        return false;
+    int width = luma->texture->params.w;
+    int height = luma->texture->params.h;
+    if (width < 1 || height < 1 || height > BAR_ANALYSIS_MAX_ROWS)
+        return false;
+
+    struct bar_analysis_slot *slot = NULL;
+    for (int i = 0; i < BAR_ANALYSIS_SLOTS; i++) {
+        if (!p->bar_slots[i].pending) {
+            slot = &p->bar_slots[i];
+            break;
+        }
+    }
+    if (!slot)
+        return false; // Never turn queue pressure into a presentation wait.
+
+    if (!slot->buf) {
+        slot->buf = pl_buf_create(p->gpu, pl_buf_params(
+            .size = sizeof(struct bar_gpu_data),
+            .memory_type = PL_BUF_MEM_DEVICE,
+            .host_readable = true,
+            .storable = true,
+        ));
+        if (!slot->buf)
+            return false;
+    }
+
+    struct pl_shader_desc descriptors[] = {{
+        .desc = {
+            .name = "luma_tex",
+            .type = PL_DESC_SAMPLED_TEX,
+        },
+        .binding = {
+            .object = luma->texture,
+            .address_mode = PL_TEX_ADDRESS_CLAMP,
+            .sample_mode = PL_TEX_SAMPLE_NEAREST,
+        },
+    }, {
+        .desc = {
+            .name = "BarRows",
+            .type = PL_DESC_BUF_STORAGE,
+            .access = PL_DESC_ACCESS_WRITEONLY,
+        },
+        .binding.object = slot->buf,
+        .buffer_vars = (struct pl_buffer_var *) bar_buffer_vars,
+        .num_buffer_vars = MP_ARRAY_SIZE(bar_buffer_vars),
+    }};
+    static const char header[] =
+        "shared uint row_min[64];\n"
+        "shared uint row_max[64];\n"
+        "shared uint row_sum[64];\n"
+        "shared uint row_count[64];\n"
+        "shared uint row_bright[64];\n"
+        "shared uint row_edge_bright[64];\n"
+        "shared uint side_min[64];\n"
+        "shared uint side_max[64];\n"
+        "shared uint side_sum[64];\n"
+        "shared uint side_count[64];\n"
+        "shared uint tile_min[64];\n"
+        "shared uint tile_max[64];\n"
+        "shared uint tile_count[64];\n";
+    // Normalize UNORM samples to one 16-bit code space. Software 10-bit
+    // uploads may be unshifted in an r16 texture while hardware P010 surfaces
+    // carry the same codes left-shifted by six bits.
+    int storage_depth = luma->texture->params.format->component_depth[component];
+    int color_depth = frame->repr.bits.color_depth > 0
+                    ? frame->repr.bits.color_depth : storage_depth;
+    int bit_shift = frame->repr.bits.bit_shift;
+    double normalization_scale = 1.0;
+    if (storage_depth > 0 && storage_depth <= 16 && color_depth > 0 &&
+        color_depth <= storage_depth && bit_shift >= 0 &&
+        bit_shift + color_depth <= storage_depth)
+    {
+        normalization_scale = ((1u << storage_depth) - 1.0) /
+            (((1u << color_depth) - 1.0) * (1u << bit_shift));
+    }
+    char *body = talloc_asprintf(NULL,
+        "uint lane = gl_LocalInvocationID.x;\n"
+        "uint y = gl_WorkGroupID.y;\n"
+        "uvec2 size = uvec2(textureSize(luma_tex, 0));\n"
+        "uint mn = 65535u, mx = 0u, sum = 0u, count = 0u, hi = 0u, edge_hi = 0u;\n"
+        "uint side_width = max(4u, size.x / 64u);\n"
+        "uint lmn = 65535u, lmx = 0u, lsum = 0u, lcount = 0u;\n"
+        "uint rmn = 65535u, rmx = 0u, rsum = 0u, rcount = 0u;\n"
+        "uint tile = lane & 31u, tile_half = lane >> 5u;\n"
+        "uint tile_x0 = size.x * tile / 32u;\n"
+        "uint tile_x1 = size.x * (tile + 1u) / 32u;\n"
+        "for (uint x = tile_x0 + tile_half; x < tile_x1; x += 2u) {\n"
+        "    float v = texelFetch(luma_tex, ivec2(x, y), 0)[%d] * %.9f;\n"
+        "    uint q = uint(clamp(v, 0.0, 1.0) * 65535.0 + 0.5);\n"
+        "    mn = min(mn, q); mx = max(mx, q); sum += q; count++;\n"
+        "    bool bright_pixel = q > 6000u;\n"
+        "    hi += bright_pixel ? 1u : 0u;\n"
+        "    if (x < side_width) { lmn = min(lmn, q); lmx = max(lmx, q); lsum += q; lcount++; }\n"
+        "    if (x + side_width >= size.x) { rmn = min(rmn, q); rmx = max(rmx, q); rsum += q; rcount++; }\n"
+        "    edge_hi += bright_pixel && (x < size.x / 8u || x >= 7u * size.x / 8u) ? 1u : 0u;\n"
+        "}\n"
+        "row_min[lane] = mn; row_max[lane] = mx;\n"
+        "row_sum[lane] = sum; row_count[lane] = count; row_bright[lane] = hi;\n"
+        "row_edge_bright[lane] = edge_hi;\n"
+        "tile_min[lane] = mn; tile_max[lane] = mx; tile_count[lane] = count;\n"
+        "barrier();\n"
+        "for (uint step = 32u; step > 0u; step >>= 1u) {\n"
