diff --git a/TOOLS/causal_scene_validate.md b/TOOLS/causal_scene_validate.md
new file mode 100644
index 0000000000000000000000000000000000000000..68fefc7aeb3cea9277197eeb47f959c539e00ed1
--- /dev/null
+++ b/TOOLS/causal_scene_validate.md
@@ -0,0 +1,24 @@
+# Causal Stage 1 trace validation
+
+Collect two JSONL property traces through mpv IPC: one with
+`--hdr-causal-scene-diagnostics=yes` and one without that session-only option.
+Each enabled record must contain the `video-out-params/causal-scene-*` values.
+Insert `{"event":"discontinuity"}` immediately after each seek, flush, track
+switch, renderer reset, or deliberately dropped association. The next sample
+must be withheld, never compared to its predecessor.
+``unsupported`` is a valid withheld reason when the renderer cannot provide
+the frozen proxy/descriptor path (for example an unsupported backend or source
+representation); it is not a visual trigger.
+
+For a rendered-output invariance check, produce deterministic frame-hash
+manifests from equivalent diagnostic-off/on runs and pass both files:
+
+```text
+python TOOLS/causal_scene_validate.py --enabled-trace on.jsonl --disabled-trace off.jsonl --output-off off.sha256 --output-on on.sha256
+```
+
+The harness checks exact tag ordering and latency (`submitted - consumed`),
+discontinuity withholding, option-off unavailability, complete property shape,
+and the Stage 1 prohibition on acceleration. It intentionally does not judge
+native descriptor values or cut quality; that belongs to the frozen CPU
+reference/corpus replay gate.
diff --git a/TOOLS/causal_scene_validate.py b/TOOLS/causal_scene_validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..6037e76840c2dab96e0c550e7783443f15f70380
--- /dev/null
+++ b/TOOLS/causal_scene_validate.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Validate Stage 1 causal-scene diagnostic traces without judging picture quality.
+
+Input is JSON Lines produced by an IPC/log collector.  Each record is a flat
+mapping of the native `video-out-params/causal-scene-*` suffixes (or the full
+property names) plus an optional `event` field.  `event=discontinuity` marks a
+seek, flush, track switch, renderer reset, or dropped association.  The first
+following descriptor must be withheld rather than compared across that boundary.
+"""
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+PREFIX = "video-out-params/causal-scene-"
+REQUIRED = (
+    "effective-allow-delayed", "submitted-tag", "consumed-tag",
+    "latency-frames", "descriptor-valid", "withheld-reason", "histogram-tv",
+    "tile-mad", "shifted-tile-mad", "translated-motion-fraction",
+    "global-motion-residual", "score", "visual-trigger", "last-tag",
+    "authored-boundary-tag", "authored-boundary-source",
+    "active-metric-branch", "acceleration-applied", "acceleration-count",
+)
+WITHHELD_REASONS = {"none", "disabled", "no-tag", "pending", "discontinuity", "unsupported"}
+
+
+def key(row, name):
+    return row.get(name, row.get(PREFIX + name))
+
+
+def rows(path):
+    for line_no, line in enumerate(Path(path).read_text(encoding="utf-8").splitlines(), 1):
+        if line.strip():
+            try:
+                yield line_no, json.loads(line)
+            except json.JSONDecodeError as exc:
+                raise ValueError(f"{path}:{line_no}: invalid JSON: {exc}") from exc
+
+
+def check_trace(path, expect_enabled):
+    errors, last_submitted, last_consumed = [], None, None
+    must_withhold = False
+    saw = False
+    for line_no, row in rows(path):
+        if row.get("event") == "discontinuity":
+            must_withhold = True
+            last_submitted = last_consumed = None
+            continue
+        values = {name: key(row, name) for name in REQUIRED}
+        present = any(value is not None for value in values.values())
+        if not expect_enabled:
+            if present:
+                errors.append(f"{line_no}: diagnostics present while option is off")
+            continue
+        if not present:
+            errors.append(f"{line_no}: diagnostics absent while option is on")
+            continue
+        saw = True
+        missing = [name for name, value in values.items() if value is None]
+        if missing:
+            errors.append(f"{line_no}: missing fields: {', '.join(missing)}")
+            continue
+        if values["acceleration-applied"] is not False:
+            errors.append(f"{line_no}: Stage 1 must never apply acceleration")
+        if not isinstance(values["acceleration-count"], int) or values["acceleration-count"] < 0:
+            errors.append(f"{line_no}: invalid acceleration count")
+        valid = values["descriptor-valid"] is True
+        withheld = values["withheld-reason"]
+        if withheld not in WITHHELD_REASONS:
+            errors.append(f"{line_no}: unknown withheld reason {withheld!r}")
+        if valid and withheld != "none":
+            errors.append(f"{line_no}: valid descriptor has withheld reason {withheld!r}")
+        if not valid and withheld == "none":
+            errors.append(f"{line_no}: invalid descriptor was not withheld")
+        if must_withhold:
+            if valid or withheld not in {"discontinuity", "pending", "no-tag", "unsupported"}:
+                errors.append(f"{line_no}: discontinuity was compared instead of withheld")
+            must_withhold = False
+        submitted, consumed = values["submitted-tag"], values["consumed-tag"]
+        if not isinstance(submitted, int) or not isinstance(consumed, int):
+            errors.append(f"{line_no}: frame tags must be integers")
+            continue
+        if submitted and consumed and submitted < consumed:
+            errors.append(f"{line_no}: submitted tag precedes consumed tag")
+        latency = values["latency-frames"]
+        if submitted and consumed and latency != submitted - consumed:
+            errors.append(f"{line_no}: latency {latency} != submitted-consumed ({submitted-consumed})")
+        if last_submitted is not None and submitted and submitted < last_submitted:
+            errors.append(f"{line_no}: submitted tag regressed without discontinuity")
+        if last_consumed is not None and consumed and consumed < last_consumed:
+            errors.append(f"{line_no}: consumed tag regressed without discontinuity")
+        last_submitted = max(last_submitted or 0, submitted)
+        last_consumed = max(last_consumed or 0, consumed)
+    if expect_enabled and not saw:
+        errors.append("trace contains no enabled diagnostic samples")
+    return errors
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--enabled-trace", type=Path, required=True)
+    parser.add_argument("--disabled-trace", type=Path, required=True)
+    parser.add_argument("--output-off", type=Path, help="rendered output/hash manifest with diagnostics off")
+    parser.add_argument("--output-on", type=Path, help="same rendered output/hash manifest with diagnostics on")
+    args = parser.parse_args()
+    errors = check_trace(args.enabled_trace, True) + check_trace(args.disabled_trace, False)
+    if bool(args.output_off) != bool(args.output_on):
+        errors.append("provide both output manifests to test rendered-output invariance")
+    if args.output_off and digest(args.output_off) != digest(args.output_on):
+        errors.append("diagnostics changed rendered-output manifest")
+    if errors:
+        print("FAIL")
+        print("\n".join(f"- {error}" for error in errors))
+        return 1
+    print("PASS: causal Stage 1 tags, withholding, option-off state, and output invariance")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/TOOLS/test_causal_scene_validate.py b/TOOLS/test_causal_scene_validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..13d18af4a0359bb0382249787652be6941db4fdd
--- /dev/null
+++ b/TOOLS/test_causal_scene_validate.py
@@ -0,0 +1,55 @@
+import importlib.util
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+SPEC = importlib.util.spec_from_file_location(
+    "causal_scene_validate", Path(__file__).with_name("causal_scene_validate.py"))
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+def sample(**overrides):
+    values = {
+        "effective-allow-delayed": False, "submitted-tag": 4,
+        "consumed-tag": 4, "latency-frames": 0, "descriptor-valid": True,
+        "withheld-reason": "none", "histogram-tv": 0.1, "tile-mad": 0.1,
+        "shifted-tile-mad": 0.05, "translated-motion-fraction": 0.5,
+        "global-motion-residual": 0.02, "score": 0.05,
+        "visual-trigger": False, "last-tag": 0, "authored-boundary-tag": 0,
+        "authored-boundary-source": "none", "active-metric-branch": "standard",
+        "acceleration-applied": False, "acceleration-count": 0,
+    }
+    values.update(overrides)
+    return values
+
+
+class CausalTraceTest(unittest.TestCase):
+    def write(self, *records):
+        handle = tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", delete=False)
+        for record in records:
+            handle.write(json.dumps(record) + "\n")
+        handle.close()
+        self.addCleanup(Path(handle.name).unlink)
+        return handle.name
+
+    def test_enabled_trace_and_discontinuity(self):
+        trace = self.write(sample(), {"event": "discontinuity"}, sample(
+            **{"submitted-tag": 1, "consumed-tag": 0, "latency-frames": 0,
+               "descriptor-valid": False, "withheld-reason": "discontinuity"}))
+        self.assertEqual(MODULE.check_trace(trace, True), [])
+
+    def test_option_off_rejects_properties(self):
+        self.assertTrue(MODULE.check_trace(self.write(sample()), False))
+
+    def test_stage_one_rejects_acceleration(self):
+        self.assertTrue(MODULE.check_trace(self.write(sample(**{"acceleration-applied": True})), True))
+
+    def test_unsupported_is_a_valid_withheld_state(self):
+        self.assertEqual(MODULE.check_trace(self.write(sample(**{
+            "descriptor-valid": False, "withheld-reason": "unsupported"})), True), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
