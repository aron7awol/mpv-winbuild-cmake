     if (!sh_try_compute(sh, 16, 16, true, shmem_req)) {
         PL_ERR(sh, "HDR peak detection requires compute shaders with support "
@@ -1650,6 +1765,7 @@ retry_ssbo:
     }
 
     obj->peak.params = *params;
+    pl_color_space_infer(&csp);
 
     sh_desc(sh, (struct pl_shader_desc) {
         .desc = {
@@ -1671,7 +1787,10 @@ retry_ssbo:
             wg_rgb_pq_max = sh_fresh(sh, "wg_rgb_pq_max"),
             wg_black   = sh_fresh(sh, "wg_black"),
             wg_hist    = NULL_IDENT,
-            wg_hist_rgb = NULL_IDENT;
+            wg_hist_rgb = NULL_IDENT,
+            wg_metric_sum = NULL_IDENT,
+            wg_metric_max = NULL_IDENT,
+            wg_hist_metric = NULL_IDENT;
     GLSLH("shared uint "$", "$", "$", "$", "$", "$"; \n",
           wg_sum, wg_max, wg_rgb_sum, wg_rgb_max, wg_rgb_pq_max, wg_black);
     if (use_histogram) {
@@ -1681,6 +1800,16 @@ retry_ssbo:
         GLSLH("shared uint "$"[%u]; \n", wg_hist_rgb, HIST_BINS);
     }
 
+    if (use_metric) {
+        wg_metric_sum = sh_fresh(sh, "wg_metric_sum");
+        wg_metric_max = sh_fresh(sh, "wg_metric_max");
+        GLSLH("shared uint "$", "$"; \n", wg_metric_sum, wg_metric_max);
+        if (use_histogram) {
+            wg_hist_metric = sh_fresh(sh, "wg_hist_metric");
+            GLSLH("shared uint "$"[%u]; \n", wg_hist_metric, HIST_BINS);
+        }
+    }
+
     sh_describe(sh, "peak detection");
 #pragma GLSL /* pl_shader_detect_peak */                                        \
     {                                                                           \
@@ -1693,16 +1822,24 @@ retry_ssbo:
     if (local_idx == 0u) {                                                      \
         $wg_sum = $wg_max = $wg_rgb_sum = $wg_rgb_max = $wg_rgb_pq_max = 0u;  \
         $wg_black = 0u;                                                         \
