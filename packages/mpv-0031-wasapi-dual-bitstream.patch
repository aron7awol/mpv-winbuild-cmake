diff --git a/audio/out/ao_wasapi_dual.h b/audio/out/ao_wasapi_dual.h
new file mode 100644
--- /dev/null
+++ b/audio/out/ao_wasapi_dual.h
@@ -0,0 +1,304 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Optional two-endpoint IEC61937 output. Included only by ao_wasapi.c.
+ * All COM objects, stream cursors and scheduling state live on AudioThread.
+ * Never resample, discard or duplicate portions of a compressed burst.
+ */
+struct wasapi_dual {
+    struct ao secondary_ao;
+    struct wasapi_state secondary;
+    unsigned char *ring;
+    uint64_t produced, cursor[2];
+    size_t capacity, stride;
+    bool running, started[2], failed;
+    bool exhausted;
+    uint64_t valid_end;
+    int64_t start_at[2], paused_at, last_report;
+    double skew_ms;
+    const char *error;
+};
+
+static struct wasapi_state *dual_endpoint(struct ao *ao, int i)
+{
+    struct wasapi_state *s = ao->priv;
+    return i ? &s->dual->secondary : s;
+}
+
+static void dual_fail(struct ao *ao, const char *error)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    if (d->failed)
+        return;
+    d->failed = true;
+    d->error = error;
+    d->running = false;
+    ao_set_draining(ao, false);
+    for (int i = 0; i < 2; i++) {
+        struct wasapi_state *e = dual_endpoint(ao, i);
+        if (e->pAudioClient)
+            IAudioClient_Stop(e->pAudioClient);
+        d->started[i] = false;
+    }
+    MP_ERR(ao, "Dual bitstream stopped: %s. Fix the devices and reload audio.\n", error);
+}
+
+static bool dual_init(struct ao *ao)
+{
+    struct wasapi_state *s = ao->priv;
+    if (!s->opt_secondary_device || !s->opt_secondary_device[0])
+        return true;
+    struct wasapi_dual *d = s->dual = talloc_zero(s, struct wasapi_dual);
+    struct ao *other = &d->secondary_ao;
+    struct wasapi_state *e = &d->secondary;
+    // Only the format/device fields are used by wasapi_thread_init. This is
+    // deliberately NOT a second mpv AO or a second decoder/buffer_state.
+    other->priv = e;
+    other->log = e->log = ao->log;
+    other->format = ao->format;
+    other->samplerate = ao->samplerate;
+    other->channels = ao->channels;
+    other->client_name = ao->client_name;
+    other->device = s->opt_secondary_device;
+    if (strncmp(other->device, "wasapi/", 7) == 0)
+        other->device += 7;
+    e->strict_bitstream = true;
+    e->opt_exclusive = true;
+    e->opt_exclusive_buffer = s->opt_exclusive_buffer;
+    e->deviceID = wasapi_find_deviceID(other);
+    if (!e->deviceID || (s->deviceID && !wcscmp(s->deviceID, e->deviceID))) {
+        MP_ERR(ao, "Dual bitstream requires two different, available WASAPI devices.\n");
+        return false;
+    }
+    e->hWake = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!e->hWake || !wasapi_thread_init(other)) {
+        MP_ERR(ao, "Secondary device cannot open this bitstream in exclusive mode.\n");
+        return false;
+    }
+    if (memcmp(&s->format, &e->format, sizeof(s->format)) != 0 ||
+        s->share_mode != AUDCLNT_SHAREMODE_EXCLUSIVE ||
+        e->share_mode != AUDCLNT_SHAREMODE_EXCLUSIVE ||
+        ao_need_conversion(&s->convert_format) ||
+        ao_need_conversion(&e->convert_format)) {
+        MP_ERR(ao, "Dual bitstream requires identical, unconverted carrier formats.\n");
+        return false;
+    }
+    d->stride = s->format.Format.nBlockAlign;
+    // The core must prebuffer enough for either endpoint, not just primary.
+    ao->device_buffer = MPMAX(s->bufferFrameCount, e->bufferFrameCount) +
+                        (int64_t)ao->samplerate * abs(s->opt_secondary_delay) / 1000;
+    // Bounded storage accommodates different driver periods and +/-1s delay.
+    d->capacity = 4ull * ao->samplerate +
+                  4ull * MPMAX(s->bufferFrameCount, e->bufferFrameCount);
+    d->ring = talloc_size(d, d->capacity * d->stride);
+    if (!d->ring)
+        return false;
+    MP_INFO(ao, "Dual bitstream ready: %s, %d Hz, buffers %u/%u frames, offset %+d ms.\n",
+            af_fmt_to_str(ao->format), ao->samplerate,
+            s->bufferFrameCount, e->bufferFrameCount, s->opt_secondary_delay);
+    return true;
+}
+
+static void dual_uninit(struct ao *ao)
+{
+    struct wasapi_state *s = ao->priv;
+    if (!s->dual)
+        return;
+    struct wasapi_dual *d = s->dual;
+    wasapi_thread_uninit(&d->secondary_ao);
+    SAFE_DESTROY(d->secondary.hWake, CloseHandle(d->secondary.hWake));
+    talloc_free(d->secondary.deviceID);
+    talloc_free(d);
+    s->dual = NULL;
+}
+
+static bool dual_copy(struct ao *ao, int i, BYTE *dst, UINT32 frames)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    uint64_t end = d->cursor[i] + frames;
+    uint64_t oldest = MPMIN(d->cursor[0], d->cursor[1]);
+    if (end - oldest > d->capacity) {
+        dual_fail(ao, "endpoint queues diverged beyond the safety limit");
+        return false;
+    }
+    while (d->produced < end) {
+        size_t offset = d->produced % d->capacity;
+        int n = MPMIN(end - d->produced, d->capacity - offset);
+        double delay_ns = 0;
+        // Forecast the primary playback time even if secondary asks ahead.
+        if (d->started[0]) {
+            if (FAILED(get_device_delay(s, &delay_ns))) {
+                dual_fail(ao, "primary audio clock unavailable");
+                return false;
+            }
+        } else {
+            delay_ns = atomic_load(&s->sample_count) * 1e9 / ao->samplerate;
+            delay_ns += MPMAX(0, d->start_at[0] - mp_time_ns());
+        }
+        int64_t ahead = (int64_t)(d->produced + n) -
+                        (int64_t)atomic_load(&s->sample_count);
+        delay_ns += ahead * 1e9 / ao->samplerate;
+        void *data[] = {d->ring + offset * d->stride};
+        if (d->exhausted) {
+            memset(data[0], 0, n * d->stride);
+        } else {
+            int got = ao_read_data(ao, data, n, mp_time_ns() + llrint(delay_ns), NULL, true, true);
+            d->valid_end = d->produced + got;
+            d->exhausted = got < n;
+        }
+        d->produced += n;
+    }
+    size_t offset = d->cursor[i] % d->capacity;
+    size_t first = MPMIN(frames, d->capacity - offset);
+    memcpy(dst, d->ring + offset * d->stride, first * d->stride);
+    memcpy(dst + first * d->stride, d->ring, (frames - first) * d->stride);
+    d->cursor[i] = end;
+    return true;
+}
+
+static bool dual_feed(struct ao *ao, int i)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    struct wasapi_state *e = dual_endpoint(ao, i);
+    if (d->failed || !d->running)
+        return false;
+    UINT32 padding;
+    HRESULT hr = IAudioClient_GetCurrentPadding(e->pAudioClient, &padding);
+    if (FAILED(hr)) {
+        dual_fail(ao, "device removed or padding query failed");
+        return false;
+    }
+    UINT32 frames = e->bufferFrameCount;
+    if (padding >= 2 * frames)
+        return false;
+    BYTE *data;
+    hr = IAudioRenderClient_GetBuffer(e->pRenderClient, frames, &data);
+    if (FAILED(hr)) {
+        dual_fail(ao, "cannot acquire endpoint buffer");
+        return false;
+    }
+    bool ok = dual_copy(ao, i, data, frames);
+    hr = IAudioRenderClient_ReleaseBuffer(e->pRenderClient, frames,
+                                         ok ? 0 : AUDCLNT_BUFFERFLAGS_SILENT);
+    if (FAILED(hr)) {
+        dual_fail(ao, "cannot submit endpoint buffer");
+        return false;
+    }
+    if (ok)
+        atomic_fetch_add(&e->sample_count, frames);
+    return ok && padding < frames;
+}
+
+static void dual_pause(struct ao *ao)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    if (!d->running)
+        return;
+    d->paused_at = mp_time_ns();
+    d->running = false;
+    for (int i = 0; i < 2; i++) {
+        if (d->started[i] && FAILED(IAudioClient_Stop(dual_endpoint(ao, i)->pAudioClient)))
+            dual_fail(ao, "cannot pause endpoint");
+        d->started[i] = false;
+    }
+}
+
+static void dual_reset(struct ao *ao)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    dual_pause(ao);
+    for (int i = 0; i < 2; i++) {
+        struct wasapi_state *e = dual_endpoint(ao, i);
+        if (FAILED(IAudioClient_Reset(e->pAudioClient)))
+            dual_fail(ao, "cannot reset endpoint");
+        atomic_store(&e->sample_count, 0);
+        d->cursor[i] = 0;
+        d->start_at[i] = 0;
+    }
+    d->produced = 0;
+    d->skew_ms = 0;
+    d->exhausted = false;
+    d->valid_end = 0;
+    ao_set_draining(ao, false);
+}
+
+static void dual_tick(struct ao *ao)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    if (!d->running || d->failed)
+        return;
+    int64_t now = mp_time_ns();
+    for (int i = 0; i < 2; i++) {
+        if (!d->started[i] && now >= d->start_at[i]) {
+            if (FAILED(IAudioClient_Start(dual_endpoint(ao, i)->pAudioClient))) {
+                dual_fail(ao, "cannot start endpoint");
+                return;
+            }
+            d->started[i] = true;
+        }
+    }
+    if (!d->started[0] || !d->started[1])
+        return;
+    double played[2];
+    for (int i = 0; i < 2; i++) {
+        struct wasapi_state *e = dual_endpoint(ao, i);
+        UINT64 pos, qpc;
+        if (FAILED(IAudioClock_GetPosition(e->pAudioClock, &pos, &qpc))) {
+            dual_fail(ao, "endpoint clock unavailable");
+            return;
+        }
+        played[i] = 1000.0 * pos / e->clock_frequency;
+    }
+    d->skew_ms = played[1] - played[0] + s->opt_secondary_delay;
+    if (d->exhausted && MPMIN(played[0], played[1]) * ao->samplerate / 1000.0 >= d->valid_end) {
+        dual_pause(ao);
+        ao_set_draining(ao, false);
+        return;
+    }
+    // Correct clock drift only by briefly stopping the leading transport.
+    // Queued bytes and burst alignment survive Stop/Start. This may cause a
+    // receiver re-lock; never corrupt compressed data to hide that possibility.
+    if (fabs(d->skew_ms) > 30) {
+        int lead = d->skew_ms > 0 ? 1 : 0;
+        if (FAILED(IAudioClient_Stop(dual_endpoint(ao, lead)->pAudioClient))) {
+            dual_fail(ao, "cannot correct endpoint clock drift");
+            return;
+        }
+        d->started[lead] = false;
+        d->start_at[lead] = now + (int64_t)((fabs(d->skew_ms) - 5) * 1e6);
+        MP_WARN(ao, "Dual bitstream clock correction: skew %+.1f ms, holding %s.\n",
+                d->skew_ms, lead ? "secondary" : "primary");
+    }
+    if (now - d->last_report >= MP_TIME_S_TO_NS(30)) {
+        d->last_report = now;
+        MP_VERBOSE(ao, "Dual bitstream clock skew %+.2f ms; queues %llu/%llu.\n",
+                   d->skew_ms, (unsigned long long)d->cursor[0],
+                   (unsigned long long)d->cursor[1]);
+    }
+}
+
+static void dual_unpause(struct ao *ao, bool fresh)
+{
+    struct wasapi_state *s = ao->priv;
+    struct wasapi_dual *d = s->dual;
+    if (d->failed)
+        return;
+    int64_t now = mp_time_ns();
+    if (fresh) {
+        d->start_at[0] = now + MPMAX(0, -s->opt_secondary_delay) * 1000000ll;
+        d->start_at[1] = now + MPMAX(0, s->opt_secondary_delay) * 1000000ll;
+    } else {
+        for (int i = 0; i < 2; i++)
+            d->start_at[i] = now + MPMAX(0, d->start_at[i] - d->paused_at);
+    }
+    d->running = true;
+    if (fresh)
+        ao_set_draining(ao, true);
+    for (int i = 0; i < 2; i++)
+        dual_feed(ao, i);
+    dual_tick(ao);
+}
