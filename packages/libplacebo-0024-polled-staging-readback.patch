     require(params->size > 0 && params->size <= gpu->limits.max_buf_size);
     require(!params->uniform || params->size <= gpu->limits.max_ubo_size);
     require(!params->storable || params->size <= gpu->limits.max_ssbo_size);
@@ -635,6 +636,7 @@ static bool pl_buf_params_superset(struct pl_buf_params a, struct pl_buf_params
            a.format          == b.format &&
            (a.host_writable  || !b.host_writable) &&
            (a.host_readable  || !b.host_readable) &&
+           (a.host_read_poll || !b.host_read_poll) &&
            (a.host_mapped    || !b.host_mapped) &&
            (a.uniform        || !b.uniform) &&
            (a.storable       || !b.storable) &&
diff --git a/src/include/libplacebo/gpu.h b/src/include/libplacebo/gpu.h
index fcaca197..57a39b50 100644
--- a/src/include/libplacebo/gpu.h
+++ b/src/include/libplacebo/gpu.h
@@ -503,6 +503,12 @@ struct pl_buf_params {
 
     // Arbitrary identifying tag. Used only for debugging purposes.
     pl_debug_tag debug_tag;
+
+    // For host-readable buffers, prepare a staged readback when polled.
+    // Backends may ignore this hint. Poll with timeout 0 until ready, then
+    // read without modifying the buffer in between. Direct reads retain
+    // their usual synchronization semantics. Default false.
+    bool host_read_poll;
 };
 
 #define pl_buf_params(...) (&(struct pl_buf_params) {   \

