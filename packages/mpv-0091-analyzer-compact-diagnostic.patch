+    char *header=talloc_asprintf(NULL,"%s\n#define BINS %d\n#define SOURCE_DENSITY %d\nshared vec3 mn[64], mx[64], sm[64];\nshared uint hist[BINS];\n",frame_math,bins,density);
     const char *body=
         "int lane=int(gl_LocalInvocationID.x), y=int(gl_WorkGroupID.y); ivec2 sz=textureSize(frame_tex,0);"
         "for(int i=lane;i<BINS;i+=64) hist[i]=0u; barrier();"
@@ -82,7 +83,7 @@ static bool async_frame_dispatch(struct priv *p, const struct pl_hook_params *hp
         .compute=true,.compute_group_size={64,1}}) && pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={1,h,1}));
     talloc_free(header);
     if(!ok){pl_dispatch_abort(hp->dispatch,&sh);return false;}
