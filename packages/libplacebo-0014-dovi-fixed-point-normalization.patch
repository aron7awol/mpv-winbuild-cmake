+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(
+        .tex = fbo,
+        .ptr = rasciola_out,
+    )));
+    REQUIRE_FEQ(rasciola_out[0], 62.0f / 65536.0f, 1e-7);
+    REQUIRE_FEQ(rasciola_out[1], 54.0f / 65536.0f, 1e-7);
+    REQUIRE_FEQ(rasciola_out[2], 87.0f / 65536.0f, 1e-7);
+
     // Test deinterlacing
     sh = pl_dispatch_begin(dp);
     pl_shader_deinterlace(sh, pl_deinterlace_source( .cur = pl_field_pair(src) ), NULL);
