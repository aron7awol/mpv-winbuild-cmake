+bool pl_get_detected_tone_map_range(const pl_shader_obj state,
+                                    enum pl_tone_map_metric metric,
+                                    float *max_pq, float *avg_pq)
+{
+    if (!state || state->type != PL_SHADER_OBJ_COLOR_MAP)
+        return false;
+    struct sh_color_map_obj *obj = state->priv;
+    update_peak_buf(state->gpu, obj, false);
+    if (metric != PL_TONE_MAP_METRIC_STANDARD) {
+        if (obj->peak.params.metric != metric || !obj->peak.avg_metric)
