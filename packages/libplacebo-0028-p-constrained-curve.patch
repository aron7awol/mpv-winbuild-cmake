From: mpv-ht <mpv-ht@localhost>
Date: Sun, 13 Sep 2026 00:00:00 -0400
Subject: [PATCH] Add experimental contrast-protected common P overflow curve

Apply after XY 0052, smooth P3D LP0025, HSTM 0053/LP0026 and the
separate PQ(P) detail-recovery addition. Rebuild both mpv and FFmpeg
against these libplacebo public headers. Not in the shipping CI selector.

---
diff --git a/src/include/libplacebo/renderer.h b/src/include/libplacebo/renderer.h
index 74140f9..758da31 100644
--- a/src/include/libplacebo/renderer.h
+++ b/src/include/libplacebo/renderer.h
@@ -602,6 +602,10 @@ struct pl_frame {
     // Exact source presentation identity for causal diagnostics; zero means
     // unavailable and suppresses comparisons.
     uint64_t causal_scene_tag;
+    // Optional source PTS for the common P curve's frame-rate-independent
+    // release. Repeated/paused renders do not advance its temporal history.
+    double p_curve_pts;
+    bool p_curve_pts_valid;
     // Optional ICC profile associated with this frame.
     pl_icc_object icc;
 
diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index ad6c98e..e8bbc73 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -407,6 +407,10 @@ struct pl_color_map_params {
     // Optional same-frame maxRGB linear-PQ stage after Perceptual RGB-ray mapping.
     bool auto_pq_second_pass;
 
+    // Experimental common log-P loss curve after the Perceptual RGB pass.
+    // Takes precedence over auto_pq_second_pass; never runs both corrections.
+    bool p_constrained_curve;
+
     // Tone mapping LUT size. Defaults to 256.
     int lut_size;
 
@@ -500,6 +504,8 @@ struct pl_color_map_args {
     // Renderer-private first-stage measurement and current-frame peak texture.
     bool measure_rgb_ray;
     pl_tex rgb_ray_peak;
+    bool measure_p_curve; // RG32: target-linear maxRGB (normalized), P nits
+    pl_tex p_curve;       // 128 clamped cubic B-spline log2-loss coefficients
 };
 
 #define pl_color_map_args(...) (&(struct pl_color_map_args) { __VA_ARGS__ })
diff --git a/src/pcurve.h b/src/pcurve.h
new file mode 100644
index 0000000..36e15cd
--- /dev/null
+++ b/src/pcurve.h
@@ -0,0 +1,230 @@
+/* Experimental common-P overflow correction. GPU-only, same-frame constraints.
+ * Cubic log2(P) loss, 512 full-frame worst-case bins, 128 coefficients.
+ * Fixed-work primal/dual fit followed by an analytic feasibility contraction.
+ * No pixel percentile, readback, clipping-based solver, or per-pixel maxRGB curve.
+ */
+#ifndef LIBPLACEBO_PCURVE_H
+#define LIBPLACEBO_PCURVE_H
+
+#define PC_BINS 512
+#define PC_COEFS 128
+#define PC_SLICES 16
+#define PC_DOMAIN 33.219280948873624f
+
+struct pcurve_state {
+    pl_buf bins;
+    pl_tex curve[2];
+    int index;
+    bool valid, history;
+    uint64_t tag, signature;
+    double pts;
+    float blend;
+};
+
+struct pcurve_bins {
+    uint32_t pc_loss[PC_BINS * PC_SLICES];
+    uint32_t pc_count[PC_BINS * PC_SLICES];
+};
+
+static void pcurve_destroy(pl_gpu gpu, struct pcurve_state *pc)
+{
+    pl_buf_destroy(gpu, &pc->bins);
+    for (int i = 0; i < 2; i++) pl_tex_destroy(gpu, &pc->curve[i]);
+    *pc = (struct pcurve_state) {0};
+}
+
+static void pcurve_bind_bins(pl_shader sh, pl_buf buf, enum pl_desc_access access)
+{
+    static const struct pl_buffer_var vars[] = {
+#define PC_VAR(field) { \
+        .var = {.name = #field, .type = PL_VAR_UINT, .dim_v = 1, .dim_m = 1, \
+                .dim_a = PC_BINS * PC_SLICES}, \
+        .layout = {.offset = offsetof(struct pcurve_bins, field), \
+                   .size = sizeof(((struct pcurve_bins *) 0)->field), .stride = 4}, \
+    }
+        PC_VAR(pc_loss), PC_VAR(pc_count),
+#undef PC_VAR
+    };
+    sh_desc(sh, (struct pl_shader_desc) {
+        .desc = {.name = "PCurveBins", .type = PL_DESC_BUF_STORAGE, .access = access},
+        .binding.object = buf,
+        .buffer_vars = (struct pl_buffer_var *) vars,
+        .num_buffer_vars = PL_ARRAY_SIZE(vars),
+    });
+}
+
+// Keep these knot and derivative definitions identical to texture_curve.py.
+static void pcurve_geometry(pl_shader sh)
+{
+    GLSLH("float pc_k(int i) { return clamp(float(i-3),0.0,125.0)*(%f/125.0); }\n"
+          "float pc_a(int i) { return 3.0/(pc_k(i+4)-pc_k(i+1)); }\n"
+          "float pc_b(int i) { return 2.0/(pc_k(i+4)-pc_k(i+2)); }\n"
+          "vec2 pc_lr(int i) { float a=pc_a(i), b=pc_a(i+1); return vec2(a,b)/max(a,b); }\n"
+          // One basis coefficient at an interior histogram-bin center.
+          "float pc_basis(int i, float x) {\n"
+          " vec4 v; for(int j=0;j<4;j++) v[j]=(x>=pc_k(i+j)&&x<pc_k(i+j+1))?1.0:0.0;\n"
+          " for(int d=1;d<=3;d++) for(int j=0;j<4-d;j++) {\n"
+          "  float a=pc_k(i+j+d)-pc_k(i+j), b=pc_k(i+j+d+1)-pc_k(i+j+1);\n"
+          "  v[j]=(a>0.0?(x-pc_k(i+j))*v[j]/a:0.0)+(b>0.0?(pc_k(i+j+d+1)-x)*v[j+1]/b:0.0);\n"
+          " } return v[0]; }\n", PC_DOMAIN);
+}
+
+// All 128 threads participate in both barriers. Prefix max enforces exact
+// nonnegative derivatives before contraction toward safe constant loss.
+static void pcurve_guard_shader(pl_shader sh, const char *ceiling)
+{
+    GLSL("for(int step=1;step<128;step*=2) {\n"
+         " float v=pc_c[i]; if(i>=step) v=max(v,pc_c[i-step]);\n"
+         " barrier(); pc_c[i]=v; barrier();\n"
+         "}\n"
+         "float pc_guard=1.0;\n"
+         "if(i<127) pc_guard=min(pc_guard,0.09998/max(pc_a(i)*(pc_c[i+1]-pc_c[i]),1e-20));\n"
+         "if(i<126) { float d=pc_b(i)*(pc_a(i+1)*(pc_c[i+2]-pc_c[i+1])-pc_a(i)*(pc_c[i+1]-pc_c[i]));\n"
+         " pc_guard=min(pc_guard,0.1499/max(abs(d),1e-20)); }\n"
+         "pc_work[i]=pc_guard; barrier();\n"
+         "for(int step=64;step>0;step/=2) { if(i<step) pc_work[i]=min(pc_work[i],pc_work[i+step]); barrier(); }\n"
+         "float pc_gamma=clamp(pc_work[0],0.0,1.0);\n"
+         "pc_c[i]=clamp(%s+pc_gamma*(pc_c[i]-%s),pc_lower[i],%s); barrier();\n",
+         ceiling, ceiling, ceiling);
+}
+
+static pl_tex pcurve_fit(pl_gpu gpu, pl_dispatch dp, struct pcurve_state *pc,
+                         pl_tex measured, float target, uint64_t tag,
+                         double pts, bool pts_valid, uint64_t signature, bool cut)
+{
+    pl_shader sh = NULL;
+    if (!pc->bins) pc->bins = pl_buf_create(gpu, pl_buf_params(
+        .size = sizeof(struct pcurve_bins), .storable = true));
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 0,
+        PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_STORABLE);
+    if (!pc->bins || !fmt) goto error;
+    for (int i = 0; i < 2; i++) {
+        // pl_tex_recreate invalidates even an unchanged allocation. History
+        // must survive redraws and ping-pong frames (D3D11 DiscardResource).
+        if (!pc->curve[i]) pc->curve[i] = pl_tex_create(gpu, pl_tex_params(
+            .w = PC_COEFS, .h = 1, .format = fmt, .sampleable = true,
+            .renderable = true, .storable = true, .blit_src = true,
+            .host_readable = true));
+        if (!pc->curve[i]) goto error;
+    }
+
+    bool same = pc->valid && pc->tag == tag && pc->pts == pts;
+    bool reset = !pc->valid || !pts_valid || !isfinite(pts) ||
+        pc->signature != signature || (!same && (cut || pts <= pc->pts || pts-pc->pts > .5));
+    if (reset) {
+        pc->history = false;
+        pc->blend = 1.0f;
+    } else if (!same) {
+        pc->history = true;
+        pc->blend = -expm1f(-(pts-pc->pts)/.5);
+        pc->index ^= 1;
+    }
+
+    // Clear on the GPU: never wait for or overwrite an in-flight host buffer.
+    sh = pl_dispatch_begin(dp);
+    if (!sh_try_compute(sh, 128, 1, false, 0)) goto error;
+    pcurve_bind_bins(sh, pc->bins, PL_DESC_ACCESS_WRITEONLY);
+    sh_describe(sh, "P curve clear");
+    GLSL("uint i=gl_GlobalInvocationID.x; pc_loss[i]=0u; pc_count[i]=0u;\n");
+    if (!pl_dispatch_compute(dp, pl_dispatch_compute_params(
+        .shader = &sh, .dispatch_size = {PC_BINS*PC_SLICES/128, 1, 1}))) goto error;
+
+    sh = pl_dispatch_begin(dp);
+    if (!sh_try_compute(sh, 16, 16, false, 2*PC_BINS*sizeof(uint32_t))) goto error;
+    pcurve_bind_bins(sh, pc->bins, PL_DESC_ACCESS_READWRITE);
+    ident_t tex = sh_bind(sh, measured, PL_TEX_ADDRESS_CLAMP, PL_TEX_SAMPLE_NEAREST,
+                          "pc_measure", NULL, NULL, NULL);
+    sh_describe(sh, "P curve full-frame constraints");
+    GLSLH("shared uint pc_local_loss[512], pc_local_count[512];\n");
+    GLSL("uint i=gl_LocalInvocationIndex;\n"
+         "pc_local_loss[i]=0u; pc_local_loss[i+256u]=0u;\n"
+         "pc_local_count[i]=0u; pc_local_count[i+256u]=0u; barrier();\n"
+         "ivec2 size=textureSize("$",0);\n"
+         "ivec2 base=ivec2(gl_WorkGroupID.xy)*32+ivec2(gl_LocalInvocationID.xy)*2;\n"
+         "for(int y=0;y<2;y++) for(int x=0;x<2;x++) {\n"
+         " ivec2 p=base+ivec2(x,y); if(any(greaterThanEqual(p,size))) continue;\n"
+         " vec2 m=texelFetch("$",p,0).rg;\n"
+         " float pos=clamp(log2(max(m.g,1e-6)/1e-6),0.0,%f);\n"
+         " uint b=uint(clamp(floor(pos*(512.0/%f)),0.0,511.0));\n"
+         // Positive finite loss uses floatBitsToUint monotonic ordering. The
+         // small margin bounds measurement/evaluation floating point error.
+         " float loss=m.r>"$"?log2(max(m.r/"$",1.0))+0.00001:0.0;\n"
+         " if(isnan(loss)||isinf(loss)) loss=64.0;\n"
+         " atomicMax(pc_local_loss[b],floatBitsToUint(loss));\n"
+         " if(m.g>0.0) atomicAdd(pc_local_count[b],1u);\n"
+         "} barrier();\n"
+         "uint slice=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)%%16u;\n"
+         "for(uint b=i;b<512u;b+=256u) {\n"
+         " uint o=slice*512u+b;\n"
+         " if(pc_local_loss[b]!=0u) atomicMax(pc_loss[o],pc_local_loss[b]);\n"
+         " if(pc_local_count[b]!=0u) atomicAdd(pc_count[o],pc_local_count[b]);\n"
+         "}\n", tex, tex, PC_DOMAIN, PC_DOMAIN, SH_FLOAT_DYN(target), SH_FLOAT_DYN(target));
+    if (!pl_dispatch_compute(dp, pl_dispatch_compute_params(.shader = &sh,
+        .dispatch_size = {(measured->params.w+31)/32, (measured->params.h+31)/32, 1}))) goto error;
+
+    sh = pl_dispatch_begin(dp);
+    if (!sh_try_compute(sh, 128, 1, false, (1024+8*128)*sizeof(float))) goto error;
+    sh->output = PL_SHADER_SIG_COLOR;
+    pcurve_bind_bins(sh, pc->bins, PL_DESC_ACCESS_READONLY);
+    ident_t previous = sh_bind(sh, pc->curve[pc->index^1], PL_TEX_ADDRESS_CLAMP,
+        PL_TEX_SAMPLE_NEAREST, "pc_previous", NULL, NULL, NULL);
+    sh_describe(sh, "P curve contrast-protected fit");
+    pcurve_geometry(sh);
+    GLSLH("shared float pc_hist[512], pc_counts[512];\n"
+          "shared float pc_c[128], pc_bar[128], pc_lower[128], pc_weight[128];\n"
+          "shared float pc_y1[128], pc_y2[128], pc_work[128], pc_prev[128];\n");
+    GLSL("int i=int(gl_LocalInvocationID.x);\n"
+         "for(int b=i;b<512;b+=128) { uint loss=0u,count=0u;\n"
+         " for(int s=0;s<16;s++) { loss=max(loss,pc_loss[s*512+b]); count+=pc_count[s*512+b]; }\n"
+         " pc_hist[b]=uintBitsToFloat(loss); pc_counts[b]=float(count); } barrier();\n"
+         "float total=0.0; for(int b=0;b<512;b++) total+=pc_counts[b];\n"
+         "float lower=0.0,weight=0.0;\n"
+         "int lo=clamp(int(floor(pc_k(i)*512.0/%f)),0,511);\n"
+         "int hi=clamp(int(floor(pc_k(i+4)*512.0/%f)),0,511);\n"
+         "for(int b=max(lo-1,0);b<=min(hi+1,511);b++) {\n"
+         " lower=max(lower,pc_hist[b]);\n"
+         " float x=(float(b)+.5)*(%f/512.0);\n"
+         " weight+=(.9*pc_counts[b]/max(total,1.0)+.1/512.0)*pc_basis(i,x); }\n"
+         "pc_lower[i]=lower; pc_weight[i]=weight; pc_work[i]=lower;\n"
+         "pc_c[i]=lower; pc_bar[i]=lower; pc_y1[i]=0.0; pc_y2[i]=0.0; barrier();\n"
+         "for(int step=64;step>0;step/=2) { if(i<step) pc_work[i]=max(pc_work[i],pc_work[i+step]); barrier(); }\n"
+         "float ceiling=pc_work[0]; barrier();\n"
+         // This fixed-work fit approximates the LP objective. Feasibility is
+         // enforced independently below, including on poorly converged fits.
+         "if(ceiling>0.0) for(int it=0;it<4096;it++) {\n"
+         " if(i<127) { float z=pc_y1[i]+.2*(pc_bar[i+1]-pc_bar[i]);\n"
+         "  pc_y1[i]=z-clamp(z,0.0,.2*.1/pc_a(i)); }\n"
+         " if(i<126) { vec2 lr=pc_lr(i); float z=pc_y2[i]+.2*(lr.x*pc_bar[i]-(lr.x+lr.y)*pc_bar[i+1]+lr.y*pc_bar[i+2]);\n"
+         "  float bound=.2*.15/(pc_b(i)*max(pc_a(i),pc_a(i+1))); pc_y2[i]=z-clamp(z,-bound,bound); } barrier();\n"
+         " float g=pc_weight[i]; if(i<127) g-=pc_y1[i]; if(i>0) g+=pc_y1[i-1];\n"
+         " if(i<126) g+=pc_lr(i).x*pc_y2[i];\n"
+         " if(i>0&&i<127) { vec2 lr=pc_lr(i-1); g-=(lr.x+lr.y)*pc_y2[i-1]; }\n"
+         " if(i>1) g+=pc_lr(i-2).y*pc_y2[i-2];\n"
+         " float next=clamp(pc_c[i]-.2*g,pc_lower[i],ceiling);\n"
+         " pc_bar[i]=2.0*next-pc_c[i]; pc_c[i]=next; barrier();\n"
+         "}\n", PC_DOMAIN, PC_DOMAIN, PC_DOMAIN);
+    pcurve_guard_shader(sh, "ceiling");
+    GLSL("float fitted=pc_c[i]; float fitted_gamma=pc_gamma;\n"
+         "if("$"!=0) {\n"
+         " pc_prev[i]=texelFetch("$",ivec2(i,0),0).r;\n"
+         " pc_work[i]=max(pc_prev[i],ceiling); barrier();\n"
+         " for(int step=64;step>0;step/=2) { if(i<step) pc_work[i]=max(pc_work[i],pc_work[i+step]); barrier(); }\n"
+         " float retained_ceiling=pc_work[0];\n"
+         " pc_c[i]=clamp(pc_prev[i],pc_lower[i],retained_ceiling); barrier();\n",
+         SH_INT_DYN(pc->history), previous);
+    pcurve_guard_shader(sh, "retained_ceiling");
+    GLSL(" fitted=mix(pc_c[i],fitted,"$"); }\n"
+         "vec4 color=vec4(fitted,pc_lower[i],pc_weight[i],fitted_gamma);\n", SH_FLOAT_DYN(pc->blend));
+    if (!pl_dispatch_finish(dp, pl_dispatch_params(.shader = &sh, .target = pc->curve[pc->index]))) goto error;
+    pc->valid = true;
+    pc->signature = signature;
+    pc->tag = tag;
+    pc->pts = pts;
+    return pc->curve[pc->index];
+error:
+    if (sh) pl_dispatch_abort(dp, &sh);
+    pc->valid = false;
+    PL_ERR(gpu, "Constrained P curve unavailable; retaining ordinary output clipping");
+    return NULL;
+}
+#endif
diff --git a/src/renderer.c b/src/renderer.c
index 4099f2a..635b09a 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -25,6 +25,7 @@
 #include "tests/causal_test.h"
 
 #include <libplacebo/renderer.h>
+#include "pcurve.h"
 
 struct cached_frame {
     uint64_t signature;
@@ -71,6 +72,7 @@ struct pl_renderer_t {
 
     // Shader resource objects and intermediate textures (FBOs)
     pl_shader_obj tone_map_state;
+    struct pcurve_state p_curve_state;
     // Forced HLG measurements must not become color-map metadata. Keeping
     // them separate preserves reference HLG rendering while exposing stats.
     pl_shader_obj hlg_measure_state;
@@ -177,6 +179,7 @@ void pl_renderer_destroy(pl_renderer *p_rr)
     pl_tex_destroy(rr->gpu, &rr->causal_linear_tex);
     pl_tex_destroy(rr->gpu, &rr->causal_proxy_tex);
     pl_tex_destroy(rr->gpu, &rr->hlg_measure_tex);
+    pcurve_destroy(rr->gpu, &rr->p_curve_state);
 
     // Free all shader resource objects
     // The live peak transaction may hold a weak causal sink until its single
@@ -223,6 +226,7 @@ void pl_renderer_load(pl_renderer rr, const uint8_t *cache)
 
 void pl_renderer_flush_cache(pl_renderer rr)
 {
+    rr->p_curve_state.valid = false;
     for (int i = 0; i < rr->frames.num; i++)
         pl_tex_destroy(rr->gpu, &rr->frames.elem[i].tex);
     rr->frames.num = 0;
@@ -2960,16 +2964,20 @@ static pl_tex measure_rgb_ray_peak(struct pass_state *pass,
     const struct pl_color_map_params *cp = pass->params->color_map_params;
     pl_renderer rr = pass->rr;
     float peak, avg;
-    if (!cp || !cp->auto_pq_second_pass || !cp->hard_clip_hdr_target ||
+    if (!cp || (!cp->auto_pq_second_pass && !cp->p_constrained_curve) || !cp->hard_clip_hdr_target ||
         cp->inverse_tone_mapping ||
         cp->tone_mapping_metric != PL_TONE_MAP_METRIC_BT2020_RGB ||
         !pl_color_transfer_is_hdr(pass->image.color.transfer) ||
         !pl_color_transfer_is_hdr(pass->target.color.transfer) ||
         !pl_get_detected_tone_map_range(rr->tone_map_state, cp->tone_mapping_metric,
-                                       &peak, &avg))
+                                       &peak, &avg)) {
+        rr->p_curve_state.valid = false;
         return NULL;
+    }
 
-    pl_fmt fmt = pl_find_fmt(rr->gpu, PL_FMT_FLOAT, 1, 32, 0,
+    const bool p_curve = cp->p_constrained_curve;
+    if (!p_curve) rr->p_curve_state.valid = false;
+    pl_fmt fmt = pl_find_fmt(rr->gpu, PL_FMT_FLOAT, p_curve ? 2 : 1, 32, 0,
                              PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
     if (!fmt) {
         PL_ERR(rr, "Auto PQ second pass requires a float32 reduction target");
@@ -2978,19 +2986,39 @@ static pl_tex measure_rgb_ray_peak(struct pass_state *pass,
     pl_tex src = img_tex(pass, &pass->img);
     if (!src)
         return NULL;
-    pl_tex prev = get_fbo(pass, src->params.w, src->params.h, fmt, 1, PL_DEBUG_TAG);
+    pl_tex prev = get_fbo(pass, src->params.w, src->params.h, fmt, p_curve ? 2 : 1, PL_DEBUG_TAG);
     if (!prev)
         return NULL;
     pl_shader sh = pl_dispatch_begin(rr->dp);
     pl_shader_sample_direct(sh, pl_sample_src(.tex = src));
-    sh_describe(sh, "auto PQ first-stage maxRGB");
+    sh_describe(sh, p_curve ? "P curve first-stage P/maxRGB" : "auto PQ first-stage maxRGB");
     pl_shader_color_map_ex(sh, cp, pl_color_map_args(
         .src = pass->image.color, .dst = dst, .prelinearized = linear,
         .state = &rr->tone_map_state, .measure_rgb_ray = true,
+        .measure_p_curve = p_curve,
         .feature_map = feature_map));
     if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(.shader = &sh, .target = prev)))
         goto error;
 
+    if (p_curve) {
+        // User edits/target/crop changes reset history immediately, including
+        // while paused. Source mastering metadata changes are not user edits.
+        uint64_t signature = pl_mem_hash(cp, sizeof(*cp));
+        pl_hash_merge(&signature, pl_var_hash(dst.primaries));
+        pl_hash_merge(&signature, pl_var_hash(dst.transfer));
+        pl_hash_merge(&signature, pl_var_hash(dst.hdr.max_luma));
+        pl_hash_merge(&signature, pl_var_hash(dst.hdr.min_luma));
+        pl_hash_merge(&signature, pl_var_hash(dst.hdr.prim));
+        pl_hash_merge(&signature, pl_mem_hash(&pass->img.rect, sizeof(pass->img.rect)));
+        pl_hash_merge(&signature, pl_var_hash(pass->image.color.primaries));
+        pl_hash_merge(&signature, pl_var_hash(pass->image.color.transfer));
+        pl_hash_merge(&signature, ((uint64_t) src->params.w << 32) | src->params.h);
+        return pcurve_fit(rr->gpu, rr->dp, &rr->p_curve_state, prev,
+            dst.hdr.max_luma / PL_COLOR_SDR_WHITE, pass->image.causal_scene_tag,
+            pass->image.p_curve_pts, pass->image.p_curve_pts_valid, signature,
+            pass->image.scene_cut);
+    }
+
     while (prev->params.w > 1 || prev->params.h > 1) {
         int w = (prev->params.w + 7) / 8, h = (prev->params.h + 7) / 8;
         pl_tex next = get_fbo(pass, w, h, fmt, 1, PL_DEBUG_TAG);
@@ -3135,7 +3163,8 @@ static void pass_convert_colors(struct pass_state *pass)
             .prelinearized = prelinearized,
             .state         = &rr->tone_map_state,
             .feature_map   = feature_map,
-            .rgb_ray_peak  = ray_peak,
+            .rgb_ray_peak  = params->color_map_params && params->color_map_params->p_constrained_curve ? NULL : ray_peak,
+            .p_curve       = params->color_map_params && params->color_map_params->p_constrained_curve ? ray_peak : NULL,
