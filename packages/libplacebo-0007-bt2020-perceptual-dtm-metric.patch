@@ -1415,6 +1424,58 @@ static inline float iir_coeff(float rate)
     return 1.0f - expf(-1.0f / rate);
 }
 
+// Smooth, homogeneous approximation of the selected literal p=1 BT.2020
+// perceptual coordinate. The fitted degree-seven triangular Bernstein surface
+// is symmetric in red/green and exact at RGBCMYW. On the simplex it is
+// evaluated as four Horner polynomials in blue fraction and R*G, avoiding the
+// max-channel branches and derivative ridges of the literal test model.
+static ident_t emit_bt2020_metric(pl_shader sh, enum pl_color_primaries prim)
+{
+    const struct pl_raw_primaries *src = pl_raw_primaries_get(prim);
+    const struct pl_raw_primaries *bt2020 =
+        pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    const pl_matrix3x3 rgb2bt2020 = pl_get_color_mapping_matrix(
+        src, bt2020, PL_INTENT_RELATIVE_COLORIMETRIC);
+    ident_t metric = sh_fresh(sh, "bt2020_perceptual_metric");
+    GLSLH("float "$"(vec3 rgb) {                                      \n"
+          " vec3 c = max("$" * rgb, vec3(0.0));                       \n"
+          " float total = c.r + c.g + c.b;                               \n"
+          " if (total <= 1e-12) return 0.0;                              \n"
+          " vec3 n = c / total;                                          \n"
+          " float w = n.b;                                               \n"
+          " float p = n.r * n.g;                                         \n"
+          " float q0 = (((((((14.5330356895*w - 25.5682414785)*w         \n"
+          "     - 13.7465695335)*w + 56.3828756991)*w - 42.760790975)*w  \n"
+          "     + 13.1725257153)*w - 2.51283511691)*w + 1.0);            \n"
+          " float q1 = (((((-31.3753030053*w - 16.6730639549)*w          \n"
+          "     + 125.654298402)*w - 103.378434394)*w                    \n"
+          "     + 22.7623461176)*w - 1.53706708322);                     \n"
+          " float q2 = (((140.435403979*w + 97.2794791377)*w             \n"
+          "     - 114.074511803)*w + 7.67118553227);                     \n"
+          " float q3 = 73.1408564899*w - 38.0916687975;                  \n"
+          " float perceptual = total * (((q3*p + q2)*p + q1)*p + q0);   \n"
+          " float pq = pow(clamp(perceptual * (203.0/10000.0),           \n"
+          "                      0.0, 1.0), .1593017578125);              \n"
+          " pq = (.8359375 + 18.8515625*pq) / (1.0 + 18.6875*pq);       \n"
+          " return pow(pq, 78.84375);                                    \n"
+          "}                                                             \n",
+          metric, SH_MAT3(rgb2bt2020));
+    return metric;
+}
+
+static ident_t emit_maxrgb_metric(pl_shader sh)
+{
+    ident_t metric = sh_fresh(sh, "maxrgb_tone_metric");
+    GLSLH("float "$"(vec3 c) {                                      \n"
+          " float p = max(max(c.r, c.g), c.b) * (203.0/10000.0);    \n"
+          " p = pow(clamp(p, 0.0, 1.0), .1593017578125);            \n"
+          " p = (.8359375 + 18.8515625*p) / (1.0 + 18.6875*p);     \n"
+          " return pow(p, 78.84375);                                \n"
+          "}                                                        \n",
+          metric);
+    return metric;
+}
