From 6d588329b095600d6d32067e90a123d2f01007dd Mon Sep 17 00:00:00 2001
From: HT_Player <noreply@example.com>
Date: Wed, 29 Jul 2026 12:41:45 -0400
Subject: [PATCH] video: expose Dolby Vision enhancement layer type

Profile 7 Dolby Vision streams carry either a minimum enhancement layer
(MEL), which has no residual picture data, or a full enhancement layer (FEL).
FFmpeg already hands mpv the parsed RPU, but mpv exposes neither form.

Add video-params/dolby-vision-el-type, reporting "mel" or "fel". Derive the
type from the RPU's NLQ method, but retain it only when container metadata
establishes that an enhancement layer exists. NLQ alone is insufficient:
single-layer profiles 5 and 8 also omit NLQ and must leave the property
unavailable rather than being misreported as MEL.

Handle both Dolby Vision layouts:

- For a single-track interleaved BL+EL stream, use the configuration record's
  bl_present_flag && el_present_flag.
- For a dual-track group, mark the EL-only member, preserve its classification
  through decoding, and copy it onto the paired BL frame. Also mirror the EL
  stream's DV profile and level onto the visible BL track.
- Because pairing occurs after the output chain captures its input parameters,
  let video-params use the current output-frame classification as a fallback.

Keep the field out of mp_image_params_equal() and propagate it through
mp_image_params_update_dynamic(), since RPU data is frame-dynamic and must not
trigger VO reconfiguration.
---
 DOCS/interface-changes/dovi-el-type.txt |  1 +
 DOCS/man/input.rst                      | 11 +++++++++++
 demux/demux_lavf.c                      | 11 +++++++++++
 demux/stheader.h                        |  1 +
 filters/f_enhancement_pair.c            |  8 +++++++-
 player/command.c                        | 13 ++++++++++++-
 video/decode/vd_lavc.c                  |  7 +++++++
 video/mp_image.c                        | 20 ++++++++++++++++++++
 video/mp_image.h                        | 16 ++++++++++++++++
 9 files changed, 86 insertions(+), 2 deletions(-)
 create mode 100644 DOCS/interface-changes/dovi-el-type.txt

diff --git a/DOCS/interface-changes/dovi-el-type.txt b/DOCS/interface-changes/dovi-el-type.txt
new file mode 100644
index 0000000..bd0621e
--- /dev/null
+++ b/DOCS/interface-changes/dovi-el-type.txt
@@ -0,0 +1 @@
+add `video-params/dolby-vision-el-type` sub-property (`fel` or `mel`)
diff --git a/DOCS/man/input.rst b/DOCS/man/input.rst
index 4741e55..5d3b9e4 100644
--- a/DOCS/man/input.rst
+++ b/DOCS/man/input.rst
@@ -2903,6 +2903,16 @@ Property list
     ``video-params/avg-pq-y``
         Average PQ luminance of a frame, as reported by peak detection (in PQ, 0-1)
 
+    ``video-params/dolby-vision-el-type``
+        Dolby Vision enhancement layer type of the current frame, as signalled
+        by the RPU. Either ``fel`` (full enhancement layer: carries residual
+        picture data, so discarding it visibly changes the image) or ``mel``
+        (minimum enhancement layer: metadata path only, discarding it is
+        visually lossless). Unavailable when the stream carries no enhancement
+        layer. Both interleaved and separate-track enhancement layers are
+        supported. The container establishes that an enhancement layer exists;
+        only the RPU distinguishes MEL from FEL.
+
     ``video-params/prim-red-x``, ``video-params/prim-red-y``
         Red primary chromaticity coordinates, available only if differs from ``video-params/primaries``
 
@@ -2951,6 +2961,7 @@ Property list
             "scene-max-b"       MPV_FORMAT_DOUBLE
             "max-pq-y"          MPV_FORMAT_DOUBLE
             "avg-pq-y"          MPV_FORMAT_DOUBLE
+            "dolby-vision-el-type" MPV_FORMAT_STRING
             "prim-red-x"        MPV_FORMAT_DOUBLE
             "prim-red-y"        MPV_FORMAT_DOUBLE
             "prim-green-x"      MPV_FORMAT_DOUBLE
diff --git a/demux/demux_lavf.c b/demux/demux_lavf.c
index 4d91983..6b09b4d 100644
--- a/demux/demux_lavf.c
+++ b/demux/demux_lavf.c
@@ -785,6 +785,7 @@ static void handle_new_stream(demuxer_t *demuxer, int i)
             sh->codec->dv_profile = cfg->dv_profile;
             sh->codec->dv_level = cfg->dv_level;
             sh->codec->dv_el_present = cfg->bl_present_flag && cfg->el_present_flag;
+            sh->codec->dv_el_only = !cfg->bl_present_flag && cfg->el_present_flag;
         }
 
         // AVI uses decode-order indices as DTS and needs the compensation.
@@ -1317,6 +1318,16 @@ static void handle_layered_video_group(demuxer_t *demuxer, AVStreamGroup *stg)
     if (!el_sh || !bl_sh)
         return;
 
+    // The group itself is authoritative even if a container omitted the
+    // per-stream DV configuration record. Keep the EL classification alive
+    // through its decoder, and expose the DV identity on the visible BL track.
+    el_sh->codec->dv_el_only = true;
+    if (!bl_sh->codec->dovi && el_sh->codec->dovi) {
+        bl_sh->codec->dovi = true;
+        bl_sh->codec->dv_profile = el_sh->codec->dv_profile;
+        bl_sh->codec->dv_level = el_sh->codec->dv_level;
+    }
+
     // Group storage is attached to the BL so its lifetime tracks the demuxer.
     struct sh_stream_group *group = talloc_zero(bl_sh, struct sh_stream_group);
     MP_TARRAY_APPEND(group, group->members, group->num_members, bl_sh);
diff --git a/demux/stheader.h b/demux/stheader.h
index 0175474..972c994 100644
--- a/demux/stheader.h
+++ b/demux/stheader.h
@@ -176,6 +176,7 @@ struct mp_codec_params {
     uint8_t dv_profile;
     uint8_t dv_level;
     bool dv_el_present;     // BL and EL interleaved in this stream (Profile 7)
+    bool dv_el_only;        // stream is the EL-only member of a DV pair
 
     // STREAM_VIDEO + STREAM_AUDIO
     int bits_per_coded_sample;
diff --git a/filters/f_enhancement_pair.c b/filters/f_enhancement_pair.c
index 18cea54..16a4966 100644
--- a/filters/f_enhancement_pair.c
+++ b/filters/f_enhancement_pair.c
@@ -99,7 +99,13 @@ static struct mp_image *take_head(struct mp_image ***queue, int *num)
 // mirror them onto the BL here. This keeps DV bookkeeping local.
 static void inherit_dovi_from_el(struct mp_image *bl, struct mp_image *el)
 {
-    if (bl->params.no_dovi || bl->dovi || !el->dovi)
+    if (bl->params.no_dovi)
+        return;
+    if (el->params.dovi_el_type != MP_DOVI_EL_NONE)
+        bl->params.dovi_el_type = el->params.dovi_el_type;
+    if (!el->dovi)
+        return;
+    if (bl->dovi)
         return;
     bl->dovi = av_buffer_ref(el->dovi);
     if (!bl->dovi)
diff --git a/player/command.c b/player/command.c
index a0dccf4..5df0837 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2570,6 +2570,9 @@ static int property_imgparams(const struct mp_image_params *p, int action, void
         {"scene-avg",   SUB_PROP_FLOAT(hdr->scene_avg),    .unavailable = !has_hdr10plus},
         {"max-pq-y",    SUB_PROP_FLOAT(hdr->max_pq_y),     .unavailable = !has_cie_y},
         {"avg-pq-y",    SUB_PROP_FLOAT(hdr->avg_pq_y),     .unavailable = !has_cie_y},
+        {"dolby-vision-el-type",
+            SUB_PROP_STR(p->dovi_el_type == MP_DOVI_EL_FEL ? "fel" : "mel"),
+            .unavailable = p->dovi_el_type == MP_DOVI_EL_NONE},
         {"prim-red-x",   SUB_PROP_FLOAT(hdr->prim.red.x),  .unavailable = !custom_prim },
         {"prim-red-y",   SUB_PROP_FLOAT(hdr->prim.red.y),  .unavailable = !custom_prim },
         {"prim-green-x", SUB_PROP_FLOAT(hdr->prim.green.x),.unavailable = !custom_prim },
@@ -2685,7 +2688,15 @@ static int mp_property_vd_imgparams(void *ctx, struct m_property *prop,
     struct mp_codec_params *c =
         track && track->stream ? track->stream->codec : NULL;
     if (vo_c->filter->input_params.imgfmt) {
-        return property_imgparams(&vo_c->filter->input_params, action, arg);
+        struct mp_image_params p = vo_c->filter->input_params;
+        // Enhancement pairing happens inside the output chain, after its
+        // input parameters are captured. Mirror the current output-frame
+        // classification so video-params exposes DT-DL just like ST-DL.
+        if (p.dovi_el_type == MP_DOVI_EL_NONE && mpctx->video_out) {
+            struct mp_image_params out = vo_get_current_params(mpctx->video_out);
+            p.dovi_el_type = out.dovi_el_type;
+        }
+        return property_imgparams(&p, action, arg);
     } else if (c && c->disp_w && c->disp_h) {
         // Simplistic fallback for stupid scripts querying "width"/"height"
         // before the first frame is decoded.
diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
index ae199c6..87a04c2 100644
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -1314,6 +1314,13 @@ static int decode_frame(struct mp_filter *vd)
         return ret;
     }
 
+    // NLQ alone cannot distinguish MEL from a single-layer profile: neither
+    // carries a residual. Retain the RPU-derived type only when the container
+    // says this stream interleaves BL+EL, or this is the EL-only member of a
+    // dual-track group. The latter is copied to the BL by f_enhancement_pair.
+    if (!ctx->codec->dv_el_present && !ctx->codec->dv_el_only)
+        mpi->params.dovi_el_type = MP_DOVI_EL_NONE;
+
     if (mpi->imgfmt == IMGFMT_CUDA && !mpi->planes[0]) {
         MP_ERR(vd, "CUDA frame without data. This is a FFmpeg bug.\n");
         talloc_free(mpi);
diff --git a/video/mp_image.c b/video/mp_image.c
index 1ce0555..b2c03f4 100644
--- a/video/mp_image.c
+++ b/video/mp_image.c
@@ -900,6 +900,10 @@ void mp_image_params_update_dynamic(struct mp_image_params *dst,
                                     bool has_peak_detect_values)
 {
     dst->repr.dovi = src->repr.dovi;
+    // EL type is per-frame RPU metadata, so it travels with the dynamic
+    // update rather than the static params; without this the property would
+    // keep reporting the value from the first frame of the stream.
+    dst->dovi_el_type = src->dovi_el_type;
     // Don't overwrite peak-detected HDR metadata if available.
     float max_pq_y = dst->color.hdr.max_pq_y;
     float avg_pq_y = dst->color.hdr.avg_pq_y;
@@ -1185,6 +1189,22 @@ struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
     if (sd) {
 #ifdef PL_HAVE_LAV_DOLBY_VISION
         const AVDOVIMetadata *metadata = (const AVDOVIMetadata *)sd->buf->data;
+        // FEL vs MEL: the RPU's NLQ signalling is the only thing that
+        // distinguishes them. A MEL EL omits the non-linear quantizer
+        // entirely (AV_DOVI_NLQ_NONE) because it carries no residual;
+        // anything else means residual picture data is present, i.e. FEL.
+        // Read unconditionally -- it is independent of whether libplacebo
+        // ends up mapping the metadata below.
+        {
+            // nlq_method_idc lives on AVDOVIDataMapping, NOT on
+            // AVDOVIRpuDataHeader -- av_dovi_get_header() returns the wrong
+            // struct for it. Both accessors are always-inline pointer offsets
+            // that cannot return NULL, so no guard is needed.
+            const AVDOVIDataMapping *mapping = av_dovi_get_mapping(metadata);
+            dst->params.dovi_el_type =
+                mapping->nlq_method_idc == AV_DOVI_NLQ_NONE ? MP_DOVI_EL_MEL
+                                                            : MP_DOVI_EL_FEL;
+        }
 #if PL_API_VER < 364
         const AVDOVIRpuDataHeader *header = av_dovi_get_header(metadata);
         if (header->disable_residual_flag)
diff --git a/video/mp_image.h b/video/mp_image.h
index f5c1562..daf843e 100644
--- a/video/mp_image.h
+++ b/video/mp_image.h
@@ -38,6 +38,18 @@
 #define MP_IMGFIELD_REPEAT_FIRST 0x04
 #define MP_IMGFIELD_INTERLACED 0x20
 
+// Dolby Vision enhancement-layer type, as signalled by the RPU of the current
+// frame. A profile 7 stream carries an EL next to the HDR10 base layer: a MEL
+// ("minimum") EL carries only the metadata path, so dropping it costs nothing
+// visually, while a FEL ("full") EL carries real residual picture data. The
+// two cannot be told apart from the container-level configuration record --
+// el_present_flag is set for both -- only from the RPU's NLQ signalling.
+enum mp_dovi_el_type {
+    MP_DOVI_EL_NONE = 0,        // no EL, or not a Dolby Vision stream
+    MP_DOVI_EL_MEL,             // EL present, no residual (NLQ absent)
+    MP_DOVI_EL_FEL,             // EL present, carries residual picture data
+};
+
 // Describes image parameters that usually stay constant.
 // New fields can be added in the future. Code changing the parameters should
 // usually copy the whole struct, so that fields added later will be preserved.
@@ -63,6 +75,10 @@ struct mp_image_params {
     int rotate;
     enum mp_stereo3d_mode stereo3d; // image is encoded with this mode
     struct mp_rect crop;        // crop applied on image
+    // Dolby Vision EL type of the current frame. Dynamic per-frame metadata
+    // like color.hdr, so it is deliberately NOT part of
+    // mp_image_params_equal() -- it must not trigger a VO reconfigure.
+    enum mp_dovi_el_type dovi_el_type;
     // Flags for f_enhancement_pair.c to not inherit flags from EL.
     bool no_dovi;
     bool no_enhancement_layer;
