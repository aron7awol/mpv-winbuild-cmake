index c2f30dabe..135759d54 100644
--- a/video/out/w32_common.h
+++ b/video/out/w32_common.h
@@ -23,12 +23,16 @@
 #include <windows.h>
 
 #include "common/common.h"
+#include "w32_resize.h"
 
 struct vo;
 
 bool vo_w32_init(struct vo *vo);
 void vo_w32_uninit(struct vo *vo);
 int vo_w32_control(struct vo *vo, int *events, int request, void *arg);
+int vo_w32_control_resize(struct vo *vo, int *events, int request, void *arg,
+                          unsigned *reasons);
+void vo_w32_track_resize_reasons(struct vo *vo);
 void vo_w32_config(struct vo *vo);
 HWND vo_w32_hwnd(struct vo *vo);
 void vo_w32_swapchain(struct vo *vo, void *swapchain);
diff --git a/video/out/w32_resize.h b/video/out/w32_resize.h
new file mode 100644
index 000000000..b0ca76cca
--- /dev/null
+++ b/video/out/w32_resize.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Coalesced Win32 resize reasons and conservative, platform-free skip policy.
+#pragma once
+#include <stdbool.h>
+
+enum w32_resize_reason {
+    W32_R_SETTING = 1 << 0, W32_R_SIZE = 1 << 1, W32_R_LAYOUT = 1 << 2,
+    W32_R_DISPLAY = 1 << 3, W32_R_DPI = 1 << 4, W32_R_MOVE = 1 << 5,
+    W32_R_FULLSCREEN = 1 << 6, W32_R_CONFIG = 1 << 7,
+    W32_R_OPTIONS = 1 << 8, W32_R_OTHER = 1 << 9,
+};
+
+static inline bool resize_guard_can_skip(bool enabled, bool forced,
+    unsigned reasons, bool query_ok, bool state_equal, bool healthy)
+{
+    const unsigned benign = W32_R_SETTING | W32_R_SIZE | W32_R_LAYOUT;
+    return enabled && !forced && (reasons & (W32_R_SETTING | W32_R_SIZE)) &&
+           !(reasons & ~benign) && query_ok && state_equal && healthy;
+}
