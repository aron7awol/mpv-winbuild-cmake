From: mpv-ht developers <dev@mpv-ht.local>
Date: Sat, 5 Sep 2026 12:00:00 -0400
Subject: [PATCH] renderer: measure and compress post-Perceptual RGB-ray peak

diff --git a/src/renderer.c b/src/renderer.c
index 50bf796..f6f749b 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -2933,6 +2933,75 @@ error:
     return NULL;
 }
 
+// Exact same-frame reduction. Never infer post-map peak from unrelated
+// source maxima and never use filtered/downsampled samples that miss highlights.
+static pl_tex measure_rgb_ray_peak(struct pass_state *pass,
+                                  struct pl_color_space dst, bool linear)
+{
+    const struct pl_color_map_params *cp = pass->params->color_map_params;
+    pl_renderer rr = pass->rr;
+    float peak, avg;
+    if (!cp || !cp->auto_pq_second_pass || !cp->hard_clip_hdr_target ||
+        cp->inverse_tone_mapping ||
+        cp->tone_mapping_metric != PL_TONE_MAP_METRIC_BT2020_RGB ||
+        !pl_color_transfer_is_hdr(pass->image.color.transfer) ||
+        !pl_color_transfer_is_hdr(pass->target.color.transfer) ||
+        !pl_get_detected_tone_map_range(rr->tone_map_state, cp->tone_mapping_metric,
+                                       &peak, &avg))
+        return NULL;
+
+    pl_fmt fmt = pl_find_fmt(rr->gpu, PL_FMT_FLOAT, 1, 32, 0,
+                             PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+    if (!fmt) {
+        PL_ERR(rr, "Auto PQ second pass requires a float32 reduction target");
+        return NULL;
+    }
+    pl_tex src = img_tex(pass, &pass->img);
+    if (!src)
+        return NULL;
+    pl_tex prev = get_fbo(pass, src->params.w, src->params.h, fmt, 1, PL_DEBUG_TAG);
+    if (!prev)
+        return NULL;
+    pl_shader sh = pl_dispatch_begin(rr->dp);
+    pl_shader_sample_direct(sh, pl_sample_src(.tex = src));
+    sh_describe(sh, "auto PQ first-stage maxRGB");
+    pl_shader_color_map_ex(sh, cp, pl_color_map_args(
+        .src = pass->image.color, .dst = dst, .prelinearized = linear,
+        .state = &rr->tone_map_state, .measure_rgb_ray = true));
+    if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(.shader = &sh, .target = prev)))
+        goto error;
+
+    while (prev->params.w > 1 || prev->params.h > 1) {
+        int w = (prev->params.w + 7) / 8, h = (prev->params.h + 7) / 8;
+        pl_tex next = get_fbo(pass, w, h, fmt, 1, PL_DEBUG_TAG);
+        if (!next)
+            goto error;
+        sh = pl_dispatch_begin(rr->dp);
+        sh->output = PL_SHADER_SIG_COLOR;
+        sh_describe(sh, "auto PQ maxRGB reduction");
+        ident_t tex = sh_bind(sh, prev, PL_TEX_ADDRESS_CLAMP,
+                             PL_TEX_SAMPLE_NEAREST, "ray_reduce", NULL, NULL, NULL);
+        GLSLF("vec4 color = vec4(0.0); \n"
+              "ivec2 base = ivec2(gl_FragCoord.xy) * 8; \n"
+              "ivec2 size = textureSize("$", 0); \n"
+              "for (int y = 0; y < 8; y++) { \n"
+              "  for (int x = 0; x < 8; x++) { \n"
+              "    ivec2 p = base + ivec2(x,y); \n"
+              "    if (all(lessThan(p, size))) \n"
+              "      color.r = max(color.r, texelFetch("$", p, 0).r); \n"
+              "  } \n"
+              "} \n", tex, tex);
+        if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(.shader = &sh, .target = next)))
+            goto error;
+        prev = next;
+    }
+    return prev;
+error:
+    pl_dispatch_abort(rr->dp, &sh);
+    PL_ERR(rr, "Auto PQ second-pass measurement failed; retaining ordinary output clipping");
+    return NULL;
+}
+
 // Transforms image into the output color space (tone-mapping, ICC 3DLUT, etc)
 static void pass_convert_colors(struct pass_state *pass)
 {
@@ -3036,7 +3105,8 @@ static void pass_convert_colors(struct pass_state *pass)
 
         // generate HDR feature map if required
         pl_tex feature_map = get_feature_map(pass);
-        sh = img_sh(pass, img); // `get_feature_map` dispatches previous shader
+        pl_tex ray_peak = measure_rgb_ray_peak(pass, target_csp, prelinearized);
+        sh = img_sh(pass, img); // Feature/peak extraction may dispatch the input.
 
         // current -> target
         pl_shader_color_map_ex(sh, params->color_map_params, pl_color_map_args(
@@ -3045,6 +3115,7 @@ static void pass_convert_colors(struct pass_state *pass)
             .prelinearized = prelinearized,
             .state         = &rr->tone_map_state,
             .feature_map   = feature_map,
+            .rgb_ray_peak  = ray_peak,
         ));
 
         if (target->icc)
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 7ca998a..bd2e062 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -2832,7 +2832,8 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
     const bool ambient_requested = isfinite(params->ambient_gamma) &&
         params->ambient_gamma > 0.0f &&
         fabsf(params->ambient_gamma - 1.0f) > 1e-6f;
-    if (pl_color_space_equal(&src, &dst) && !ambient_requested) {
+    if (pl_color_space_equal(&src, &dst) && !ambient_requested &&
+        !args->measure_rgb_ray && !args->rgb_ray_peak) {
 #ifdef PL_BLACK_LEVEL_DIAGNOSTICS
         blkdiag_identity(sh, obj, &src, &dst);
 #endif
@@ -3024,7 +3025,8 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
     const bool base_need_tone_map = !pl_tone_map_params_noop(&tone);
     const bool inverse_expansion = params->inverse_tone_mapping &&
         tone.output_max > tone.input_max + 1e-6f;
-    bool need_tone_map = base_need_tone_map || ambient_active;
+    bool need_tone_map = base_need_tone_map || ambient_active ||
+        args->measure_rgb_ray || args->rgb_ray_peak;
     bool need_gamut_map = !pl_gamut_map_params_noop(&gamut);
 
     if (!args->prelinearized)
@@ -3254,6 +3256,42 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
                 params->tone_mapping_metric == PL_TONE_MAP_METRIC_MAXRGB_RGB) {
                 // Homogeneity makes this the exact fixed-hue inverse:
                 // P(scale * RGB) == scale * P(RGB).
+                // Measure BEFORE gamut mapping, ambient lift and hard clipping.
+                // Destination channel maximum is the physical upper constraint;
+                // RGB scaling commutes with this linear primaries conversion.
+                if (args->measure_rgb_ray || args->rgb_ray_peak) {
+                    const pl_matrix3x3 to_dst = pl_get_color_mapping_matrix(
+                        pl_raw_primaries_get(src.primaries),
+                        pl_raw_primaries_get(dst.primaries),
+                        PL_INTENT_RELATIVE_COLORIMETRIC);
+                    GLSL("vec3 ray_dst = "$" * (color.rgb * metric_scale); \n"
+                         "float ray_max = max(max(ray_dst.r, ray_dst.g), ray_dst.b); \n",
+                         SH_MAT3(to_dst));
+                    if (args->measure_rgb_ray) {
+                        GLSL("color = vec4(max(ray_max, 0.0), 0.0, 0.0, 1.0); \n"
+                             "#undef tone_map \n"
+                             "} \n");
+                        return;
+                    }
+                    ident_t peak_tex = sh_bind(sh, args->rgb_ray_peak,
+                        PL_TEX_ADDRESS_CLAMP, PL_TEX_SAMPLE_NEAREST,
+                        "rgb_ray_peak", NULL, NULL, NULL);
+                    const float target_max = pl_hdr_rescale(
+                        PL_HDR_PQ, PL_HDR_NORM, tone.output_max);
+                    GLSL("float ray_peak = texelFetch("$", ivec2(0), 0).r; \n"
+                         "if (ray_peak > "$" && ray_max > 1e-12) { \n"
+                         "  vec2 q = pow(max(vec2(ray_max, ray_peak) * %f, 0.0), vec2(%f)); \n"
+                         "  q = pow((vec2(%f) + %f*q)/(vec2(1.0) + %f*q), vec2(%f)); \n"
+                         "  float qout = q.x * min(1.0, "$" / q.y); \n"
+                         "  float v = pow(qout, 1.0/%f); \n"
+                         "  float mout = pow(max(v-%f, 0.0)/max(%f-%f*v, 1e-9), 1.0/%f) * %f; \n"
+                         "  metric_scale *= min(1.0, mout/ray_max); \n"
+                         "} \n",
+                         peak_tex, SH_FLOAT_DYN(target_max),
+                         PL_COLOR_SDR_WHITE/10000, PQ_M1, PQ_C1, PQ_C2, PQ_C3, PQ_M2,
+                         SH_FLOAT_DYN(tone.output_max),
+                         PQ_M2, PQ_C1, PQ_C2, PQ_C3, PQ_M1, 10000/PL_COLOR_SDR_WHITE);
+                }
                 GLSL("color.rgb *= metric_scale;                           \n"
                  "lms = "$" * color.rgb;                                \n"
                  "lmspq = %f * lms;                                      \n"
diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index 160570b..ac59d8a 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -396,6 +396,9 @@ struct pl_color_map_params {
     // leave disabled for metadata passthrough.
     bool hard_clip_hdr_target;
 
+    // Optional same-frame maxRGB linear-PQ stage after Perceptual RGB-ray mapping.
+    bool auto_pq_second_pass;
+
     // Tone mapping LUT size. Defaults to 256.
     int lut_size;
 
@@ -485,6 +488,10 @@ struct pl_color_map_args {
     // `pl_shader_extract_features`. Optional. No effect if
     // `params->contrast_recovery` is disabled.
     pl_tex feature_map;
+
+    // Renderer-private first-stage measurement and current-frame peak texture.
+    bool measure_rgb_ray;
+    pl_tex rgb_ray_peak;
 };
 
 #define pl_color_map_args(...) (&(struct pl_color_map_args) { __VA_ARGS__ })
