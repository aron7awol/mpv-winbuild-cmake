From 26b88d5b0614aeeb38355bc43ab687da39d17a4a Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:49:50 -0500
Subject: [PATCH] gpu-next: add live Dolby Vision EL toggle


diff --git a/DOCS/man/options.rst b/DOCS/man/options.rst
index b50c9f0ca5042890a1efeaff266cc5f8efd06793..0ada9af70388a33346105108e7d3f88aea4ea0f2 100644
--- a/DOCS/man/options.rst
+++ b/DOCS/man/options.rst
@@ -7853,6 +7853,12 @@ them.
     advanced scaling is enabled. Defaults to no. (Only affects
     ``--vo=gpu-next``, note that ``--vo=gpu`` always delays the peak.)
 
+``--dovi-enhancement-layer=<yes|no>``
+    Render the Dolby Vision enhancement layer when one is attached to the
+    current frame (default: yes). Changing this option redraws a cached paused
+    frame without seeking or decoding it again. This option affects only the
+    ``gpu-next`` video output and does not disable enhancement-layer decoding.
+
 ``--hdr-authored-scene-reset=<yes|no>``
     When measured HDR peak detection is active, reset its temporal smoothing at
     authored scene boundaries. Dolby Vision uses the RPU scene refresh flag.
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index e97058d041135caf47ad0830dd4a3f05a24867f2..4bb033e06840b16a8c4ca2f94675079b05d6b975 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -191,6 +191,7 @@ static void update_lut(struct priv *p, struct user_lut *lut);
 
 struct gl_next_opts {
     bool delayed_peak;
+    bool dovi_enhancement_layer;
     bool causal_scene_diagnostics;
     bool causal_scene_acceleration;
     bool authored_scene_reset;
@@ -226,6 +227,7 @@ const struct m_sub_options gl_next_conf = {
         {"image-subs-hdr-peak", OPT_CHOICE(image_subs_hdr_peak, {"sdr", PL_COLOR_SDR_WHITE},
             {"video", -1}, {"video-static", -2}, {"video-dynamic", -3}),  M_RANGE(10, 10000)},
         {"allow-delayed-peak-detect", OPT_BOOL(delayed_peak)},
+        {"dovi-enhancement-layer", OPT_BOOL(dovi_enhancement_layer)},
         // Hidden Stage 1 instrumentation. This collects descriptors only and
         // must never alter tone-map state or rendered output.
         {"hdr-causal-scene-diagnostics", OPT_BOOL(causal_scene_diagnostics), M_OPT_NOCFG},
@@ -260,6 +262,7 @@ const struct m_sub_options gl_next_conf = {
         .image_subs_hdr_peak = 1000,
         .target_hint = -1,
         .target_hint_strict = true,
+        .dovi_enhancement_layer = true,
         .authored_scene_reset = true,
         .causal_scene_diagnostics = false,
         .causal_scene_acceleration = false,
@@ -585,12 +588,22 @@ struct frame_priv {
     struct ra_hwdec *el_hwdec;
     pl_tex el_tex[4];
     struct pl_frame el_frame;
+    bool has_el_frame;
     unsigned authored_scene_cut;
     // Exact monotonic presentation identity from vo_frame::frame_id. It is
     // deliberately not a PTS and is carried into libplacebo's readback tag.
     uint64_t causal_scene_tag;
 };
 
+#if PL_API_VER >= 367
+static void apply_dovi_enhancement_layer(struct priv *p, struct pl_frame *frame,
+                                         struct frame_priv *fp)
+{
+    frame->enhancement_layer = p->next_opts->dovi_enhancement_layer &&
+                               fp->has_el_frame ? &fp->el_frame : NULL;
+}
+#endif
+
 static void reset_authored_scene_state(struct priv *p)
 {
     p->hdr10plus_stable_signature = 0;
@@ -1142,6 +1155,7 @@ static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src
 
         if (el_ok) {
             pl_frame_set_chroma_location(&fp->el_frame, el_par.chroma_location);
+            fp->has_el_frame = true;
             frame->enhancement_layer = &fp->el_frame;
         } else {
             MP_WARN(vo, "Failed setting up enhancement layer; "
@@ -1212,10 +1226,13 @@ static void update_options(struct vo *vo)
 {
     struct priv *p = vo->priv;
     pl_options pars = p->pars;
+    bool old_dovi_enhancement_layer = p->next_opts->dovi_enhancement_layer;
     bool changed = m_config_cache_update(p->opts_cache);
     changed = m_config_cache_update(p->next_opts_cache) || changed;
     if (changed)
         update_render_options(vo);
+    if (old_dovi_enhancement_layer != p->next_opts->dovi_enhancement_layer)
+        p->flush_cache = true;
 
     update_lut(p, &p->next_opts->lut);
     pars->params.lut = p->next_opts->lut.lut;
@@ -1480,6 +1497,13 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         }
     }
 
+    // A paused redraw can have no incoming frames, so flush before the push
+    // loop rather than waiting for a newly decoded frame.
+    if (p->flush_cache) {
+        pl_renderer_flush_cache(p->rr);
+        p->flush_cache = false;
+    }
+
     // Push all incoming frames into the frame queue
     for (int n = 0; n < frame->num_frames; n++) {
         int id = frame->frame_id + n;
@@ -1490,12 +1514,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
             p->last_id = 0;
             reset_authored_scene_state(p);
             p->want_reset = false;
-            p->flush_cache = true;
-        }
-
-        if (p->flush_cache) {
             pl_renderer_flush_cache(p->rr);
-            p->flush_cache = false;
         }
 
         if (id <= p->last_id)
@@ -1835,6 +1854,9 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
             struct pl_frame *image = (struct pl_frame *) mix.frames[i];
             struct mp_image *mpi = image->user_data;
             struct frame_priv *fp = mpi->priv;
+#if PL_API_VER >= 367
+            apply_dovi_enhancement_layer(p, image, fp);
+#endif
             apply_crop(image, p->src, vo->params->w, vo->params->h);
             if (opts->blend_subs) {
                 if (frame->redraw)
@@ -2371,6 +2393,9 @@ static void video_screenshot(struct vo *vo, struct voctrl_screenshot *args)
         osd_flags |= OSD_DRAW_SUB_ONLY;
 
     struct frame_priv *fp = mpi->priv;
+#if PL_API_VER >= 367
+    apply_dovi_enhancement_layer(p, &image, fp);
+#endif
     if (opts->blend_subs) {
         float w = pl_rect_w(opts->blend_subs == BLEND_SUBS_VIDEO ? image.crop : target.crop);
         float h = pl_rect_h(opts->blend_subs == BLEND_SUBS_VIDEO ? image.crop : target.crop);
