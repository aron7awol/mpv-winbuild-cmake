From: mpv-ht <mpv-ht@localhost>
Date: Sun, 13 Sep 2026 00:00:00 -0400
Subject: [PATCH] Add opt-in histogram-shaped P tone mapping and bounded brightening

Use the measured P RGB-ray histogram to redistribute the existing tone curve.
Strength and above-source retention default to zero; no SEP path is added.

---
diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index ac59d8a..ad6c98e 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -190,6 +190,9 @@ struct pl_peak_detect_params {
     // Set internally by the renderer only for generic pixel DTM.
     enum pl_tone_map_metric metric;
 
+    // Renderer-owned full-range P histogram, only for enabled HSTM.
+    bool hstm_histogram;
+
     // One-shot tag for the measurement submitted with these parameters. When
     // its GPU result is consumed, temporal peak/average smoothing is reseeded
     // from that frame. Deliberately excluded from parameter equality.
@@ -353,6 +356,11 @@ struct pl_color_map_params {
     // mapping function capable of bidirectional mapping.
     bool gamut_expansion;
 
+    // Private P RGB-ray histogram shaping and above-source retention (0..1).
+    // Defaults off. At full retention above-source gain is bounded to 2x.
+    float hstm_strength;
+    float hstm_overbrightening;
+
     // --- Tone mapping options
 
     // Tone mapping function to use to handle out-of-range colors.
