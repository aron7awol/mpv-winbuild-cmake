diff --git a/sub/sd_ass.c b/sub/sd_ass.c
index db4d67dac..a1885c081 100644
--- a/sub/sd_ass.c
+++ b/sub/sd_ass.c
@@ -20,6 +20,7 @@
 #include <string.h>
 #include <math.h>
 #include <limits.h>
