+/* Generated from shipping Inspector; do not hand edit. */
+static const char frame_math[] = "float perceptual_bt2020(vec3 rgb)\n{\n    vec3 c=max(rgb,vec3(0)); float total=c.r+c.g+c.b;\n    if(total<=1e-12) return 0.0;\n    vec3 n=c/total; float w=n.b, p=n.r*n.g;\n    float q0=(((((((14.5330356895*w-25.5682414785)*w-13.7465695335)*w+56.3828756991)*w-42.760790975)*w+13.1725257153)*w-2.51283511691)*w+1.0);\n    float q1=(((((-31.3753030053*w-16.6730639549)*w+125.654298402)*w-103.378434394)*w+22.7623461176)*w-1.53706708322);\n    float q2=((140.435403979*w+97.2794791377)*w-114.074511803)*w+7.67118553227;\n    float q3=73.1408564899*w-38.0916687975;\n    return total*(((q3*p+q2)*p+q1)*p+q0);\n}\n\nfloat pq_encode_nits(float nits)\n{\n    const float m1=2610.0/16384.0, m2=2523.0/32.0;\n    const float c1=3424.0/4096.0, c2=2413.0/128.0, c3=2392.0/128.0;\n    float sign_n=nits<0.0 ? -1.0 : 1.0;\n    float p=pow(abs(nits)/10000.0,m1);\n    return sign_n*pow((c1+c2*p)/(1.0+c3*p),m2);\n}\n\n";
diff --git a/video/out/analyzer_output_bridge.h b/video/out/analyzer_output_bridge.h
new file mode 100644
index 000000000..728a70d33
--- /dev/null
+++ b/video/out/analyzer_output_bridge.h
@@ -0,0 +1,68 @@
+#include <libplacebo/shaders/colorspace.h>
+#include <libplacebo/shaders/sampling.h>
+static bool async_output_frame(struct priv *p,const struct pl_hook_params *hp,
+                                struct async_probe_slot *slot,const struct pl_hook *hook)
+{
+    int w=(int)fabsf(hp->rect.x1-hp->rect.x0),h=(int)fabsf(hp->rect.y1-hp->rect.y0);
+    if(w<1 || h<1)return false;
+    // Keep measurement precision: renderer scratch textures are usually FP16
+    // and would make the frame maximum disagree with the direct pixel decode.
+    pl_fmt fmt=pl_find_fmt(p->gpu,PL_FMT_FLOAT,4,32,0,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE);
+    if(!fmt || !pl_tex_recreate(p->gpu,&slot->output_linear,pl_tex_params(
+        .w=w,.h=h,.format=fmt,.sampleable=true,.renderable=true,
+        .storable=!!(fmt->caps&PL_FMT_CAP_STORABLE))))return false;
+    pl_tex tex=slot->output_linear;
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_sample_direct(sh,pl_sample_src(.tex=hp->tex,.rect=hp->rect,.new_w=w,.new_h=h));
+    struct pl_color_repr repr=hp->repr;
+    pl_shader_decode_color_ex(sh,pl_color_decode_args(.repr=&repr));
+    pl_shader_linearize(sh,&hp->color);
+    ok=ok && pl_dispatch_finish(hp->dispatch,pl_dispatch_params(.shader=&sh,.target=tex));
+    if(!ok){pl_dispatch_abort(hp->dispatch,&sh);return false;}
+    return async_frame_dispatch(p,hp,slot,hook,tex,560);
+}
+/* Decode the post-color-management signal, before overlays/rotation/dither.
+ * No mapping is applied here: use the effective TARGET EOTF and primaries. */
+static bool async_output_pixel(struct priv *p, const struct pl_hook_params *hp,
+                               struct async_probe_slot *slot, int x, int y)
+{
+    struct vo *vo=p->async_probe->hook.priv;
+    float u=(x-p->dst.x0+.5f)/mp_rect_w(p->dst),v=(y-p->dst.y0+.5f)/mp_rect_h(p->dst);
+    int rotation=vo->params ? (vo->params->rotate%360+360)%360 : 0;
+    float ox=u,oy=v;
+    if(rotation==90){ox=v;oy=1-u;}
+    if(rotation==180){ox=1-u;oy=1-v;}
+    if(rotation==270){ox=1-v;oy=u;}
+    float pos[2] = {
+        (hp->rect.x0+ox*(hp->rect.x1-hp->rect.x0))/hp->tex->params.w,
+        (hp->rect.y0+oy*(hp->rect.y1-hp->rect.y0))/hp->tex->params.h};
+    const struct pl_raw_primaries *prim=pl_raw_primaries_get(hp->color.primaries);
+    pl_matrix3x3 xyz=pl_get_rgb2xyz_matrix(prim);
+    pl_matrix3x3 map=pl_get_color_mapping_matrix(prim,pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020),PL_INTENT_RELATIVE_COLORIMETRIC);
+    float matrix[9], ym[3];
+    for(int i=0;i<3;i++) {ym[i]=xyz.m[1][i];for(int j=0;j<3;j++)matrix[3*j+i]=map.m[i][j];}
+    struct pl_shader_var vars[]={
+        {.var=pl_var_vec2("out_pos"),.data=pos,.dynamic=true},
+        {.var=pl_var_vec3("out_y"),.data=ym,.dynamic=true},
+        {.var={.name="out_2020",.type=PL_VAR_FLOAT,.dim_v=3,.dim_m=3,.dim_a=1},.data=matrix,.dynamic=true}};
+    struct pl_buffer_var bv={.var={.name="out_samples",.type=PL_VAR_FLOAT,.dim_v=4,.dim_m=1,.dim_a=140},.layout={.offset=0,.stride=16,.size=2240}};
+    struct pl_shader_desc desc[]={
+        {.desc={.name="out_tex",.type=PL_DESC_SAMPLED_TEX},.binding={.object=hp->tex,.address_mode=PL_TEX_ADDRESS_CLAMP,.sample_mode=PL_TEX_SAMPLE_NEAREST}},
+        {.desc={.name="OutputPixel",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=slot->buf,.buffer_vars=&bv,.num_buffer_vars=1}};
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){
+        .description="Analyzer output pixel decode",.body="color=textureLod(out_tex,out_pos,0.0);",
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_COLOR,
+        .compute=true,.compute_group_size={1,1},.variables=vars,.num_variables=3,.descriptors=desc,.num_descriptors=2});
+    struct pl_color_repr repr=hp->repr;
+    pl_shader_decode_color_ex(sh,pl_color_decode_args(.repr=&repr));
+    pl_shader_linearize(sh,&hp->color);
+    ok=ok && pl_shader_custom(sh,&(struct pl_custom_shader){
+        .header=frame_math,
+        .body="vec3 rgb=color.rgb*203.0; out_samples[137]=vec4(rgb,dot(out_y,rgb));"
+              "out_samples[138]=vec4(perceptual_bt2020(out_2020*rgb),1,0,0);out_samples[139]=vec4(0);",
+        .input=PL_SHADER_SIG_COLOR,.output=PL_SHADER_SIG_NONE}) &&
+        pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={1,1,1}));
+    if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    return ok;
+}
