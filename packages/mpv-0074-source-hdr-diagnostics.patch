diff --git a/test/source_hdr.c b/test/source_hdr.c
new file mode 100644
index 000000000..529852afd
--- /dev/null
+++ b/test/source_hdr.c
@@ -0,0 +1,85 @@
+#include <libavutil/frame.h>
+#include <libavutil/mastering_display_metadata.h>
+
+#include "test_utils.h"
+#include "video/mp_image.h"
+
+// Original metadata is diagnostic only and must survive mpv-owned AVFrame
+// conversions without entering renderer equality or overwriting peak results.
+int main(void)
+{
+    AVFrame *frame = av_frame_alloc();
+    frame->format = AV_PIX_FMT_YUV420P;
+    frame->width = frame->height = 16;
+    frame->color_trc = AVCOL_TRC_SMPTE2084;
+    frame->color_primaries = AVCOL_PRI_BT2020;
+    frame->colorspace = AVCOL_SPC_BT2020_NCL;
+    assert_true(av_frame_get_buffer(frame, 32) >= 0);
+    AVMasteringDisplayMetadata *mdl = av_mastering_display_metadata_create_side_data(frame);
+    mdl->has_luminance = 1;
+    mdl->min_luminance = (AVRational){5, 1000};
+    mdl->max_luminance = (AVRational){1000, 1};
+    AVContentLightMetadata *cll = av_content_light_metadata_create_side_data(frame);
+    cll->MaxCLL = 1000;
+    cll->MaxFALL = 497;
+    struct mp_image *image = mp_image_from_av_frame(frame);
+    assert_true(image);
+    struct mp_source_hdr_metadata *sh = &image->params.source_hdr;
+    assert_true(sh->valid && sh->bl_mdl && sh->bl_cll);
+    assert_false(sh->dovi || sh->dv.l1 || sh->dv.l6 || sh->hdr10plus);
+    assert_float_equal(sh->bl_min, 0.005, 1e-10);
+    assert_int_equal(sh->bl_max, 1000);
+    assert_int_equal(sh->bl_max_cll, 1000);
+    assert_int_equal(sh->bl_max_fall, 497);
+
+    // Simulate the already-merged renderer record. Never read this back as BL.
+    image->params.color.hdr.max_luma = 4000;
+    sh->dovi = sh->dv.l6 = sh->dv.l1 = true;
+    sh->dv.max_mdl = 4000;
+    sh->dv.min_mdl = 50;
+    sh->dv.max_cll = 1600;
+    sh->dv.max_fall = 600;
+    sh->dv.min_pq = 0;
+    sh->dv.max_pq = 2000;
+    sh->dv.avg_pq = 600;
+    AVFrame *roundtrip = mp_image_to_av_frame(image);
+    assert_true(roundtrip);
+    struct mp_image *restored = mp_image_from_av_frame(roundtrip);
+    assert_true(restored);
+    assert_memcmp(&restored->params.source_hdr, sh, sizeof(*sh));
+    struct mp_image *copy = mp_image_alloc(image->imgfmt, image->w, image->h);
+    mp_image_copy_attributes(copy, image);
+    assert_memcmp(&copy->params.source_hdr, sh, sizeof(*sh));
+
+    struct mp_image_params before = image->params;
+    struct mp_image_params after = before;
+    after.source_hdr = (struct mp_source_hdr_metadata){.valid = true};
+    assert_true(mp_image_params_equal(&before, &after));
+    assert_true(mp_image_params_static_equal(&before, &after));
+    after.color.hdr.max_pq_y = 0.4;
+    after.color.hdr.avg_pq_y = 0.2;
+    mp_image_params_update_dynamic(&after, &before, true);
+    assert_memcmp(&after.source_hdr, sh, sizeof(*sh));
+    assert_float_equal(after.color.hdr.max_pq_y, 0.4, 1e-6);
+    assert_float_equal(after.color.hdr.avg_pq_y, 0.2, 1e-6);
+
+    // Zero-valued authored CLL is present but unspecified, not a missing record.
+    cll->MaxCLL = 0;
+    struct mp_image *zero = mp_image_from_av_frame(frame);
+    assert_true(zero->params.source_hdr.bl_cll);
+    assert_int_equal(zero->params.source_hdr.bl_max_cll, 0);
+    av_frame_remove_side_data(frame, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+    av_frame_remove_side_data(frame, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    struct mp_image *missing = mp_image_from_av_frame(frame);
+    assert_true(missing->params.source_hdr.valid);
+    assert_false(missing->params.source_hdr.bl_mdl || missing->params.source_hdr.bl_cll);
+
+    talloc_free(missing);
+    talloc_free(zero);
+    talloc_free(copy);
+    talloc_free(restored);
+    talloc_free(image);
+    av_frame_free(&roundtrip);
+    av_frame_free(&frame);
+    return 0;
+}
