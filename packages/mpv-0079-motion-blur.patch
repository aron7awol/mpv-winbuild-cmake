diff --git a/video/out/motion_blur_response.h b/video/out/motion_blur_response.h
new file mode 100644
--- /dev/null
+++ b/video/out/motion_blur_response.h
@@ -0,0 +1,35 @@
+// Local Motion blur prototype. Generic curves, not a measured panel model.
+#ifndef MPV_HT_MOTION_BLUR_RESPONSE_H
+#define MPV_HT_MOTION_BLUR_RESPONSE_H
+#include <math.h>
+
+// Integral of the previous-pixel fraction from 0 to x, for 0 <= x <= 1.
+// Smooth is the complement of cubic smoothstep. Exponential is a first-order
+// decay normalized from 100% to 0% over its nominal 99%-settled interval.
+static inline double motion_blur_response_integral(double x, int curve)
+{
+    if (curve == 1)
+        return x - x*x*x + 0.5*x*x*x*x;
+    const double a = 4.605170185988091368; // ln(100)
+    return (-expm1(-a*x) / a - 0.01*x) / 0.99;
+}
+
+// Average light over the output refresh, not a point sample at refresh start.
+// All times are wall-clock milliseconds. T is full settling time, NOT GtG
+// 10-90%. Limiting T to 32 ms settles before the next supported 24p frame,
+// so two source frames suffice without accumulated multi-frame trails.
+static inline double motion_blur_response_weight(double strength, double settle_ms,
+                                         int curve, double elapsed_ms,
+                                         double interval_ms)
+{
+    if (!isfinite(strength) || !isfinite(settle_ms) || !isfinite(elapsed_ms) ||
+        !isfinite(interval_ms) || strength <= 0 || settle_ms <= 0 ||
+        elapsed_ms < 0 || interval_ms <= 0 || elapsed_ms >= settle_ms)
+        return 0;
+    double a = elapsed_ms / settle_ms;
+    double b = fmin((elapsed_ms + interval_ms) / settle_ms, 1.0);
+    double average = settle_ms / interval_ms *
+        (motion_blur_response_integral(b, curve) - motion_blur_response_integral(a, curve));
+    return fmin(strength / 100.0, 1.0) * fmin(fmax(average, 0.0), 1.0);
+}
+#endif
