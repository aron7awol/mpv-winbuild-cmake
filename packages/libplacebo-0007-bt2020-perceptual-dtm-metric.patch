+            $wg_metric_sum = $wg_metric_max = 0u;                                  \
+        @}                                                                      \
     }                                                                           \
     @if (use_histogram) {                                                       \
-        for (uint i = local_idx; i < ${const uint: HIST_BINS}; i += wg_size)    \
+        for (uint i = local_idx; i < ${const uint: HIST_BINS}; i += wg_size) {  \
