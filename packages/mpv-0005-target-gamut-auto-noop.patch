From e52ac76d15a9bd64d03fa222be1a1fd7f7af506c Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:49:30 -0500
Subject: [PATCH] vo_gpu_next: ignore unparsable --target-gamut values

--target-gamut is a string option and both use sites gate on
`if (opts->target_gamut)`, so any non-empty value is an active override.
`auto` parses to PL_COLOR_PRIM_UNKNOWN, which has no entry in libplacebo's
raw-primaries table, so mp_parse_raw_primaries() yields all-zero primaries.
Those zeros are written into the render target and into the colorspace hint,
and the hint's mastering-display primaries are forwarded to the display (on
Windows through SetHDRMetaData), producing invalid HDR metadata rather than
the intended "no gamut constraint".

Parse into a temporary and assign only when the result is a valid primaries
triangle, so `--target-gamut=auto` - and any other unrecognised value - is a
no-op instead of silent metadata corruption.

diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index df7cf522a1cc6664e972b888a02677b53ca639dd..5afb4c71f54e40d7fc4e75cfde10ecfd0c5d8dc5 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1192,8 +1192,12 @@ static void apply_target_options(struct priv *p, struct pl_frame *target,
     }
     if ((!target->color.hdr.min_luma || !hint))
         apply_target_contrast(p, &target->color, min_luma);
-    if (opts->target_gamut)
-        mp_parse_raw_primaries(mp_null_log, opts->target_gamut, &target->color.hdr.prim);
+    if (opts->target_gamut) {
+        struct pl_raw_primaries tmp = {0};
+        mp_parse_raw_primaries(mp_null_log, opts->target_gamut, &tmp);
+        if (pl_primaries_valid(&tmp))
+            target->color.hdr.prim = tmp;
+    }
     int dither_depth = opts->dither_depth;
     if (dither_depth == 0) {
         struct ra_swapchain *sw = p->ra_ctx->swapchain;
@@ -1470,8 +1474,12 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         }
         if (opts->target_prim)
             hint.primaries = opts->target_prim;
-        if (opts->target_gamut)
-            mp_parse_raw_primaries(mp_null_log, opts->target_gamut, &hint.hdr.prim);
+        if (opts->target_gamut) {
+            struct pl_raw_primaries tmp = {0};
+            mp_parse_raw_primaries(mp_null_log, opts->target_gamut, &tmp);
+            if (pl_primaries_valid(&tmp))
+                hint.hdr.prim = tmp;
+        }
         if (opts->target_trc)
             hint.transfer = opts->target_trc;
         if (opts->target_peak)
