@@ -1542,6 +1604,55 @@ static void update_peak_buf(pl_gpu gpu, struct sh_color_map_obj *obj, bool force
         obj->peak.raw_max_rgb = (float) frame_max_rgb / RGB_MAX * 10000.0f;
     }
 
+    if (params->metric != PL_TONE_MAP_METRIC_STANDARD) {
+        float raw_avg_metric = frame_wg_active
+            ? (float) frame_sum_metric / (frame_wg_active * PQ_MAX)
+            : PL_COLOR_HDR_BLACK;
+        float raw_max_metric = frame_wg_active
+            ? measure_peak(data.frame_max_metric, data.frame_hist_metric,
+                           params->percentile)
+            : PL_COLOR_HDR_BLACK;
+        obj->peak.raw_avg_metric = raw_avg_metric;
+        obj->peak.raw_max_metric = raw_max_metric;
+        if (!obj->peak.avg_metric) {
+            obj->peak.avg_metric = raw_avg_metric;
+            obj->peak.max_metric = raw_max_metric;
+        } else {
+            // Match the standard detector's rounding-noise suppression before
+            // applying its temporal behavior in this metric's own PQ domain.
+            static const float epsilon = 1.0f / PQ_MAX;
+            if (fabsf(raw_avg_metric - obj->peak.avg_metric) < epsilon)
+                raw_avg_metric = obj->peak.avg_metric;
+            if (fabsf(raw_max_metric - obj->peak.max_metric) < epsilon)
+                raw_max_metric = obj->peak.max_metric;
+        }
+
+        const float coeff = iir_coeff(params->smoothing_period);
+        obj->peak.avg_metric += coeff *
+            (raw_avg_metric - obj->peak.avg_metric);
+        obj->peak.max_metric += coeff *
+            (raw_max_metric - obj->peak.max_metric);
+
+        // Accelerate both smoothed values on scene changes, exactly as the
+        // standard detector does, but detect the change from this metric's
+        // frame average rather than CIE Y.
+        if (params->scene_threshold_low > 0 &&
+            params->scene_threshold_high > 0) {
+            const float log10_pq = 1e-2f;
+            const float thresh_low = params->scene_threshold_low * log10_pq;
+            const float thresh_high = params->scene_threshold_high * log10_pq;
+            const float bias = (float) frame_wg_active / frame_wg_count;
+            const float delta = bias *
+                fabsf(raw_avg_metric - obj->peak.avg_metric);
+            const float mix_coeff =
+                pl_smoothstep(thresh_low, thresh_high, delta);
+            obj->peak.avg_metric = PL_MIX(obj->peak.avg_metric,
+                                          raw_avg_metric, mix_coeff);
+            obj->peak.max_metric = PL_MIX(obj->peak.max_metric,
+                                          raw_max_metric, mix_coeff);
+        }
+    }
+
     if (!obj->peak.avg_pq) {
         // Set the initial value accordingly if it contains no data
         obj->peak.avg_pq = avg_pq;
@@ -1590,9 +1701,13 @@ bool pl_shader_detect_peak(pl_shader sh, struct pl_color_space csp,
     }
 
