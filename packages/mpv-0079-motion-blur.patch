+    struct m_sub_property props[] = {
+        {"active", SUB_PROP_BOOL(v.active)},
+        {"display-hz", SUB_PROP_DOUBLE(v.hz)},
+        {"source-fps", SUB_PROP_DOUBLE(v.fps)},
+        {"previous-weight", SUB_PROP_DOUBLE(v.previous_weight)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
