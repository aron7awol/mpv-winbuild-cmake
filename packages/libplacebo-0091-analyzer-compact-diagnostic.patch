From 2737308437edea494e5f4a4be433a08acf7c0b67 Mon Sep 17 00:00:00 2001
From: mpv-ht diagnostic preparation <diagnostic@mpv-ht.invalid>
Date: Sat, 12 Sep 2026 01:43:46 -0400
Subject: [PATCH] diagnostic: opt in to nonblocking D3D11 Analyzer readback

---
 src/d3d11/gpu.c      |  1 +
 src/d3d11/gpu.h      |  2 ++
 src/d3d11/gpu_buf.c  | 43 ++++++++++++++++++++++++++++++++++++++++---
 src/d3d11/gpu_pass.c |  2 ++
 4 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/src/d3d11/gpu.c b/src/d3d11/gpu.c
index a4a003dc..ac424cdd 100644
--- a/src/d3d11/gpu.c
+++ b/src/d3d11/gpu.c
@@ -431,6 +431,7 @@ static struct pl_gpu_fns pl_fns_d3d11 = {
     .buf_destroy            = pl_d3d11_buf_destroy,
     .buf_write              = pl_d3d11_buf_write,
     .buf_read               = pl_d3d11_buf_read,
+    .buf_poll               = pl_d3d11_buf_poll,
     .buf_copy               = pl_d3d11_buf_copy,
     .desc_namespace         = d3d11_desc_namespace,
     .pass_create            = pl_d3d11_pass_create,
diff --git a/src/d3d11/gpu.h b/src/d3d11/gpu.h
index c6d842e6..1b0b7559 100644
--- a/src/d3d11/gpu.h
+++ b/src/d3d11/gpu.h
@@ -101,6 +101,7 @@ void pl_d3d11_timer_end(pl_gpu gpu, pl_timer timer);
 struct pl_buf_d3d11 {
     ID3D11Buffer *buf;
     ID3D11Buffer *staging;
+    bool analyzer_nonblocking, read_pending, read_ready;
     ID3D11ShaderResourceView *raw_srv;
     ID3D11UnorderedAccessView *raw_uav;
     ID3D11ShaderResourceView *texel_srv;
@@ -110,6 +111,7 @@ struct pl_buf_d3d11 {
     bool dirty;
 };
 
+bool pl_d3d11_buf_poll(pl_gpu gpu, pl_buf buf, uint64_t timeout);
 void pl_d3d11_buf_destroy(pl_gpu gpu, pl_buf buf);
 pl_buf pl_d3d11_buf_create(pl_gpu gpu, const struct pl_buf_params *params);
 void pl_d3d11_buf_write(pl_gpu gpu, pl_buf buf, size_t offset, const void *data,
diff --git a/src/d3d11/gpu_buf.c b/src/d3d11/gpu_buf.c
index 955e6e19..3a3c29f6 100644
--- a/src/d3d11/gpu_buf.c
+++ b/src/d3d11/gpu_buf.c
@@ -47,6 +47,10 @@ pl_buf pl_d3d11_buf_create(pl_gpu gpu, const struct pl_buf_params *params)
 
     struct pl_buf_d3d11 *buf_p = PL_PRIV(buf);
 
+    const char *experiment = getenv("MPV_HT_ANALYZER_NONBLOCK");
+    buf_p->analyzer_nonblocking = experiment && !strcmp(experiment, "1") &&
+        params->host_readable && params->storable &&
+        (params->size == 4480 || params->size == 554368);
     D3D11_BUFFER_DESC desc = { .ByteWidth = params->size };
 
     if (params->uniform && !params->format &&
@@ -211,6 +215,7 @@ void pl_d3d11_buf_write(pl_gpu gpu, pl_buf buf, size_t offset, const void *data,
     struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
     struct pl_buf_d3d11 *buf_p = PL_PRIV(buf);
 
+    buf_p->read_pending = buf_p->read_ready = false;
     if (buf_p->data) {
         memcpy(buf_p->data + offset, data, size);
         buf_p->dirty = true;
@@ -239,6 +244,34 @@ void pl_d3d11_buf_resolve(pl_gpu gpu, pl_buf buf)
         0, NULL, buf_p->data, 0, 0);
 }
 
+// Private zero-timeout Analyzer experiment. Submit the staging copy once,
+// then retry on later VO wakeups; never map an unfinished copy with a wait.
+bool pl_d3d11_buf_poll(pl_gpu gpu, pl_buf buf, uint64_t timeout)
+{
+    struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
+    struct pl_buf_d3d11 *bp = PL_PRIV(buf);
+    if (!bp->analyzer_nonblocking || timeout || !bp->staging) return false;
+    if (bp->read_ready) return false;
+    if (!bp->read_pending) {
+        ID3D11DeviceContext_CopyResource(p->imm, (ID3D11Resource *) bp->staging,
+            (ID3D11Resource *) bp->buf);
+        bp->read_pending = true;
+        // Paused playback also needs progress without a future Present.
+        ID3D11DeviceContext_Flush(p->imm);
+    }
+    D3D11_MAPPED_SUBRESOURCE lock;
+    HRESULT hr = ID3D11DeviceContext_Map(p->imm, (ID3D11Resource *) bp->staging,
+        0, D3D11_MAP_READ, D3D11_MAP_FLAG_DO_NOT_WAIT, &lock);
+    if (hr == DXGI_ERROR_WAS_STILL_DRAWING) return true;
+    if (FAILED(hr)) {
+        PL_ERR(gpu, "Analyzer nonblocking poll failed: 0x%lx", (unsigned long) hr);
+        return false;
+    }
+    ID3D11DeviceContext_Unmap(p->imm, (ID3D11Resource *) bp->staging, 0);
+    bp->read_ready = true;
+    return false;
+}
+
 bool pl_d3d11_buf_read(pl_gpu gpu, pl_buf buf, size_t offset, void *dest,
                        size_t size)
 {
@@ -252,18 +285,21 @@ bool pl_d3d11_buf_read(pl_gpu gpu, pl_buf buf, size_t offset, void *dest,
         return true;
     }
 
-    ID3D11DeviceContext_CopyResource(p->imm, (ID3D11Resource *) buf_p->staging,
-        (ID3D11Resource *) buf_p->buf);
+    if (buf_p->analyzer_nonblocking && !buf_p->read_ready) return false;
+    if (!buf_p->analyzer_nonblocking)
+        ID3D11DeviceContext_CopyResource(p->imm, (ID3D11Resource *) buf_p->staging,
+            (ID3D11Resource *) buf_p->buf);
 
     D3D11_MAPPED_SUBRESOURCE lock;
     D3D(ID3D11DeviceContext_Map(p->imm, (ID3D11Resource *) buf_p->staging, 0,
-                                D3D11_MAP_READ, 0, &lock));
+                                D3D11_MAP_READ, buf_p->analyzer_nonblocking ? D3D11_MAP_FLAG_DO_NOT_WAIT : 0, &lock));
 
     char *csrc = lock.pData;
     memcpy(dest, csrc + offset, size);
 
     ID3D11DeviceContext_Unmap(p->imm, (ID3D11Resource *) buf_p->staging, 0);
 
+    buf_p->read_pending = buf_p->read_ready = false;
     pl_d3d11_flush_message_queue(ctx, "After buffer read");
 
     return true;
@@ -279,6 +315,7 @@ void pl_d3d11_buf_copy(pl_gpu gpu, pl_buf dst, size_t dst_offset, pl_buf src,
     struct d3d11_ctx *ctx = p->ctx;
     struct pl_buf_d3d11 *src_p = PL_PRIV(src);
     struct pl_buf_d3d11 *dst_p = PL_PRIV(dst);
+    dst_p->read_pending = dst_p->read_ready = false;
 
     // Handle system memory copies in case one or both of the buffers has a
     // system memory mirror
diff --git a/src/d3d11/gpu_pass.c b/src/d3d11/gpu_pass.c
index e47d5fac..826cc694 100644
--- a/src/d3d11/gpu_pass.c
+++ b/src/d3d11/gpu_pass.c
@@ -1005,6 +1005,7 @@ static void fill_uavs(pl_pass pass, const struct pl_pass_run_params *params,
         case PL_DESC_BUF_STORAGE:
             buf = params->desc_bindings[binding].object;
             buf_p = PL_PRIV(buf);
+            buf_p->read_pending = buf_p->read_ready = false;
             uavs[i] = buf_p->raw_uav;
             break;
         case PL_DESC_STORAGE_IMG:
@@ -1015,6 +1016,7 @@ static void fill_uavs(pl_pass pass, const struct pl_pass_run_params *params,
         case PL_DESC_BUF_TEXEL_STORAGE:
             buf = params->desc_bindings[binding].object;
             buf_p = PL_PRIV(buf);
+            buf_p->read_pending = buf_p->read_ready = false;
             uavs[i] = buf_p->texel_uav;
             break;
         default:
