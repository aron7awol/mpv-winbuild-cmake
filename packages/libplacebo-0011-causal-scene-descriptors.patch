+// Build the Stage-1 diagnostic source directly from immutable decoded planes.
+// This deliberately does not reuse pass_build_source: that function owns
+// renderer samplers, FBO bookkeeping, hook/LUT state and failure bits used by
+// the live render.  The diagnostic path must not touch any of those.
+static bool causal_extract_source(struct pass_state *live)
+{
+    struct pl_frame *image = &live->image;
+    pl_renderer rr = live->rr;
+    // Use the renderer dispatch so source uploads and proxy reads share one
+    // ordered GPU queue. State, textures and readback remain causal-private.
+    pl_dispatch dp = rr->dp;
+    // A failed preflight must never leave the preceding frame's proxy live.
+    live->causal_proxy = NULL;
+    if (image->field != PL_FIELD_NONE || image->rotation != PL_ROTATION_0 ||
+        image->color.primaries == PL_COLOR_PRIM_UNKNOWN)
+        return false;
+
+    const int ref_idx = frame_ref(image);
+    if (ref_idx < 0 || ref_idx >= image->num_planes ||
+        !image->planes[ref_idx].texture)
+        return false;
+
+    pl_tex ref_tex = image->planes[ref_idx].texture;
+    const pl_rect2df ref_rc = image->crop;
+    pl_rect2d rounded = {
+        .x0 = truncf(ref_rc.x0), .y0 = truncf(ref_rc.y0),
+    };
+    rounded.x1 = rounded.x0 + roundf(pl_rect_w(ref_rc));
+    rounded.y1 = rounded.y0 + roundf(pl_rect_h(ref_rc));
+    if (pl_rect_w(rounded) <= 0 || pl_rect_h(rounded) <= 0)
+        return false;
+
+    // The only transient state is a fresh shader tree.  Every plane is bound
+    // directly; no renderer sampler/cache/FBO/error state is consulted.
+    pl_shader sh = pl_dispatch_begin_ex(dp, true);
+    if (!sh_require(sh, PL_SHADER_SIG_NONE, 0, 0))
+        goto error;
+
+    int bits = image->repr.bits.sample_depth;
+    float out_scale = bits ? (1llu << bits) / ((1llu << bits) - 1.0f) : 1.0f;
+    float neutral_luma = 0.0, neutral_chroma = 0.5f * out_scale;
+    if (pl_color_levels_guess(&image->repr) == PL_COLOR_LEVELS_LIMITED)
+        neutral_luma = 16 / 256.0f * out_scale;
+    if (!pl_color_system_is_ycbcr_like(image->repr.sys))
+        neutral_chroma = neutral_luma;
+    GLSL("vec4 color = vec4("$", vec2("$"), 1.0);\n",
+         SH_FLOAT(neutral_luma), SH_FLOAT(neutral_chroma));
+
+    // Normalize stored sample depth once and carry the normalized
+    // representation into YUV/DV decoding, matching pass_build_source.
+    struct pl_color_repr normalized_repr = image->repr;
+    const float sample_scale = pl_color_repr_normalize(&normalized_repr);
+
+    for (int i = 0; i < image->num_planes; i++) {
+        const struct pl_plane *plane = &image->planes[i];
+        if (!plane->texture)
+            continue;
+        enum plane_type type = detect_plane_type(plane, &image->repr);
+        if (!type || type == PLANE_ALPHA)
+            continue;
+
+        float rx = (float) plane->texture->params.w / ref_tex->params.w;
+        float ry = (float) plane->texture->params.h / ref_tex->params.h;
+        float rrx = rx >= 1 ? roundf(rx) : 1.0 / roundf(1.0 / rx);
+        float rry = ry >= 1 ? roundf(ry) : 1.0 / roundf(1.0 / ry);
+        struct pl_sample_src src = {
+            .tex = plane->texture,
+            .components = plane->components,
+            .address_mode = plane->address_mode,
+            .scale = sample_scale,
+            .new_w = pl_rect_w(rounded),
+            .new_h = pl_rect_h(rounded),
+            .rect = {
+                (ref_rc.x0 - plane->shift_x) * rrx,
+                (ref_rc.y0 - plane->shift_y) * rry,
+                (ref_rc.x1 - plane->shift_x) * rrx,
+                (ref_rc.y1 - plane->shift_y) * rry,
+            },
+        };
+        if (plane->flipped) {
+            float h = ref_tex->params.h * rry;
+            src.rect.y0 = h - src.rect.y0;
+            src.rect.y1 = h - src.rect.y1;
+        }
+        if (!(plane->texture->params.format->caps & PL_FMT_CAP_LINEAR))
+            goto error;
+
+        pl_shader plane_sh = pl_dispatch_begin_ex(dp, true);
+        if (!pl_shader_sample_bilinear(plane_sh, &src)) {
+            pl_dispatch_abort(dp, &plane_sh);
+            goto error;
+        }
+        sh_describe(plane_sh, "causal scene source reconstruction");
+        ident_t sub = sh_subpass(sh, plane_sh);
+        pl_dispatch_abort(dp, &plane_sh);
+        if (!sub)
+            goto error;
+        GLSL("{\nvec4 causal_plane = "$"();\n", sub);
+        for (int c = 0; c < plane->components; c++) {
+            int channel = plane->component_mapping[c];
+            if (channel >= 0 && channel <= 3)
+                GLSL("color[%d] = causal_plane[%d];\n",
+                     channel, plane->texture->params.format->sample_order[c]);
+        }
+        GLSL("}\n");
+    }
+
+    struct pl_color_repr repr = normalized_repr;
+    if (repr.sys == PL_COLOR_SYSTEM_DOLBYVISION && repr.dovi &&
+        repr.dovi->nlq_active)
+        goto error; // EL/NLQ is deliberately fail-closed until direct EL is added.
+    pl_shader_decode_color_ex(sh, pl_color_decode_args(.repr = &repr));
+
+    struct pass_state causal = {
+        .rr = rr,
+        .img = {
+            .sh = sh,
+            .w = pl_rect_w(rounded),
+            .h = pl_rect_h(rounded),
+            .repr = repr,
+            .color = image->color,
+            .comps = 3,
+            .rect = {0, 0, pl_rect_w(rounded), pl_rect_h(rounded)},
+        },
+    };
+    return causal_make_proxy(&causal, dp) &&
+           (live->causal_proxy = causal.causal_proxy, true);
+error:
+    pl_dispatch_abort(dp, &sh);
+    return false;
+}
