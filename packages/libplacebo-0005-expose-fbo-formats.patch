From 2b4615b6332e3f1f3e859809339504ecfd16099f Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:52:57 -0500
Subject: [PATCH] renderer: expose effective intermediate FBO formats


diff --git a/src/include/libplacebo/renderer.h b/src/include/libplacebo/renderer.h
index 81f3f712c7072be14f0aec6561737b2d126590a5..2ffc32ea4acb3a9f7fa9fef20c292753b2b83b28 100644
--- a/src/include/libplacebo/renderer.h
+++ b/src/include/libplacebo/renderer.h
@@ -73,6 +73,11 @@ PL_API void pl_renderer_destroy(pl_renderer *rr);
 // Returns current renderer state, see pl_render_errors.
 PL_API struct pl_render_errors pl_renderer_get_errors(pl_renderer rr);
 
+// Returns the effective intermediate FBO formats selected by the most recent
+// render pass, indexed by component count minus one. Entries are NULL until a
+// render pass initializes them, or when FBO rendering is unavailable.
+PL_API void pl_renderer_get_fbo_formats(pl_renderer rr, pl_fmt out_formats[4]);
+
 // Clears errors state of renderer. If `errors` is NULL, all render errors will
 // be cleared. Otherwise only selected errors/hooks will be cleared.
 // If `PL_RENDER_ERR_HOOKS` is set and `num_disabled_hooks` is 0, clear all hooks.
diff --git a/src/renderer.c b/src/renderer.c
index 9cf9a90727532b62c63bafb119e3b637a3800cdc..5d70743d296d027a066b1feb2c2862bd1a2d3579 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -61,6 +61,9 @@ struct pl_renderer_t {
     // Cached feature checks (inverted)
     enum pl_render_error errors;
 
+    // Effective intermediate formats from the most recently initialized pass.
+    pl_fmt fbo_formats[4];
+
     // List containing signatures of disabled hooks
     PL_ARRAY(uint64_t) disabled_hooks;
 
@@ -3547,6 +3550,8 @@ static bool pass_init(struct pass_state *pass, bool acquire_image)
         goto error;
 
     find_fbo_format(pass);
+    memcpy(pass->rr->fbo_formats, &pass->fbofmt[1],
+           sizeof(pass->rr->fbo_formats));
     pass_fix_frames(pass);
 
     pass->tmp = pl_tmp(NULL);
@@ -4398,6 +4403,11 @@ struct pl_render_errors pl_renderer_get_errors(pl_renderer rr)
     };
 }
 
+void pl_renderer_get_fbo_formats(pl_renderer rr, pl_fmt out_formats[4])
+{
+    memcpy(out_formats, rr->fbo_formats, sizeof(rr->fbo_formats));
+}
+
 void pl_renderer_reset_errors(pl_renderer rr,
                               const struct pl_render_errors *errors)
 {
