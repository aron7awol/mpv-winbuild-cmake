         goto cleanup; // DV metadata already present
 
     enum pl_hdr_metadata_type metadata = PL_HDR_METADATA_ANY;
@@ -1430,6 +1434,7 @@ static void hdr_update_peak(struct pass_state *pass)
     struct pl_peak_detect_params peak_params = *params->peak_detect_params;
