+static void emit_p3d_brightness_restore(pl_shader sh, const struct pl_gamut_map_params *gamut,
+                                      ident_t metric, ident_t brightness,
+                                      ident_t ipt2lms, ident_t lms2ipt)
+{
+    const struct pl_raw_primaries *working=pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    const pl_matrix3x3 target=pl_get_color_mapping_matrix(working,&gamut->output_gamut,PL_INTENT_RELATIVE_COLORIMETRIC);
+    const pl_matrix3x3 inverse=pl_get_color_mapping_matrix(&gamut->output_gamut,working,PL_INTENT_RELATIVE_COLORIMETRIC);
+    const float peak=pl_hdr_rescale(PL_HDR_PQ,PL_HDR_NITS,gamut->max_luma)/10000;
+    ident_t rgb=emit_p3d_rgb(sh,ipt2lms);
