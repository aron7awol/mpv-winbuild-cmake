From fde6d0c11659dbc23049cf685ae9d14a2a157264 Mon Sep 17 00:00:00 2001
From: mpv-ht development <development@mpv-ht.local>
Date: Mon, 31 Aug 2026 22:50:53 -0400
Subject: [PATCH 34/34] gpu-next: crop detected bars for image positioning

---
 video/out/vo_gpu_next.c | 21 ++++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 5473902fa..fe94f05c8 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -238,6 +238,7 @@ struct gl_next_opts {
     bool causal_scene_acceleration;
     bool authored_scene_reset;
     bool automatic_aspect_ratio;
+    bool automatic_aspect_ratio_crop;
     float automatic_aspect_ratio_canvas;
     int sub_hdr_peak;
     int image_subs_hdr_peak;
@@ -278,6 +279,7 @@ const struct m_sub_options gl_next_conf = {
         {"hdr-causal-scene-acceleration", OPT_BOOL(causal_scene_acceleration), M_OPT_NOCFG},
         {"hdr-authored-scene-reset", OPT_BOOL(authored_scene_reset)},
         {"automatic-aspect-ratio", OPT_BOOL(automatic_aspect_ratio)},
+        {"automatic-aspect-ratio-crop", OPT_BOOL(automatic_aspect_ratio_crop)},
         {"automatic-aspect-ratio-canvas",
             OPT_FLOAT(automatic_aspect_ratio_canvas), M_RANGE(0, 10)},
         {"border-background", OPT_CHOICE(border_background,
@@ -1261,7 +1263,8 @@ static struct mp_rect active_source_rect(struct priv *p, uint64_t tag,
 }
 
 static struct mp_rect fit_active_destination(struct mp_rect canvas,
-                                             int active_w, int active_h)
+                                             int active_w, int active_h,
+                                             float align_x, float align_y)
 {
     int cw = mp_rect_w(canvas), ch = mp_rect_h(canvas);
     if (cw < 1 || ch < 1 || active_w < 1 || active_h < 1)
@@ -1276,8 +1279,8 @@ static struct mp_rect fit_active_destination(struct mp_rect canvas,
         h = ch;
         w = lrint(ch * source_ar);
     }
-    int x = canvas.x0 + (cw - w) / 2;
-    int y = canvas.y0 + (ch - h) / 2;
+    int x = canvas.x0 + lrint((cw - w) * (MPCLAMP(align_x, -1, 1) + 1) / 2);
+    int y = canvas.y0 + lrint((ch - h) * (MPCLAMP(align_y, -1, 1) + 1) / 2);
     return (struct mp_rect) {x, y, x + w, y + h};
 }
 
@@ -2296,11 +2299,15 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
             p->next_opts->automatic_aspect_ratio && vo->opts->fullscreen &&
             (int64_t) mp_rect_w(aspect_canvas) * 9 >
             (int64_t) mp_rect_h(aspect_canvas) * 16;
-        if (p->automatic_aspect_effective && p->active_image_available) {
+        bool detected_crop_effective = vo->opts->fullscreen &&
+            (p->automatic_aspect_effective ||
+             p->next_opts->automatic_aspect_ratio_crop);
+        if (detected_crop_effective && p->active_image_available) {
             int active_h = p->active_image.source_h - p->active_image.top -
                            p->active_image.bottom;
             struct mp_rect auto_dst = fit_active_destination(
-                aspect_canvas, p->active_image.source_w, active_h);
+                aspect_canvas, p->active_image.source_w, active_h,
+                vo->opts->align_x, vo->opts->align_y);
             apply_crop(&target, auto_dst, swframe.fbo->params.w,
                        swframe.fbo->params.h);
         }
@@ -2316,7 +2323,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
 #if PL_API_VER >= 367
             apply_dovi_enhancement_layer(p, image, fp);
 #endif
-            if (p->automatic_aspect_effective) {
+            if (detected_crop_effective) {
                 struct mp_rect auto_src = active_source_rect(
                     p, fp->causal_scene_tag, vo->params->w, vo->params->h);
                 apply_crop(image, auto_src, vo->params->w, vo->params->h);
@@ -2369,7 +2376,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         // AR transition, render the current frame alone; this keeps optional
         // interpolation from softening or delaying an otherwise exact cut.
         const struct pl_frame *current = pl_frame_mix_current(&mix);
-        if (p->automatic_aspect_effective && current && mix.num_frames > 1) {
+        if (detected_crop_effective && current && mix.num_frames > 1) {
             bool mixed_apertures = false;
             int current_index = -1;
             for (int i = 0; i < mix.num_frames; i++) {
-- 
