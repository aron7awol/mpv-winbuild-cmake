     struct pl_buffer_var result_var={.var={.name="samples",.type=PL_VAR_FLOAT,.dim_v=4,.dim_m=1,.dim_a=result_count},.layout={.offset=(size_t)offset*4,.stride=16,.size=(size_t)result_count*16}};
     desc[0]=(struct pl_shader_desc){.desc={.name="FrameResults",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=slot->buf,.buffer_vars=&result_var,.num_buffer_vars=1};
     char *finish=talloc_asprintf(NULL,
@@ -91,7 +92,7 @@ static bool async_frame_dispatch(struct priv *p, const struct pl_hook_params *hp
