diff --git a/video/out/output_capture.h b/video/out/output_capture.h
new file mode 100644
index 000000000..cfb8a324e
--- /dev/null
+++ b/video/out/output_capture.h
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// On-demand diagnostics: read the real D3D11 backbuffer after all live rendering,
+// before Present. No screenshot render, format conversion or persistent copy.
+// Kept on the VO thread so arming, cancellation and backend lifetime are ordered.
+
+static void output_capture_finish(struct priv *p, int state, const char *error)
+{
+    if (p->capture_file && fclose(p->capture_file) != 0 && state == 2) {
+        state = 3;
+        error = "Closing capture file failed";
+    }
+    p->capture_file = NULL;
+    if (state != 2 && p->capture_path)
+        unlink(p->capture_path); // only the file exclusively created by this request
+    TA_FREEP(&p->capture_path);
+    p->capture_status.state = state;
+    snprintf(p->capture_status.error, sizeof(p->capture_status.error), "%s", error);
+    if (state == 3)
+        MP_ERR(p, "Output capture failed: %s\n", error);
+}
+
+static int output_capture_request(struct vo *vo,
+                                  struct voctrl_capture_output_request *r)
+{
+    struct priv *p = vo->priv;
+    if (!r->path || !r->path[0]) {
+        if (p->capture_file)
+            output_capture_finish(p, 4, "Cancelled");
+        r->sequence = p->capture_status.sequence;
+        return VO_TRUE;
+    }
+    if (p->capture_file || !vo->params || !p->sw)
+        return VO_FALSE;
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    if (!ra_is_d3d11(p->ra_ctx->ra))
+        return VO_FALSE;
+#else
+    return VO_FALSE;
+#endif
+    // Never overwrite a previous capture or an unrelated file.
+    FILE *file = fopen(r->path, "wbx");
+    if (!file)
+        return VO_FALSE;
+    p->capture_file = file;
+    p->capture_path = talloc_strdup(p, r->path);
+    p->capture_status = (struct voctrl_output_capture){
+        .state = 1, .sequence = p->capture_status.sequence + 1,
+    };
+    r->sequence = p->capture_status.sequence;
+    if (r->redraw)
+        vo->want_redraw = true; // normal cache reuse, not screenshot rendering
+    return VO_TRUE;
+}
+
+static void output_capture_frame(struct priv *p,
+                                  const struct pl_swapchain_frame *swframe,
+                                  const struct pl_frame *target)
+{
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    IDXGISwapChain *swap = NULL;
+    ID3D11Texture2D *source = NULL, *staging = NULL;
+    ID3D11Device *device = NULL;
+    ID3D11DeviceContext *context = NULL;
+    D3D11_MAPPED_SUBRESOURCE mapped = {0};
+    bool is_mapped = false, success = false;
+    const char *error = "D3D11 backbuffer readback failed";
+    pl_fmt fmt = swframe->fbo->params.format;
+    if (fmt->opaque || !fmt->texel_size) {
+        output_capture_finish(p, 3, "Unsupported opaque framebuffer format");
+        return;
+    }
+    swap = pl_d3d11_swapchain_unwrap(p->sw);
+    if (!swap || FAILED(IDXGISwapChain_GetBuffer(swap, 0,
+                            &IID_ID3D11Texture2D, (void **)&source)))
+        goto done;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D_GetDesc(source, &desc);
+    size_t row = (size_t)desc.Width * fmt->texel_size;
+    if (!desc.Width || !desc.Height || row > (512u << 20) / desc.Height ||
+        desc.SampleDesc.Count != 1 || desc.ArraySize != 1 || desc.MipLevels != 1 ||
+        desc.Width != swframe->fbo->params.w || desc.Height != swframe->fbo->params.h) {
+        error = "Unsupported or oversized backbuffer";
+        goto done;
+    }
+    unsigned dxgi_format = desc.Format;
+    ID3D11Texture2D_GetDevice(source, &device);
+    ID3D11Device_GetImmediateContext(device, &context);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(device, &desc, NULL, &staging)))
+        goto done;
+    // Same format and dimensions: exact native bits, no sampling/color pass.
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)staging,
+                                     (ID3D11Resource *)source);
+    if (FAILED(ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0,
+                                      D3D11_MAP_READ, 0, &mapped)))
+        goto done;
+    is_mapped = true;
+    if (mapped.RowPitch < row)
+        goto done;
+    FILE *file = p->capture_file;
+    // Format/CSP labels are libplacebo constants, not user-supplied strings.
+    int n = fprintf(file,
+        "MPVCAP1\n{\"sequence\":%"PRId64",\"width\":%u,\"height\":%u,"
+        "\"format\":\"%s\",\"dxgi_format\":%u,\"type\":%d,"
+        "\"texel_size\":%zu,\"row_bytes\":%zu,\"bytes\":%zu,"
+        "\"host_bits\":[%d,%d,%d,%d],\"sample_order\":[%d,%d,%d,%d],"
+        "\"flipped\":%s,\"primaries\":\"%s\",\"transfer\":\"%s\","
+        "\"min_luma\":%.9g,\"max_luma\":%.9g,\"levels\":%d,\"alpha\":%d,"
+        "\"capture_stage\":\"before-present\",\"frame_id\":%"PRIu64",\"pts\":%.17g}\n",
+        p->capture_status.sequence, desc.Width, desc.Height, fmt->name,
+        dxgi_format, fmt->type, fmt->texel_size, row, row * desc.Height,
+        fmt->host_bits[0], fmt->host_bits[1], fmt->host_bits[2], fmt->host_bits[3],
+        fmt->sample_order[0], fmt->sample_order[1], fmt->sample_order[2], fmt->sample_order[3],
+        swframe->flipped ? "true" : "false",
+        pl_color_primaries_name(target->color.primaries),
+        pl_color_transfer_name(target->color.transfer),
+        isfinite(target->color.hdr.min_luma) ? target->color.hdr.min_luma : 0.0,
+        isfinite(target->color.hdr.max_luma) ? target->color.hdr.max_luma : 0.0,
+        target->repr.levels, target->repr.alpha, p->last_id,
+        isfinite(p->last_pts) ? p->last_pts : 0.0);
+    error = "Writing capture file failed";
+    if (n < 0)
+        goto done;
+    for (unsigned y = 0; y < desc.Height; y++) {
+        const uint8_t *pixels = (const uint8_t *)mapped.pData + (size_t)y * mapped.RowPitch;
+        if (fwrite(pixels, 1, row, file) != row)
+            goto done;
+    }
+    p->capture_status.width = desc.Width;
+    p->capture_status.height = desc.Height;
+    success = true;
+done:
+    if (is_mapped) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+    if (context) ID3D11DeviceContext_Release(context);
+    if (device) ID3D11Device_Release(device);
+    if (staging) ID3D11Texture2D_Release(staging);
+    if (source) ID3D11Texture2D_Release(source);
+    if (swap) IDXGISwapChain_Release(swap);
+    output_capture_finish(p, success ? 2 : 3, success ? "" : error);
+#else
+    output_capture_finish(p, 3, "Output capture requires D3D11");
+#endif
+}
