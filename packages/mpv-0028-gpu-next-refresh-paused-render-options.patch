From 790c7c65e11f37304b653879d1348fc296071b80 Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:49:55 -0500
Subject: [PATCH] gpu-next: invalidate cached frames after option changes

VOCTRL_UPDATE_RENDER_OPTS already requests a redraw, but gpu-next can reuse
libplacebo intermediates cached before the new options were applied. This is
most visible while paused, where no new video frame arrives to replace them.

Invalidate the renderer cache whenever render options actually change. The
existing draw-frame flush path then rebuilds cached frames with the new
options, covering current and future live controls without option-specific
invalidation.

diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index db470237b2cbf4dfe67b1bf6271d897ddce15e8a..9915da25ba914893b6e7044a84aa77978be03ad8 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1227,13 +1227,13 @@ static void update_options(struct vo *vo)
 {
     struct priv *p = vo->priv;
     pl_options pars = p->pars;
-    bool old_dovi_enhancement_layer = p->next_opts->dovi_enhancement_layer;
     bool changed = m_config_cache_update(p->opts_cache);
     changed = m_config_cache_update(p->next_opts_cache) || changed;
-    if (changed)
+    if (changed) {
         update_render_options(vo);
-    if (old_dovi_enhancement_layer != p->next_opts->dovi_enhancement_layer)
+        // Cached intermediates were produced with the previous options.
         p->flush_cache = true;
+    }
 
     update_lut(p, &p->next_opts->lut);
     pars->params.lut = p->next_opts->lut.lut;
