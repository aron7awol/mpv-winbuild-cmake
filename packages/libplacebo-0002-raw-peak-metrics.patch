+                float r = powf(color[0], 2.2f);
+                float g = powf(color[1], 2.2f);
+                float b = powf(color[2], 2.2f);
+                float luma = 0.212639f * r + 0.715169f * g + 0.072192f * b;
                 luma = pl_hdr_rescale(PL_HDR_NORM, PL_HDR_PQ, luma);
                 real_peak = PL_MAX(real_peak, luma);
                 real_avg += luma;
+                float max_rgb = PL_COLOR_SDR_WHITE * PL_MAX(r, PL_MAX(g, b));
+                real_rgb_peak = PL_MAX(real_rgb_peak, max_rgb);
