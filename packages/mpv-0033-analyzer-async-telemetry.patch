diff --git a/player/command.c b/player/command.c
index 31464ce34be37fa71746bc899449c56340da1f69..3d0317c8f28ae8f1381e4aa96e87e5d0d274ea3d 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2770,6 +2770,108 @@ static int mp_property_gpu_render_formats(void *ctx, struct m_property *prop,
     return m_property_read_sub(props, action, arg);
 }
 
+static int mp_property_async_probe(void *ctx, struct m_property *prop, int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct voctrl_async_probe v = {0};
+    struct vo *vo = mpctx->video_out;
+    if (!vo) return M_PROPERTY_UNAVAILABLE;
+    mp_mutex_lock(&vo->async_probe_mutex);
+    v = vo->async_probe_snapshot;
+    mp_mutex_unlock(&vo->async_probe_mutex);
+    vo_wakeup(vo); // Request a future zero-timeout poll; never wait for the VO thread.
+    if (!v.sequence) return M_PROPERTY_UNAVAILABLE;
+    char *hist = talloc_strdup(NULL, "");
+    // Fixed upper bound avoids quadratic realloc/copy when Lua polls histograms.
+    char *frame = talloc_zero_size(NULL, 16384);
+    char *output_frame = talloc_zero_size(NULL, 16384);
+    if (v.mode==3 && v.stats_ns) for(int stage=0;stage<2;stage++) {
+        char *text=stage ? output_frame : frame;
+        int offset=stage ? 576 : 16;
+        size_t used=0;
+        for(int i=0;i<532;i++) {
+            int n=snprintf(text+used,16384-used,"%s%.9g",i?",":"",v.values[offset+i]);
+            if(n<0 || (size_t)n>=16384-used){text[0]=0;break;}
+            used+=n;
+        }
+    }
+    if (v.mode == 2) for (int i = 4; i < 260; i++)
+        hist = talloc_asprintf_append(hist, "%s%.0f", i == 4 ? "" : ",", v.values[i]);
+    struct m_sub_property props[] = {
+        {"waveform-x", SUB_PROP_INT(v.wave_x)}, {"waveform-y", SUB_PROP_INT(v.wave_y)},
+        {"waveform-w", SUB_PROP_INT(v.wave_w)}, {"waveform-h", SUB_PROP_INT(v.wave_h)},
+        {"waveform-sequence", SUB_PROP_INT64(v.wave_sequence)},
+        {"sequence", SUB_PROP_INT64(v.sequence)}, {"skipped", SUB_PROP_INT64(v.skipped)},
+        {"x", SUB_PROP_INT(v.x)}, {"y", SUB_PROP_INT(v.y)}, {"mode", SUB_PROP_INT(v.mode)},
+        {"ready-ms", SUB_PROP_DOUBLE(v.ready_ms)},
+        {"age-ms", SUB_PROP_DOUBLE((mp_time_ns() - v.submitted_ns) / 1e6)},
+        {"r", SUB_PROP_DOUBLE(v.values[0])}, {"g", SUB_PROP_DOUBLE(v.values[1])},
+        {"b", SUB_PROP_DOUBLE(v.values[2])}, {"histogram", SUB_PROP_STR(hist)},
+        {"Y", SUB_PROP_DOUBLE(v.values[3])}, {"P", SUB_PROP_DOUBLE(v.values[4])},
+        {"cx", SUB_PROP_DOUBLE(v.values[5])}, {"cy", SUB_PROP_DOUBLE(v.values[6])},
+        {"gamut", SUB_PROP_INT((int)v.values[7])}, {"de", SUB_PROP_DOUBLE(v.values[8])},
+        {"sdr", SUB_PROP_BOOL(v.values[9] > .5f)}, {"chromatic", SUB_PROP_BOOL(v.values[10] > .5f)},
+        {"valid", SUB_PROP_BOOL(v.values[11] > .5f)},
+        {"output-r", SUB_PROP_DOUBLE(v.values[548])}, {"output-g", SUB_PROP_DOUBLE(v.values[549])},
+        {"output-b", SUB_PROP_DOUBLE(v.values[550])}, {"output-Y", SUB_PROP_DOUBLE(v.values[551])},
+        {"output-P", SUB_PROP_DOUBLE(v.values[552])}, {"output-valid", SUB_PROP_BOOL(v.values[553] > .5f)},
+        {"output-cx", SUB_PROP_DOUBLE(v.values[554])}, {"output-cy", SUB_PROP_DOUBLE(v.values[555])},
+        {"output-chromatic", SUB_PROP_BOOL(v.values[556] > .5f)},
+        {"frame", SUB_PROP_STR(frame)}, {"frame-age-ms", SUB_PROP_DOUBLE(v.stats_ns ? (mp_time_ns()-v.stats_ns)/1e6 : -1)},
+        {"output-frame", SUB_PROP_STR(output_frame)},
+        {"frame-sequence", SUB_PROP_INT64(v.stats_ns)}, {0}
+    };
+    int ret = m_property_read_sub(props, action, arg);
+    talloc_free(hist);
+    talloc_free(frame);
+    talloc_free(output_frame);
+    return ret;
+}
+
+// Queried only when frame-sequence changes, not for every cursor update.
+static int mp_property_analyzer_chromaticity(void *ctx, struct m_property *prop,
+                                            int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct vo *vo = mpctx->video_out;
+    if (!vo) return M_PROPERTY_UNAVAILABLE;
+    float bins[6400];
+    float colors[131072];
+    int64_t sequence;
+    mp_mutex_lock(&vo->async_probe_mutex);
+    sequence = vo->async_probe_snapshot.stats_ns;
+    memcpy(bins, vo->async_probe_snapshot.values+1120, sizeof(bins));
+    memcpy(colors, vo->async_probe_snapshot.values+7520, sizeof(colors));
+    mp_mutex_unlock(&vo->async_probe_mutex);
+    if (!sequence) return M_PROPERTY_UNAVAILABLE;
+    char *text = talloc_zero_size(NULL, 131072);
+    char *rgb = talloc_zero_size(text, 4194304);
+    size_t rgb_used = 0;
+    size_t used = 0;
+    // Sparse index:count representation bounds transport and Lua parse work.
+    for (int i=0; i<6400; i++) if (bins[i]>0) {
+        int n=snprintf(text+used,131072-used,"%s%d:%.0f",used?",":"",i,bins[i]);
+        if (n<0 || (size_t)n>=131072-used) { talloc_free(text); return M_PROPERTY_ERROR; }
+        used+=n;
+    }
+    // Colors have their own finer grid; legacy density bins retain their ABI.
+    for (int i=0; i<23104; i++) if (colors[4*i+3]>0) {
+        int n=snprintf(rgb+rgb_used,4194304-rgb_used,"%s%d:%.9g:%.9g:%.9g:%.9g",rgb_used?",":"",i,
+            colors[4*i],colors[4*i+1],colors[4*i+2],colors[4*i+3]);
+        if(n<0 || (size_t)n>=4194304-rgb_used){talloc_free(text);return M_PROPERTY_ERROR;}
+        rgb_used+=n;
+    }
+    struct m_sub_property props[] = {
+        {"frame-sequence", SUB_PROP_INT64(sequence)}, {"size", SUB_PROP_INT(80)},
+        {"bins", SUB_PROP_STR(text)}, {"colors", SUB_PROP_STR(rgb)},
+        {"colors-size", SUB_PROP_INT(152)},
+        {"color-space", SUB_PROP_STR("bt.2020-linear-nits")}, {0}
+    };
+    int ret=m_property_read_sub(props,action,arg);
+    talloc_free(text);
+    return ret;
+}
+
 static int mp_property_video_active_image(void *ctx, struct m_property *prop,
                                           int action, void *arg)
 {
@@ -4884,6 +4986,8 @@ static const struct m_property mp_properties_base[] = {
     {"video-out-params", mp_property_vo_imgparams},
     {"gpu-render-formats", mp_property_gpu_render_formats},
     {"video-active-image", mp_property_video_active_image},
+    {"analyzer-async-result", mp_property_async_probe},
+    {"analyzer-chromaticity", mp_property_analyzer_chromaticity},
     {"video-dec-params", mp_property_dec_imgparams},
     {"video-params", mp_property_vd_imgparams},
     {"video-frame-info", mp_property_video_frame_info},
diff --git a/video/out/analyzer_async_bridge.h b/video/out/analyzer_async_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..ae9ed809cf78849728a241bb534eb197802fa6b8
--- /dev/null
+++ b/video/out/analyzer_async_bridge.h
@@ -0,0 +1,222 @@
+/* Experimental, included by vo_gpu_next.c after gl_next_opts. Not a release patch. */
+struct async_probe_slot {
+    pl_buf buf;
+    pl_buf scratch;
+    pl_buf output_scratch;
+    pl_tex output_linear;
+    bool pending;
+    struct voctrl_async_probe meta;
+};
+struct async_probe {
+    pl_buf xy_buf;
+    pl_tex xy_tex;
+    pl_tex xy_display;
+    struct pl_overlay_part xy_part;
+    struct pl_overlay *xy_overlays;
+    float xy_cap, xy_background;
+    pl_buf wave_buf;
+    pl_tex wave_tex;
+    struct pl_overlay_part wave_part;
+    struct pl_overlay *wave_overlays;
+    pl_rect2df wave_dst;
+    int wave_x, wave_y, wave_w, wave_h, wave_rotation;
+    int64_t wave_sequence;
+    struct pl_hook hook;
+    struct pl_hook_params output;
+    bool output_valid;
+    uint64_t render_revision, last_render_revision;
+    struct pl_color_space last_output_color;
+    pl_rect2df last_output_rect;
+    struct async_probe_slot slots[4];
+    struct voctrl_async_probe latest;
+    int64_t sequence, skipped;
+    uint64_t last_stats_revision, last_stats_parameters;
+    const struct pl_hook *last_stats_hook;
+};
+
+#include "analyzer_frame_bridge.h"
+#include "analyzer_output_bridge.h"
+#include "analyzer_waveform_bridge.h"
+#include "analyzer_chromaticity_bridge.h"
+
+static void async_probe_collect(struct priv *p)
+{
+    struct async_probe *a = p->async_probe;
+    if (!a) return;
+    for (int i = 0; i < 4; i++) {
+        struct async_probe_slot *s = &a->slots[i];
+        if (!s->pending || pl_buf_poll(p->gpu, s->buf, 0)) continue;
+        float values[138592] = {0};
+        size_t size = s->meta.mode == 3 ? sizeof(values) : s->meta.mode == 2 ? 260 * sizeof(float) : 4 * sizeof(float);
+        if (pl_buf_read(p->gpu, s->buf, 0, values, size) &&
+            s->meta.mode == p->next_opts->analyzer_async) {
+            // Frame and cursor snapshots have independent cadences. A newer
+            // cursor slot must not discard an older newly completed frame job.
+            if(s->meta.stats_ns > a->latest.stats_ns) {
+                memcpy(a->latest.values+16,values+16,(548-16)*sizeof(float));
+                memcpy(a->latest.values+576,values+576,532*sizeof(float));
+                memcpy(a->latest.values+1120,values+1120,137472*sizeof(float));
+                a->latest.stats_ns=s->meta.stats_ns;
+            }
+            if(s->meta.sequence <= a->latest.sequence) {s->pending=false;continue;}
+            if (s->meta.mode==3 && !s->meta.stats_ns) {
+                memcpy(values+16,a->latest.values+16,(548-16)*sizeof(float));
+                memcpy(values+576,a->latest.values+576,532*sizeof(float));
+                memcpy(values+1120,a->latest.values+1120,137472*sizeof(float));
+                s->meta.stats_ns=a->latest.stats_ns;
+            }
+            a->latest = s->meta;
+            memcpy(a->latest.values, values, sizeof(values));
+            a->latest.ready_ms = (mp_time_ns() - s->meta.submitted_ns) / 1e6;
+        }
+        s->pending = false;
+    }
+    a->latest.skipped = a->skipped;
+    a->latest.wave_x=a->wave_x;a->latest.wave_y=a->wave_y;
+    a->latest.wave_w=a->wave_w;a->latest.wave_h=a->wave_h;
+    a->latest.wave_sequence=a->wave_sequence;
+    struct vo *vo = a->hook.priv;
+    mp_mutex_lock(&vo->async_probe_mutex);
+    vo->async_probe_snapshot = p->next_opts->analyzer_async ? a->latest : (struct voctrl_async_probe){0};
+    mp_mutex_unlock(&vo->async_probe_mutex);
+}
+
+static struct pl_hook_res async_probe_hook(void *priv, const struct pl_hook_params *hp)
+{
+    struct vo *vo = priv;
+    struct priv *p = vo->priv;
+    struct async_probe *a = p->async_probe;
+    if (hp->stage == PL_HOOK_PRE_OUTPUT) {
+        // Borrowed only until OUTPUT in this same render; never between frames.
+        a->output = *hp;
+        a->output_valid = true;
+        return (struct pl_hook_res){0};
+    }
+    async_probe_collect(p);
+    int x, y, hover;
+    mp_input_get_mouse_pos(vo->input_ctx, &x, &y, &hover);
+    int w = mp_rect_w(p->dst), h = mp_rect_h(p->dst);
+    if (w<=0 || h<=0) return (struct pl_hook_res){0};
+    if (p->next_opts->analyzer_async!=3 && (!hover || x < p->dst.x0 || x >= p->dst.x1 ||
+        y < p->dst.y0 || y >= p->dst.y1)) return (struct pl_hook_res){0};
+    struct async_probe_slot *s = NULL;
+    for (int i = 0; i < 4; i++) if (!a->slots[i].pending) { s = &a->slots[i]; break; }
+    if (!s) { a->skipped++; return (struct pl_hook_res){0}; }
+    if (!s->buf) s->buf = pl_buf_create(p->gpu, pl_buf_params(
+        .size = 138592 * sizeof(float), .memory_type = PL_BUF_MEM_DEVICE,
+        .host_readable = true, .storable = true));
+    if (!s->buf) return (struct pl_hook_res){0};
+    float pos[] = {
+        (hp->rect.x0 + (x - p->dst.x0 + .5f) / w * (hp->rect.x1-hp->rect.x0)) / hp->tex->params.w,
+        (hp->rect.y0 + (y - p->dst.y0 + .5f) / h * (hp->rect.y1-hp->rect.y0)) / hp->tex->params.h};
+    struct pl_shader_var vars[] = {{.var = pl_var_vec2("probe_pos"), .data = pos, .dynamic = true}};
+    struct pl_buffer_var bv = {
+        .var = {.name = "samples", .type = PL_VAR_FLOAT, .dim_v = 4, .dim_m = 1, .dim_a = 140},
+        .layout = {.offset = 0, .stride = 16, .size = 2240},
+    };
+    pl_tex texture = hp->tex;
+    const struct pl_hook *source_hook=NULL;
+    if (p->next_opts->analyzer_async == 3) {
+        texture = NULL;
+        for (int i = 0; i < p->num_user_hooks && !texture; i++) {
+            bool active = false;
+            for (int j = 0; j < p->pars->params.num_hooks; j++)
+                active |= p->pars->params.hooks[j] == p->user_hooks[i].hook;
+            if (active) {
+                texture = pl_mpv_user_shader_saved_texture(p->user_hooks[i].hook, "ANALYZER_METRICS");
+                if (texture) source_hook=p->user_hooks[i].hook;
+            }
+        }
+        if (!texture) return (struct pl_hook_res){0};
+    }
+    struct pl_shader_desc desc[] = {
+        {.desc = {.name = "probe_tex", .type = PL_DESC_SAMPLED_TEX},
+         .binding = {.object = texture, .address_mode = PL_TEX_ADDRESS_CLAMP, .sample_mode = PL_TEX_SAMPLE_NEAREST}},
+        {.desc = {.name = "ProbeData", .type = PL_DESC_BUF_STORAGE, .access = PL_DESC_ACCESS_WRITEONLY},
+         .binding.object = s->buf, .buffer_vars = &bv, .num_buffer_vars = 1},
+    };
+    /* Single small invocation: deliberately simple transport benchmark, not production histogram code. */
+    const char *body = p->next_opts->analyzer_async == 3 ?
+        "for(int i=0;i<4;i++) samples[i]=vec4(0); for(int i=137;i<140;i++)samples[i]=vec4(0);"
+        "for(int i=0;i<12;i++){uvec4 b=uvec4(texelFetch(probe_tex,ivec2(i,0),0)+0.5);"
+        "samples[i/4][i%4]=uintBitsToFloat(b.x|(b.y<<8u)|(b.z<<16u)|(b.w<<24u));}" :
+        p->next_opts->analyzer_async == 2 ?
+        "float hist[256]; for(int i=0;i<256;i++) hist[i]=0.0;"
+        "for(int y=0;y<36;y++) for(int x=0;x<64;x++){"
+        "vec3 c=textureLod(probe_tex,(vec2(x,y)+0.5)/vec2(64,36),0.0).rgb;"
+        "int b=int(clamp(max(c.r,max(c.g,c.b)),0.0,1.0)*255.0); hist[b]+=1.0;}"
+        "for(int i=0;i<64;i++) samples[i+1]=vec4(hist[4*i],hist[4*i+1],hist[4*i+2],hist[4*i+3]);"
+        "samples[0]=textureLod(probe_tex,probe_pos,0.0);" :
+        "samples[0]=textureLod(probe_tex,probe_pos,0.0);";
+    pl_shader sh = pl_dispatch_begin(hp->dispatch);
+    int64_t submitted = mp_time_ns();
+    bool ok = pl_shader_custom(sh, &(struct pl_custom_shader){
+        .description = "experimental async Analyzer readback", .body = body,
+        .input = PL_SHADER_SIG_NONE, .output = PL_SHADER_SIG_NONE,
+        .variables = vars, .num_variables = 1,
+        .descriptors = desc, .num_descriptors = 2,
+        .compute = true, .compute_group_size = {1, 1},
+    }) && pl_dispatch_compute(hp->dispatch, pl_dispatch_compute_params(
+        .shader = &sh, .dispatch_size = {1, 1, 1}));
+    if (!ok) { pl_dispatch_abort(hp->dispatch, &sh); return (struct pl_hook_res){0}; }
+    if (source_hook && a->output_valid)
+        async_output_pixel(p, &a->output, s, x, y);
+    s->meta = (struct voctrl_async_probe){.sequence = ++a->sequence,
+        .submitted_ns = submitted, .x = x, .y = y, .mode = p->next_opts->analyzer_async};
+    if (source_hook) {
+        uint64_t revision=pl_mpv_user_shader_saved_revision(source_hook,"ANALYZER_LINEAR");
+        uint64_t parameters=1469598103934665603ULL;
+        for (int i=0;i<source_hook->num_parameters;i++) {
+            const struct pl_hook_par *param=&source_hook->parameters[i];
+            if (strncmp(param->name,"source_",7) && strcmp(param->name,"sdr_reference_peak")) continue;
+            uint32_t bits; memcpy(&bits,param->data,sizeof(bits));
+            parameters=(parameters^bits)*1099511628211ULL;
+        }
+        bool changed=revision!=a->last_stats_revision || parameters!=a->last_stats_parameters || source_hook!=a->last_stats_hook ||
+            a->render_revision!=a->last_render_revision || !pl_color_space_equal(&a->output.color,&a->last_output_color) ||
+            memcmp(&a->output.rect,&a->last_output_rect,sizeof(a->output.rect));
+        if (revision && changed && a->output_valid &&
+            async_frame_dispatch(p,hp,s,source_hook,NULL,0) &&
+            async_output_frame(p,&a->output,s,source_hook) &&
+            analyzer_xy_update(p,hp,s,source_hook)) {
+            s->meta.stats_ns=submitted;
+            analyzer_waveform_update(p,hp,s,source_hook);
+            a->last_stats_revision=revision;
+            a->last_stats_parameters=parameters;
+            a->last_stats_hook=source_hook;
+            a->last_render_revision=a->render_revision;
+            a->last_output_color=a->output.color;
+            a->last_output_rect=a->output.rect;
+        }
+    }
+    a->output_valid = false;
+    s->pending = true;
+    return (struct pl_hook_res){0};
+}
+
+static const struct pl_hook *async_probe_init(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->async_probe) {
+        p->async_probe = talloc_zero(p, struct async_probe);
+        p->async_probe->hook = (struct pl_hook){.stages = PL_HOOK_PRE_OUTPUT | PL_HOOK_OUTPUT,
+            .input = PL_HOOK_SIG_TEX, .priv = vo, .hook = async_probe_hook};
+    }
+    return &p->async_probe->hook;
+}
+
+static void async_probe_destroy(struct priv *p)
+{
+    if (!p->async_probe) return;
+    pl_buf_destroy(p->gpu,&p->async_probe->xy_buf);
+    pl_tex_destroy(p->gpu,&p->async_probe->xy_tex);
+    pl_tex_destroy(p->gpu,&p->async_probe->xy_display);
+    pl_buf_destroy(p->gpu,&p->async_probe->wave_buf);
+    pl_tex_destroy(p->gpu,&p->async_probe->wave_tex);
+    for (int i = 0; i < 4; i++) {
+        pl_buf_destroy(p->gpu, &p->async_probe->slots[i].buf);
+        pl_buf_destroy(p->gpu, &p->async_probe->slots[i].scratch);
+        pl_buf_destroy(p->gpu, &p->async_probe->slots[i].output_scratch);
+        pl_tex_destroy(p->gpu, &p->async_probe->slots[i].output_linear);
+    }
+}
diff --git a/video/out/analyzer_chromaticity_bridge.h b/video/out/analyzer_chromaticity_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..c74b2dd5ac7b4be51942f68fc7c05cfb952da95a
--- /dev/null
+++ b/video/out/analyzer_chromaticity_bridge.h
@@ -0,0 +1,118 @@
+#include "analyzer_xy_tiled_prototype.h"
+/* Brightest-P source pixel per xy cell. Two ordered reductions select an
+ * indivisible RGB triplet; equal-P ties select the first raster-order pixel.
+ * No float atomics, 64-bit atomics, locks, or GPU -> CPU waits are required. */
+static bool analyzer_xy_update(struct priv *p, const struct pl_hook_params *hp,
+                               struct async_probe_slot *slot, const struct pl_hook *hook)
+{
+    struct async_probe *a=p->async_probe;
+    pl_tex source=pl_mpv_user_shader_saved_texture(hook,"ANALYZER_LINEAR");
+    if(!source || !a->xy_tex) return false;
+    if(!a->xy_buf) a->xy_buf=pl_buf_create(p->gpu,pl_buf_params(
+        .size=46208*4,.storable=true,.host_writable=true,.memory_type=PL_BUF_MEM_DEVICE));
+    if(!a->xy_buf) return false;
+    uint32_t initial[46208]={0};
+    for(int i=23104;i<46208;i++) initial[i]=UINT32_MAX;
+    pl_buf_write(p->gpu,a->xy_buf,0,initial,sizeof(initial));
+    float matrix[9];
+    for(int i=0;i<9;i++){char n[40];snprintf(n,sizeof(n),"source_to_bt2020_%d",i);matrix[i]=frame_parameter(hook,n);}
+    float scale=frame_parameter(hook,"source_is_sdr") ? frame_parameter(hook,"sdr_reference_peak") :
+        (frame_parameter(hook,"source_is_absolute") || frame_parameter(hook,"source_is_hlg")) ? 203.f : 100.f;
+    struct pl_shader_var vars[]={
+        {.var={.name="to2020",.type=PL_VAR_FLOAT,.dim_v=3,.dim_m=3,.dim_a=1},.data=matrix,.dynamic=true},
+        {.var=pl_var_float("nits"),.data=&scale,.dynamic=true},
+        {.var=pl_var_float("cap"),.data=&a->xy_cap,.dynamic=true},
+        {.var=pl_var_float("background"),.data=&a->xy_background,.dynamic=true},
+    };
+    struct pl_buffer_var bv={.var={.name="keys",.type=PL_VAR_UINT,.dim_v=1,.dim_m=1,.dim_a=46208},.layout={.offset=0,.stride=4,.size=46208*sizeof(uint32_t)}};
+    struct pl_shader_desc desc[]={
+        {.desc={.name="xy_source",.type=PL_DESC_SAMPLED_TEX},.binding={.object=source,.sample_mode=PL_TEX_SAMPLE_NEAREST}},
+        {.desc={.name="XYWinners",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_READWRITE},.binding.object=a->xy_buf,.buffer_vars=&bv,.num_buffer_vars=1},
+        {0},
+    };
+    const char *bin_math=
+        "int xy_bin(vec3 rgb){vec3 xyz=mat3(.636958,.262700,0.,.144617,.677998,.028073,.168881,.059302,1.060985)*rgb;"
+        "float total=xyz.x+xyz.y+xyz.z;if(!(total>1e-12))return -1;vec2 xy=xyz.xy/total;"
+        "if(!all(greaterThanEqual(xy,vec2(0)))||!all(lessThan(xy,vec2(.8,.9))))return -1;"
+        "ivec2 b=ivec2(xy/vec2(.8,.9)*152.);return b.y*152+b.x;}";
+    bool ok=analyzer_xy_tiled_reduce(p,hp,source,vars,desc,bin_math,23104);
+    if(!ok)return false;
+    struct pl_buffer_var result={.var={.name="xy_colors",.type=PL_VAR_FLOAT,.dim_v=4,.dim_m=1,.dim_a=23104},.layout={.offset=7520*4,.stride=16,.size=23104*16}};
+    desc[2]=(struct pl_shader_desc){.desc={.name="XYColors",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=slot->buf,.buffer_vars=&result,.num_buffer_vars=1};
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description="Analyzer opaque xy color texture",.header=frame_math,
+        .body="ivec2 q=ivec2(gl_FragCoord.xy);int b=(151-q.y)*152+q.x;uint id=keys[23104+b];color=vec4(vec3(background),1.0);xy_colors[b]=vec4(0);"
+              "if(id!=0xffffffffu){int w=textureSize(xy_source,0).x;vec3 c=to2020*texelFetch(xy_source,ivec2(int(id)%w,int(id)/w),0).rgb*nits;"
+              "xy_colors[b]=vec4(c,uintBitsToFloat(keys[b])*nits);"
+              "c*=min(1.,cap/max(max(c.r,c.g),max(c.b,1e-12)));"
+              "color=vec4(c/203.,1.);}",
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_COLOR,.variables=vars,.num_variables=4,.descriptors=desc,.num_descriptors=3}) &&
+        pl_dispatch_finish(hp->dispatch,pl_dispatch_params(.shader=&sh,.target=a->xy_tex));
+    if(!ok){pl_dispatch_abort(hp->dispatch,&sh);return false;}
+    // libplacebo filters overlay textures. Expand with nearest-cell sampling
+    // first, then display 1:1 so occupied cells retain alpha=1 at every pixel.
+    struct pl_shader_desc image={.desc={.name="cells",.type=PL_DESC_SAMPLED_TEX},
+        .binding={.object=a->xy_tex,.sample_mode=PL_TEX_SAMPLE_NEAREST}};
+    float size=(float)a->xy_display->params.w;
+    struct pl_shader_var size_var={.var=pl_var_float("size"),.data=&size,.dynamic=true};
+    sh=pl_dispatch_begin(hp->dispatch);
+    ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description="Analyzer xy nearest-cell expansion",
+        .body="color=texelFetch(cells,clamp(ivec2(gl_FragCoord.xy/size*152.),ivec2(0),ivec2(151)),0);",
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_COLOR,.variables=&size_var,.num_variables=1,.descriptors=&image,.num_descriptors=1}) &&
+        pl_dispatch_finish(hp->dispatch,pl_dispatch_params(.shader=&sh,.target=a->xy_display));
+    if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    return ok;
+}
+
+static void analyzer_xy_prepare(struct priv *p, struct pl_frame *target, struct pl_color_space osd)
+{
+    struct async_probe *a=p->async_probe;
+    if(!a || p->next_opts->analyzer_async!=3)return;
+    pl_color_space_infer(&osd);
+    float code=p->next_opts->analyzer_xy_intensity/255.f;
+    float light=code<=.04045f ? code/12.92f : powf((code+.055f)/1.055f,2.4f);
+    float cap=fmaxf(.0001f,osd.hdr.max_luma*light);
+    // Match the opaque ASS card backing: #080808, alpha 1. Plotted cells
+    // replace that backing with fully opaque source color.
+    float background=(8.f/255.f/12.92f)*osd.hdr.max_luma/203.f;
+    if(cap!=a->xy_cap || background!=a->xy_background){
+        a->xy_cap=cap;a->xy_background=background;a->last_stats_revision=0;
+    }
+    pl_fmt fmt=pl_find_fmt(p->gpu,PL_FMT_FLOAT,4,32,0,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE);
+    bool fresh=!a->xy_tex;
+    if(!fmt)return;
+    // Cached analysis must survive OSD-only redraws. pl_tex_recreate would
+    // invalidate the contents even when the existing allocation already fits.
+    if(fresh){
+        if(!pl_tex_recreate(p->gpu,&a->xy_tex,pl_tex_params(.w=152,.h=152,.format=fmt,.sampleable=true,.renderable=true,.blit_dst=true)))return;
+        pl_tex_clear(p->gpu,a->xy_tex,(float[4]){background,background,background,1});
+        a->last_stats_revision=0;
+    }
+    int size=p->next_opts->analyzer_xy_size;
+    int raster=MPMAX(size,152);
+    bool resized=!a->xy_display || a->xy_display->params.w!=raster;
+    if(resized){
+        if(!pl_tex_recreate(p->gpu,&a->xy_display,pl_tex_params(.w=raster,.h=raster,.format=fmt,.sampleable=true,.renderable=true,.blit_dst=true)))return;
+        pl_tex_clear(p->gpu,a->xy_display,(float[4]){background,background,background,1});
+        a->last_stats_revision=0;
+    }
+    if(size<=0)return;
+    int x=p->next_opts->analyzer_xy_x,y=p->next_opts->analyzer_xy_y;
+    // Crop only the presented slice. The cached 152-grid analysis and opaque
+    // nearest-cell expansion keep their original coordinate scale.
+    int clip_top=p->next_opts->analyzer_xy_clip_height>0 ?
+        MPMIN(p->next_opts->analyzer_xy_clip_top,size) : 0;
+    int height=p->next_opts->analyzer_xy_clip_height>0 ?
+        MPMIN(p->next_opts->analyzer_xy_clip_height,size-clip_top) : size;
+    if(height<=0)return;
+    a->xy_part=(struct pl_overlay_part){
+        .src={0,clip_top*raster/(float)size,raster,(clip_top+height)*raster/(float)size},
+        .dst={x,y,x+size,y+height}};
+    MP_TARRAY_GROW(p,a->xy_overlays,target->num_overlays);
+    memcpy(a->xy_overlays+1,target->overlays,target->num_overlays*sizeof(*target->overlays));
+    a->xy_overlays[0]=(struct pl_overlay){.tex=a->xy_display,.mode=PL_OVERLAY_NORMAL,
+        .repr={.alpha=PL_ALPHA_INDEPENDENT},
+        .color={.primaries=PL_COLOR_PRIM_BT_2020,.transfer=PL_COLOR_TRC_LINEAR,.hdr={.min_luma=0,.max_luma=cap}},
+        .coords=PL_OVERLAY_COORDS_DST_FRAME,.parts=&a->xy_part,.num_parts=1};
+    target->overlays=a->xy_overlays;target->num_overlays++;
+}
diff --git a/video/out/analyzer_frame_bridge.h b/video/out/analyzer_frame_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..421791704296274a2e89575607d61d11110c68e3
--- /dev/null
+++ b/video/out/analyzer_frame_bridge.h
@@ -0,0 +1,104 @@
+/* GPU full-frame reductions. All dispatches and buffer ownership stay on VO thread. */
+#include "analyzer_frame_math.h"
+static float frame_parameter(const struct pl_hook *hook, const char *name)
+{
+    for (int i=0;i<hook->num_parameters;i++) {
+        const struct pl_hook_par *par=&hook->parameters[i];
+        if (!strcmp(par->name,name)) return par->type==PL_VAR_FLOAT ? par->data->f : par->data->i;
+    }
+    return 0;
+}
+
+static bool async_frame_dispatch(struct priv *p, const struct pl_hook_params *hp,
+                                 struct async_probe_slot *slot, const struct pl_hook *hook,
+                                 pl_tex output, int offset)
+{
+    pl_tex source=output ? output : pl_mpv_user_shader_saved_texture(hook,"ANALYZER_LINEAR");
+    if (!source) return false;
+    int w=source->params.w, h=source->params.h;
+    // 80x80 source xy density, in addition to the two 256-bin histograms.
+    // Shared storage stays below D3D11's 32 KiB limit (29,952 bytes).
+    int bins=output ? 512 : 6912;
+    size_t bins_size=(size_t)bins*4;
+    size_t scratch_size=bins_size+(size_t)h*48;
+    pl_buf *scratch=output ? &slot->output_scratch : &slot->scratch;
+    if (*scratch && (*scratch)->params.size!=scratch_size)
+        pl_buf_destroy(p->gpu,scratch);
+    if (!*scratch) *scratch=pl_buf_create(p->gpu,pl_buf_params(
+        .size=scratch_size,.memory_type=PL_BUF_MEM_DEVICE,.storable=true,.host_writable=true));
+    if (!*scratch) return false;
+    uint32_t zero[6912]={0};
+    pl_buf_write(p->gpu,*scratch,0,zero,bins_size);
+    float matrix[9], ycoeff[3];
+    for(int i=0;i<9;i++) { char name[40]; snprintf(name,sizeof(name),"source_to_bt2020_%d",i); matrix[i]=frame_parameter(hook,name); }
+    for(int i=0;i<3;i++) { char name[40]; snprintf(name,sizeof(name),"source_cie_y_%d",i); ycoeff[i]=frame_parameter(hook,name); }
+    float scale=frame_parameter(hook,"source_is_sdr") ? frame_parameter(hook,"sdr_reference_peak") :
+        (frame_parameter(hook,"source_is_absolute") || frame_parameter(hook,"source_is_hlg")) ? 203.f : 100.f;
+    if (output) {
+        const struct pl_raw_primaries *prim=pl_raw_primaries_get(hp->color.primaries);
+        pl_matrix3x3 xyz=pl_get_rgb2xyz_matrix(prim);
+        pl_matrix3x3 map=pl_get_color_mapping_matrix(prim,pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020),PL_INTENT_RELATIVE_COLORIMETRIC);
+        for(int i=0;i<3;i++){ycoeff[i]=xyz.m[1][i];for(int j=0;j<3;j++)matrix[3*j+i]=map.m[i][j];}
+        scale=203.f;
+    }
+    struct pl_shader_var vars[]={
+        {.var={.name="to2020",.type=PL_VAR_FLOAT,.dim_v=3,.dim_m=3,.dim_a=1},.data=matrix,.dynamic=true},
+        {.var=pl_var_vec3("ycoeff"),.data=ycoeff,.dynamic=true},
+        {.var=pl_var_float("nits_scale"),.data=&scale,.dynamic=true},
+    };
+    struct pl_buffer_var scratch_vars[]={
+        {.var={.name="bins",.type=PL_VAR_UINT,.dim_v=1,.dim_m=1,.dim_a=bins},.layout={.offset=0,.stride=4,.size=bins_size}},
+        {.var={.name="rows",.type=PL_VAR_FLOAT,.dim_v=4,.dim_m=1,.dim_a=h*3},.layout={.offset=bins_size,.stride=16,.size=(size_t)h*48}},
+    };
+    struct pl_shader_desc desc[]={
+        {.desc={.name="frame_tex",.type=PL_DESC_SAMPLED_TEX},.binding={.object=source,.address_mode=PL_TEX_ADDRESS_CLAMP,.sample_mode=PL_TEX_SAMPLE_NEAREST}},
+        {.desc={.name="FrameScratch",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_READWRITE},.binding.object=*scratch,.buffer_vars=scratch_vars,.num_buffer_vars=2},
+    };
+    char *header=talloc_asprintf(NULL,"%s\n#define BINS %d\n#define SOURCE_DENSITY %d\nshared vec3 mn[64], mx[64], sm[64];\nshared uint hist[BINS];\n",frame_math,bins,!output);
+    const char *body=
+        "int lane=int(gl_LocalInvocationID.x), y=int(gl_WorkGroupID.y); ivec2 sz=textureSize(frame_tex,0);"
+        "for(int i=lane;i<BINS;i+=64) hist[i]=0u; barrier();"
+        "vec3 lo=vec3(1e30), hi=vec3(0), sum=vec3(0);"
+        "for(int x=lane;x<sz.x;x+=64){vec3 c=texelFetch(frame_tex,ivec2(x,y),0).rgb;"
+        "vec3 v=vec3(max(dot(ycoeff,c),0.0),max(perceptual_bt2020(to2020*c),0.0),max(max(c.r,c.g),max(c.b,0.0)))*nits_scale;"
+        "lo=min(lo,v); hi=max(hi,v); sum+=v;"
+        "int bp=int(clamp(pq_encode_nits(v.y)*256.0,0.0,255.0));"
+        "int br=int(clamp(pq_encode_nits(v.z)*256.0,0.0,255.0));"
+        "atomicAdd(hist[bp],1u); atomicAdd(hist[256+br],1u);"
+        "\n#if SOURCE_DENSITY\n"
+        "vec3 rgb=to2020*c; vec3 xyz=mat3(.636958,.262700,0.0,.144617,.677998,.028073,.168881,.059302,1.060985)*rgb;"
+        "float total=xyz.x+xyz.y+xyz.z;"
+        "if(total>1e-12){vec2 xy=xyz.xy/total;"
+        "if(all(greaterThanEqual(xy,vec2(0))) && all(lessThan(xy,vec2(.8,.9)))){"
+        "ivec2 bin=ivec2(xy/vec2(.8,.9)*80.0);atomicAdd(hist[512+bin.y*80+bin.x],1u);}}"
+        "\n#endif\n}"
+        "mn[lane]=lo; mx[lane]=hi; sm[lane]=sum; barrier();"
+        "for(int step=32;step>0;step/=2){if(lane<step){mn[lane]=min(mn[lane],mn[lane+step]);mx[lane]=max(mx[lane],mx[lane+step]);sm[lane]+=sm[lane+step];}barrier();}"
+        "if(lane==0){rows[3*y]=vec4(mn[0],0);rows[3*y+1]=vec4(mx[0],0);rows[3*y+2]=vec4(sm[0],0);}"
+        "for(int i=lane;i<BINS;i+=64) if(hist[i]>0u) atomicAdd(bins[i],hist[i]);";
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description="Analyzer full source frame reduction",.header=header,.body=body,
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_NONE,.variables=vars,.num_variables=3,.descriptors=desc,.num_descriptors=2,
+        .compute=true,.compute_group_size={64,1}}) && pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={1,h,1}));
+    talloc_free(header);
+    if(!ok){pl_dispatch_abort(hp->dispatch,&sh);return false;}
+    int result_count=output ? 140 : 1880;
+    struct pl_buffer_var result_var={.var={.name="samples",.type=PL_VAR_FLOAT,.dim_v=4,.dim_m=1,.dim_a=result_count},.layout={.offset=(size_t)offset*4,.stride=16,.size=(size_t)result_count*16}};
+    desc[0]=(struct pl_shader_desc){.desc={.name="FrameResults",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=slot->buf,.buffer_vars=&result_var,.num_buffer_vars=1};
+    char *finish=talloc_asprintf(NULL,
+        "int lane=int(gl_LocalInvocationID.x);vec3 lo=vec3(1e30),hi=vec3(0),sum=vec3(0),correction=vec3(0);for(int y=lane;y<%d;y+=64){lo=min(lo,rows[3*y].rgb);hi=max(hi,rows[3*y+1].rgb);vec3 add=rows[3*y+2].rgb-correction;vec3 next=sum+add;correction=(next-sum)-add;sum=next;}"
+        "mn[lane]=lo;mx[lane]=hi;sm[lane]=sum;barrier();"
+        "for(int step=32;step>0;step/=2){if(lane<step){mn[lane]=min(mn[lane],mn[lane+step]);mx[lane]=max(mx[lane],mx[lane+step]);sm[lane]+=sm[lane+step];}barrier();}"
+        "if(lane==0){samples[4]=vec4(mn[0],0);samples[5]=vec4(clamp(sm[0]/%.1f,mn[0],mx[0]),0);samples[6]=vec4(mx[0],0);samples[136]=vec4(%d,%d,1,0);}"
+        "for(int i=lane;i<128;i+=64)samples[8+i]=vec4(bins[4*i],bins[4*i+1],bins[4*i+2],bins[4*i+3]);",h,(double)w*h,w,h);
+    if (!output) finish=talloc_asprintf_append(finish,
+        "for(int i=lane;i<1600;i+=64)samples[280+i]=vec4(bins[512+4*i],bins[513+4*i],bins[514+4*i],bins[515+4*i]);");
+    sh=pl_dispatch_begin(hp->dispatch);
+    ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description="Analyzer compact frame result",.body=finish,
+        .header="shared vec3 mn[64],mx[64],sm[64];",
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_NONE,.descriptors=desc,.num_descriptors=2,
+        .compute=true,.compute_group_size={64,1}}) && pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={1,1,1}));
+    talloc_free(finish);
+    if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    return ok;
+}
diff --git a/video/out/analyzer_frame_math.h b/video/out/analyzer_frame_math.h
new file mode 100644
index 0000000000000000000000000000000000000000..5bc520fbb97715506c472479441686b41bbbd2c7
--- /dev/null
+++ b/video/out/analyzer_frame_math.h
@@ -0,0 +1,2 @@
+/* Generated from shipping Inspector; do not hand edit. */
+static const char frame_math[] = "float perceptual_bt2020(vec3 rgb)\n{\n    vec3 c=max(rgb,vec3(0)); float total=c.r+c.g+c.b;\n    if(total<=1e-12) return 0.0;\n    vec3 n=c/total; float w=n.b, p=n.r*n.g;\n    float q0=(((((((14.5330356895*w-25.5682414785)*w-13.7465695335)*w+56.3828756991)*w-42.760790975)*w+13.1725257153)*w-2.51283511691)*w+1.0);\n    float q1=(((((-31.3753030053*w-16.6730639549)*w+125.654298402)*w-103.378434394)*w+22.7623461176)*w-1.53706708322);\n    float q2=((140.435403979*w+97.2794791377)*w-114.074511803)*w+7.67118553227;\n    float q3=73.1408564899*w-38.0916687975;\n    return total*(((q3*p+q2)*p+q1)*p+q0);\n}\n\nfloat pq_encode_nits(float nits)\n{\n    const float m1=2610.0/16384.0, m2=2523.0/32.0;\n    const float c1=3424.0/4096.0, c2=2413.0/128.0, c3=2392.0/128.0;\n    float sign_n=nits<0.0 ? -1.0 : 1.0;\n    float p=pow(abs(nits)/10000.0,m1);\n    return sign_n*pow((c1+c2*p)/(1.0+c3*p),m2);\n}\n\n";
diff --git a/video/out/analyzer_output_bridge.h b/video/out/analyzer_output_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..38371498c89c52ca1a67892254229762a1dc10cc
--- /dev/null
+++ b/video/out/analyzer_output_bridge.h
@@ -0,0 +1,94 @@
+#include <libplacebo/shaders/colorspace.h>
+#include <libplacebo/shaders/sampling.h>
+/* Interpret decoded SDR signal values as a hypothetical display response.
+ * This private analysis pass never replaces playback pixels. Keep HDR on the
+ * effective renderer EOTF (PQ absolute / HLG renderer interpretation).
+ * Store all output linear samples in libplacebo's 203-nit units, so pixel,
+ * frame and waveform consumers share exactly the same conversion to nits. */
+static void analyzer_output_linearize(struct priv *p, pl_shader sh,
+                                     const struct pl_color_space *color)
+{
+    if (pl_color_transfer_is_hdr(color->transfer)) {
+        pl_shader_linearize(sh, color);
+        return;
+    }
+    float gamma=p->next_opts->analyzer_sdr_output_gamma;
+    float peak=p->next_opts->analyzer_sdr_output_peak / 203.f;
+    struct pl_shader_var vars[]={
+        {.var=pl_var_float("display_gamma"),.data=&gamma,.dynamic=true},
+        {.var=pl_var_float("display_scale"),.data=&peak,.dynamic=true},
+    };
+    pl_shader_custom(sh,&(struct pl_custom_shader){
+        .body="color.rgb=pow(max(color.rgb,vec3(0.0)),vec3(display_gamma))*display_scale;",
+        .input=PL_SHADER_SIG_COLOR,.output=PL_SHADER_SIG_COLOR,
+        .variables=vars,.num_variables=2});
+}
+static bool async_output_frame(struct priv *p,const struct pl_hook_params *hp,
+                                struct async_probe_slot *slot,const struct pl_hook *hook)
+{
+    int w=(int)fabsf(hp->rect.x1-hp->rect.x0),h=(int)fabsf(hp->rect.y1-hp->rect.y0);
+    if(w<1 || h<1)return false;
+    // Keep measurement precision: renderer scratch textures are usually FP16
+    // and would make the frame maximum disagree with the direct pixel decode.
+    pl_fmt fmt=pl_find_fmt(p->gpu,PL_FMT_FLOAT,4,32,0,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE);
+    if(!fmt || !pl_tex_recreate(p->gpu,&slot->output_linear,pl_tex_params(
+        .w=w,.h=h,.format=fmt,.sampleable=true,.renderable=true,
+        .storable=!!(fmt->caps&PL_FMT_CAP_STORABLE))))return false;
+    pl_tex tex=slot->output_linear;
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_sample_direct(sh,pl_sample_src(.tex=hp->tex,.rect=hp->rect,.new_w=w,.new_h=h));
+    struct pl_color_repr repr=hp->repr;
+    pl_shader_decode_color_ex(sh,pl_color_decode_args(.repr=&repr));
+    analyzer_output_linearize(p,sh,&hp->color);
+    ok=ok && pl_dispatch_finish(hp->dispatch,pl_dispatch_params(.shader=&sh,.target=tex));
+    if(!ok){pl_dispatch_abort(hp->dispatch,&sh);return false;}
+    return async_frame_dispatch(p,hp,slot,hook,tex,560);
+}
+/* Decode the post-color-management signal, before overlays/rotation/dither.
+ * SDR uses the user's display assumption; HDR uses the effective TARGET EOTF.
+ * Both retain effective target primaries. */
+static bool async_output_pixel(struct priv *p, const struct pl_hook_params *hp,
+                               struct async_probe_slot *slot, int x, int y)
+{
+    struct vo *vo=p->async_probe->hook.priv;
+    float u=(x-p->dst.x0+.5f)/mp_rect_w(p->dst),v=(y-p->dst.y0+.5f)/mp_rect_h(p->dst);
+    int rotation=vo->params ? (vo->params->rotate%360+360)%360 : 0;
+    float ox=u,oy=v;
+    if(rotation==90){ox=v;oy=1-u;}
+    if(rotation==180){ox=1-u;oy=1-v;}
+    if(rotation==270){ox=1-v;oy=u;}
+    float pos[2] = {
+        (hp->rect.x0+ox*(hp->rect.x1-hp->rect.x0))/hp->tex->params.w,
+        (hp->rect.y0+oy*(hp->rect.y1-hp->rect.y0))/hp->tex->params.h};
+    const struct pl_raw_primaries *prim=pl_raw_primaries_get(hp->color.primaries);
+    pl_matrix3x3 xyz=pl_get_rgb2xyz_matrix(prim);
+    pl_matrix3x3 map=pl_get_color_mapping_matrix(prim,pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020),PL_INTENT_RELATIVE_COLORIMETRIC);
+    float matrix[9], ym[3];
+    for(int i=0;i<3;i++) {ym[i]=xyz.m[1][i];for(int j=0;j<3;j++)matrix[3*j+i]=map.m[i][j];}
+    struct pl_shader_var vars[]={
+        {.var=pl_var_vec2("out_pos"),.data=pos,.dynamic=true},
+        {.var=pl_var_vec3("out_y"),.data=ym,.dynamic=true},
+        {.var={.name="out_2020",.type=PL_VAR_FLOAT,.dim_v=3,.dim_m=3,.dim_a=1},.data=matrix,.dynamic=true}};
+    struct pl_buffer_var bv={.var={.name="out_samples",.type=PL_VAR_FLOAT,.dim_v=4,.dim_m=1,.dim_a=140},.layout={.offset=0,.stride=16,.size=2240}};
+    struct pl_shader_desc desc[]={
+        {.desc={.name="out_tex",.type=PL_DESC_SAMPLED_TEX},.binding={.object=hp->tex,.address_mode=PL_TEX_ADDRESS_CLAMP,.sample_mode=PL_TEX_SAMPLE_NEAREST}},
+        {.desc={.name="OutputPixel",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=slot->buf,.buffer_vars=&bv,.num_buffer_vars=1}};
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){
+        .description="Analyzer output pixel decode",.body="color=textureLod(out_tex,out_pos,0.0);",
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_COLOR,
+        .compute=true,.compute_group_size={1,1},.variables=vars,.num_variables=3,.descriptors=desc,.num_descriptors=2});
+    struct pl_color_repr repr=hp->repr;
+    pl_shader_decode_color_ex(sh,pl_color_decode_args(.repr=&repr));
+    analyzer_output_linearize(p,sh,&hp->color);
+    ok=ok && pl_shader_custom(sh,&(struct pl_custom_shader){
+        .header=frame_math,
+        .body="vec3 rgb=color.rgb*203.0; out_samples[137]=vec4(rgb,dot(out_y,rgb));"
+              "vec3 xyz=mat3(.636958,.262700,0.0,.144617,.677998,.028073,.168881,.059302,1.060985)*(out_2020*rgb);"
+              "float total=xyz.x+xyz.y+xyz.z;vec2 xy=total>1e-12 ? xyz.xy/total : vec2(0);"
+              "out_samples[138]=vec4(perceptual_bt2020(out_2020*rgb),1,xy);out_samples[139]=vec4(total>1e-12 ? 1 : 0,0,0,0);",
+        .input=PL_SHADER_SIG_COLOR,.output=PL_SHADER_SIG_NONE}) &&
+        pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={1,1,1}));
+    if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    return ok;
+}
diff --git a/video/out/analyzer_waveform_bridge.h b/video/out/analyzer_waveform_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..6429fa19e5ee33e8d758ead956f9ab0ad75ce9ec
--- /dev/null
+++ b/video/out/analyzer_waveform_bridge.h
@@ -0,0 +1,135 @@
+/* Source/output waveforms remain GPU-resident. No dense graph readback. */
+static bool analyzer_waveform_reduce(struct priv *p, const struct pl_hook_params *hp,
+                                    const struct pl_hook *hook, pl_tex tex, bool output)
+{
+    struct async_probe *a=p->async_probe;
+    if (!tex || !a->wave_tex || a->wave_w<1) return false;
+    int width=a->wave_w, rotation=a->wave_rotation;
+    int channels=p->next_opts->analyzer_waveform==4 ? 3 : 1;
+    int bins=256*channels;
+    int columns=(rotation==90 || rotation==270) ? tex->params.h : tex->params.w;
+    int rows=(rotation==90 || rotation==270) ? tex->params.w : tex->params.h;
+    float matrix[9], yc[3];
+    for(int i=0;i<9;i++){char n[40];snprintf(n,sizeof(n),"source_to_bt2020_%d",i);matrix[i]=frame_parameter(hook,n);}
+    for(int i=0;i<3;i++){char n[40];snprintf(n,sizeof(n),"source_cie_y_%d",i);yc[i]=frame_parameter(hook,n);}
+    float scale=frame_parameter(hook,"source_is_sdr") ? frame_parameter(hook,"sdr_reference_peak") :
+        (frame_parameter(hook,"source_is_absolute") || frame_parameter(hook,"source_is_hlg")) ? 203.f : 100.f;
+    if(output){
+        const struct pl_raw_primaries *prim=pl_raw_primaries_get(hp->color.primaries);
+        pl_matrix3x3 xyz=pl_get_rgb2xyz_matrix(prim);
+        pl_matrix3x3 map=pl_get_color_mapping_matrix(prim,pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020),PL_INTENT_RELATIVE_COLORIMETRIC);
+        for(int i=0;i<3;i++){yc[i]=xyz.m[1][i];for(int j=0;j<3;j++)matrix[3*j+i]=map.m[i][j];}
+        scale=203.f;
+    }
+    size_t bytes=(size_t)width*bins*2*4;
+    if(a->wave_buf && a->wave_buf->params.size!=bytes) pl_buf_destroy(p->gpu,&a->wave_buf);
+    if(!a->wave_buf) a->wave_buf=pl_buf_create(p->gpu,pl_buf_params(.size=bytes,.storable=true,.memory_type=PL_BUF_MEM_DEVICE));
+    if(!a->wave_buf) return false;
+    float range[2]={(a->wave_x-a->wave_dst.x0)/pl_rect_w(a->wave_dst),1.f/pl_rect_w(a->wave_dst)};
+    float peak=p->next_opts->analyzer_waveform_peak;
+    struct pl_shader_var vars[]={
+        {.var={.name="to2020",.type=PL_VAR_FLOAT,.dim_v=3,.dim_m=3,.dim_a=1},.data=matrix,.dynamic=true},
+        {.var=pl_var_vec3("yc"),.data=yc,.dynamic=true},
+        {.var=pl_var_float("nits"),.data=&scale,.dynamic=true},
+        {.var=pl_var_vec2("xrange"),.data=range,.dynamic=true},
+        {.var=pl_var_float("plot_peak"),.data=&peak,.dynamic=true},
+    };
+    struct pl_buffer_var bv={.var={.name="counts",.type=PL_VAR_UINT,.dim_v=1,.dim_m=1,.dim_a=width*bins*2},.layout={.offset=0,.stride=4,.size=bytes}};
+    struct pl_shader_desc desc[]={
+        {.desc={.name="wave_source",.type=PL_DESC_SAMPLED_TEX},.binding={.object=tex,.sample_mode=PL_TEX_SAMPLE_NEAREST}},
+        {.desc={.name="WaveCounts",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_WRITEONLY},.binding.object=a->wave_buf,.buffer_vars=&bv,.num_buffer_vars=1},
+    };
+    char *header=talloc_asprintf(NULL,"%s\nshared uint bins[%d];\n",frame_math,bins);
+    char *body=talloc_asprintf(NULL,
+        "int lane=int(gl_LocalInvocationID.x), col=int(gl_WorkGroupID.x);"
+        "for(int i=lane;i<%d;i+=64)bins[i]=0u;barrier();"
+        "int lo=clamp(int(floor((xrange.x+col*xrange.y)*%d.0)),0,%d);"
+        "int hi=clamp(int(floor((xrange.x+(col+1)*xrange.y)*%d.0)),lo+1,%d);"
+        "for(int n=lane;n<(hi-lo)*%d;n+=64){int sx=lo+n/%d, sy=n%%%d;"
+        "ivec2 xy=ivec2(sx,sy);ivec2 sz=textureSize(wave_source,0);"
+        "if(%d==90)xy=ivec2(sy,sz.y-1-sx);"
+        "if(%d==180)xy=sz-1-ivec2(sx,sy);"
+        "if(%d==270)xy=ivec2(sz.x-1-sy,sx);"
+        "vec3 c=texelFetch(wave_source,xy,0).rgb;"
+        "float v=%d==1 ? perceptual_bt2020(to2020*c) : %d==2 ? dot(yc,c) : max(c.r,max(c.g,c.b));"
+        "for(int ch=0;ch<%d;ch++){float value=%d==3?c[ch]:v;"
+        "int bin=int(clamp(pq_encode_nits(max(value*nits,0.0))/pq_encode_nits(plot_peak)*256.0,0.0,255.0));atomicAdd(bins[ch*256+bin],1u);}}barrier();"
+        "for(int i=lane;i<%d;i+=64)counts[%d+col*%d+i]=bins[i];",
+        bins,columns,columns-1,columns,columns,rows,rows,rows,
+        rotation,rotation,rotation,p->next_opts->analyzer_waveform,p->next_opts->analyzer_waveform,
+        channels,channels,bins,output?width*bins:0,bins);
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description=output?"Analyzer output waveform":"Analyzer source waveform",
+        .header=header,.body=body,.input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_NONE,
+        .variables=vars,.num_variables=5,.descriptors=desc,.num_descriptors=2,
+        .compute=true,.compute_group_size={64,1}}) &&
+        pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,.dispatch_size={width,1,1}));
+    talloc_free(header);talloc_free(body);
+    if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    return ok;
+}
+
+static void analyzer_waveform_update(struct priv *p,const struct pl_hook_params *hp,
+                                    struct async_probe_slot *slot,const struct pl_hook *hook)
+{
+    struct async_probe *a=p->async_probe;
+    if(!a->wave_tex || !p->next_opts->analyzer_waveform || p->next_opts->analyzer_waveform_height<=0) return;
+    pl_tex source=pl_mpv_user_shader_saved_texture(hook,"ANALYZER_LINEAR");
+    if(!analyzer_waveform_reduce(p,hp,hook,source,false) ||
+       !analyzer_waveform_reduce(p,&a->output,hook,slot->output_linear,true)) return;
+    int width=a->wave_w, tint=p->next_opts->analyzer_waveform_tint;
+    int channels=p->next_opts->analyzer_waveform==4 ? 3 : 1, stride=256*channels;
+    float rgb[3]={((tint>>16)&255)/255.f,((tint>>8)&255)/255.f,(tint&255)/255.f};
+    struct pl_shader_var var={.var=pl_var_vec3("tint"),.data=rgb,.dynamic=true};
+    struct pl_buffer_var bv={.var={.name="counts",.type=PL_VAR_UINT,.dim_v=1,.dim_m=1,.dim_a=width*stride*2},.layout={.offset=0,.stride=4,.size=(size_t)width*stride*2*4}};
+    struct pl_shader_desc desc={.desc={.name="WaveCounts",.type=PL_DESC_BUF_STORAGE,.access=PL_DESC_ACCESS_READONLY},.binding.object=a->wave_buf,.buffer_vars=&bv,.num_buffer_vars=1};
+    char *body=talloc_asprintf(NULL,
+        "ivec2 q=ivec2(gl_FragCoord.xy);int bin=255-q.y;vec3 c=vec3(0);"
+        "for(int ch=0;ch<%d;ch++){int idx=q.x*%d+ch*256+bin;"
+        "float s=%d==2?0.0:float(counts[idx]);float o=%d==1?0.0:float(counts[%d+idx]);"
+        "s=s>0.0?clamp(.20+.13*log(1.0+s),0.0,1.0):0.0;o=o>0.0?clamp(.20+.13*log(1.0+o),0.0,1.0):0.0;"
+        "if(%d==3)c[ch]=max(s,o);else c=max(vec3(.18,.78,1)*s,vec3(1,.72,.32)*o);}"
+        "color=vec4(c*tint,1.0);",channels,stride,p->next_opts->analyzer_waveform_layers,p->next_opts->analyzer_waveform_layers,width*stride,channels);
+    pl_shader sh=pl_dispatch_begin(hp->dispatch);
+    bool ok=pl_shader_custom(sh,&(struct pl_custom_shader){.description="Analyzer waveform density texture",.body=body,
+        .input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_COLOR,.variables=&var,.num_variables=1,.descriptors=&desc,.num_descriptors=1}) &&
+        pl_dispatch_finish(hp->dispatch,pl_dispatch_params(.shader=&sh,.target=a->wave_tex));
+    talloc_free(body);if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+    if(ok)a->wave_sequence++;
+}
+
+static void analyzer_waveform_prepare(struct priv *p, struct pl_frame *target,
+                                     struct pl_color_space color, int rotation)
+{
+    struct async_probe *a=p->async_probe;
+    if(!a || p->next_opts->analyzer_async!=3 || !p->next_opts->analyzer_waveform ||
+       p->next_opts->analyzer_waveform_height<=0) return;
+    int frame_w=target->planes[0].texture->params.w, frame_h=target->planes[0].texture->params.h;
+    int x=MPCLAMP((int)ceilf(target->crop.x0),0,frame_w),right=MPCLAMP((int)floorf(target->crop.x1),0,frame_w);
+    int y=MPCLAMP(p->next_opts->analyzer_waveform_y,0,frame_h);
+    int height=MPCLAMP(p->next_opts->analyzer_waveform_height,0,frame_h-y);
+    int width=right-x;
+    if(width<1 || width>16384 || height<1) return;
+    if(width!=a->wave_w || memcmp(&target->crop,&a->wave_dst,sizeof(target->crop)) || rotation!=a->wave_rotation) {
+        a->last_stats_revision=0; // Geometry changes must rebuild even when paused.
+    }
+    a->wave_x=x;a->wave_y=y;a->wave_w=width;a->wave_h=height;
+    a->wave_dst=target->crop;a->wave_rotation=rotation;
+    pl_fmt fmt=pl_find_fmt(p->gpu,PL_FMT_UNORM,4,8,0,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE);
+    bool recreate=!a->wave_tex || a->wave_tex->params.w!=width;
+    if(!fmt)return;
+    // pl_tex_recreate invalidates even a matching texture. Redraws may reuse
+    // cached analysis, so retain its pixels until a real allocation change.
+    if(recreate){
+        if(!pl_tex_recreate(p->gpu,&a->wave_tex,pl_tex_params(.w=width,.h=256,.format=fmt,.sampleable=true,.renderable=true,.blit_dst=true)))return;
+        pl_tex_clear(p->gpu,a->wave_tex,(float[4]){0,0,0,1});
+        a->last_stats_revision=0;
+    }
+    a->wave_part=(struct pl_overlay_part){.src={0,0,width,256},.dst={x,y,right,y+height}};
+    MP_TARRAY_GROW(p,a->wave_overlays,target->num_overlays);
+    memcpy(a->wave_overlays+1,target->overlays,target->num_overlays*sizeof(*target->overlays));
+    a->wave_overlays[0]=(struct pl_overlay){.tex=a->wave_tex,.mode=PL_OVERLAY_NORMAL,
+        .repr={.alpha=PL_ALPHA_INDEPENDENT},.color=color,.coords=PL_OVERLAY_COORDS_DST_FRAME,
+        .parts=&a->wave_part,.num_parts=1};
+    target->overlays=a->wave_overlays;target->num_overlays++;
+}
diff --git a/video/out/analyzer_xy_tiled_prototype.h b/video/out/analyzer_xy_tiled_prototype.h
new file mode 100644
index 0000000000000000000000000000000000000000..8e9901c0312c70720feb96951a14114a9aafe395
--- /dev/null
+++ b/video/out/analyzer_xy_tiled_prototype.h
@@ -0,0 +1,42 @@
+static bool analyzer_xy_tiled_reduce(struct priv *p,const struct pl_hook_params *hp,
+                                    pl_tex source,struct pl_shader_var *vars,
+                                    struct pl_shader_desc *desc,const char *bin_math,
+                                    int bins)
+{
+    // 32x32 source tiles; 64 invocations with 16 pixels each. A bounded shared
+    // hash combines coherent colors before global atomics. Full/colliding hash
+    // entries fall back to the SAME global reduction, never dropping a sample.
+    char *header=talloc_asprintf(NULL,"%s\n%s\nshared uint tags[256];shared uint values[256];",
+                                 frame_math,bin_math);
+    bool ok=true;
+    for(int pass=0;pass<2 && ok;pass++){
+        char *body=talloc_asprintf(NULL,
+            "int lane=int(gl_LocalInvocationID.x);ivec2 sz=textureSize(xy_source,0),origin=ivec2(gl_WorkGroupID.xy)*32;"
+            "for(int i=lane;i<256;i+=64){tags[i]=0xffffffffu;values[i]=%s;}barrier();"
+            "for(int i=lane;i<1024;i+=64){ivec2 pos=origin+ivec2(i%%32,i/32);if(any(greaterThanEqual(pos,sz)))continue;"
+            "vec3 c=to2020*texelFetch(xy_source,pos,0).rgb;int b=xy_bin(c);if(b<0)continue;"
+            "float value=max(perceptual_bt2020(c),0.);if(isnan(value)||isinf(value))continue;uint key=floatBitsToUint(value);%s"
+            "uint h=(uint(b)*2654435761u)&255u;int found=-1;"
+            "for(uint k=0u;k<8u;k++){uint at=(h+k)&255u;uint prev=atomicCompSwap(tags[at],0xffffffffu,uint(b));if(prev==0xffffffffu||prev==uint(b)){found=int(at);break;}}"
+            "%s}barrier();"
+            "for(int i=lane;i<256;i+=64){uint b=tags[i];if(b!=0xffffffffu){%s}}",
+            pass?"0xffffffffu":"0u",
+            pass?"if(key!=keys[b])continue;uint id=uint(pos.y*sz.x+pos.x);":"",
+            pass?"if(found>=0)atomicMin(values[found],id);else atomicMin(keys[XY_TILE_BINS+b],id);":
+                 "if(found>=0)atomicMax(values[found],key);else atomicMax(keys[b],key);",
+            pass?"if(values[i]!=0xffffffffu)atomicMin(keys[XY_TILE_BINS+b],values[i]);":
+                 "if(values[i]>0u)atomicMax(keys[b],values[i]);");
+        char *with_bins=talloc_asprintf(NULL,"#define XY_TILE_BINS %d\n%s",bins,header);
+        pl_shader sh=pl_dispatch_begin(hp->dispatch);
+        ok=pl_shader_custom(sh,&(struct pl_custom_shader){
+            .description=pass?"Analyzer tiled xy winning pixel":"Analyzer tiled xy peak P",
+            .header=with_bins,.body=body,.input=PL_SHADER_SIG_NONE,.output=PL_SHADER_SIG_NONE,
+            .variables=vars,.num_variables=3,.descriptors=desc,.num_descriptors=2,
+            .compute=true,.compute_group_size={64,1}}) &&
+            pl_dispatch_compute(hp->dispatch,pl_dispatch_compute_params(.shader=&sh,
+                .dispatch_size={(source->params.w+31)/32,(source->params.h+31)/32,1}));
+        if(!ok)pl_dispatch_abort(hp->dispatch,&sh);
+        talloc_free(body);talloc_free(with_bins);
+    }
+    talloc_free(header);return ok;
+}
