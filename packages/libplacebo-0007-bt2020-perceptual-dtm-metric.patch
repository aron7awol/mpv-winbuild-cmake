+            int bin_metric = int(metric_pq) >> ${const int: PQ_BITS - HIST_BITS};  \
+            bin_metric -= ${const int: HIST_BIAS};                                \
+            bin_metric = clamp(bin_metric, 0, ${const int: HIST_BINS - 1});         \
+            atomicAdd($wg_hist_metric[bin_metric], 1u);                             \
+        @}                                                                      \
         @if (has_subgroups) {                                                   \
             /* Optimize for the very common case of identical histogram bins */ \
             if (subgroupAllEqual(bin)) {                                        \
@@ -1781,6 +1932,11 @@ retry_ssbo:
                 atomicAdd($wg_black, 1u);                                       \
