From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <noreply@openai.com>
Date: Mon, 12 Oct 2026 12:00:00 -0400
Subject: [PATCH] d3d11: opt-in rolling blackout evidence on fullscreen exit

Default-off config-only diagnostics. Freeze bounded pre-restore history,
then save ten seconds of recovery asynchronously. Sample native backbuffer
patches without shader changes, GPU waits or frame rerender. Never classify
missing readbacks/feedback as black and never reset playback automatically.
Requires mpv 0070 result logging; separately removable with no Lua/UI state.

---
diff --git a/video/out/d3d11/context.c b/video/out/d3d11/context.c
--- a/video/out/d3d11/context.c
+++ b/video/out/d3d11/context.c
@@ -27,4 +27,6 @@
 #include "context.h"
 #include "ra_d3d11.h"
 #include "result_log.h"
+#include "blackout_recorder.h"
+#include "blackout_probe.h"
 #include "vsync_estimator.h"
@@ -43,6 +45,8 @@ struct d3d11_opts {
     int color_space;
     bool exclusive_fs;
     int output_mode;
+    bool blackout_diagnostics;
+    char *blackout_dir;
 };
 
 #define OPT_BASE_STRUCT struct d3d11_opts
@@ -68,6 +72,8 @@ const struct m_sub_options d3d11_conf = {
         },
         {"d3d11-flip", OPT_BOOL(flip), .flags = UPDATE_VO},
         {"d3d11-sync-interval", OPT_INT(sync_interval), M_RANGE(0, 4)},
+        {"d3d11-blackout-diagnostics", OPT_BOOL(blackout_diagnostics), .flags = UPDATE_VO},
+        {"d3d11-blackout-dir", OPT_STRING(blackout_dir), .flags = UPDATE_VO},
         {"d3d11-adapter",
             OPT_STRING_VALIDATE(adapter_name, mp_dxgi_validate_adapter),
             .flags = UPDATE_VO,
@@ -106,6 +112,7 @@ const struct m_sub_options d3d11_conf = {
         .output_format = DXGI_FORMAT_UNKNOWN,
         .color_space = -1,
         .output_mode = -1,
+        .blackout_dir = "~~/../user-data/logs/blackout",
     },
     .size = sizeof(struct d3d11_opts)
 };
@@ -128,6 +135,12 @@ struct priv {
     struct d3d11_result_log result_log[RESULT_OPERATION_COUNT];
     uint64_t present_calls;
     uint64_t swapchain_generation;
+    struct bo_recorder *blackout;
+    struct bo_gpu blackout_gpu;
+    uint64_t blackout_frame_id;
+    int64_t blackout_next_state, blackout_next_feedback, blackout_last_advance;
+    DXGI_FRAME_STATISTICS blackout_last_stats;
+    struct bo_record blackout_feedback_snapshot;
 
     struct ra_tex *backbuffer;
     ID3D11Device *device;
@@ -141,6 +154,131 @@ struct priv {
     struct mp_dxgi_factory_ctx dxgi_ctx;
 };
 
+static struct bo_record blackout_base(struct ra_ctx *ctx, enum bo_kind kind)
+{
+    struct priv *p = ctx->priv;
+    return (struct bo_record){
+        .kind = kind, .time_ns = mp_time_ns(), .generation = p->swapchain_generation,
+        .present = p->present_calls + (kind == BO_PRESENT_BEGIN || kind == BO_RENDER_BEGIN ||
+                   kind == BO_RENDER_END || kind == BO_RENDER_ABORT || kind == BO_FRAME_SUBMIT),
+        .frame_id = p->blackout_frame_id,
+    };
+}
+
+static void blackout_call(struct ra_ctx *ctx, enum bo_kind kind,
+                           HRESULT hr, int value, double duration_ms)
+{
+    struct priv *p = ctx->priv;
+    if (!p->blackout)
+        return;
+    struct bo_record r = blackout_base(ctx, kind);
+    r.u.call.hr = hr;
+    r.u.call.value = value;
+    r.u.call.duration_ms = duration_ms;
+    bo_record(p->blackout, r);
+}
+
+static void blackout_frame(struct ra_ctx *ctx, const struct vo_frame *frame,
+                           const struct mp_image *selected, uint64_t selected_id,
+                           int mixed, int stage, const struct pl_color_space *target)
+{
+    struct priv *p = ctx->priv;
+    p->blackout_frame_id = frame->current ? frame->frame_id : 0;
+    struct bo_record r = blackout_base(ctx, stage == 0 ? BO_RENDER_BEGIN :
+                                           stage == 1 ? BO_RENDER_END : BO_RENDER_ABORT);
+    r.u.frame.pts = frame->current ? frame->current->pts : MP_NOPTS_VALUE;
+    r.u.frame.selected_id = selected_id;
+    r.u.frame.selected_pts = selected ? selected->pts : MP_NOPTS_VALUE;
+    r.u.frame.scheduled_ns = frame->pts;
+    r.u.frame.repeats = frame->num_vsyncs;
+    r.u.frame.mixed = mixed;
+    r.u.frame.flags = frame->repeat | frame->still << 1 | frame->display_synced << 2 |
+                      frame->redraw << 3 | !!frame->current << 4;
+    if (target) {
+        r.u.frame.target_prim = target->primaries;
+        r.u.frame.target_trc = target->transfer;
+        r.u.frame.target_min = isfinite(target->hdr.min_luma) ? target->hdr.min_luma : 0;
+        r.u.frame.target_max = isfinite(target->hdr.max_luma) ? target->hdr.max_luma : 0;
+    }
+    bo_record(p->blackout, r);
+}
+
+static void blackout_state(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p->blackout || !p->swapchain)
+        return;
+    struct bo_record r = blackout_base(ctx, BO_STATE);
+    DXGI_SWAP_CHAIN_DESC desc = {0};
+    BOOL exclusive = FALSE;
+    r.u.state.desc_hr = IDXGISwapChain_GetDesc(p->swapchain, &desc);
+    r.u.state.fs_hr = IDXGISwapChain_GetFullscreenState(p->swapchain, &exclusive, NULL);
+    r.u.state.removed_hr = ID3D11Device_GetDeviceRemovedReason(p->device);
+    r.u.state.width = desc.BufferDesc.Width;
+    r.u.state.height = desc.BufferDesc.Height;
+    r.u.state.format = desc.BufferDesc.Format;
+    r.u.state.buffers = desc.BufferCount;
+    r.u.state.effect = desc.SwapEffect;
+    r.u.state.flags = desc.Flags;
+    r.u.state.fullscreen = p->vo_opts->fullscreen;
+    r.u.state.exclusive = SUCCEEDED(r.u.state.fs_hr) ? !!exclusive : -1;
+    HWND window = ctx->opts.composition ? NULL : vo_w32_hwnd(ctx->vo);
+    r.u.state.visible = window ? !!IsWindowVisible(window) : -1;
+    r.u.state.minimized = window ? !!IsIconic(window) : -1;
+    r.u.state.composition = ctx->opts.composition;
+    r.u.state.sync_interval = p->opts->sync_interval;
+    r.u.state.requested_csp = p->opts->color_space;
+    r.u.state.window = (uintptr_t)window;
+    r.u.state.swapchain = (uintptr_t)p->swapchain;
+    r.u.state.monitor = (uintptr_t)(window ? MonitorFromWindow(window, MONITOR_DEFAULTTONEAREST) : NULL);
+    IDXGIOutput *output = NULL;
+    IDXGIOutput6 *output6 = NULL;
+    r.u.state.output_csp = r.u.state.bits = -1;
+    r.u.state.output_hr = IDXGISwapChain_GetContainingOutput(p->swapchain, &output);
+    if (SUCCEEDED(r.u.state.output_hr)) {
+        r.u.state.output_hr = IDXGIOutput_QueryInterface(output, &IID_IDXGIOutput6, (void **)&output6);
+        if (SUCCEEDED(r.u.state.output_hr)) {
+            DXGI_OUTPUT_DESC1 od;
+            r.u.state.output_hr = IDXGIOutput6_GetDesc1(output6, &od);
+            if (SUCCEEDED(r.u.state.output_hr)) {
+                r.u.state.output_csp = od.ColorSpace;
+                r.u.state.bits = od.BitsPerColor;
+            }
+        }
+    }
+    SAFE_RELEASE(output6);
+    SAFE_RELEASE(output);
+    bo_record(p->blackout, r);
+    p->blackout_next_state = r.time_ns + INT64_C(1000000000);
+}
+
+static void blackout_feedback(struct ra_ctx *ctx, struct bo_record r)
+{
+    struct priv *p = ctx->priv;
+    if (!p->blackout)
+        return;
+    r.u.feedback.populated = r.u.feedback.stats_hr == S_OK && r.u.feedback.displayed &&
+                            r.u.feedback.present_refresh && r.u.feedback.sync_refresh && r.u.feedback.sync_qpc;
+    if (r.u.feedback.stats_hr == DXGI_ERROR_FRAME_STATISTICS_DISJOINT) {
+        p->blackout_last_stats = (DXGI_FRAME_STATISTICS){0};
+        p->blackout_last_advance = 0;
+    }
+    r.u.feedback.advanced = r.u.feedback.populated &&
+        r.u.feedback.sync_qpc > p->blackout_last_stats.SyncQPCTime.QuadPart &&
+        r.u.feedback.displayed != p->blackout_last_stats.PresentCount;
+    if (r.u.feedback.advanced) {
+        p->blackout_last_stats.SyncQPCTime.QuadPart = r.u.feedback.sync_qpc;
+        p->blackout_last_stats.PresentCount = r.u.feedback.displayed;
+        p->blackout_last_advance = r.time_ns;
+    }
+    r.u.feedback.age_ns = p->blackout_last_advance ? r.time_ns - p->blackout_last_advance : -1;
+    if (r.time_ns < p->blackout_next_feedback &&
+        r.u.feedback.stats_hr != DXGI_ERROR_FRAME_STATISTICS_DISJOINT)
+        return;
+    p->blackout_next_feedback = r.time_ns + INT64_C(100000000);
+    bo_record(p->blackout, r);
+}
+
 static void log_result(struct ra_ctx *ctx, enum result_operation operation,
                        HRESULT result, double call_ms)
 {
@@ -231,11 +369,16 @@ static bool resize(struct ra_ctx *ctx)
         return false;
     }
 
+    blackout_call(ctx, BO_RESIZE_BEGIN, S_OK, 0, 0);
     hr = IDXGISwapChain_ResizeBuffers(p->swapchain, 0, ctx->vo->dwidth,
         ctx->vo->dheight, DXGI_FORMAT_UNKNOWN, 0);
+    blackout_call(ctx, BO_RESIZE_END, hr, 0, 0);
     log_result(ctx, RESULT_RESIZE, hr, -1);
     if (FAILED(hr)) {
         return false;
     }
 
+    p->blackout_last_stats = (DXGI_FRAME_STATISTICS){0};
+    p->blackout_last_advance = 0;
+    blackout_state(ctx);
     d3d11_vsync_reset(&p->vsync);
@@ -331,6 +474,7 @@ static bool d3d11_submit_frame(struct ra_swapchain *sw,
 
     ra_d3d11_flush(sw->ctx->ra);
     ra_tex_free(sw->ctx->ra, &p->backbuffer);
+    blackout_call(sw->ctx, BO_FRAME_SUBMIT, S_OK, 0, 0);
     return true;
 }
 
@@ -358,6 +502,14 @@ static void d3d11_swap_buffers(struct ra_swapchain *sw)
 
     m_config_cache_update(p->opts_cache);
 
+    if (p->blackout) {
+        struct bo_record r = blackout_base(sw->ctx, BO_PRESENT_BEGIN);
+        // The backbuffer is complete here and has not been handed to Present.
+        bo_gpu_sample(p->blackout, &p->blackout_gpu, p->device, p->swapchain, r);
+        if (r.time_ns >= p->blackout_next_state)
+            blackout_state(sw->ctx);
+        blackout_call(sw->ctx, BO_PRESENT_BEGIN, S_OK, p->opts->sync_interval, 0);
+    }
     LARGE_INTEGER perf_count;
     QueryPerformanceCounter(&perf_count);
     p->last_submit_qpc = perf_count.QuadPart;
@@ -368,9 +520,14 @@ static void d3d11_swap_buffers(struct ra_swapchain *sw)
+    int64_t blackout_present_end = p->blackout ? qpc_ns_now(sw) : 0;
     p->present_calls++;
     log_result(sw->ctx, RESULT_PRESENT, hr, hr == S_OK ? -1 :
                (qpc_ns_now(sw) - qpc_to_ns(sw, p->last_submit_qpc)) / 1e6);
+    if (p->blackout) {
+        blackout_call(sw->ctx, BO_PRESENT_END, hr, p->opts->sync_interval,
+                      (blackout_present_end - qpc_to_ns(sw, p->last_submit_qpc)) / 1e6);
+    }
 }
 
-static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
+static void d3d11_get_vsync_impl(struct ra_swapchain *sw, struct vo_vsync_info *info)
 {
     struct priv *p = sw->priv;
     HRESULT hr;
@@ -394,6 +551,10 @@ static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
     // the last call to IDXGISwapChain::Present()
     UINT submit_count;
     hr = IDXGISwapChain_GetLastPresentCount(p->swapchain, &submit_count);
+    if (p->blackout) {
+        p->blackout_feedback_snapshot.u.feedback.count_hr = hr;
+        p->blackout_feedback_snapshot.u.feedback.submitted = SUCCEEDED(hr) ? submit_count : 0;
+    }
     if (FAILED(hr))
         return;
 
@@ -404,4 +565,14 @@ static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
     // to a timestamp on the same clock as QueryPerformanceCounter.
     DXGI_FRAME_STATISTICS stats;
     hr = IDXGISwapChain_GetFrameStatistics(p->swapchain, &stats);
+    if (p->blackout) {
+        struct bo_record *r = &p->blackout_feedback_snapshot;
+        r->u.feedback.stats_hr = hr;
+        if (SUCCEEDED(hr)) {
+            r->u.feedback.displayed = stats.PresentCount;
+            r->u.feedback.present_refresh = stats.PresentRefreshCount;
+            r->u.feedback.sync_refresh = stats.SyncRefreshCount;
+            r->u.feedback.sync_qpc = stats.SyncQPCTime.QuadPart;
+        }
+    }
     if (hr == DXGI_ERROR_FRAME_STATISTICS_DISJOINT) {
@@ -447,6 +618,23 @@ static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
     }
 }
 
+static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
+{
+    struct priv *p = sw->priv;
+    if (p->blackout) {
+        p->blackout_feedback_snapshot = blackout_base(sw->ctx, BO_FEEDBACK);
+        // E_PENDING here means the normal feedback path did not query this
+        // API (unsupported mode / gated feedback), NOT a failed or stalled GPU.
+        p->blackout_feedback_snapshot.u.feedback.count_hr = E_PENDING;
+        p->blackout_feedback_snapshot.u.feedback.stats_hr = E_PENDING;
+    }
+    // Reuse the exact existing calls: extra GetFrameStatistics calls could
+    // consume a DISJOINT result before the timing estimator sees it.
+    d3d11_get_vsync_impl(sw, info);
+    if (p->blackout)
+        blackout_feedback(sw->ctx, p->blackout_feedback_snapshot);
+}
+
 static bool d3d11_set_fullscreen(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
@@ -471,6 +659,7 @@ static bool d3d11_set_fullscreen(struct ra_ctx *ctx)
 
     hr = IDXGISwapChain_SetFullscreenState(p->swapchain,
                                            enable_exclusive_fs, NULL);
+    blackout_call(ctx, BO_FULLSCREEN_RESULT, hr, enable_exclusive_fs, 0);
     log_result(ctx, RESULT_FULLSCREEN, hr, -1);
     if (FAILED(hr))
         return false;
@@ -507,6 +696,15 @@ static int d3d11_control(struct ra_ctx *ctx, int *events, int request, void *arg
         break;
     }
 
+    if (fullscreen_switch_needed && p->blackout) {
+        // This must precede SetFullscreenState, ResizeBuffers AND Win32's
+        // window-style/placement changes. A Lua property observer is too late.
+        bo_gpu_poll(p->blackout, &p->blackout_gpu);
+        blackout_call(ctx, BO_FULLSCREEN_REQUEST, S_OK, p->vo_opts->fullscreen, 0);
+        if (!p->vo_opts->fullscreen)
+            bo_trigger(p->blackout, mp_time_ns());
+    }
+
     // if leaving full screen, handle d3d11 stuff first, then general
     // windowing
     if (fullscreen_switch_needed && !p->vo_opts->fullscreen) {
@@ -537,6 +735,13 @@ static void d3d11_uninit(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
 
+    if (p->blackout) {
+        ctx->diagnostic_frame = NULL;
+        bo_gpu_destroy(p->blackout, &p->blackout_gpu);
+        blackout_call(ctx, BO_STOP, S_OK, 0, 0);
+        bo_destroy(&p->blackout);
+    }
+
     if (p->swapchain)
         IDXGISwapChain_SetFullscreenState(p->swapchain, FALSE, NULL);
 
@@ -638,6 +843,14 @@ static bool d3d11_init(struct ra_ctx *ctx)
     if (ctx->opts.composition)
         vo_w32_swapchain(ctx->vo, p->swapchain);
 
+    if (p->opts->blackout_diagnostics) {
+        p->blackout = bo_create(ctx, p->opts->blackout_dir);
+        if (p->blackout) {
+            ctx->diagnostic_frame = blackout_frame;
+            blackout_state(ctx);
+        }
+    }
+
     return true;
 
 error:
@@ -673,6 +886,8 @@ bool ra_d3d11_ctx_recreate_swapchain(struct ra_ctx *ra)
     if (!p->swapchain || p->backbuffer)
         return false;
 
+    blackout_call(ra, BO_RECREATE_BEGIN, S_OK, 0, 0);
+
     BOOL was_exclusive = FALSE;
     IDXGISwapChain_GetFullscreenState(p->swapchain, &was_exclusive, NULL);
     if (was_exclusive)
@@ -702,6 +917,7 @@ bool ra_d3d11_ctx_recreate_swapchain(struct ra_ctx *ra)
     if (!mp_d3d11_create_swapchain(p->device, ra->log, &scopts,
                                     &p->swapchain))
     {
+        blackout_call(ra, BO_RECREATE_END, E_FAIL, 0, 0);
         return false;
     }
 
@@ -711,6 +927,11 @@ bool ra_d3d11_ctx_recreate_swapchain(struct ra_ctx *ra)
     if (was_exclusive)
         IDXGISwapChain_SetFullscreenState(p->swapchain, TRUE, NULL);
 
+    p->blackout_last_stats = (DXGI_FRAME_STATISTICS){0};
+    p->blackout_last_advance = 0;
+    blackout_call(ra, BO_RECREATE_END, S_OK, 0, 0);
+    blackout_state(ra);
+
     return true;
 }
 
