@@ -477,7 +486,7 @@ static void vsync_skip_detection(struct vo *vo)
 }
 
 // Always called locked.
-static void update_vsync_timing_after_swap(struct vo *vo,
+static void update_vsync_timing_legacy(struct vo *vo,
                                            struct vo_vsync_info *vsync)
 {
     struct vo_internal *in = vo->in;
@@ -534,6 +543,48 @@ static void update_vsync_timing_after_swap(struct vo *vo,
     MP_STATS(vo, "value %f vsync-diff", MP_TIME_NS_TO_S(in->vsync_samples[0]));
 }
 
+static void update_vsync_timing_after_swap(struct vo *vo, struct vo_vsync_info *v)
+{
+    struct vo_internal *in = vo->in;
+    if (!vo->opts->video_sync_experiment) {
+        update_vsync_timing_legacy(vo, v);
+        return;
+    }
+    struct vo_vsync_info *old = &in->timing.feedback;
+    // The hardware epoch, trust changes and a refresh-rate change must not
+    // share a phase history. Preserve whether the scheduler expects VSync.
+    bool expecting = in->expecting_vsync;
+    bool valid = v->feedback_valid && v->vsync_duration >= 2500000 &&
+        v->vsync_duration <= 50000000 && v->last_queue_display_time > 0 &&
+        (in->nominal_vsync_interval <= 0 ||
+         fabs(v->vsync_duration / in->nominal_vsync_interval - 1) <= 0.05);
+    v->feedback_valid = valid;
+    if (v->feedback_epoch != old->feedback_epoch ||
+        v->feedback_source != old->feedback_source || valid != old->feedback_valid) {
+        reset_vsync_timings(vo);
+        in->expecting_vsync = expecting;
+    }
+    in->timing.feedback = *v;
+    in->timing.updated = mp_time_ns();
+    in->timing.samples++;
+    if (!valid || !expecting) {
+        in->timing.fallbacks += !valid;
+        // Do not use rejected backend forecasts. Submission-time estimation
+        // remains the legacy fallback, explicitly marked as such in telemetry.
+        if (!valid) v->last_queue_display_time = in->timing.updated;
+        update_vsync_timing_legacy(vo, v);
+        return;
+    }
