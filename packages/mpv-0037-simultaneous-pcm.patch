diff --git a/audio/out/ao.c b/audio/out/ao.c
index 5cb24bda0..be3678e58 100644
--- a/audio/out/ao.c
+++ b/audio/out/ao.c
@@ -213,6 +213,15 @@ static struct ao *ao_init(bool probing, struct mpv_global *global,
     ao->format = format;
     ao->encode_lavc_ctx = encode_lavc_ctx;
     ao->init_flags = flags;
+    struct MPOpts *main_opts = mp_get_config_group(ao, global, &mp_opt_root);
+    if (!(flags & AO_INIT_SECONDARY_PCM) && main_opts->audio_pcm_device &&
+        main_opts->audio_pcm_device[0])
+    {
+        // A negative PCM offset starts it before the carrier. Keep sufficient
+        // primary headroom so the packet tee does not starve that head start.
+        ao->def_buffer += MPMAX(0, -main_opts->audio_pcm_delay);
+    }
+    talloc_free(main_opts);
     if (ao->driver->encode != !!ao->encode_lavc_ctx)
         goto fail;
 
@@ -288,6 +297,23 @@ static void split_ao_device(void *tmp, char *opt, char **out_ao, char **out_dev)
     *out_ao = bstrto0(tmp, b_ao);
 }
 
+struct ao *ao_init_pcm(struct mpv_global *global, const char *device,
+                      void (*wakeup_cb)(void *), void *ctx,
+                      int rate, int format, struct mp_chmap channels)
+{
+    void *tmp = talloc_new(NULL);
+    char *name, *dev;
+    split_ao_device(tmp, (char *)device, &name, &dev);
+    struct ao *ao = NULL;
+    // Explicit endpoints only. "null" is useful for deterministic engine tests.
+    if (name && (!strcmp(name, "wasapi") || !strcmp(name, "null")))
+        ao = ao_init(false, global, wakeup_cb, ctx, NULL,
+                     AO_INIT_SECONDARY_PCM | AO_INIT_EXCLUSIVE,
+                     rate, format, channels, dev, name);
+    talloc_free(tmp);
+    return ao;
+}
+
 struct ao *ao_init_best(struct mpv_global *global,
                         int init_flags,
                         void (*wakeup_cb)(void *ctx), void *wakeup_ctx,
