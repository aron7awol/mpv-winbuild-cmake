+static int mp_property_output_capture(void *ctx, struct m_property *prop,
+                                      int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct voctrl_output_capture v = {0};
+    if (!mpctx->video_out || vo_control(mpctx->video_out,
+            VOCTRL_GET_OUTPUT_CAPTURE, &v) != VO_TRUE)
+        return M_PROPERTY_UNAVAILABLE;
+    const char *states[] = {"idle", "pending", "complete", "error", "cancelled"};
+    struct m_sub_property props[] = {
+        {"state", SUB_PROP_STR(states[MPCLAMP(v.state, 0, 4)])},
+        {"sequence", SUB_PROP_INT64(v.sequence)},
+        {"width", SUB_PROP_INT(v.width)},
+        {"height", SUB_PROP_INT(v.height)},
+        {"error", SUB_PROP_STR(v.error)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
