     return (struct mp_rect) {
-        active_dst.x0 + lrint((sx0 - ax) * scale_x),
-        active_dst.y0 + lrint((sy0 - ay) * scale_y),
-        active_dst.x0 + lrint((sx1 - ax) * scale_x),
-        active_dst.y0 + lrint((sy1 - ay) * scale_y),
+        active_coord(active_dst.x0 + (sx0 - ax) * scale_x),
+        active_coord(active_dst.y0 + (sy0 - ay) * scale_y),
+        active_coord(active_dst.x0 + (sx1 - ax) * scale_x),
+        active_coord(active_dst.y0 + (sy1 - ay) * scale_y),
