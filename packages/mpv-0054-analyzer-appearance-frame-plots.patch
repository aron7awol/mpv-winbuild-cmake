From: mpv-ht development <dev@mpv-ht.local>
Date: Sun, 13 Sep 2026 08:00:00 -0400
Subject: [PATCH] analyzer: separate background opacity and keep frame plots live

Keep occupied XY and waveform cells opaque while allowing transparent empty
backgrounds. Invalidate cached plots when opacity changes, including while
paused. Chromaticity reduction follows the visible chart independently of
cursor sampling, so mouse exit can stop pixel readouts without hiding the
whole-frame gamut cloud.

diff --git a/video/out/analyzer_async_bridge.h b/video/out/analyzer_async_bridge.h
index 555e4a40d..7404e447a 100644
--- a/video/out/analyzer_async_bridge.h
+++ b/video/out/analyzer_async_bridge.h
@@ -13,7 +13,7 @@ struct async_probe {
     pl_tex xy_display;
     struct pl_overlay_part xy_part;
     struct pl_overlay *xy_overlays;
-    float xy_cap, xy_background;
+    float xy_cap, xy_background, xy_opacity, wave_opacity;
     pl_buf wave_buf;
     pl_tex wave_tex;
     struct pl_overlay_part wave_part;
@@ -254,7 +254,7 @@ static struct pl_hook_res async_probe_hook(void *priv, const struct pl_hook_para
             (!(stages & 2) || async_output_frame(p,&a->output,s,source_hook))) {
             s->meta.stats_ns=submitted;
             // Optional presentation work must never gate frame statistics.
-            if (p->next_opts->analyzer_cursor && p->next_opts->analyzer_xy_size > 0)
+            if (p->next_opts->analyzer_xy_size > 0)
                 analyzer_xy_update(p,hp,s,source_hook);
             analyzer_waveform_update(p,hp,s,source_hook);
             a->last_stats_revision=revision;
