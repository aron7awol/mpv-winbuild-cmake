From 6187106d40a6302e486e8aefd0bd16e2a6fab0ce Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:54:17 -0500
Subject: [PATCH] colorspace: shape contrast with smooth gain and shadow limits

Consolidates the published .76 changes without modifying the final source.
Original: libplacebo-0026-p-histogram-tone-mapping.patch
Original: libplacebo-0029-hstm-preserve-highlight-order.patch
Original: libplacebo-0031-hstm-smooth-near-black.patch
Original: libplacebo-0032-hstm-near-black-option.patch
Original: libplacebo-0036-hstm-smooth-gain-limits.patch

diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index ac59d8ad5ea191c9b1b423c42b6c834da7ba9524..5a9f7d3e9bd401aed127392efb6e79cfa9ba50df 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -190,6 +190,9 @@ struct pl_peak_detect_params {
     // Set internally by the renderer only for generic pixel DTM.
     enum pl_tone_map_metric metric;
 
+    // Renderer-owned full-range P histogram, only for enabled HSTM.
+    bool hstm_histogram;
+
     // One-shot tag for the measurement submitted with these parameters. When
     // its GPU result is consumed, temporal peak/average smoothing is reseeded
     // from that frame. Deliberately excluded from parameter equality.
@@ -353,6 +356,14 @@ struct pl_color_map_params {
     // mapping function capable of bidirectional mapping.
     bool gamut_expansion;
 
+    // Private P RGB-ray histogram shaping and above-source retention (0..1).
+    // Defaults off. At full retention above-source gain is bounded to 2x.
+    float hstm_strength;
+    float hstm_overbrightening;
+    // Retain the near-black base slope and fade shaping in from 0.1 to 1 nit.
+    // False allows redistribution down to black; source/peak limits still apply.
+    bool hstm_near_black_protection;
+
     // --- Tone mapping options
 
     // Tone mapping function to use to handle out-of-range colors.
@@ -451,6 +462,7 @@ struct pl_color_map_params {
     .tone_constants         = { PL_TONE_MAP_CONSTANTS },        \
     .metadata               = PL_HDR_METADATA_ANY,              \
     .adaptive_chroma_strength = 0.5f,                           \
+    .hstm_near_black_protection = true,                         \
     .ambient_gamma          = 1.0f,                             \
     .lut3d_size             = {48, 32, 256},                    \
     .lut_size               = 256,                              \
