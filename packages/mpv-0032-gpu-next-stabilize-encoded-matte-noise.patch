From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mpv-ht development <development@mpv-ht.local>
Date: Mon, 31 Aug 2026 16:00:00 -0400
Subject: [PATCH] gpu-next: stabilize encoded matte noise

Distinguish sparse encoded residue from established picture content when
extending the exact black core to the authored image boundary.
---
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index aaaa5c7725a5a5bbacf4e797e27d8aa59b10524f..a44cd05213e039969c3df6f10d3d4ec6668d3440 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -107,6 +107,9 @@ struct frame_info {
 struct bar_gpu_data {
     // min, max, sum, sample count in normalized unsigned 16-bit luma.
     uint32_t rows[BAR_ANALYSIS_MAX_ROWS][4];
+    // Pixels materially above nominal black, used to distinguish sparse codec
+    // residue from an established row of picture content.
+    uint32_t bright[BAR_ANALYSIS_MAX_ROWS];
 };
 
 struct bar_analysis_slot {
@@ -1120,43 +1123,29 @@ static void store_bar_result(struct priv *p, uint64_t tag, int width, int height
             result.valid = false;
             result.indeterminate = true;
         } else if (exact_top >= 2 && exact_bottom >= 2) {
-            // Codec blocks can contaminate the last matte rows. Refine only a
-            // short and vertically mirrored neighbourhood beyond the exact
-            // core. Select the strongest paired row transition rather than a
-            // broad per-pixel "black" threshold: this crosses contaminated
-            // HEVC/H.264 block rows and lands on the authored image edge.
+            // Codec blocks can perturb otherwise black matte rows by a few
+            // luma code values. Extend the perfectly uniform core only while
+            // every value in both mirrored rows remains near this frame's
+            // measured black baseline. The first genuine non-black value is
+            // content; this tolerance exists solely for encoded matte noise.
             int core = MPMIN(exact_top, exact_bottom);
-            int best_edge = core;
-            uint32_t best_rise = 0;
+            int centered = core;
+            uint32_t matte_ceiling = black + 2048;
+            uint32_t noise_pixels = MPMAX(4, width / 200);
             for (int n = 0; n < 64; n++) {
-                int y0 = core + n, y1 = y0 + 1;
-                if (y1 >= height / 2)
+                int y = core + n;
+                if (y >= height / 2)
                     break;
-                const uint32_t *t0 = data->rows[y0];
-                const uint32_t *b0 = data->rows[height - 1 - y0];
-                const uint32_t *t1 = data->rows[y1];
-                const uint32_t *b1 = data->rows[height - 1 - y1];
-                uint32_t tm0 = t0[3] ? t0[2] / t0[3] : UINT32_MAX;
-                uint32_t bm0 = b0[3] ? b0[2] / b0[3] : UINT32_MAX;
-                uint32_t tm1 = t1[3] ? t1[2] / t1[3] : UINT32_MAX;
-                uint32_t bm1 = b1[3] ? b1[2] / b1[3] : UINT32_MAX;
-                if (abs((int) tm1 - (int) bm1) > 2048)
-                    continue;
-                uint32_t pair0 = ((uint64_t) tm0 + bm0) / 2;
-                uint32_t pair1 = ((uint64_t) tm1 + bm1) / 2;
-                // Refinement may traverse codec-contaminated matte rows, but
-                // never search onward through established picture content.
-                // In particular, this prevents a centered horizon or title
-                // edge from replacing an already exact matte boundary.
-                if (pair0 > black + 4096)
+                const uint32_t *top = data->rows[y];
+                const uint32_t *bottom = data->rows[height - 1 - y];
+                bool top_content = top[1] > matte_ceiling &&
+                                   data->bright[y] > noise_pixels;
+                bool bottom_content = bottom[1] > matte_ceiling &&
+                    data->bright[height - 1 - y] > noise_pixels;
+                if (top_content || bottom_content)
                     break;
-                uint32_t rise = pair1 > pair0 ? pair1 - pair0 : 0;
-                if (rise > best_rise) {
-                    best_rise = rise;
-                    best_edge = y1;
-                }
+                centered = y + 1;
             }
-            int centered = best_rise >= 256 ? best_edge : core;
             int active_h = height - 2 * centered;
             if (active_h > 0 && (double) width / active_h <= 3.0) {
                 result.top = result.bottom = centered;
@@ -1268,7 +1257,20 @@ static const struct pl_buffer_var bar_buffer_vars[] = {{
     .layout = {
         .offset = 0,
         .stride = sizeof(uint32_t) * 4,
-        .size = sizeof(struct bar_gpu_data),
+        .size = sizeof(((struct bar_gpu_data *) 0)->rows),
+    },
+}, {
+    .var = {
+        .name = "bright",
+        .type = PL_VAR_UINT,
+        .dim_v = 1,
+        .dim_m = 1,
+        .dim_a = BAR_ANALYSIS_MAX_ROWS,
+    },
+    .layout = {
+        .offset = offsetof(struct bar_gpu_data, bright),
+        .stride = sizeof(uint32_t),
+        .size = sizeof(((struct bar_gpu_data *) 0)->bright),
     },
 }};
 
@@ -1340,19 +1342,21 @@ static bool submit_bar_analysis(struct priv *p, struct pl_frame *frame,
         "shared uint row_min[64];\n"
         "shared uint row_max[64];\n"
         "shared uint row_sum[64];\n"
-        "shared uint row_count[64];\n";
+        "shared uint row_count[64];\n"
+        "shared uint row_bright[64];\n";
     char *body = talloc_asprintf(NULL,
         "uint lane = gl_LocalInvocationID.x;\n"
         "uint y = gl_WorkGroupID.y;\n"
         "uvec2 size = uvec2(textureSize(luma_tex, 0));\n"
-        "uint mn = 65535u, mx = 0u, sum = 0u, count = 0u;\n"
+        "uint mn = 65535u, mx = 0u, sum = 0u, count = 0u, hi = 0u;\n"
         "for (uint x = lane; x < size.x; x += 64u) {\n"
         "    float v = texelFetch(luma_tex, ivec2(x, y), 0)[%d];\n"
         "    uint q = uint(clamp(v, 0.0, 1.0) * 65535.0 + 0.5);\n"
         "    mn = min(mn, q); mx = max(mx, q); sum += q; count++;\n"
+        "    hi += q > 6000u ? 1u : 0u;\n"
         "}\n"
         "row_min[lane] = mn; row_max[lane] = mx;\n"
-        "row_sum[lane] = sum; row_count[lane] = count;\n"
+        "row_sum[lane] = sum; row_count[lane] = count; row_bright[lane] = hi;\n"
         "barrier();\n"
         "for (uint step = 32u; step > 0u; step >>= 1u) {\n"
         "    if (lane < step) {\n"
@@ -1360,11 +1364,14 @@ static bool submit_bar_analysis(struct priv *p, struct pl_frame *frame,
         "        row_max[lane] = max(row_max[lane], row_max[lane + step]);\n"
         "        row_sum[lane] += row_sum[lane + step];\n"
         "        row_count[lane] += row_count[lane + step];\n"
+        "        row_bright[lane] += row_bright[lane + step];\n"
         "    }\n"
         "    barrier();\n"
         "}\n"
-        "if (lane == 0u) rows[y] = uvec4(row_min[0], row_max[0], "
-        "                                row_sum[0], row_count[0]);\n",
+        "if (lane == 0u) {\n"
+        "    rows[y] = uvec4(row_min[0], row_max[0], row_sum[0], row_count[0]);\n"
+        "    bright[y] = row_bright[0];\n"
+        "}\n",
         component);
 
     pl_shader sh = pl_dispatch_begin(p->bar_dispatch);
-- 
2.51.0.windows.1
