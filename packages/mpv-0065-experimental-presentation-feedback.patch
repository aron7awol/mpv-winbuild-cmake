diff --git a/video/out/presentation_feedback.h b/video/out/presentation_feedback.h
new file mode 100644
index 000000000..daf7cc125
--- /dev/null
+++ b/video/out/presentation_feedback.h
@@ -0,0 +1,146 @@
+#pragma once
+
+// Pure policy helpers: no driver calls, sleeps, allocation or logging.
+#include <stdbool.h>
+#include <stdint.h>
+#include <math.h>
+
+enum ht_feedback_source { HT_FEEDBACK_FALLBACK, HT_FEEDBACK_DXGI,
+                          HT_FEEDBACK_VK_COMPLETION };
+
+struct ht_dxgi_state {
+    uint32_t present, refresh;
+    int64_t last_advance;
+    bool initialized, blocked;
+};
+
+struct ht_dxgi_result {
+    bool valid;
+    int queued;
+    int64_t predicted, skipped;
+};
+
+static inline struct ht_dxgi_result ht_dxgi_validate(
+    struct ht_dxgi_state *s, uint32_t submitted, uint32_t presented,
+    uint32_t present_refresh, uint32_t sync_refresh, int64_t sync_time,
+    int64_t now, int64_t period, int64_t nominal)
+{
+    struct ht_dxgi_result r = {.queued = -1, .skipped = -1};
+    // Counter differences are modulo 2^32. The bounded queue also rejects
+    // unexplained counter regression/reset instead of extrapolating it.
+    uint32_t pending = submitted - presented;
+    int32_t age = (int32_t)(sync_refresh - present_refresh);
+    if (!presented || !present_refresh || !sync_refresh || sync_time <= 0 ||
+        period < 2500000 || period > 50000000 || pending > 64 ||
+        age < -2 || age > 64 || sync_time > now + period ||
+        now - sync_time > 500000000 ||
+        (nominal > 0 && fabs((double)period / nominal - 1) > 0.05))
+        goto invalid;
+    if (s->blocked && presented == s->present && present_refresh == s->refresh)
+        goto invalid;
+    if (!s->initialized) {
+        s->initialized = true;
+        s->blocked = false;
+        s->last_advance = now;
+    } else {
+        uint32_t dp = presented - s->present, dr = present_refresh - s->refresh;
+        if (dp > 128 || dr > 128 || (dp == 0 && dr != 0))
+            goto invalid;
+        if (dp) {
+            s->last_advance = now;
+            // Only the caller knows whether every refresh was intended.
+            r.skipped = dr >= dp ? dr - dp : -1;
+        } else {
+            r.skipped = 0; // repeated statistics are not additional misses
+        }
+    }
+    s->present = presented;
+    s->refresh = present_refresh;
+    if (now - s->last_advance > (period * 8 > 250000000 ? period * 8 : 250000000))
+        goto invalid;
+    r.predicted = sync_time + ((int64_t)pending - age) * period;
+    if (r.predicted < now - period * 2 ||
+        r.predicted > now + (pending + 2) * period)
+        goto invalid;
+    r.valid = true;
+    r.queued = pending;
+    return r;
+invalid:
+    *s = (struct ht_dxgi_state){.present = presented, .refresh = present_refresh,
+        .last_advance = now, .blocked = true};
+    return (struct ht_dxgi_result){.queued = -1, .skipped = -1};
+}
+
+struct ht_drift_guard {
+    uint64_t epoch;
+    double filtered, persistence, cooldown_until, last_time;
+    int direction;
+    int64_t small_corrections, recovery_corrections, signed_refreshes;
+};
+
+static inline bool ht_guard_timing_ready(bool validated, int samples,
+    double chosen_period, double measured_period, double jitter, double age)
+{
+    if (!isfinite(age) || age < 0 || age > 0.25) return false;
+    if (validated) return true;
+    return samples >= 32 && chosen_period > 0 && measured_period > 0 &&
+        isfinite(jitter) && jitter >= 0 && jitter < 0.05 &&
+        fabs(measured_period / chosen_period - 1) < 0.05;
+}
+
+static inline void ht_drift_reset(struct ht_drift_guard *g)
+{
+    *g = (struct ht_drift_guard){0};
+}
+
+// avdiff already includes the scheduler's queued correction offset. Never
+// subtract that correction a second time. Cooldown permits it to reach output.
+static inline int ht_drift_step(struct ht_drift_guard *g, uint64_t epoch,
+    double now, double error, double period, double frame_duration,
+    double queue_seconds, int holds, bool eligible)
+{
+    if (!eligible || !isfinite(error) || !isfinite(period) || period <= 0 ||
+        !isfinite(queue_seconds) || !isfinite(frame_duration)) {
+        ht_drift_reset(g);
+        return 0;
+    }
+    if (g->epoch != epoch || now <= g->last_time || now - g->last_time > 0.5) {
+        // Keep diagnostic totals for this scheduler lifetime across epochs.
+        g->epoch = epoch;
+        g->filtered = g->persistence = 0;
+        g->direction = 0;
+        g->cooldown_until = now + fmax(0.25, queue_seconds + 2 * frame_duration);
+    }
+    double dt = fmin(fmax(now - g->last_time, 0), 0.1);
+    g->last_time = now;
+    if (now < g->cooldown_until)
+        return 0;
+    g->filtered += (1 - exp(-dt / 0.1)) * (error - g->filtered);
+    double threshold = fmax(0.020, period);
+    int sign = error > 0 ? 1 : -1;
+    bool large = fabs(error) >= fmax(0.150, 4 * period);
+    if (fabs(error) < threshold || (!large && fabs(g->filtered) < threshold) ||
+        error * g->filtered <= 0) {
+        g->persistence = 0;
+        g->direction = 0;
+        return 0;
+    }
+    if (g->direction != sign) {
+        g->direction = sign;
+        g->persistence = 0;
+    }
+    g->persistence += dt;
+    if (g->persistence < (large ? fmax(frame_duration, 0.04) : 0.15))
+        return 0;
+    int count = large ? fmin(4, fabs(error) / period) : 1;
+    int correction = -sign * count;
+    if (correction < -holds) correction = -holds;
+    if (correction > holds * 10) correction = holds * 10;
+    if (!correction) return 0;
+    g->cooldown_until = now + fmax(0.15, queue_seconds + 2 * period);
+    g->filtered = g->persistence = 0;
+    g->direction = 0;
+    g->signed_refreshes += correction;
+    if (large) g->recovery_corrections++; else g->small_corrections++;
+    return correction;
+}
