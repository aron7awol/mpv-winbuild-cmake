     int analyzer_waveform_layers, analyzer_waveform_tint;
     float analyzer_sdr_output_peak, analyzer_sdr_output_gamma;
@@ -310,6 +311,7 @@ const struct m_sub_options gl_next_conf = {
         {"hdr-authored-scene-reset", OPT_BOOL(authored_scene_reset)},
