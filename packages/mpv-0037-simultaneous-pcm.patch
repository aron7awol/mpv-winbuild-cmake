diff --git a/player/audio_secondary.c b/player/audio_secondary.c
new file mode 100644
index 000000000..e11a4f132
--- /dev/null
+++ b/player/audio_secondary.c
@@ -0,0 +1,349 @@
+/* Simultaneous passthrough + PCM. LGPL-2.1-or-later. */
+#include <math.h>
+#include <string.h>
+#include <libavcodec/avcodec.h>
+#include "common/av_common.h"
+#include "common/msg.h"
+#include "audio/aframe.h"
+#include "audio/format.h"
+#include "audio/out/ao.h"
+#include "demux/stheader.h"
+#include "filters/f_async_queue.h"
+#include "filters/f_decoder_wrapper.h"
+#include "filters/f_output_chain.h"
+#include "filters/filter_internal.h"
+#include "options/options.h"
+#include "osdep/timer.h"
+#include "core.h"
+
+struct secondary_audio {
+    struct MPContext *mpctx;
+    struct mp_filter *f, *reader, *writer;
+    struct mp_decoder *decoder;
+    struct mp_output_chain *chain;
+    struct ao *ao;
+    struct mp_codec_params codec;
+    double last_pts, first_pts, speed, drift;
+    double pcm_start, primary_start, video_start;
+    double paused_at;
+    double next_clock;
+    bool planned, started, eof, failed, primary_start_known;
+    const char *error;
+};
+
+static bool enabled(struct MPContext *mpctx)
+{
+    return mpctx->opts->audio_pcm_device && mpctx->opts->audio_pcm_device[0];
+}
+
+static void fail(struct secondary_audio *s, const char *reason)
+{
+    if (s->failed)
+        return;
+    s->failed = true;
+    s->error = reason;
+    MP_ERR(s->mpctx, "Secondary PCM: %s; playback paused.\n", reason);
+    set_pause_state(s->mpctx, true);
+}
+
+static void process(struct mp_filter *f)
+{
+    struct secondary_audio *s = f->priv;
+    struct MPContext *mpctx = s->mpctx;
+    struct ao_chain *primary = mpctx->ao_chain;
+    if (s->failed || !primary)
+        return;
+    struct mp_pin *out = s->chain->f->pins[1];
+    if (!s->writer) {
+        mp_pin_out_request_data(out);
+        if (s->chain->got_output_eof)
+            s->eof = true;
+        mp_wakeup_core(mpctx);
+        return;
+    }
+    if (!primary->start_pts_known)
+        return;
+    if (s->eof || !mp_pin_can_transfer_data(s->writer->pins[0], out))
+        return;
+    struct mp_frame frame = mp_pin_out_read(out);
+    if (frame.type == MP_FRAME_AUDIO) {
+        struct mp_aframe *af = frame.data;
+        double end = get_play_end_pts(mpctx);
+        double start = s->first_pts == MP_NOPTS_VALUE ? primary->start_pts :
+                       MP_NOPTS_VALUE;
+        mp_aframe_clip_timestamps(af, start, end);
+        if (mp_aframe_get_pts(af) == MP_NOPTS_VALUE) {
+            mp_frame_unref(&frame);
+            fail(s, "decoded audio has no synchronization timestamp");
+            return;
+        }
+        if (!mp_aframe_get_size(af)) {
+            bool at_end = end != MP_NOPTS_VALUE && mp_aframe_get_pts(af) >= end;
+            mp_frame_unref(&frame);
+            if (at_end) {
+                s->eof = true;
+                mp_pin_in_write(s->writer->pins[0], MP_EOF_FRAME);
+            }
+            mp_filter_internal_mark_progress(f);
+            return;
+        }
+        if (s->first_pts == MP_NOPTS_VALUE)
+            s->first_pts = mp_aframe_get_pts(af);
+        s->last_pts = mp_aframe_end_pts(af);
+    } else if (frame.type == MP_FRAME_EOF) {
+        s->eof = true;
+    } else {
+        mp_frame_unref(&frame);
+        return;
+    }
+    mp_pin_in_write(s->writer->pins[0], frame);
+    mp_wakeup_core(mpctx);
+}
+
+static void reset(struct mp_filter *f)
+{
+    struct secondary_audio *s = f->priv;
+    if (s->ao)
+        ao_reset(s->ao);
+    s->last_pts = s->first_pts = MP_NOPTS_VALUE;
+    s->planned = s->started = s->eof = false;
+    s->primary_start_known = false;
+    s->speed = 1;
+    s->drift = 0;
+    s->paused_at = 0;
+    s->next_clock = 0;
+    if (s->chain)
+        mp_output_chain_set_audio_speed(s->chain, 1, 1, 1);
+}
+
+static void destroy(struct mp_filter *f)
+{
+    struct secondary_audio *s = f->priv;
+    // Queue accessors and conversion chain must release AO references first.
+    mp_filter_free_children(f);
+    if (s->ao)
+        ao_uninit(s->ao);
+}
+
+static const struct mp_filter_info info = {
+    .name = "secondary-pcm", .priv_size = sizeof(struct secondary_audio),
+    .process = process, .reset = reset, .destroy = destroy,
+};
+
+void secondary_audio_close(struct MPContext *mpctx)
+{
+    if (mpctx->secondary_audio)
+        talloc_free(mpctx->secondary_audio->f);
+    mpctx->secondary_audio = NULL;
+}
+
+void secondary_audio_reset(struct MPContext *mpctx)
+{
+    if (mpctx->secondary_audio)
+        mp_filter_reset(mpctx->secondary_audio->f);
+}
+
+void secondary_audio_pause(struct MPContext *mpctx, bool paused)
+{
+    struct secondary_audio *s = mpctx->secondary_audio;
+    if (!s || !s->ao)
+        return;
+    ao_set_paused(s->ao, paused, s->eof && !ao_is_playing(s->ao));
+    if (paused) {
+        s->paused_at = mp_time_sec();
+    } else if (s->paused_at) {
+        double elapsed = mp_time_sec() - s->paused_at;
+        s->pcm_start += elapsed;
+        s->primary_start += elapsed;
+        s->video_start += elapsed;
+        s->paused_at = 0;
+    }
+}
+
+static bool create(struct MPContext *mpctx)
+{
+    struct track *t = mpctx->ao_chain->track;
+    if (!t || !t->dec || !t->dec->pcm_packets)
+        return false;
+    struct mp_filter *f = mp_filter_create(mpctx->filter_root, &info);
+    struct secondary_audio *s = f->priv;
+    *s = (struct secondary_audio){.mpctx = mpctx, .f = f,
+        .last_pts = MP_NOPTS_VALUE, .first_pts = MP_NOPTS_VALUE, .speed = 1};
+    mpctx->secondary_audio = s;
+    // ad_lavc updates codec metadata; do not modify the primary decoder's copy.
+    s->codec = *t->stream->codec;
+    const AVCodec *impl = avcodec_find_decoder(mp_codec_to_av_codec_id(s->codec.codec));
+    s->decoder = impl ? ad_lavc.create(f, &s->codec, impl->name) : NULL;
+    if (!s->decoder) {
+        fail(s, "no PCM decoder for this track");
+        return false;
+    }
+    s->reader = mp_async_queue_create_filter(f, MP_PIN_OUT, t->dec->pcm_packets);
+    s->chain = mp_output_chain_create(f, MP_OUTPUT_CHAIN_AUDIO);
+    mp_pin_connect(s->decoder->f->pins[0], s->reader->pins[0]);
+    mp_pin_connect(s->chain->f->pins[0], s->decoder->f->pins[1]);
+    mp_pin_set_manual_connection_for(s->chain->f->pins[1], f);
+    mp_filter_wakeup(f);
+    return true;
+}
+
+// Called at the primary's start boundary. Negative offsets start PCM first;
+// positive offsets start primary first. Neither path discards program samples.
+bool secondary_audio_start(struct MPContext *mpctx)
+{
+    struct secondary_audio *s = mpctx->secondary_audio;
+    if (!enabled(mpctx))
+        return true;
+    if (s && s->eof && !s->ao)
+        return true;
+    if (!s || s->failed || !s->ao || s->last_pts == MP_NOPTS_VALUE)
+        return false;
+    if (get_internal_paused(mpctx))
+        return false;
+    double now = mp_time_sec();
+    if (!s->planned) {
+        double primary = playing_audio_pts(mpctx);
+        if (primary == MP_NOPTS_VALUE)
+            return false;
+        double delta = s->first_pts - primary + mpctx->opts->audio_pcm_delay;
+        double late = 0;
+        if (mpctx->vo_chain && mpctx->video_status != STATUS_EOF &&
+            mpctx->video_pts != MP_NOPTS_VALUE)
+            late = MPMAX(0, primary - (mpctx->video_pts - mpctx->opts->audio_delay));
+        s->video_start = now + MPMAX(0, -(late + delta));
+        s->primary_start = s->video_start + late;
+        s->pcm_start = s->primary_start + delta;
+        s->planned = true;
+        MP_VERBOSE(mpctx, "Secondary PCM start offset %.3f ms\n", delta * 1000);
+    }
+    if (!s->started && now >= s->pcm_start) {
+        ao_start(s->ao);
+        s->started = true;
+    }
+    if (now < s->primary_start) {
+        mp_set_timeout(mpctx, s->primary_start - now);
+        return false;
+    }
+    if (!s->started)
+        mp_set_timeout(mpctx, s->pcm_start - now);
+    return true;
+}
+
+bool secondary_audio_video_ready(struct MPContext *mpctx)
+{
+    if (!enabled(mpctx) || get_internal_paused(mpctx))
+        return true;
+    secondary_audio_start(mpctx);
+    struct secondary_audio *s = mpctx->secondary_audio;
+    return s && ((s->planned && mp_time_sec() >= s->video_start) ||
+                 (s->eof && !s->ao));
+}
+
+void secondary_audio_update(struct MPContext *mpctx)
+{
+    if (!enabled(mpctx) || !mpctx->ao_chain)
+        return;
+    if (!mpctx->secondary_audio && !create(mpctx))
+        return;
+    struct secondary_audio *s = mpctx->secondary_audio;
+    if (s->failed)
+        return;
+    mp_set_timeout(mpctx, 0.02);
+    if (mpctx->play_dir != 1 || fabs(mpctx->audio_speed - 1) > 0.0001) {
+        fail(s, "simultaneous passthrough requires forward, normal-speed playback");
+        return;
+    }
+    if (mp_filter_has_failed(s->decoder->f) || s->chain->failed_output_conversion) {
+        fail(s, "PCM decoding or format conversion failed");
+        return;
+    }
+    if (s->chain->ao_needs_update) {
+        if (s->ao) {
+            fail(s, "midstream PCM format change requires audio reload");
+            return;
+        }
+        struct mp_aframe *fmt = s->chain->output_aformat;
+        struct mp_chmap channels;
+        mp_aframe_get_chmap(fmt, &channels);
+        s->ao = ao_init_pcm(mpctx->global, mpctx->opts->audio_pcm_device,
+            mp_wakeup_core_cb, mpctx, mp_aframe_get_rate(fmt),
+            mp_aframe_get_format(fmt), channels);
+        if (!s->ao) {
+            fail(s, "could not open the selected PCM endpoint");
+            return;
+        }
+        int rate, format;
+        struct mp_chmap actual;
+        ao_get_format(s->ao, &rate, &format, &actual);
+        if (af_fmt_is_spdif(format) || !mp_chmap_equals(&channels, &actual)) {
+            fail(s, "PCM endpoint does not support the decoded channel layout");
+            return;
+        }
+        mp_output_chain_set_ao(s->chain, s->ao);
+        s->writer = mp_async_queue_create_filter(s->f, MP_PIN_IN, ao_get_queue(s->ao));
+        mp_async_queue_set_notifier(s->writer, s->f);
+        ao_set_paused(s->ao, get_internal_paused(mpctx), false);
+        MP_INFO(mpctx, "Secondary PCM: %d Hz, %s, %s\n", rate,
+                mp_chmap_to_str(&actual), af_fmt_to_str(format));
+    }
+    if (s->primary_start_known != mpctx->ao_chain->start_pts_known) {
+        s->primary_start_known = mpctx->ao_chain->start_pts_known;
+        mp_filter_wakeup(s->f);
+    }
+    if (!s->ao)
+        return;
+    if (ao_query_and_reset_events(s->ao, AO_EVENT_RELOAD | AO_EVENT_RELOAD_FAILURE)) {
+        fail(s, "PCM endpoint was lost; reload audio to reconnect");
+        return;
+    }
+    // Follow mute/volume without ever applying PCM processing to the carrier.
+    ao_set_gain(s->ao, audio_get_gain(mpctx));
+    if (get_internal_paused(mpctx))
+        return;
+    double now = mp_time_sec();
+    if (s->planned && !s->started && now >= s->pcm_start) {
+        ao_start(s->ao);
+        s->started = true;
+    }
+    if (s->started && !s->eof && now > s->pcm_start + 0.25 &&
+        !ao_is_playing(s->ao)) {
+        fail(s, "PCM underrun; reload audio to resynchronize");
+        return;
+    }
+    if (!s->started || mpctx->audio_status < STATUS_PLAYING ||
+        mpctx->audio_status == STATUS_EOF || !mpctx->ao ||
+        !ao_is_playing(mpctx->ao) || !ao_is_playing(s->ao))
+        return;
+    if (now < s->next_clock)
+        return;
+    s->next_clock = now + 0.05;
+    double primary = playing_audio_pts(mpctx);
+    double pcm = s->last_pts - ao_get_delay(s->ao) * s->speed;
+    double error = pcm - primary + mpctx->opts->audio_pcm_delay;
+    MP_DBG(mpctx, "PCM clock primary=%.6f pcm=%.6f tail=%.6f delay=%.6f error=%.6f speed=%.6f\n",
+           primary, pcm, s->last_pts, ao_get_delay(s->ao), error, s->speed);
+    s->drift += 0.1 * (error - s->drift);
+    // A bounded clock follower. Positive error means PCM is ahead: slow it.
+    s->speed = 1 - MPCLAMP((fabs(s->drift) < 0.001 ? 0 : s->drift) * 0.1, -0.005, 0.005);
+    mp_output_chain_set_audio_speed(s->chain, 1, s->speed, 1);
+}
+
+bool secondary_audio_drained(struct MPContext *mpctx)
+{
+    struct secondary_audio *s = mpctx->secondary_audio;
+    return !enabled(mpctx) || !s || s->failed ||
+           (s->eof && (!s->ao || (s->started && !ao_is_playing(s->ao) &&
+                                  !mp_async_queue_get_frames(ao_get_queue(s->ao)))));
+}
+
+char *secondary_audio_status(struct MPContext *mpctx)
+{
+    struct secondary_audio *s = mpctx->secondary_audio;
+    if (!s)
+        return talloc_strdup(NULL, "PCM: waiting for passthrough audio");
+    if (s->failed)
+        return talloc_asprintf(NULL, "error: PCM %s", s->error);
+    return talloc_asprintf(NULL, "PCM: %s, drift %+.2f ms, correction %+.0f ppm",
+        s->started ? "running" : "buffering", s->drift * 1000,
+        (s->speed - 1) * 1e6);
+}
