From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <noreply@openai.com>
Date: Mon, 12 Oct 2026 08:30:00 -0400
Subject: [PATCH] d3d11: diagnose failed presentation without flooding the log

Report HRESULT, device removal reason, presentation duration and swapchain
state on failures, with bounded repetition and return-to-S_OK messages.
Keep successful playback quiet and do not change scheduling or recovery.

Preserve the existing Present expression: release-only patch 0065 records
its result for feedback. The initializer also preserves that assignment.
The two Present hunks deliberately use context on opposite sides of it.

---
diff --git a/video/out/d3d11/context.c b/video/out/d3d11/context.c
index 8bac900b2..6b62b301c 100644
--- a/video/out/d3d11/context.c
+++ b/video/out/d3d11/context.c
@@ -26,4 +26,5 @@
 #include "video/out/w32_common.h"
 #include "context.h"
 #include "ra_d3d11.h"
+#include "result_log.h"
 #include "vsync_estimator.h"
@@ -109,6 +110,14 @@ const struct m_sub_options d3d11_conf = {
     .size = sizeof(struct d3d11_opts)
 };
 
+enum result_operation {
+    RESULT_PRESENT,
+    RESULT_GET_BUFFER,
+    RESULT_RESIZE,
+    RESULT_FULLSCREEN,
+    RESULT_OPERATION_COUNT,
+};
+
 struct priv {
     struct d3d11_opts *opts;
     struct m_config_cache *opts_cache;
@@ -116,6 +125,10 @@ struct priv {
     struct mp_vo_opts *vo_opts;
     struct m_config_cache *vo_opts_cache;
 
+    struct d3d11_result_log result_log[RESULT_OPERATION_COUNT];
+    uint64_t present_calls;
+    uint64_t swapchain_generation;
+
     struct ra_tex *backbuffer;
     ID3D11Device *device;
     IDXGISwapChain *swapchain;
@@ -128,6 +141,66 @@ struct priv {
     struct mp_dxgi_factory_ctx dxgi_ctx;
 };
 
+static void log_result(struct ra_ctx *ctx, enum result_operation operation,
+                       HRESULT result, double call_ms)
+{
+    struct priv *p = ctx->priv;
+    struct d3d11_result_log *s = &p->result_log[operation];
+    // Successful steady-state playback adds no clock, device, or DXGI queries.
+    if (result == S_OK && !s->active)
+        return;
+
+    int64_t now = mp_time_ns();
+    enum d3d11_result_event event = d3d11_result_log_update(s, result, now);
+    if (event == D3D11_RESULT_QUIET)
+        return;
+
+    static const char *const names[] = {
+        "Present", "GetBuffer", "ResizeBuffers", "SetFullscreenState",
+    };
+    if (event == D3D11_RESULT_OK_AGAIN) {
+        MP_MSG(ctx, s->last_result < 0 ? MSGL_INFO : MSGL_V,
+               "D3D11 %s returned S_OK again: last=0x%08"PRIx32
+               " non_ok_calls=%"PRIu64" duration_ms=%.3f generation=%"PRIu64
+               " present_calls=%"PRIu64" (API success, not display confirmation)\n",
+               names[operation], (uint32_t)s->last_result, s->consecutive,
+               (now - s->first_ns) / 1e6, p->swapchain_generation,
+               p->present_calls);
+        return;
+    }
+
+    // These queries are diagnostic only, and run only when a report is emitted.
+    HRESULT removed = ID3D11Device_GetDeviceRemovedReason(p->device);
+    DXGI_SWAP_CHAIN_DESC desc = {0};
+    HRESULT desc_hr = IDXGISwapChain_GetDesc(p->swapchain, &desc);
+    BOOL exclusive = FALSE;
+    HRESULT fs_hr = IDXGISwapChain_GetFullscreenState(p->swapchain,
+                                                     &exclusive, NULL);
+    HWND window = ctx->opts.composition ? NULL : vo_w32_hwnd(ctx->vo);
+    MP_MSG(ctx, FAILED(result) ? MSGL_ERR : MSGL_V,
+           "D3D11 %s %s: hr=0x%08"PRIx32" (%s)"
+           " device_reason=0x%08"PRIx32" (%s) call_ms=%.3f"
+           " non_ok_calls=%"PRIu64" since_report=%"PRIu64
+           " duration_ms=%.3f generation=%"PRIu64" present_calls=%"PRIu64
+           " sync_interval=%d viewport=%dx%d fullscreen=%d exclusive=%d"
+           " composition=%d visible=%d minimized=%d"
+           " desc_hr=0x%08"PRIx32" fs_hr=0x%08"PRIx32
+           " buffers=%u size=%ux%u format=%u swap_effect=%u flags=0x%x\n",
+           names[operation], FAILED(result) ? "failed" : "status",
+           (uint32_t)result, mp_HRESULT_to_str(result),
+           (uint32_t)removed, mp_HRESULT_to_str(removed), call_ms,
+           s->consecutive, s->since_report, (now - s->first_ns) / 1e6,
+           p->swapchain_generation, p->present_calls, p->opts->sync_interval,
+           ctx->vo->dwidth, ctx->vo->dheight, p->vo_opts->fullscreen,
+           SUCCEEDED(fs_hr) ? !!exclusive : -1, ctx->opts.composition,
+           window ? !!IsWindowVisible(window) : -1,
+           window ? !!IsIconic(window) : -1,
+           (uint32_t)desc_hr, (uint32_t)fs_hr, desc.BufferCount,
+           desc.BufferDesc.Width, desc.BufferDesc.Height,
+           (unsigned)desc.BufferDesc.Format, (unsigned)desc.SwapEffect, desc.Flags);
+    s->since_report = 0;
+}
+
 static struct ra_tex *get_backbuffer(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
@@ -137,8 +210,8 @@ static struct ra_tex *get_backbuffer(struct ra_ctx *ctx)
 
     hr = IDXGISwapChain_GetBuffer(p->swapchain, 0, &IID_ID3D11Texture2D,
                                   (void**)&backbuffer);
+    log_result(ctx, RESULT_GET_BUFFER, hr, -1);
     if (FAILED(hr)) {
-        MP_ERR(ctx, "Couldn't get swapchain image\n");
         goto done;
     }
 
@@ -160,8 +233,8 @@ static bool resize(struct ra_ctx *ctx)
 
     hr = IDXGISwapChain_ResizeBuffers(p->swapchain, 0, ctx->vo->dwidth,
         ctx->vo->dheight, DXGI_FORMAT_UNKNOWN, 0);
+    log_result(ctx, RESULT_RESIZE, hr, -1);
     if (FAILED(hr)) {
-        MP_FATAL(ctx, "Couldn't resize swapchain: %s\n", mp_HRESULT_to_str(hr));
         return false;
     }
 
@@ -288,4 +361,6 @@ static void d3d11_swap_buffers(struct ra_swapchain *sw)
     LARGE_INTEGER perf_count;
     QueryPerformanceCounter(&perf_count);
     p->last_submit_qpc = perf_count.QuadPart;
+    // Also capture the result when the feedback patch assigns it here.
+    HRESULT hr =
 
@@ -293,3 +368,6 @@ static void d3d11_swap_buffers(struct ra_swapchain *sw)
+    p->present_calls++;
+    log_result(sw->ctx, RESULT_PRESENT, hr, hr == S_OK ? -1 :
+               (qpc_ns_now(sw) - qpc_to_ns(sw, p->last_submit_qpc)) / 1e6);
 }
 
 static void d3d11_get_vsync(struct ra_swapchain *sw, struct vo_vsync_info *info)
@@ -393,6 +471,7 @@ static bool d3d11_set_fullscreen(struct ra_ctx *ctx)
 
     hr = IDXGISwapChain_SetFullscreenState(p->swapchain,
                                            enable_exclusive_fs, NULL);
+    log_result(ctx, RESULT_FULLSCREEN, hr, -1);
     if (FAILED(hr))
         return false;
 
@@ -555,6 +634,7 @@ static bool d3d11_init(struct ra_ctx *ctx)
     if (!mp_d3d11_create_swapchain(p->device, ctx->log, &scopts, &p->swapchain))
         goto error;
 
+    p->swapchain_generation++;
     if (ctx->opts.composition)
         vo_w32_swapchain(ctx->vo, p->swapchain);
 
@@ -625,6 +705,7 @@ bool ra_d3d11_ctx_recreate_swapchain(struct ra_ctx *ra)
         return false;
     }
 
+    p->swapchain_generation++;
     if (ra->opts.composition)
         vo_w32_swapchain(ra->vo, p->swapchain);
     if (was_exclusive)
diff --git a/video/out/d3d11/result_log.h b/video/out/d3d11/result_log.h
new file mode 100644
--- /dev/null
+++ b/video/out/d3d11/result_log.h
@@ -0,0 +1,66 @@
+/*
+ * D3D11 result logging policy. No graphics or clock calls; independently testable.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef MP_D3D11_RESULT_LOG_H
+#define MP_D3D11_RESULT_LOG_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define D3D11_RESULT_LOG_INTERVAL_NS INT64_C(5000000000)
+
+enum d3d11_result_event {
+    D3D11_RESULT_QUIET,
+    D3D11_RESULT_REPORT,
+    D3D11_RESULT_OK_AGAIN,
+};
+
+struct d3d11_result_log {
+    bool active;
+    bool reported;
+    bool episode_reported;
+    int32_t last_result;
+    int32_t reported_result;
+    int64_t first_ns;
+    int64_t last_report_ns;
+    uint64_t consecutive;
+    uint64_t since_report;
+};
+
+// result is the signed 32-bit HRESULT: zero is S_OK, a positive value is a
+// status (e.g. occlusion), and a negative value is an error. Keep the cooldown
+// across successful calls, so alternating failure/success cannot spam the log.
+static inline enum d3d11_result_event d3d11_result_log_update(
+    struct d3d11_result_log *s, int32_t result, int64_t now)
+{
+    if (!result) {
+        if (!s->active)
+            return D3D11_RESULT_QUIET;
+        s->active = false;
+        return s->episode_reported ? D3D11_RESULT_OK_AGAIN : D3D11_RESULT_QUIET;
+    }
+
+    if (!s->active) {
+        s->active = true;
+        s->episode_reported = false;
+        s->first_ns = now;
+        s->consecutive = 0;
+    }
+    s->last_result = result;
+    s->consecutive++;
+    s->since_report++;
+
+    // An actual error must not be hidden by a recent harmless status report.
+    bool escalation = result < 0 && s->reported_result >= 0;
+    if (s->reported && !escalation &&
+        now - s->last_report_ns < D3D11_RESULT_LOG_INTERVAL_NS)
+        return D3D11_RESULT_QUIET;
+
+    s->reported = s->episode_reported = true;
+    s->reported_result = result;
+    s->last_report_ns = now;
+    return D3D11_RESULT_REPORT;
+}
+
+#endif
