From: mpv-ht <mpv-ht@localhost>
Date: Fri, 30 Oct 2026 12:00:00 -0400
Subject: [PATCH] renderer: preserve the code domain and intermediate precision for FEL

Normalize EL samples to the full code domain expected by inverse NLQ,
independently of the carrier video-range flag. Preserve FP32 intermediates
for the EL spatial stages and BL plane filtering while FEL is active.
FP16 rounding there can lose reconstructed 12-bit levels. Ordinary RGB
rendering and non-FEL plane precision remain unchanged.

Keep a normal-format fallback for GPUs without a suitable FP32 target.

---
diff --git a/src/renderer.c b/src/renderer.c
index 76d289891a0bdfbdd30719b0dd5cc438b42586d5..d649a797121e3b3b82ed03f8afa290c79a0d8583 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -638,6 +638,22 @@ static inline bool sampler_is_el(enum sampler_usage usage)
     return usage == SAMPLER_EL_LUMA || usage == SAMPLER_EL_CHROMA;
 }
 
+// BL and EL values used for FEL reconstruction are codes, not display RGB.
+// Rounding them to FP16 between filter passes can lose a reconstructed 12-bit
+// level even in an otherwise flat region. Keep this requirement local to
+// FEL reconstruction. Fall back to the normal FBO choice on GPUs without a
+// suitable FP32 render target.
+static pl_fmt dovi_fbo_format(struct pass_state *pass, int components)
+{
+    for (int c = components; c <= 4; c++) {
+        pl_fmt fmt = pl_find_fmt(pass->rr->gpu, PL_FMT_FLOAT, c, 32, 0,
+                                PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_LINEAR);
+        if (fmt)
+            return fmt;
+    }
+    return NULL;
+}
+
 struct sampler_info {
     const struct pl_filter_config *config; // if applicable
     enum sampler_usage usage;
@@ -761,6 +777,10 @@ static void dispatch_sampler(struct pass_state *pass, pl_shader sh,
 
     pl_renderer rr = pass->rr;
     struct sampler_info info = sample_src_info(pass, src, usage);
+    const bool fel_plane = usage == SAMPLER_PLANE &&
+        pass->image.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION &&
+        pass->image.enhancement_layer && pass->image.repr.dovi &&
+        pass->image.repr.dovi->nlq_active;
     pl_shader_obj *lut = NULL;
     switch (info.dir) {
     case SAMPLER_NOOP:
@@ -834,6 +854,8 @@ static void dispatch_sampler(struct pass_state *pass, pl_shader sh,
             .w  = src1.new_w,
             .h  = src1.new_h,
             .comps = src->components,
+            .fmt = sampler_is_el(usage) || fel_plane
+                 ? dovi_fbo_format(pass, src->components) : NULL,
         };
 
         src2.tex = img_tex(pass, &img);
@@ -1978,6 +2000,10 @@ static pl_shader sample_el(struct pass_state *pass, const struct pl_frame *el)
           rly = lry >= 1 ? roundf(lry) : 1.0 / roundf(1.0 / lry);
 
     struct pl_color_repr el_repr = el->repr;
+    // NLQ offsets/slopes use residual code / (2^el_depth - 1), regardless
+    // of the carrier's video-range flag. Retain storage depth and bit shift,
+    // but normalize to this full code domain (as for the Dolby Vision BL).
+    el_repr.levels = PL_COLOR_LEVELS_FULL;
     float el_scale = pl_color_repr_normalize(&el_repr);
 
 #pragma GLSL vec4 color = vec4(0.0), tmp;
@@ -2033,6 +2059,7 @@ static pl_shader sample_el(struct pass_state *pass, const struct pl_frame *el)
                 .w     = spatial_w,
                 .h     = spatial_h,
                 .comps = plane->components,
+                .fmt   = dovi_fbo_format(pass, plane->components),
             };
             pl_tex spatial_tex = img_tex(pass, &spatial);
             if (!spatial_tex) {
