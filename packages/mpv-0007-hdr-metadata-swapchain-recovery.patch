From 07a6ef39a8e45414d93eb73f3ddcdc306652fe40 Mon Sep 17 00:00:00 2001
From: Aaron <aaronmedeiros@gmail.com>
Date: Sat, 1 Aug 2026 01:58:40 -0400
Subject: [PATCH] d3d11: recover HDR metadata with a fresh swapchain

---
 video/out/d3d11/context.c    | 49 ++++++++++++++++++++++++++++++++++++
 video/out/d3d11/context.h    |  4 +++
 video/out/gpu_next/context.c | 30 ++++++++++++++++++++++
 video/out/gpu_next/context.h |  1 +
 video/out/vo_gpu_next.c      | 44 ++++++++++++++++++++++++++++++++
 5 files changed, 128 insertions(+)

diff --git a/video/out/d3d11/context.c b/video/out/d3d11/context.c
index fc8802e60..9fb65e283 100644
--- a/video/out/d3d11/context.c
+++ b/video/out/d3d11/context.c
@@ -598,6 +598,55 @@ IDXGISwapChain *ra_d3d11_ctx_get_swapchain(struct ra_ctx *ra)
     return p->swapchain;
 }
 
+bool ra_d3d11_ctx_recreate_swapchain(struct ra_ctx *ra)
+{
+    if (!ra || !ra->swapchain || ra->swapchain->fns != &d3d11_swapchain)
+        return false;
+
+    struct priv *p = ra->priv;
+    if (!p->swapchain || p->backbuffer)
+        return false;
+
+    BOOL was_exclusive = FALSE;
+    IDXGISwapChain_GetFullscreenState(p->swapchain, &was_exclusive, NULL);
+    if (was_exclusive)
+        IDXGISwapChain_SetFullscreenState(p->swapchain, FALSE, NULL);
+    if (ra->opts.composition)
+        vo_w32_swapchain(ra->vo, NULL);
+    SAFE_RELEASE(p->swapchain);
+
+    UINT usage = DXGI_USAGE_RENDER_TARGET_OUTPUT | DXGI_USAGE_SHADER_INPUT;
+    if (ID3D11Device_GetFeatureLevel(p->device) >= D3D_FEATURE_LEVEL_11_0 &&
+        p->opts->output_format != DXGI_FORMAT_B8G8R8A8_UNORM)
+    {
+        usage |= DXGI_USAGE_UNORDERED_ACCESS;
+    }
+
+    struct d3d11_swapchain_opts scopts = {
+        .window = ra->opts.composition ? NULL : vo_w32_hwnd(ra->vo),
+        .width = ra->vo->dwidth,
+        .height = ra->vo->dheight,
+        .format = p->opts->output_format,
+        .color_space = p->opts->color_space,
+        .configured_csp = &p->swapchain_csp,
+        .flip = p->opts->flip,
+        .length = ra->vo->opts->swapchain_depth + 1,
+        .usage = usage,
+    };
+    if (!mp_d3d11_create_swapchain(p->device, ra->log, &scopts,
+                                    &p->swapchain))
+    {
+        return false;
+    }
+
+    if (ra->opts.composition)
+        vo_w32_swapchain(ra->vo, p->swapchain);
+    if (was_exclusive)
+        IDXGISwapChain_SetFullscreenState(p->swapchain, TRUE, NULL);
+
+    return true;
+}
+
 #ifdef PL_HAVE_D3D11
 void ra_d3d11_ctx_set_swapchain_params(struct ra_ctx *ra,
                                        struct pl_d3d11_swapchain_params *params)
diff --git a/video/out/d3d11/context.h b/video/out/d3d11/context.h
index 640533b87..2f7d53ad8 100644
--- a/video/out/d3d11/context.h
+++ b/video/out/d3d11/context.h
@@ -8,6 +8,10 @@
 // refcounted and must be released by the caller.
 IDXGISwapChain *ra_d3d11_ctx_get_swapchain(struct ra_ctx *ra);
 
+// Replace only the DXGI swap chain, preserving the window, D3D11 device and
+// renderer context. No frame may be in progress when this is called.
+bool ra_d3d11_ctx_recreate_swapchain(struct ra_ctx *ra);
+
 // Sets pl_d3d11_swapchain_params according to requested d3d11-output-format for
 // an RA context.
 struct pl_d3d11_swapchain_params;
diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 369921cfc..259c6ef09 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -191,6 +191,36 @@ bool gpu_ctx_resize(struct gpu_ctx *ctx, int w, int h)
     return pl_swapchain_resize(ctx->swapchain, &w, &h);
 }
 
+bool gpu_ctx_recreate_d3d11_swapchain(struct gpu_ctx *ctx)
+{
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    if (!ctx->ra_ctx || !ctx->gpu || !ctx->swapchain ||
+        !ra_is_d3d11(ctx->ra_ctx->ra))
+    {
+        return false;
+    }
+
+    pl_swapchain_destroy(&ctx->swapchain);
+    if (!ra_d3d11_ctx_recreate_swapchain(ctx->ra_ctx))
+        return false;
+
+    IDXGISwapChain *swapchain = ra_d3d11_ctx_get_swapchain(ctx->ra_ctx);
+    if (!swapchain)
+        return false;
+
+    pl_d3d11 d3d11 = pl_d3d11_get(ctx->gpu);
+    struct pl_d3d11_swapchain_params *params = pl_d3d11_swapchain_params(
+        .swapchain = swapchain,
+    );
+    ra_d3d11_ctx_set_swapchain_params(ctx->ra_ctx, params);
+    ctx->swapchain = pl_d3d11_create_swapchain(d3d11, params);
+    SAFE_RELEASE(swapchain);
+    return !!ctx->swapchain;
+#else
+    return false;
+#endif
+}
+
 void gpu_ctx_destroy(struct gpu_ctx **ctxp)
 {
     struct gpu_ctx *ctx = *ctxp;
diff --git a/video/out/gpu_next/context.h b/video/out/gpu_next/context.h
index aa441964f..9b1c48d05 100644
--- a/video/out/gpu_next/context.h
+++ b/video/out/gpu_next/context.h
@@ -37,4 +37,5 @@ struct gpu_ctx {
 
 struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx_opts *ctx_opts);
 bool gpu_ctx_resize(struct gpu_ctx *ctx, int w, int h);
+bool gpu_ctx_recreate_d3d11_swapchain(struct gpu_ctx *ctx);
 void gpu_ctx_destroy(struct gpu_ctx **ctxp);
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 27567827e..f84d73d74 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -169,6 +169,10 @@ struct priv {
     struct frame_info perf_redraw;
 
     struct mp_image_params target_params;
+    int hdrdiag_swapchain_recreate_seq_applied;
+    int hdrdiag_swapchain_rearm_frames;
+    bool hdrdiag_last_hint_valid;
+    struct pl_color_space hdrdiag_last_hint;
 };
 
 static void update_render_options(struct vo *vo);
@@ -188,6 +192,7 @@ struct gl_next_opts {
     int target_hint;
     int target_hint_mode;
     bool target_hint_strict;
+    int hdrdiag_swapchain_recreate_seq;
     char **raw_opts;
 };
 
@@ -223,6 +228,8 @@ const struct m_sub_options gl_next_conf = {
         {"target-colorspace-hint", OPT_CHOICE(target_hint, {"auto", -1}, {"no", 0}, {"yes", 1})},
         {"target-colorspace-hint-mode", OPT_CHOICE(target_hint_mode, {"target", 0}, {"source", 1}, {"source-dynamic", 2})},
         {"target-colorspace-hint-strict", OPT_BOOL(target_hint_strict)},
+        {"gpu-hdrdiag-swapchain-recreate-seq",
+            OPT_INT(hdrdiag_swapchain_recreate_seq), M_RANGE(0, INT_MAX)},
         // No `target-lut-type` because we don't support non-RGB targets
         {"libplacebo-opts", OPT_KEYVALUELIST(raw_opts)},
         {0},
@@ -1175,6 +1182,9 @@ static void apply_crop(struct pl_frame *frame, struct mp_rect crop,
 static bool set_colorspace_hint(struct priv *p, struct pl_color_space *hint)
 {
     struct ra_swapchain *sw = p->ra_ctx->swapchain;
+    p->hdrdiag_last_hint_valid = !!hint;
+    if (hint)
+        p->hdrdiag_last_hint = *hint;
 
     struct mp_image_params params = {
         .color = hint ? *hint : pl_color_space_srgb,
@@ -1686,6 +1696,8 @@ static void flip_page(struct vo *vo)
 {
     struct priv *p = vo->priv;
     struct ra_swapchain *sw = p->ra_ctx->swapchain;
+    bool presented_rearm_frame =
+        p->hdrdiag_swapchain_rearm_frames > 0 && p->frame_pending;
 
     if (p->frame_pending) {
         if (!pl_swapchain_submit_frame(p->sw))
@@ -1693,7 +1705,37 @@ static void flip_page(struct vo *vo)
         p->frame_pending = false;
     }
 
+    if (presented_rearm_frame) {
+        pl_swapchain_colorspace_hint_force(
+            p->sw, p->hdrdiag_last_hint_valid ? &p->hdrdiag_last_hint : NULL);
+    }
+
     sw->fns->swap_buffers(sw);
+
+    if (presented_rearm_frame) {
+        p->hdrdiag_swapchain_rearm_frames--;
+        if (p->hdrdiag_swapchain_rearm_frames > 0)
+            vo->want_redraw = true;
+    }
+
+    int recreate_sequence = p->next_opts->hdrdiag_swapchain_recreate_seq;
+    if (recreate_sequence != p->hdrdiag_swapchain_recreate_seq_applied) {
+        bool recreated = gpu_ctx_recreate_d3d11_swapchain(p->context);
+        p->hdrdiag_swapchain_recreate_seq_applied = recreate_sequence;
+        if (recreated) {
+            p->sw = p->context->swapchain;
+            pl_swapchain_colorspace_hint(
+                p->sw, p->hdrdiag_last_hint_valid
+                    ? &p->hdrdiag_last_hint : NULL);
+            p->hdrdiag_swapchain_rearm_frames = 3;
+            vo->want_redraw = true;
+            MP_INFO(p, "MPV-SK swapchain recovery complete sequence=%d\n",
+                    recreate_sequence);
+        } else {
+            MP_ERR(p, "MPV-SK swapchain recovery failed sequence=%d\n",
+                   recreate_sequence);
+        }
+    }
 }
 
 static void get_vsync(struct vo *vo, struct vo_vsync_info *info)
@@ -2413,6 +2455,8 @@ static int preinit(struct vo *vo)
     p->opts_cache = m_config_cache_alloc(p, vo->global, &gl_video_conf);
     p->next_opts_cache = m_config_cache_alloc(p, vo->global, &gl_next_conf);
     p->next_opts = p->next_opts_cache->opts;
+    p->hdrdiag_swapchain_recreate_seq_applied =
+        p->next_opts->hdrdiag_swapchain_recreate_seq;
     p->video_eq = mp_csp_equalizer_create(p, vo->global);
     p->global = vo->global;
     p->log = vo->log;
-- 
2.54.0.windows.1
