+// Scene analysis is meaningful only when an HDR source is being mapped. Keep
+// the sidecar completely out of SDR and HDR-passthrough render paths.
+static bool causal_scene_eligible(const struct pass_state *pass)
+{
+    const struct pl_render_params *params = pass->params;
+    return (params->causal_scene_detection || params->causal_scene_acceleration) &&
+           pl_color_space_is_hdr(&pass->image.color) &&
+           !pl_color_space_equal(&pass->image.color, &pass->target.color);
+}
+
+// Freeze the native-cie-y-v1 representation before PL_HOOK_RGB. Rendering to
+// this fixed target makes the sampler evaluate at 320x180 pixel centres; the
+// explicit bilinear sampler clamps edge fetches through the texture binding.
+static bool causal_make_proxy(struct pass_state *pass, pl_dispatch dp)
+{
+    enum { W = 320, H = 180 };
+    pl_renderer rr = pass->rr;
+    if (pass->img.color.primaries == PL_COLOR_PRIM_UNKNOWN)
+        return false;
+    pl_fmt fmt = pl_find_fmt(rr->gpu, PL_FMT_FLOAT, 1, 32, 0,
+                             PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE |
+                             PL_FMT_CAP_LINEAR);
+    // The frozen reference is linear RGB -> CIE Y -> bilinear scale -> PQ.
+    // Materialize Y first; interpolation in encoded RGB is not equivalent.
+    struct pl_tex_params yparams = {
+        .w = pass->img.w, .h = pass->img.h, .format = fmt, .sampleable = true,
+        .renderable = true, .debug_tag = "causal native-cie-y-v1 linear Y",
+    };
+    struct pl_tex_params tparams = {
+        .w = W, .h = H, .format = fmt, .sampleable = true,
+        .renderable = true, .blit_src = true,
+        .debug_tag = "causal native-cie-y-v1 proxy",
+    };
+    if (!fmt || !pl_tex_recreate(rr->gpu, &rr->causal_linear_tex, &yparams) ||
+        !pl_tex_recreate(rr->gpu, &rr->causal_proxy_tex, &tparams))
+        return false;
+    pl_tex linear_y = rr->causal_linear_tex, dst = rr->causal_proxy_tex;
+    if (!linear_y || !dst)
+        return false;
+
+    pl_shader sh = pass->img.sh;
+
+    struct pl_color_space csp = pass->img.color;
+    const pl_matrix3x3 rgb2xyz =
+        pl_get_rgb2xyz_matrix(pl_raw_primaries_get(csp.primaries));
+    float cy[3] = { rgb2xyz.m[1][0], rgb2xyz.m[1][1], rgb2xyz.m[1][2] };
+    // native-cie-y-v1 freezes these normative rows (rather than inheriting
+    // tiny chromaticity-matrix rounding differences) for the common HDR and
+    // SDR source primaries covered by the CPU reference.
+    switch (csp.primaries) {
+    case PL_COLOR_PRIM_BT_2020: cy[0]=0.2627f; cy[1]=0.6780f; cy[2]=0.0593f; break;
+    case PL_COLOR_PRIM_BT_709: cy[0]=0.2126f; cy[1]=0.7152f; cy[2]=0.0722f; break;
+    case PL_COLOR_PRIM_DCI_P3:
+    case PL_COLOR_PRIM_DISPLAY_P3: cy[0]=0.2289746f; cy[1]=0.6917385f; cy[2]=0.0792869f; break;
+    default: break;
+    }
+    pl_shader_linearize(sh, &csp);
+    sh_describe(sh, "causal scene CIE Y conversion");
+    // The raw primary matrix may be rounded very slightly away from a white
+    // row sum of one. Normalise that row so neutral RGB follows the frozen
+    // physical CIE-Y definition exactly at uniform PQ bin boundaries.
+    const float ysum = cy[0] + cy[1] + cy[2];
+    GLSL("// native-cie-y-v1 full-resolution linear CIE Y\n"
+         "float y = dot(vec3("$", "$", "$"), color.rgb) / "$";\n"
+         "color = vec4(max(y, 0.0), 0.0, 0.0, 1.0);\n",
+         SH_FLOAT(cy[0]), SH_FLOAT(cy[1]), SH_FLOAT(cy[2]), SH_FLOAT(ysum));
+    if (!pl_dispatch_finish(dp, pl_dispatch_params(.shader = &sh, .target = linear_y)))
+        return false;
+    sh = pl_dispatch_begin(dp);
+    // Preserve an already-native 320x180 source exactly. The CPU fixture
+    // defines this first proxy stage as identity before the independent
+    // 48x27 bilinear grid is formed.
+    const struct pl_sample_src proxy_src = *pl_sample_src(
+        .tex = linear_y, .new_w = W, .new_h = H);
+    sh_describe(sh, "causal scene 320x180 proxy");
+    bool sampled = pass->img.w == W && pass->img.h == H
+        ? pl_shader_sample_direct(sh, &proxy_src)
+        : pl_shader_sample_bilinear(sh, &proxy_src);
+    if (!sampled)
+        goto error;
+    GLSL("// native-cie-y-v1 scaled Y -> normalized ST 2084 PQ\n"
+         "float y = clamp(color.r * "$", 0.0, 1.0);\n"
+         "y = pow(y, "$");\n"
+         "y = ("$" + "$" * y) / (1.0 + "$" * y);\n"
+         "y = pow(y, "$");\n"
+         "color = vec4(y, 0.0, 0.0, 1.0);\n",
+         SH_FLOAT(PL_COLOR_SDR_WHITE / 10000.0),
+         SH_FLOAT(0.1593017578125), SH_FLOAT(0.8359375),
+         SH_FLOAT(18.8515625), SH_FLOAT(18.6875), SH_FLOAT(78.84375));
+    if (!pl_dispatch_finish(dp, pl_dispatch_params(.shader = &sh, .target = dst)))
+        return false;
+    pass->causal_proxy = dst;
+    return true;
+error:
+    pl_dispatch_abort(dp, &sh);
+    return false;
+}
+
+static void causal_update(struct pass_state *pass);
+
 static void hdr_update_peak(struct pass_state *pass)
 {
     const struct pl_render_params *params = pass->params;
@@ -1246,6 +1368,15 @@ static void hdr_update_peak(struct pass_state *pass)
                                : PL_TONE_MAP_METRIC_STANDARD;
     peak_params.scene_reset = pass->image.scene_cut;
