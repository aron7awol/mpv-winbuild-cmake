From 6fcfd38b42ac39a762ba146f87841909956ec93c Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:52:51 -0500
Subject: [PATCH] Expose a read-only native Analyzer tone curve

Retain the actual uploaded base/shaped LUT samples and analytic fast path,
with live frame metadata. Collect only for the Analyzer tone-curve view.
Keep playback mapping, histogram eligibility and measured RGB unchanged.

Include the near-black protection telemetry with its owning telemetry feature.

diff --git a/player/command.c b/player/command.c
index 245f98359aa98b1b2904c86b9de98c0dc82812c7..3505a102fce38e0822b5f216cbbb4eec2034af7d 100644
--- a/player/command.c
+++ b/player/command.c
@@ -2795,6 +2795,42 @@ static int mp_property_output_capture(void *ctx, struct m_property *prop,
     return m_property_read_sub(props, action, arg);
 }
 
+static int mp_property_tone_curve(void *ctx, struct m_property *prop, int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct vo *vo = mpctx->video_out;
+    if (!vo) return M_PROPERTY_UNAVAILABLE;
+    struct vo_tone_curve v;
+    mp_mutex_lock(&vo->async_probe_mutex);
+    v = vo->tone_curve_snapshot;
+    mp_mutex_unlock(&vo->async_probe_mutex);
+    if (!v.enabled) return M_PROPERTY_UNAVAILABLE;
+    // Bounded CSV keeps transport inexpensive and consistent with the other
+    // Analyzer frame properties. Invalid mapping paths never borrow old curves.
+    char input[4096] = "", base[4096] = "", output[4096] = "";
+    size_t ix = 0, bx = 0, ox = 0;
+    for (int i = 0; v.valid && i < MP_TONE_CURVE_SAMPLES; i++) {
+        ix += snprintf(input + ix, sizeof(input) - ix, "%s%.9g", i ? "," : "", v.input[i]);
+        bx += snprintf(base + bx, sizeof(base) - bx, "%s%.9g", i ? "," : "", v.base[i]);
+        ox += snprintf(output + ox, sizeof(output) - ox, "%s%.9g", i ? "," : "", v.output[i]);
+    }
+    const char *metric = v.metric == PL_TONE_MAP_METRIC_BT2020_RGB ||
+        v.metric == PL_TONE_MAP_METRIC_BT2020_ITP || v.metric == PL_TONE_MAP_METRIC_BT2020_ADAPTIVE
+        ? "P" : v.metric == PL_TONE_MAP_METRIC_STANDARD ? "Intensity" : "maxRGB";
+    struct m_sub_property props[] = {
+        {"valid", SUB_PROP_BOOL(v.valid)}, {"sequence", SUB_PROP_INT64(v.sequence)},
+        {"pts", SUB_PROP_DOUBLE(v.pts)}, {"identity", SUB_PROP_BOOL(v.identity)},
+        {"shaping-active", SUB_PROP_BOOL(v.shaped)}, {"metric", SUB_PROP_STR(metric)},
+        {"function", SUB_PROP_STR(v.function)},
+        {"input-peak", SUB_PROP_DOUBLE(v.source_peak)}, {"target-peak", SUB_PROP_DOUBLE(v.target_peak)},
+        {"strength", SUB_PROP_DOUBLE(v.strength)}, {"overbrightening", SUB_PROP_DOUBLE(v.overbrightening)},
+        {"near-black-protection", SUB_PROP_BOOL(v.near_black_protection)},
+        {"input", SUB_PROP_STR(input)}, {"base", SUB_PROP_STR(base)}, {"output", SUB_PROP_STR(output)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
 static int mp_property_async_probe(void *ctx, struct m_property *prop, int action, void *arg)
 {
     MPContext *mpctx = ctx;
@@ -5021,6 +5057,7 @@ static const struct m_property mp_properties_base[] = {
     {"video-active-image", mp_property_video_active_image},
     {"output-capture", mp_property_output_capture},
     {"analyzer-async-result", mp_property_async_probe},
+    {"analyzer-tone-curve-result", mp_property_tone_curve},
     {"analyzer-chromaticity", mp_property_analyzer_chromaticity},
     {"video-dec-params", mp_property_dec_imgparams},
     {"video-params", mp_property_vd_imgparams},
diff --git a/video/out/vo.h b/video/out/vo.h
index e68a63234b051adab740e7798ad56b31a7e67f24..f7a72a5f615c006f2e527e388573eb5f48627745 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -520,9 +520,23 @@ struct vo_driver {
     const struct m_sub_options *global_opts;
 };
 
+// Read-only Analyzer scalar curve, copied on the VO thread. The existing
+// async_probe_mutex guards this small independent snapshot as well.
+#define MP_TONE_CURVE_SAMPLES 256
+struct vo_tone_curve {
+    bool enabled, valid, identity, shaped, near_black_protection;
+    int metric;
+    int64_t sequence;
+    double pts;
+    char function[32];
+    float source_peak, target_peak, strength, overbrightening;
+    float input[MP_TONE_CURVE_SAMPLES], base[MP_TONE_CURVE_SAMPLES], output[MP_TONE_CURVE_SAMPLES];
+};
+
 struct vo {
     mp_mutex async_probe_mutex;
     struct voctrl_async_probe async_probe_snapshot;
+    struct vo_tone_curve tone_curve_snapshot;
     struct analyzer_property_cache *async_probe_property_cache; // core thread only
     const struct vo_driver *driver;
     struct mp_log *log; // Using e.g. "[vo/vdpau]" as prefix
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 60502797997c66b16f7ba2132916ed55021181f1..93489c794887e99b09cffa5f2763f5a7b622a7e2 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -260,6 +260,7 @@ static void update_lut(struct priv *p, struct user_lut *lut);
 
 struct gl_next_opts {
     int analyzer_async;
+    bool analyzer_tone_curve;
     int analyzer_stages;
     bool analyzer_cursor;
     float analyzer_background_opacity;
@@ -325,6 +326,7 @@ const struct m_sub_options gl_next_conf = {
         {"hdr-authored-scene-reset", OPT_BOOL(authored_scene_reset)},
         {"active-image-detection", OPT_BOOL(active_image_detection)},
         {"analyzer-async", OPT_INT(analyzer_async), M_RANGE(0, 3)},
+        {"analyzer-tone-curve", OPT_BOOL(analyzer_tone_curve)},
         {"analyzer-stages", OPT_INT(analyzer_stages), M_RANGE(1, 3)},
         {"analyzer-cursor", OPT_BOOL(analyzer_cursor)},
         {"analyzer-background-opacity", OPT_FLOAT(analyzer_background_opacity), M_RANGE(0, 1)},
@@ -3387,6 +3389,31 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     stats_time_start(p->stats, "render");
     bool render_ok = pl_render_image_mix(p->rr, &mix, &target, &params);
     stats_time_end(p->stats, "render");
+    struct vo_tone_curve curve = {
+        .enabled = p->next_opts->analyzer_tone_curve,
+        .pts = frame->current ? frame->current->pts : MP_NOPTS_VALUE,
+    };
+    struct pl_tone_curve native_curve;
+    if (curve.enabled && render_ok && pl_renderer_get_tone_curve(p->rr, &native_curve)) {
+        static_assert(MP_TONE_CURVE_SAMPLES == PL_TONE_CURVE_SAMPLES, "curve sample count");
+        curve.valid = true;
+        curve.identity = native_curve.identity;
+        curve.shaped = native_curve.hstm_active;
+        curve.metric = native_curve.metric;
+        snprintf(curve.function, sizeof(curve.function), "%s", native_curve.function);
+        curve.source_peak = native_curve.source_peak;
+        curve.target_peak = native_curve.target_peak;
+        curve.strength = native_curve.strength;
+        curve.overbrightening = native_curve.overbrightening;
+        curve.near_black_protection = native_curve.near_black_protection;
+        memcpy(curve.input, native_curve.input, sizeof(curve.input));
+        memcpy(curve.base, native_curve.base, sizeof(curve.base));
+        memcpy(curve.output, native_curve.output, sizeof(curve.output));
+    }
+    mp_mutex_lock(&vo->async_probe_mutex);
+    curve.sequence = vo->tone_curve_snapshot.sequence + 1;
+    vo->tone_curve_snapshot = curve;
+    mp_mutex_unlock(&vo->async_probe_mutex);
     if (!render_ok) {
         MP_ERR(vo, "Failed rendering frame!\n");
         goto done;
@@ -4964,6 +4991,7 @@ static void update_render_options(struct vo *vo)
         [GAMUT_IPT_PATH]        = &pl_gamut_map_ipt_path,
     };
 
+    pars->color_map_params.report_tone_curve = p->next_opts->analyzer_tone_curve;
     pars->color_map_params.tone_mapping_function = tone_map_funs[opts->tone_map.curve];
 AV_NOWARN_DEPRECATED(
     pars->color_map_params.tone_mapping_param = opts->tone_map.curve_param;
