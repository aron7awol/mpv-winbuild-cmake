 int mp_aframe_pool_allocate(struct mp_aframe_pool *pool, struct mp_aframe *frame,
                             int samples);
+
+// Copy LFE at unity gain to both channels of a stereo frame. If the source has
+// no named LFE channel, return timed silence. Does not modify the source.
+struct mp_aframe *mp_aframe_lfe_stereo(struct mp_aframe_pool *pool,
+                                     struct mp_aframe *src, bool *has_lfe);
diff --git a/audio/bass_redirect.c b/audio/bass_redirect.c
new file mode 100644
--- /dev/null
+++ b/audio/bass_redirect.c
@@ -0,0 +1,111 @@
+/* Secondary bass redirector. LGPL-2.1-or-later. */
+#include <math.h>
+#include <string.h>
+
+#include "audio/aframe.h"
+#include "audio/bass_redirect.h"
+#include "audio/format.h"
+#include "common/common.h"
+
+static double sample(const uint8_t *p, int format)
+{
+    switch (af_fmt_from_planar(format)) {
+    case AF_FORMAT_U8: return ((int)*p - 128) / 128.0;
+    case AF_FORMAT_S16: { int16_t v; memcpy(&v, p, sizeof(v)); return v / 32768.0; }
+    case AF_FORMAT_S32: { int32_t v; memcpy(&v, p, sizeof(v)); return v / 2147483648.0; }
+    case AF_FORMAT_S64: { int64_t v; memcpy(&v, p, sizeof(v)); return v / 9223372036854775808.0; }
+    case AF_FORMAT_FLOAT: { float v; memcpy(&v, p, sizeof(v)); return v; }
+    case AF_FORMAT_DOUBLE: { double v; memcpy(&v, p, sizeof(v)); return v; }
+    default: return NAN;
+    }
+}
+
+struct mp_aframe *mp_bass_redirect_frame(struct mp_bass_redirect *s,
+    struct mp_aframe_pool *pool, struct mp_aframe *src, double crossover,
+    bool lfe_left)
+{
+    int format = mp_aframe_get_format(src), rate = mp_aframe_get_rate(src);
+    if (!af_fmt_is_pcm(format) || !mp_aframe_config_is_valid(src) ||
+        !mp_aframe_is_allocated(src) || crossover < 20 || crossover > 250 ||
+        !isfinite(crossover) || crossover >= rate / 2.0)
+        return NULL;
+
+    struct mp_chmap channels;
+    mp_aframe_get_chmap(src, &channels);
+    if (s->rate != rate || s->crossover != crossover ||
+        !mp_chmap_equals(&s->channels, &channels)) {
+        *s = (struct mp_bass_redirect){.rate = rate, .crossover = crossover,
+                                      .channels = channels};
+        // Two identical Butterworth sections form a 24 dB/octave LR crossover.
+        double k = tan(M_PI * crossover / rate);
+        double norm = 1 / (1 + M_SQRT2 * k + k * k);
+        s->b0 = k * k * norm;
+        s->b1 = 2 * s->b0;
+        s->b2 = s->b0;
+        s->a1 = 2 * (k * k - 1) * norm;
+        s->a2 = (1 - M_SQRT2 * k + k * k) * norm;
+    }
+
+    struct mp_aframe *out = mp_aframe_create();
+    mp_aframe_config_copy(out, src);
+    struct mp_chmap stereo = MP_CHMAP2(FL, FR);
+    int samples = mp_aframe_get_size(src);
+    if (!mp_aframe_set_format(out, AF_FORMAT_FLOAT) ||
+        !mp_aframe_set_chmap(out, &stereo) ||
+        mp_aframe_pool_allocate(pool, out, samples) < 0)
+        goto error;
+    uint8_t **input = mp_aframe_get_data_ro(src);
+    uint8_t **output = mp_aframe_get_data_rw(out);
+    if (!input || !output)
+        goto error;
+    float *dst = (float *)output[0];
+    bool planar = af_fmt_is_planar(format);
+    size_t bytes = af_fmt_to_bytes(format);
+    int mains = 0, lfes = 0;
+    for (int c = 0; c < channels.num; c++) {
+        bool lfe = channels.speaker[c] == MP_SPEAKER_ID_LFE ||
+                   channels.speaker[c] == MP_SPEAKER_ID_LFE2;
+        if (lfe) lfes++; else mains++;
+    }
+    // Keep level constant for mono through 7.1. Larger layouts reserve more
+    // headroom for their larger coherent channel sum, never less.
+    double bound = mains + lfes * sqrt(10.0);
+    double reference = 7 + sqrt(10.0);
+    double gain = pow(10.0, -MP_BASS_HEADROOM_DB / 20.0) *
+                  MPMIN(1.0, reference / MPMAX(bound, 1.0));
+    for (int n = 0; n < samples; n++) {
+        double main = 0, lfe = 0, direct_lfe = 0;
+        for (int c = 0; c < channels.num; c++) {
+            const uint8_t *p = input[planar ? c : 0] +
+                (planar ? n : n * channels.num + c) * bytes;
+            double v = sample(p, format);
+            if (!isfinite(v))
+                goto error;
+            // Match LFE-only mode: the named LFE channel at decoded level.
+            // With no LFE, the split output's left channel remains silent.
+            if (channels.speaker[c] == MP_SPEAKER_ID_LFE)
+                direct_lfe = v;
+            if (channels.speaker[c] == MP_SPEAKER_ID_LFE ||
+                channels.speaker[c] == MP_SPEAKER_ID_LFE2)
+                lfe += v;
+            else
+                main += v;
+        }
+        for (int section = 0; section < 2; section++) {
+            double y = s->b0 * main + s->z1[section];
+            s->z1[section] = s->b1 * main - s->a1 * y + s->z2[section];
+            s->z2[section] = s->b2 * main - s->a2 * y;
+            main = y;
+        }
+        // LFE retains its authored bandwidth; only speaker bass uses the XO.
+        double mixed = (main + sqrt(10.0) * lfe) * gain;
+        if (!isfinite(mixed))
+            goto error;
+        dst[2*n] = lfe_left ? direct_lfe : mixed;
+        dst[2*n+1] = mixed;
+    }
+    return out;
+error:
+    talloc_free(out);
+    return NULL;
+}
diff --git a/audio/bass_redirect.h b/audio/bass_redirect.h
new file mode 100644
--- /dev/null
+++ b/audio/bass_redirect.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "audio/chmap.h"
+
+struct mp_aframe;
+struct mp_aframe_pool;
+
+// Round up the 20.14 dB coherent 7.1 sum (seven mains plus LFE at +10 dB).
+// Fixed gain only: this is not a limiter or a bound on subsequent DSP overshoot.
+#define MP_BASS_HEADROOM_DB 20.2
+
+struct mp_bass_redirect {
+    int rate;
+    double crossover;
+    struct mp_chmap channels;
+    double b0, b1, b2, a1, a2;
+    double z1[2], z2[2];
+};
+
+struct mp_aframe *mp_bass_redirect_frame(struct mp_bass_redirect *state,
+    struct mp_aframe_pool *pool, struct mp_aframe *src, double crossover,
+    bool lfe_left);
