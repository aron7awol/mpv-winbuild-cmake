From: mpv-ht development <mpv-ht@localhost>
Subject: [PATCH] wasapi: recover from failed start/reset with a per-file retry limit

Keep device-change reload events independent; bound control-error recovery to
three attempts per file, with the counter surviving AO recreation.

diff --git a/audio/out/ao.h b/audio/out/ao.h
index 843b1bc..7f37ef5 100644
--- a/audio/out/ao.h
+++ b/audio/out/ao.h
@@ -45,6 +45,7 @@ enum aocontrol {
 enum {
     AO_EVENT_RELOAD = 1,
     AO_EVENT_HOTPLUG = 2,
+    AO_EVENT_RELOAD_FAILURE = 4, // bounded recovery, distinct from device changes
 };
 
 enum {
@@ -107,6 +108,7 @@ struct mp_async_queue;
 struct mp_async_queue *ao_get_queue(struct ao *ao);
 int ao_query_and_reset_events(struct ao *ao, int events);
 void ao_request_reload(struct ao *ao);
+void ao_request_reload_failure(struct ao *ao);
 void ao_hotplug_event(struct ao *ao);
 
 struct ao_hotplug;
diff --git a/audio/out/ao.c b/audio/out/ao.c
index 4e5e9e3..5cb24bd 100644
--- a/audio/out/ao.c
+++ b/audio/out/ao.c
@@ -384,6 +384,11 @@ void ao_request_reload(struct ao *ao)
     ao_add_events(ao, AO_EVENT_RELOAD);
 }
 
+void ao_request_reload_failure(struct ao *ao)
+{
+    ao_add_events(ao, AO_EVENT_RELOAD_FAILURE);
+}
+
 // Notify the player that the device list changed. Fully thread-safe.
 void ao_hotplug_event(struct ao *ao)
 {
diff --git a/audio/out/ao_wasapi.c b/audio/out/ao_wasapi.c
index 337c24f..c96542d 100644
--- a/audio/out/ao_wasapi.c
+++ b/audio/out/ao_wasapi.c
@@ -180,6 +180,7 @@ static void thread_unpause(struct ao *ao)
     if (FAILED(hr)) {
         MP_ERR(state, "IAudioClient_Start returned %s\n",
                mp_HRESULT_to_str(hr));
+        ao_request_reload_failure(ao);
     }
 }
 
@@ -195,8 +196,11 @@ static void thread_reset(struct ao *ao)
     thread_pause(ao);
 
     hr = IAudioClient_Reset(state->pAudioClient);
-    if (FAILED(hr))
+    if (FAILED(hr)) {
         MP_ERR(state, "IAudioClient_Reset returned: %s\n", mp_HRESULT_to_str(hr));
+        if (atomic_load(&state->thread_state) != WASAPI_THREAD_SHUTDOWN)
+            ao_request_reload_failure(ao);
+    }
 
     atomic_store(&state->sample_count, 0);
 }
diff --git a/player/core.h b/player/core.h
index ec67844..b7992bb 100644
--- a/player/core.h
+++ b/player/core.h
@@ -342,6 +342,7 @@ typedef struct MPContext {
     struct mp_image *saved_frame;   // for hrseek_lastframe and hrseek_backstep
 
     enum playback_status video_status, audio_status;
+    int audio_failure_reloads; // survives AO recreation, reset for each new file
     bool restart_complete;
     int play_dir;
     // Factors to multiply with opts->playback_speed to get the total audio or
diff --git a/player/audio.c b/player/audio.c
index bb3a301..87cc427 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -875,8 +875,24 @@ void fill_audio_out_buffers(struct MPContext *mpctx)
 {
     struct MPOpts *opts = mpctx->opts;
 
-    if (mpctx->ao && ao_query_and_reset_events(mpctx->ao, AO_EVENT_RELOAD))
-        reload_audio_output(mpctx);
+    if (mpctx->ao) {
+        int events = ao_query_and_reset_events(mpctx->ao,
+            AO_EVENT_RELOAD | AO_EVENT_RELOAD_FAILURE);
+        bool recover = false;
+        if (events & AO_EVENT_RELOAD_FAILURE) {
+            if (mpctx->audio_failure_reloads < 3) {
+                mpctx->audio_failure_reloads++;
+                MP_WARN(mpctx, "Audio start/reset recovery attempt %d/3\n",
+                        mpctx->audio_failure_reloads);
+                recover = true;
+            } else if (mpctx->audio_failure_reloads == 3) {
+                mpctx->audio_failure_reloads++;
+                MP_ERR(mpctx, "Audio recovery limit reached; check the output device and reopen the file.\n");
+            }
+        }
+        if (recover || (events & AO_EVENT_RELOAD))
+            reload_audio_output(mpctx);
+    }
 
     update_throttle(mpctx);
 
diff --git a/player/loadfile.c b/player/loadfile.c
index 3ded4e7..f833a14 100644
--- a/player/loadfile.c
+++ b/player/loadfile.c
@@ -1789,6 +1789,7 @@ static void play_current_file(struct MPContext *mpctx)
     mp_filter_graph_set_max_run_time(mpctx->filter_root, 0.1);
 
     reset_playback_state(mpctx);
+    mpctx->audio_failure_reloads = 0;
 
 #ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
     if (mpctx->playlist->num_entries > 3)
