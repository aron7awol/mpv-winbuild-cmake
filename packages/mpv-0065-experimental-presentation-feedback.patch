+static int mp_property_video_sync_feedback(void *ctx, struct m_property *prop,
+                                           int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (!mpctx->video_out) return M_PROPERTY_UNAVAILABLE;
+    struct vo_timing_state s = vo_get_timing_state(mpctx->video_out);
+    struct vo_vsync_info f = s.feedback;
+    const char *source = f.feedback_source == HT_FEEDBACK_DXGI ? "dxgi" :
+        f.feedback_source == HT_FEEDBACK_VK_COMPLETION ? "vulkan-completion" : "submission-time";
+    const char *trust = f.feedback_valid ? "validated-prediction" : "submission-time-estimate";
+    struct ht_drift_guard *g = &mpctx->drift_guard;
+    struct m_sub_property props[] = {
+        {"source", SUB_PROP_STR(source)},
+        {"timing", SUB_PROP_STR(trust)},
+        {"epoch", SUB_PROP_INT64(s.epoch)},
+        {"backend-epoch", SUB_PROP_INT64(f.feedback_epoch)},
+        {"valid", SUB_PROP_BOOL(f.feedback_valid)},
+        {"guard-ready", SUB_PROP_BOOL(s.guard_ready)},
+        {"pending", SUB_PROP_INT(f.queued), .unavailable = f.queued < 0},
+        {"submitted", SUB_PROP_INT64(f.submitted)},
+        {"completed", SUB_PROP_INT64(f.completed)},
+        {"period-ms", SUB_PROP_DOUBLE(f.vsync_duration / 1e6), .unavailable = !f.feedback_valid},
+        {"queue-estimate-ms", SUB_PROP_DOUBLE(s.queue_seconds * 1000)},
+        {"samples", SUB_PROP_INT64(s.samples)},
+        {"fallbacks", SUB_PROP_INT64(s.fallbacks)},
+        {"small-corrections", SUB_PROP_INT64(g->small_corrections)},
+        {"recovery-corrections", SUB_PROP_INT64(g->recovery_corrections)},
+        {"signed-refreshes", SUB_PROP_INT64(g->signed_refreshes)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
