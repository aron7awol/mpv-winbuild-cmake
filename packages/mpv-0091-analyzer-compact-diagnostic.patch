         "for(int i=lane;i<128;i+=64)samples[8+i]=vec4(bins[4*i],bins[4*i+1],bins[4*i+2],bins[4*i+3]);",h,(double)w*h,w,h);
-    if (!output) finish=talloc_asprintf_append(finish,
+    if (density) finish=talloc_asprintf_append(finish,
         "for(int i=lane;i<1600;i+=64)samples[280+i]=vec4(bins[512+4*i],bins[513+4*i],bins[514+4*i],bins[515+4*i]);");
     sh=pl_dispatch_begin(hp->dispatch);
