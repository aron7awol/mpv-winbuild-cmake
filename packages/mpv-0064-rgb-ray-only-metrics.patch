-            {"maxrgb-adaptive", TONE_MAPPING_METRIC_MAXRGB_ADAPTIVE},
-            {"maxrgb-rgb", TONE_MAPPING_METRIC_MAXRGB_RGB})},
+            {"maxrgb-rgb", TONE_MAPPING_METRIC_MAXRGB_RGB},
+            // Read-only compatibility names: all selections resolve to RGB ray.
+            {"bt2020-itp", TONE_MAPPING_METRIC_BT2020_RGB},
+            {"bt2020-adaptive", TONE_MAPPING_METRIC_BT2020_RGB},
+            {"maxrgb-itp", TONE_MAPPING_METRIC_MAXRGB_RGB},
+            {"maxrgb-adaptive", TONE_MAPPING_METRIC_MAXRGB_RGB})},
         {"tone-mapping-hstm-strength", OPT_FLOAT(tone_map.hstm_strength), M_RANGE(0, 100)},
         {"tone-mapping-hstm-overbrightening", OPT_FLOAT(tone_map.hstm_overbrightening), M_RANGE(0, 100)},
         {"tone-mapping-hstm-near-black-protection", OPT_BOOL(tone_map.hstm_near_black_protection)},
         {"tone-mapping-auto-pq-second-pass", OPT_BOOL(tone_map.auto_pq_second_pass)},
         {"tone-mapping-p-constrained-curve", OPT_BOOL(tone_map.p_constrained_curve)},
-        {"tone-mapping-adaptive-chroma-strength",
-            OPT_FLOAT(tone_map.adaptive_chroma_strength), M_RANGE(0.0, 100.0)},
         {"tone-mapping-ambient-gamma",
             OPT_FLOAT(tone_map.ambient_gamma), M_RANGE(0.5, 1.5)},
         {"inverse-tone-mapping", OPT_BOOL(tone_map.inverse)},
