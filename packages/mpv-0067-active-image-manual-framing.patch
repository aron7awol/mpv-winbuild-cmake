                                       int height, uint32_t black,
                                       int *boundary, int *support)
@@ -1438,7 +1489,15 @@ static void store_bar_result(struct priv *p, uint64_t tag, int width, int height
                 boundary_found = legacy_found;
             }
             result.boundary_exact = legacy_found;
-            if (result.breakout && have_previous)
+            bool asymmetric = boundary_found &&
+                bar_asymmetric_mattes(p, data, height, centered, black);
+            if (asymmetric) {
+                // This is positive evidence against a centered crop, not an
+                // indeterminate black frame: clear even a previous aperture.
+                centered = 0;
+                result.breakout = false;
+            }
+            if (!asymmetric && result.breakout && have_previous)
             {
                 centered = previous.top;
             }
@@ -1447,7 +1506,8 @@ static void store_bar_result(struct priv *p, uint64_t tag, int width, int height
             // that matte on both sides across the width. Breakout effects leave
             // a substantial portion of the old matte line intact, even when
             // their total envelope reaches the encoded frame edges.
-            if (boundary_found && have_previous && centered < previous.top)
+            if (!asymmetric && boundary_found && have_previous &&
+                centered < previous.top)
             {
                 int prior_top = previous.top;
                 if (result.breakout)
@@ -1814,22 +1874,72 @@ static double active_display_ratio(const struct mp_image_params *params,
     return ratio;
 }
 
-static struct mp_rect rotated_active_source_rect(struct priv *p, uint64_t tag,
+static struct mp_rect user_source_rect(const struct mp_image_params *params)
+{
+    return mp_image_crop_valid(params) ? params->crop
+        : (struct mp_rect) {0, 0, params->w, params->h};
+}
+
+static struct mp_rect cropped_active_source_rect(struct priv *p, uint64_t tag,
                                                   const struct mp_image_params *params)
+{
+    struct mp_rect src = active_source_rect(p, tag, params->w, params->h);
+    struct mp_rect user = user_source_rect(params);
+    // Compose in unrotated source coordinates, before pan/zoom clipping. An
+    // explicit crop selecting only a matte must not restore excluded picture.
+    if (!mp_rect_intersection(&src, &user))
+        src = user;
+    return src;
+}
+
+static struct mp_rect rotate_source_rect(struct mp_rect src,
+                                         const struct mp_image_params *params)
 {
     int width = params->w, height = params->h;
-    struct mp_rect src = active_source_rect(p, tag, width, height);
     if (params->rotate % 180 == 90)
         MPSWAP(int, width, height);
     mp_rect_rotate(&src, width, height, params->rotate);
     return src;
 }
 
+static struct mp_rect rotated_active_source_rect(struct priv *p, uint64_t tag,
+                                                  const struct mp_image_params *params)
+{
+    return rotate_source_rect(cropped_active_source_rect(p, tag, params), params);
+}
+
+static int active_coord(double value)
+{
+    // Leave room for rectangle differences, even with extreme manual pan/zoom.
+    return lrint(MPCLAMP(value, -INT_MAX / 4.0, INT_MAX / 4.0));
+}
+
+static void active_canvas_margin(int *start, int *end, const float margin[2])
+{
+    int size = *end - *start;
+    int a = MPCLAMP((int) (size * margin[0]), 0, size);
+    int b = MPCLAMP((int) (size * margin[1]), 0, size);
+    if (a + b >= size) {
+        a = 0;
+        b = MPMAX(0, size - 1);
+    }
+    *start += a;
+    *end -= b;
+}
+
 static struct mp_rect fit_active_destination(struct mp_rect canvas,
-                                             double source_ar,
-                                             float align_x, float align_y,
-                                             float panscan, float zoom)
+                                             const struct mp_image_params *params,
+                                             const struct mp_vo_opts *opts,
+                                             double monitor_par)
 {
+    // Stretch deliberately ignores aspect, pan and zoom, just as aspect.c does.
+    if (!opts->keepaspect)
+        return canvas;
+    active_canvas_margin(&canvas.x0, &canvas.x1, opts->margin_x);
+    active_canvas_margin(&canvas.y0, &canvas.y1, opts->margin_y);
+    struct mp_rect aperture = user_source_rect(params);
+    double source_ar = active_display_ratio(params, mp_rect_w(aperture),
+                                             mp_rect_h(aperture)) * monitor_par;
     int cw = mp_rect_w(canvas), ch = mp_rect_h(canvas);
     if (cw < 1 || ch < 1 || !isfinite(source_ar) || source_ar <= 0)
         return canvas;
@@ -1839,14 +1949,36 @@ static struct mp_rect fit_active_destination(struct mp_rect canvas,
     // uniform scale, including Fullscreen UI's fixed Video scale adjustment.
     double fit_h = MPMIN(ch, cw / source_ar);
     double fill_h = MPMAX(ch, cw / source_ar);
-    double scaled_h = (fit_h + (fill_h - fit_h) * panscan) * exp2(zoom);
+    double panscan = opts->unscaled ? 0 : opts->panscan;
+    double scaled_h = fit_h + (fill_h - fit_h) * panscan;
+    double scaled_w = scaled_h * source_ar;
+    if (opts->unscaled) {
+        int dw, dh;
+        mp_image_params_get_dsize(params, &dw, &dh);
+        if (params->rotate % 180 == 90)
+            MPSWAP(int, dw, dh);
+        if (opts->unscaled != 2 || (dw <= cw && dh <= ch)) {
+            scaled_w = dw * monitor_par;
+            scaled_h = dh;
+        }
+    }
+    scaled_w *= exp2(opts->zoom) * opts->scale_x;
+    scaled_h *= exp2(opts->zoom) * opts->scale_y;
     // Keep integer rectangles representable even at video-zoom's +/-20 limits.
-    scaled_h = MPMIN(scaled_h, (INT_MAX / 4.0) / MPMAX(1.0, source_ar));
-    int w = MPMAX(1, lrint(scaled_h * source_ar));
-    int h = MPMAX(1, lrint(scaled_h));
-    int x = canvas.x0 + lrint((cw - w) * (MPCLAMP(align_x, -1, 1) + 1) / 2);
-    int y = canvas.y0 + lrint((ch - h) * (MPCLAMP(align_y, -1, 1) + 1) / 2);
-    return (struct mp_rect) {x, y, x + w, y + h};
+    double limit = MPMAX(1.0, MPMAX(scaled_w, scaled_h) / (INT_MAX / 8.0));
+    int w = MPMAX(1, lrint(scaled_w / limit));
+    int h = MPMAX(1, lrint(scaled_h / limit));
+    float ax = opts->recenter && cw >= w ? 0 : opts->align_x;
+    float ay = opts->recenter && ch >= h ? 0 : opts->align_y;
+    double x = canvas.x0 + (cw - w) * (MPCLAMP(ax, -1, 1) + 1) / 2.0 +
+               (double) opts->pan_x * w;
+    double y = canvas.y0 + (ch - h) * (MPCLAMP(ay, -1, 1) + 1) / 2.0 +
+               (double) opts->pan_y * h;
+    // Round the origin once, then preserve the integer extent. Rounding both
+    // half-pixel endpoints separately can collapse a one-pixel zoom to zero.
+    int ix = active_coord(x), iy = active_coord(y);
+    return (struct mp_rect) {ix, iy, active_coord((double) ix + w),
+                             active_coord((double) iy + h)};
 }
 
