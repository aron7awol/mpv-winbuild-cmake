     }
-
     pass->need_peak_fbo = !params->peak_detect_params->allow_delayed;
     return;
 
@@ -1275,6 +1405,137 @@ bool pl_renderer_get_peak_detect_metrics(
     return pl_get_peak_detect_metrics(rr->tone_map_state, metrics);
 }
 
+static void causal_update(struct pass_state *pass)
+{
+    const struct pl_render_params *params = pass->params;
+    pl_renderer rr = pass->rr;
+    if (!causal_scene_eligible(pass)) {
+        rr->causal_unavailable_valid = false;
+        rr->causal_last_dispatched_valid = false;
+        pl_reset_causal_scene(rr->causal_state);
+        return;
+    }
+
+    // Mixing may enter pass_scale_main more than once for the same decoded
+    // source tag. A descriptor transaction is source-frame scoped, never an
+    // interpolation-pass scoped operation.
+    if (rr->causal_last_dispatched_valid &&
+        rr->causal_last_dispatched_tag == pass->image.causal_scene_tag)
+        return;
+    if (!pass->image.causal_scene_tag) {
+        rr->causal_unavailable = (struct pl_causal_scene_diagnostics) {
+            .effective_allow_delayed = params->peak_detect_params
+                ? params->peak_detect_params->allow_delayed : true,
+            .authored_boundary_tag = pass->image.scene_cut_tag,
+            .authored_boundary_source = pass->image.scene_cut_source,
+            .active_metric_branch = params->color_map_params
+                ? params->color_map_params->tone_mapping_metric
+                : PL_TONE_MAP_METRIC_STANDARD,
+            .withheld_reason = PL_CAUSAL_SCENE_WITHHELD_NO_TAG,
+        };
+        rr->causal_unavailable_valid = true;
+        pl_reset_causal_scene(rr->causal_state);
+        rr->causal_last_dispatched_tag = pass->image.causal_scene_tag;
+        rr->causal_last_dispatched_valid = true;
+        return;
+    }
+
+    // The frozen Stage-1 source domain is display-oriented. Plane flips are
+    // handled by source assembly, but source rotation is normally applied
+    // later in the live output pipeline; fail closed until that transpose is
+    // represented in the isolated source target.
+    if (pass->image.field != PL_FIELD_NONE || pass->image.rotation ||
+        !pass->causal_proxy) {
+        rr->causal_unavailable = (struct pl_causal_scene_diagnostics) {
+            .effective_allow_delayed = params->peak_detect_params
+                ? params->peak_detect_params->allow_delayed : true,
+            .submitted_tag = pass->image.causal_scene_tag,
+            .authored_boundary_tag = pass->image.scene_cut_tag,
+            .authored_boundary_source = pass->image.scene_cut_source,
+            .active_metric_branch = params->color_map_params
+                ? params->color_map_params->tone_mapping_metric
+                : PL_TONE_MAP_METRIC_STANDARD,
+            .withheld_reason = PL_CAUSAL_SCENE_WITHHELD_UNSUPPORTED,
+        };
+        rr->causal_unavailable_valid = true;
+        pl_reset_causal_scene(rr->causal_state);
+        rr->causal_last_dispatched_tag = pass->image.causal_scene_tag;
+        rr->causal_last_dispatched_valid = true;
+        return;
+    }
+
+    // This is representation identity, not PTS. It deliberately covers every
+    // source fact that changes the native-cie-y-v1 descriptor domain.
+    uint64_t sig = 1469598103934665603ULL;
+#define CAUSAL_SIG(v) (sig = (sig ^ (uint64_t) (v)) * 1099511628211ULL)
+#define CAUSAL_SIG_FLOAT(v) do { uint32_t bits; float f = (v); \
+    memcpy(&bits, &f, sizeof(bits)); CAUSAL_SIG(bits); } while (0)
+    CAUSAL_SIG_FLOAT(pass->image.crop.x0); CAUSAL_SIG_FLOAT(pass->image.crop.y0);
+    CAUSAL_SIG_FLOAT(pass->image.crop.x1); CAUSAL_SIG_FLOAT(pass->image.crop.y1);
+    CAUSAL_SIG(pass->image.color.primaries);
+    CAUSAL_SIG(pass->image.color.transfer);
+    CAUSAL_SIG(pass->image.repr.sys);
+    CAUSAL_SIG(pass->image.repr.levels);
+    CAUSAL_SIG(pass->rotation);
+    CAUSAL_SIG(pass->image.num_planes);
+    CAUSAL_SIG(pass->image.repr.bits.sample_depth);
+    CAUSAL_SIG(pass->image.repr.bits.color_depth);
+    for (int i = 0; i < pass->image.num_planes; i++) {
+        const struct pl_plane *plane = &pass->image.planes[i];
+        CAUSAL_SIG(plane->texture->params.w); CAUSAL_SIG(plane->texture->params.h);
+        CAUSAL_SIG(plane->texture->params.format->num_components);
+        CAUSAL_SIG(plane->flipped); CAUSAL_SIG(plane->components);
+        CAUSAL_SIG_FLOAT(plane->shift_x); CAUSAL_SIG_FLOAT(plane->shift_y);
+    }
+#undef CAUSAL_SIG_FLOAT
+#undef CAUSAL_SIG
+
+    struct pl_peak_detect_params causal = {
+        .allow_delayed = params->peak_detect_params
+            ? params->peak_detect_params->allow_delayed : true,
+        .metric = params->color_map_params
+            ? params->color_map_params->tone_mapping_metric
+            : PL_TONE_MAP_METRIC_STANDARD,
+        .scene_reset = pass->image.scene_cut,
+        .scene_reset_tag = pass->image.scene_cut_tag,
+        .scene_reset_source = pass->image.scene_cut_source,
+        .causal_scene_enabled = true,
+        .causal_scene_acceleration = params->causal_scene_acceleration,
+        .causal_scene_tag = pass->image.causal_scene_tag,
+        .causal_scene_signature = sig,
+    };
+    if (!pl_shader_detect_causal_scene(rr->dp, rr->gpu, pass->causal_proxy,
+                                        &rr->causal_state, rr->tone_map_state,
+                                        &causal))
+    {
+        PL_WARN(rr, "Causal-scene diagnostics unsupported for this frame");
+        rr->causal_unavailable = (struct pl_causal_scene_diagnostics) {
+            .effective_allow_delayed = causal.allow_delayed,
+            .submitted_tag = causal.causal_scene_tag,
+            .authored_boundary_tag = causal.scene_reset_tag,
+            .authored_boundary_source = causal.scene_reset_source,
+            .active_metric_branch = causal.metric,
+            .withheld_reason = PL_CAUSAL_SCENE_WITHHELD_UNSUPPORTED,
+        };
+        rr->causal_unavailable_valid = true;
+        pl_reset_causal_scene(rr->causal_state);
+    } else {
+        rr->causal_unavailable_valid = false;
+        rr->causal_last_dispatched_tag = pass->image.causal_scene_tag;
+        rr->causal_last_dispatched_valid = true;
+    }
+}
+
+bool pl_renderer_get_causal_scene_diagnostics(
+    pl_renderer rr, struct pl_causal_scene_diagnostics *diagnostics)
+{
+    if (rr->causal_unavailable_valid) {
+        *diagnostics = rr->causal_unavailable;
+        return true;
+    }
+    return pl_get_causal_scene_diagnostics(rr->causal_state, diagnostics);
+}
+
 struct plane_state {
     enum plane_type type;
     struct pl_plane plane;
@@ -1515,10 +1776,14 @@ static pl_fmt merge_fmt(struct pass_state *pass, const struct img *a,
 // Applies a series of rough heuristics to figure out whether we expect any
 // performance gains from plane merging. This is basically a series of checks
 // for operations that we *know* benefit from merged planes
-static bool want_merge(struct pass_state *pass,
+static bool want_merge(struct pass_state *pass, bool source_processing,
                        const struct plane_state *st,
                        const struct plane_state *ref)
 {
+    // Keep the diagnostics source graph independent of live processing and
+    // sampler/cache selection. It is a direct decoded-plane reconstruction.
+    if (!source_processing)
+        return false;
     const struct pl_render_params *params = pass->params;
