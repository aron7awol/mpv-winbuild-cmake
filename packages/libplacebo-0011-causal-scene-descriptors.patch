+        .renderable=true, .host_readable=true));
+    pl_tex dt_peak = pl_tex_create(gpu, pl_tex_params(.w=W*2, .h=H*2, .format=fmt,
+        .renderable=true, .host_readable=true));
+    if (!st || !dt || !dt_causal || !dt_peak) goto done;
+    // Separate renderers avoid normal peak-detection history from one render
+    // becoming a false difference in the opt-in causal comparison.
+    pl_renderer rr_ref = pl_renderer_create(gpu->log, gpu);
+    pl_renderer rr = pl_renderer_create(gpu->log, gpu);
+    REQUIRE(rr_ref && rr);
+    struct pl_frame image = { .num_planes=1, .planes={{.texture=st,
+        .components=3, .component_mapping={0,1,2}}},
+        .repr={.sys=PL_COLOR_SYSTEM_RGB,.levels=PL_COLOR_LEVELS_FULL},
+        .color={.primaries=PL_COLOR_PRIM_BT_2020,.transfer=PL_COLOR_TRC_LINEAR},
+        .causal_scene_tag=1 };
+    image.color.hdr.max_luma = 10000.0f;
+    struct pl_frame target = { .num_planes=1, .planes={{.texture=dt,
+        .components=4, .component_mapping={0,1,2,3}}},
+        .repr={.sys=PL_COLOR_SYSTEM_RGB,.levels=PL_COLOR_LEVELS_FULL},
+        .color=image.color };
+    REQUIRE(pl_render_image(rr_ref, &image, &target, NULL));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt,.ptr=ref)));
+    struct pl_render_params p = pl_render_default_params;
+    // Guard the harness: NULL and a value copy of the default parameters must
+    // match before any opt-in diagnostic work is enabled.
+    REQUIRE(pl_render_image(rr, &image, &target, &p));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt,.ptr=out)));
+    REQUIRE_MEMEQ(ref, out, sizeof(ref));
+    p.causal_scene_detection = true;
+    // Equal HDR source/target spaces are passthrough. The saved request may be
+    // on, but the sidecar must remain completely inactive.
+    image.causal_scene_tag = 0;
+    target.planes[0].texture = dt_causal;
+    REQUIRE(pl_render_image(rr, &image, &target, &p));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt_causal,.ptr=out)));
+    REQUIRE_MEMEQ(ref, out, sizeof(ref));
+    image.causal_scene_tag = 1;
+    REQUIRE(pl_render_image(rr, &image, &target, &p));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt_causal,.ptr=out)));
+    REQUIRE_MEMEQ(ref, out, sizeof(ref));
+
+    float *proxy = malloc(PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H * sizeof(*proxy));
+    struct pl_causal_test_descriptors causal_desc = {0};
+    REQUIRE(proxy);
+    REQUIRE(!pl_renderer_get_causal_test_data(rr, proxy,
+            PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H, &causal_desc));
+
+    // An explicit HDR-to-SDR target activates tone mapping. A normal tagged
+    // transaction, including reducer/readback setup, remains observational.
+    struct pl_frame mapped_target = target;
+    mapped_target.color.transfer = PL_COLOR_TRC_SRGB;
+    mapped_target.color.hdr.max_luma = 80.0f;
+    mapped_target.planes[0].texture = dt;
+    REQUIRE(pl_render_image(rr_ref, &image, &mapped_target, NULL));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt,.ptr=ref)));
+    mapped_target.planes[0].texture = dt_causal;
+    REQUIRE(pl_render_image(rr, &image, &mapped_target, &p));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt_causal,.ptr=out)));
+    REQUIRE_MEMEQ(ref, out, sizeof(ref));
+
+    // The private test seam downloads the exact fixed proxy and completed
+    // reducer descriptors. This is intentionally not part of libplacebo's API.
+    REQUIRE(pl_renderer_get_causal_test_data(rr, proxy,
+            PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H, &causal_desc));
+    float hist_sum = 0.0f;
+    for (int i = 0; i < PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H; i++)
+        REQUIRE(isfinite(proxy[i]) && proxy[i] >= 0.0f && proxy[i] <= 1.0f);
+    for (int i = 0; i < PL_CAUSAL_TEST_HIST_BINS; i++)
+        hist_sum += causal_desc.histogram[i];
+    REQUIRE(fabsf(hist_sum - 1.0f) < 2e-5f);
+    free(proxy);
+
+    // A real HDR peak transaction shares its SSBO/readback with causal
+    // descriptors. Compare independent clean renderers first: enabling the
+    // diagnostic must not alter pixels even while peak detection is active.
+    pl_renderer rr_peak_ref = pl_renderer_create(gpu->log, gpu);
+    pl_renderer rr_peak = pl_renderer_create(gpu->log, gpu);
+    REQUIRE(rr_peak_ref && rr_peak);
+    struct pl_peak_detect_params peak = pl_peak_detect_default_params;
+    peak.force = true;
+    peak.allow_delayed = false;
+    struct pl_render_params hp = pl_render_default_params;
+    hp.peak_detect_params = &peak;
+    struct pl_frame hdr_image = image;
+    hdr_image.color.transfer = PL_COLOR_TRC_PQ;
+    hdr_image.color.hdr.max_luma = 10000.0f;
+    hdr_image.causal_scene_tag = 10;
+    struct pl_frame sdr_target = target;
+    sdr_target.color.transfer = PL_COLOR_TRC_SRGB;
+    sdr_target.color.hdr.max_luma = 80.0f;
+    sdr_target.planes[0].texture = dt_peak;
+    REQUIRE(pl_render_image(rr_peak_ref, &hdr_image, &sdr_target, &hp));
+    float peak_ref[W * H * 4 * 4], peak_out[W * H * 4 * 4];
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt_peak,.ptr=peak_ref)));
+    hp.causal_scene_detection = true;
+    sdr_target.planes[0].texture = dt_peak;
+    REQUIRE(pl_render_image(rr_peak, &hdr_image, &sdr_target, &hp));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt_peak,.ptr=peak_out)));
+    REQUIRE_MEMEQ(peak_ref, peak_out, sizeof(peak_ref));
+    struct pl_peak_detect_metrics peak_metrics;
+    REQUIRE(pl_renderer_get_peak_detect_metrics(rr_peak, &peak_metrics));
+    proxy = malloc(PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H * sizeof(*proxy));
+    REQUIRE(proxy && pl_renderer_get_causal_test_data(rr_peak, proxy,
+            PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H, &causal_desc));
+    REQUIRE(causal_desc.borrowed_peak_transaction && causal_desc.readback_count == 1);
+    // Cost is one shared descriptor-extended transaction: no second buffer
+    // or synchronization is allocated in the peak-active path.
+    REQUIRE(causal_desc.transaction_bytes >= sizeof(struct pl_causal_test_descriptors));
+    free(proxy);
+    struct pl_causal_scene_diagnostics shared_diag;
+    REQUIRE(pl_renderer_get_causal_scene_diagnostics(rr_peak, &shared_diag));
+    REQUIRE(shared_diag.consumed_tag == 10 && shared_diag.readback_latency_frames >= 0);
+    pl_renderer_destroy(&rr_peak_ref);
+    pl_renderer_destroy(&rr_peak);
+
+    // Delayed mode has backend-dependent completion latency. Poll the live
+    // owner first (never the sink) across a bounded tagged sequence, then
+    // verify that its single consume reached the borrowed causal sink.
+    pl_renderer rr_delayed = pl_renderer_create(gpu->log, gpu);
+    REQUIRE(rr_delayed);
+    peak.allow_delayed = true;
+    bool delivered = false;
+    for (uint64_t tag = 20; tag < 40 && !delivered; tag++) {
+        hdr_image.causal_scene_tag = tag;
+        REQUIRE(pl_render_image(rr_delayed, &hdr_image, &sdr_target, &hp));
+        struct pl_peak_detect_metrics delayed_peak;
+        pl_renderer_get_peak_detect_metrics(rr_delayed, &delayed_peak);
+        proxy = malloc(PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H * sizeof(*proxy));
+        REQUIRE(proxy);
+        delivered = pl_renderer_get_causal_test_data(rr_delayed, proxy,
+            PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H, &causal_desc);
+        free(proxy);
+    }
+    REQUIRE(delivered && causal_desc.borrowed_peak_transaction &&
+            causal_desc.readback_count == 1);
+    REQUIRE(pl_renderer_get_causal_scene_diagnostics(rr_delayed, &shared_diag));
+    REQUIRE(shared_diag.submitted_tag >= shared_diag.consumed_tag &&
+            shared_diag.readback_latency_frames >= 0 && !shared_diag.acceleration_applied);
+    pl_renderer_destroy(&rr_delayed);
+
+
+
+    // Interlaced input is explicitly unsupported by Stage 1. Validate the
+    // fail-closed diagnostic state rather than byte equality.
+    image.field = PL_FIELD_TOP;
+    image.first_field = PL_FIELD_TOP;
+    image.causal_scene_tag++;
+    REQUIRE(pl_render_image(rr, &image, &mapped_target, &p));
+    struct pl_causal_scene_diagnostics d;
+    REQUIRE(pl_renderer_get_causal_scene_diagnostics(rr, &d));
+    REQUIRE(d.withheld_reason == PL_CAUSAL_SCENE_WITHHELD_UNSUPPORTED);
+    pl_renderer_destroy(&rr_ref);
+    pl_renderer_destroy(&rr);
+done:
+    pl_tex_destroy(gpu, &st); pl_tex_destroy(gpu, &dt); pl_tex_destroy(gpu, &dt_causal); pl_tex_destroy(gpu, &dt_peak);
+}
+
+// Frozen native_cie_y_v1 GPU fixture subset. Inputs are libplacebo internal
+// linear units (1.0 == PL_COLOR_SDR_WHITE nits), not physical 0..10000 nits.
+static void pl_causal_native_cie_y_fixture_test(pl_gpu gpu)
+{
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 0,
+                             PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    if (!fmt || !gpu->limits.compute_queues || !gpu->limits.max_ssbo_size)
+        return;
+    const float scale = 10000.0f / PL_COLOR_SDR_WHITE;
+    float src[2 * 2 * 4] = {
+        0, 0, 0, 1,       scale, 0, 0, 1,
+        0, scale, 0, 1,   0, 0, scale, 1,
+    };
+    float out[2 * 2 * 4], proxy[PL_CAUSAL_TEST_PROXY_W * PL_CAUSAL_TEST_PROXY_H];
+    pl_tex st = pl_tex_create(gpu, pl_tex_params(.w=2, .h=2, .format=fmt,
+        .sampleable=true, .initial_data=src));
+    pl_tex dt = pl_tex_create(gpu, pl_tex_params(.w=2, .h=2, .format=fmt,
+        .renderable=true, .host_readable=true));
+    if (!st || !dt) goto done;
+    pl_renderer rr = pl_renderer_create(gpu->log, gpu);
+    REQUIRE(rr);
+    struct pl_frame image = { .num_planes=1, .planes={{.texture=st,
+        .components=3, .component_mapping={0,1,2}}},
+        .repr={.sys=PL_COLOR_SYSTEM_RGB,.levels=PL_COLOR_LEVELS_FULL},
+        .color={.primaries=PL_COLOR_PRIM_BT_2020,.transfer=PL_COLOR_TRC_LINEAR},
+        .causal_scene_tag=1 };
+    image.color.hdr.max_luma = 10000.0f;
+    struct pl_frame target = { .num_planes=1, .planes={{.texture=dt,
+        .components=4,.component_mapping={0,1,2,3}}}, .repr=image.repr,
+        .color=image.color };
+    target.color.transfer = PL_COLOR_TRC_SRGB;
+    target.color.hdr.max_luma = 80.0f;
+    struct pl_render_params p = pl_render_default_params;
+    // Descriptor-only fixtures deliberately exercise the causal-owned
+    // transaction while static tone mapping is active.
+    p.peak_detect_params = NULL;
+    p.causal_scene_detection = true;
+    REQUIRE(pl_render_image(rr, &image, &target, &p));
+    REQUIRE(pl_tex_download(gpu, pl_tex_transfer_params(.tex=dt,.ptr=out)));
+    struct pl_causal_test_descriptors d;
+    REQUIRE(pl_renderer_get_causal_test_data(rr, proxy, PL_ARRAY_SIZE(proxy), &d));
+    // Frozen fixture: BT.2020 R/G/B normalized ST2084 values.
+    REQUIRE(fabsf(proxy[0] - 7.309559e-7f) < 2e-5f);
+    REQUIRE(fabsf(proxy[PL_CAUSAL_TEST_PROXY_W - 1] - 0.85708486f) < 2e-5f);
+    REQUIRE(fabsf(proxy[(PL_CAUSAL_TEST_PROXY_H - 1) * PL_CAUSAL_TEST_PROXY_W] - 0.95902807f) < 2e-5f);
+    REQUIRE(fabsf(proxy[PL_CAUSAL_TEST_PROXY_H * PL_CAUSAL_TEST_PROXY_W - 1] - 0.69502327f) < 2e-5f);
+    // The fixed reducer must expose exactly one normalized histogram.
+    float sum = 0.0f;
+    for (int i = 0; i < PL_CAUSAL_TEST_HIST_BINS; i++) sum += d.histogram[i];
+    REQUIRE(fabsf(sum - 1.0f) < 2e-5f);
+    pl_renderer_destroy(&rr);
+done:
+    pl_tex_destroy(gpu, &st); pl_tex_destroy(gpu, &dt);
+}
+
+static float causal_pq_to_internal(float pq)
+{
+    const float x = powf(PL_CLAMP(pq, 0.0f, 1.0f), 1.0f / 78.84375f);
+    const float n = powf(PL_MAX(x - 0.8359375f, 0.0f) /
+                         (18.8515625f - 18.6875f * x), 1.0f / 0.1593017578125f);
+    return n * 10000.0f / PL_COLOR_SDR_WHITE;
+}
+
+// Render a full native-v1 proxy directly.  Each fixture is intentionally a
+// fresh renderer: tags begin at one and there is no hidden prior history.
+static bool causal_fixture_render(pl_gpu gpu, const float *gray,
+                                  uint64_t tag, pl_renderer *out_rr,
+                                  struct pl_causal_test_descriptors *out)
+{
+    enum { W = PL_CAUSAL_TEST_PROXY_W, H = PL_CAUSAL_TEST_PROXY_H };
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 0,
+                             PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    if (!fmt) return false;
+    float *src = malloc(W * H * 4 * sizeof(*src));
+    float *proxy = malloc(W * H * sizeof(*proxy));
+    if (!src || !proxy) { free(src); free(proxy); return false; }
+    for (int i = 0; i < W * H; i++)
+        src[4*i+0] = src[4*i+1] = src[4*i+2] = gray[i], src[4*i+3] = 1.0f;
+    pl_tex st = pl_tex_create(gpu, pl_tex_params(.w=W,.h=H,.format=fmt,
+        .sampleable=true,.initial_data=src));
+    pl_tex dt = pl_tex_create(gpu, pl_tex_params(.w=W,.h=H,.format=fmt,
+        .renderable=true));
+    pl_renderer rr = pl_renderer_create(gpu->log, gpu);
+    struct pl_frame image = { .num_planes=1, .planes={{.texture=st,
+        .components=3,.component_mapping={0,1,2}}},
+        .repr={.sys=PL_COLOR_SYSTEM_RGB,.levels=PL_COLOR_LEVELS_FULL},
+        .color={.primaries=PL_COLOR_PRIM_BT_2020,.transfer=PL_COLOR_TRC_LINEAR},
+        .causal_scene_tag=tag };
+    image.color.hdr.max_luma = 10000.0f;
+    struct pl_frame target = { .num_planes=1, .planes={{.texture=dt,
+        .components=4,.component_mapping={0,1,2,3}}}, .repr=image.repr,.color=image.color };
+    target.color.transfer = PL_COLOR_TRC_SRGB;
+    target.color.hdr.max_luma = 80.0f;
+    struct pl_render_params p = pl_render_default_params;
+    // Descriptor-only fixtures deliberately exercise the causal-owned
+    // transaction while static tone mapping is active.
+    p.peak_detect_params = NULL;
+    p.causal_scene_detection = true;
+    bool ok = st && dt && rr && pl_render_image(rr, &image, &target, &p) &&
+        pl_renderer_get_causal_test_data(rr, proxy, W * H, out);
+    free(src); free(proxy);
+    if (ok && out_rr) {
+        *out_rr = rr;
+    } else {
+        pl_renderer_destroy(&rr);
+    }
+    pl_tex_destroy(gpu,&st); pl_tex_destroy(gpu,&dt);
+    return ok;
+}
+
+// Sequential native-v1 state gate: black -> white triggers once and, when the
+// experimental acceleration is enabled, snaps both the standard and private
+// Perceptual detector histories to the current frame. The next black boundary
+// is observed but suppressed by the documented two-tag cooldown.
+static void pl_causal_temporal_fixture_test(pl_gpu gpu)
+{
+    enum { W = PL_CAUSAL_TEST_PROXY_W, H = PL_CAUSAL_TEST_PROXY_H };
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 0,
+                             PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    if (!fmt || !gpu->limits.compute_queues || !gpu->limits.max_ssbo_size)
+        return;
+    float *src = calloc((size_t) W * H * 4, sizeof(*src));
+    if (!src) return;
+    pl_tex st = pl_tex_create(gpu, pl_tex_params(.w=W,.h=H,.format=fmt,
+        .sampleable=true,.host_writable=true));
+    pl_tex dt = pl_tex_create(gpu, pl_tex_params(.w=W,.h=H,.format=fmt,
+        .renderable=true));
+    pl_renderer rr = pl_renderer_create(gpu->log, gpu);
+    if (!st || !dt || !rr) goto done;
+    struct pl_frame image = { .num_planes=1, .planes={{.texture=st,
+        .components=3,.component_mapping={0,1,2}}},
+        .repr={.sys=PL_COLOR_SYSTEM_RGB,.levels=PL_COLOR_LEVELS_FULL},
+        .color={.primaries=PL_COLOR_PRIM_BT_2020,.transfer=PL_COLOR_TRC_LINEAR},
+    };
+    image.color.hdr.max_luma = 10000.0f;
+    struct pl_frame target = { .num_planes=1, .planes={{.texture=dt,
+        .components=4,.component_mapping={0,1,2,3}}},.repr=image.repr,.color=image.color};
+    target.color.transfer = PL_COLOR_TRC_SRGB;
+    target.color.hdr.max_luma = 80.0f;
+    struct pl_peak_detect_params peak = pl_peak_detect_default_params;
+    peak.force = true;
+    peak.allow_delayed = false;
+    peak.metric = PL_TONE_MAP_METRIC_BT2020_ITP;
+    struct pl_render_params p = pl_render_default_params;
+    p.peak_detect_params = &peak;
+    p.causal_scene_detection = true;
+    p.causal_scene_acceleration = true;
+    for (uint64_t tag=1; tag<=7; tag++) {
+        const float v = tag == 2 ? 10000.0f / PL_COLOR_SDR_WHITE : 0.0f;
+        for (int i=0;i<W*H;i++) src[4*i]=src[4*i+1]=src[4*i+2]=v,src[4*i+3]=1.0f;
+        // A 20%-wide white stripe is deliberately below the immediate
+        // score/residual gate. Its unchanged following frame confirms the
+        // original candidate with one frame of latency.
+        if (tag == 6 || tag == 7) {
+            for (int y=0; y<H; y++) for (int x=0; x<64; x++)
+                src[4*(y*W+x)]=src[4*(y*W+x)+1]=src[4*(y*W+x)+2]=
+                    10000.0f / PL_COLOR_SDR_WHITE;
+        }
+        REQUIRE(pl_tex_upload(gpu, pl_tex_transfer_params(.tex=st,.ptr=src)));
+        image.causal_scene_tag=tag;
+        REQUIRE(pl_render_image(rr,&image,&target,&p));
+        struct pl_causal_scene_diagnostics d;
+        REQUIRE(pl_renderer_get_causal_scene_diagnostics(rr,&d));
+        REQUIRE(d.consumed_tag == tag && d.readback_latency_frames == 0);
+        if (tag == 2) {
+            REQUIRE(d.visual_trigger && d.cut_score > .99f && d.global_motion_residual > .99f);
+            REQUIRE(d.acceleration_applied && d.acceleration_count == 1);
+            struct pl_peak_detect_metrics m;
+            REQUIRE(pl_renderer_get_peak_detect_metrics(rr, &m));
+            REQUIRE(fabsf(m.raw_max_pq_y - m.smoothed_max_pq_y) < 2e-5f);
+            REQUIRE(fabsf(m.raw_avg_pq_y - m.smoothed_avg_pq_y) < 2e-5f);
+            REQUIRE(fabsf(m.raw_max_metric - m.smoothed_max_metric) < 2e-5f);
+            REQUIRE(fabsf(m.raw_avg_metric - m.smoothed_avg_metric) < 2e-5f);
+        }
+        if (tag == 3) {
+            REQUIRE(!d.visual_trigger && !d.acceleration_applied);
+            REQUIRE(d.last_trigger_tag == 2 && d.visual_trigger_count == 1 &&
+                    d.acceleration_count == 1);
+        }
+        if (tag == 6) {
+            REQUIRE(!d.visual_trigger && !d.acceleration_applied);
+            REQUIRE(d.acceleration_count == 1);
+            REQUIRE(d.cut_score >= .10f && d.cut_score < .16f);
+        }
+        if (tag == 7) {
+            REQUIRE(d.visual_trigger && d.acceleration_applied);
+            REQUIRE(d.last_trigger_tag == 6 && d.visual_trigger_count == 2 &&
+                    d.acceleration_count == 2);
+        }
+    }
+done:
+    pl_renderer_destroy(&rr); pl_tex_destroy(gpu,&st); pl_tex_destroy(gpu,&dt); free(src);
+}
+
+// A one-tile horizontal descriptor translation must be explained by the
+// +/-1 search, while the independently sampled grid retains zero residual.
+static void pl_causal_translation_fixture_test(pl_gpu gpu)
+{
+    enum { W=PL_CAUSAL_TEST_PROXY_W, H=PL_CAUSAL_TEST_PROXY_H };
+    float *a=calloc((size_t)W*H,sizeof(*a)), *b=calloc((size_t)W*H,sizeof(*b));
+    if (!a || !b) { free(a); free(b); return; }
+    for (int y=0;y<H;y++) for(int x=0;x<W;x++) {
+        a[y*W+x]=causal_pq_to_internal((float)(x/20)/16.0f);
+        b[y*W+x]=causal_pq_to_internal((float)PL_MIN((x/20)+1,15)/16.0f);
+    }
+    struct pl_causal_test_descriptors da,db;
+    REQUIRE(causal_fixture_render(gpu,a,1,NULL,&da));
+    REQUIRE(causal_fixture_render(gpu,b,2,NULL,&db));
+    float best=INFINITY;
+    for(int dy=-1;dy<=1;dy++) for(int dx=-1;dx<=1;dx++) {
+        float sum=0; int n=0;
+        for(int y=0;y<9;y++) for(int x=0;x<16;x++) {
+            int px=x+dx, py=y+dy;
+            if(px>=0&&px<16&&py>=0&&py<9) {
+                sum += fabsf(db.tiles[y*16+x]-da.tiles[py*16+px]); n++;
+            }
+        }
+        best=PL_MIN(best,sum/n);
+    }
+    REQUIRE(best < 2e-5f);
+    free(a); free(b);
+}
+
+static void pl_causal_descriptor_fixture_test(pl_gpu gpu)
+{
+    enum { W=PL_CAUSAL_TEST_PROXY_W, H=PL_CAUSAL_TEST_PROXY_H };
+    float *gray = malloc(W * H * sizeof(*gray));
+    if (!gray) return;
+    struct pl_causal_test_descriptors d;
+    // 100-nit neutral produces PQ 0.5080784; equal RGB must stay neutral.
+    for (int i=0;i<W*H;i++) gray[i]=100.0f/PL_COLOR_SDR_WHITE;
+    REQUIRE(causal_fixture_render(gpu,gray,1,NULL,&d));
+    REQUIRE(d.readback_count == 1 && !d.borrowed_peak_transaction);
+    REQUIRE(d.transaction_bytes > 0);
+    for (int i=0;i<PL_CAUSAL_TEST_HIST_BINS;i++)
+        REQUIRE(fabsf(d.histogram[i] - (i == 32 ? 1.0f : 0.0f)) < 2e-5f);
+    // Five equal-width PQ stripes exercise uniform bin edges including code 1.
+    const float codes[5]={0.0f,1.0f/64.0f,0.5f,63.0f/64.0f,1.0f};
+    for(int y=0;y<H;y++)for(int x=0;x<W;x++) gray[y*W+x]=causal_pq_to_internal(codes[x/64]);
