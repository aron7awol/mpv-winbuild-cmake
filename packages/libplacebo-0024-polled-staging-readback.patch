+            buf_p->read_pending = buf_p->read_ready = buf_p->read_failed = false;
             uavs[i] = buf_p->texel_uav;
             break;
         default:
diff --git a/src/gpu.c b/src/gpu.c
index 130979f2..fb57cc89 100644
--- a/src/gpu.c
+++ b/src/gpu.c
@@ -588,6 +588,7 @@ pl_buf pl_buf_create(pl_gpu gpu, const struct pl_buf_params *params)
         }
