 static float measure_peak(const unsigned max_pq[SLICES],
                           const unsigned hist[SLICES][HIST_BINS],
                           float percentile)
@@ -1508,12 +1569,13 @@ static void update_peak_buf(pl_gpu gpu, struct sh_color_map_obj *obj, bool force
         return;
