+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Diagnostic-only resize provenance and conservative, platform-free policy.
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+enum w32_resize_reason {
+    W32_R_SETTING = 1 << 0, W32_R_SIZE = 1 << 1, W32_R_LAYOUT = 1 << 2,
+    W32_R_DISPLAY = 1 << 3, W32_R_DPI = 1 << 4, W32_R_MOVE = 1 << 5,
+    W32_R_FULLSCREEN = 1 << 6, W32_R_CONFIG = 1 << 7,
+    W32_R_OPTIONS = 1 << 8, W32_R_OTHER = 1 << 9,
+};
+
+struct w32_resize_info {
+    unsigned reasons, messages;
+    uint64_t first_serial, last_serial;
+    unsigned setting_action;
+    char setting_area[64]; // bounded printable ASCII; no quote/backslash
+};
+
+enum resize_guard_decision {
+    RG_SKIP, RG_DISABLED, RG_FORCED, RG_UNKNOWN_OR_REQUIRED,
+    RG_QUERY_FAILED, RG_CHANGED, RG_RECOVERY,
+};
+
+static inline enum resize_guard_decision resize_guard_decide(
+    bool enabled, bool forced, unsigned reasons, bool query_ok,
+    bool state_equal, bool healthy)
+{
+    if (!enabled) return RG_DISABLED;
+    if (forced) return RG_FORCED;
+    const unsigned benign = W32_R_SETTING | W32_R_SIZE | W32_R_LAYOUT;
+    if (!(reasons & (W32_R_SETTING | W32_R_SIZE)) || (reasons & ~benign))
+        return RG_UNKNOWN_OR_REQUIRED;
+    if (!query_ok) return RG_QUERY_FAILED;
+    if (!healthy) return RG_RECOVERY;
+    if (!state_equal) return RG_CHANGED;
+    return RG_SKIP;
+}
+
+static inline const char *resize_guard_name(enum resize_guard_decision d)
+{
+    switch (d) {
+    case RG_SKIP: return "skip-redundant";
+    case RG_DISABLED: return "disabled";
+    case RG_FORCED: return "forced";
+    case RG_UNKNOWN_OR_REQUIRED: return "unknown-or-required-origin";
+    case RG_QUERY_FAILED: return "query-failed";
+    case RG_CHANGED: return "state-changed-or-unprimed";
+    case RG_RECOVERY: return "recovery";
+    }
+    return "invalid";
+}
