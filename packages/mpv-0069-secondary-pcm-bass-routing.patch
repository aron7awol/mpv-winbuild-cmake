From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <noreply@openai.com>
Date: Wed, 7 Oct 2026 19:30:00 -0400
Subject: [PATCH] audio: secondary stereo LFE and bass management

Keep full PCM as the default. Route LFE to both stereo channels, or
sum all main-channel bass with LFE using a common crossover and
20.2 dB fixed headroom. Preserve primary bitstream and PCM clock control.

---
diff --git a/audio/aframe.c b/audio/aframe.c
--- a/audio/aframe.c
+++ b/audio/aframe.c
@@ -550,6 +550,60 @@
     return true;
 }
 
+struct mp_aframe *mp_aframe_lfe_stereo(struct mp_aframe_pool *pool,
+                                     struct mp_aframe *src, bool *has_lfe)
+{
+    int format = mp_aframe_get_format(src);
+    if (!af_fmt_is_pcm(format) || !mp_aframe_config_is_valid(src) ||
+        !mp_aframe_is_allocated(src))
+        return NULL;
+
+    struct mp_chmap input;
+    mp_aframe_get_chmap(src, &input);
+    int lfe = -1;
+    for (int c = 0; c < input.num; c++) {
+        if (input.speaker[c] == MP_SPEAKER_ID_LFE) {
+            lfe = c;
+            break;
+        }
+    }
+
+    struct mp_aframe *dst = mp_aframe_create();
+    mp_aframe_config_copy(dst, src);
+    struct mp_chmap stereo = MP_CHMAP2(FL, FR);
+    int samples = mp_aframe_get_size(src);
+    if (!mp_aframe_set_chmap(dst, &stereo) ||
+        mp_aframe_pool_allocate(pool, dst, samples) < 0)
+        goto error;
+
+    if (lfe < 0) {
+        // This also handles unsigned PCM's nonzero representation of silence.
+        if (!mp_aframe_set_silence(dst, 0, samples))
+            goto error;
+    } else {
+        uint8_t **s = mp_aframe_get_data_ro(src);
+        uint8_t **d = mp_aframe_get_data_rw(dst);
+        if (!s || !d)
+            goto error;
+        size_t bytes = af_fmt_to_bytes(format);
+        if (af_fmt_is_planar(format)) {
+            memcpy(d[0], s[lfe], samples * bytes);
+            memcpy(d[1], s[lfe], samples * bytes);
+        } else {
+            for (int n = 0; n < samples; n++) {
+                const uint8_t *sample = s[0] + (n * input.num + lfe) * bytes;
+                memcpy(d[0] + (n * 2) * bytes, sample, bytes);
+                memcpy(d[0] + (n * 2 + 1) * bytes, sample, bytes);
+            }
+        }
+    }
+    *has_lfe = lfe >= 0;
+    return dst;
+error:
+    talloc_free(dst);
+    return NULL;
+}
+
 bool mp_aframe_set_silence(struct mp_aframe *f, int offset, int samples)
 {
     if (mp_aframe_get_size(f) < offset + samples)
diff --git a/audio/aframe.h b/audio/aframe.h
--- a/audio/aframe.h
+++ b/audio/aframe.h
@@ -73,3 +73,8 @@
