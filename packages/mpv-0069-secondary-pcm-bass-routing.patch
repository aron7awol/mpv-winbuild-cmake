+    int lfe_present; // -1 before the first decoded frame, 0 absent, 1 present.
     const char *error;
+};
+
+struct lfe_route {
+    struct secondary_audio *owner;
+    struct mp_aframe_pool *pool;
+    struct mp_bass_redirect bass;
+};
+
+static void route_lfe(struct mp_filter *f)
+{
+    struct lfe_route *p = f->priv;
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type == MP_FRAME_AUDIO) {
+        bool has_lfe = false;
+        struct mp_aframe *routed = p->owner->bass ?
+            mp_bass_redirect_frame(&p->bass, p->pool, frame.data,
+                                   p->owner->crossover, p->owner->lfe_left) :
+            mp_aframe_lfe_stereo(p->pool, frame.data, &has_lfe);
+        mp_frame_unref(&frame);
+        if (!routed) {
+            mp_filter_internal_mark_failed(f);
+            return;
+        }
+        int present = has_lfe;
+        if (!p->owner->bass && present != p->owner->lfe_present) {
+            p->owner->lfe_present = present;
+            MP_VERBOSE(f, "%s\n", has_lfe ? "LFE copied to both stereo channels" :
+                       "No LFE channel: sending stereo silence");
+        }
+        frame = MAKE_FRAME(MP_FRAME_AUDIO, routed);
+    } else if (!mp_frame_is_signaling(frame)) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
+static void reset_route(struct mp_filter *f)
+{
+    struct lfe_route *p = f->priv;
+    p->bass = (struct mp_bass_redirect){0};
+}
+
+static const struct mp_filter_info lfe_info = {
+    .name = "secondary-lfe", .priv_size = sizeof(struct lfe_route),
+    .process = route_lfe, .reset = reset_route,
 };
 
