diff --git a/video/out/vo.h b/video/out/vo.h
index 9befceb94..ee52907ee 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -172,6 +172,9 @@ struct voctrl_async_probe {
     int x, y, mode;
     double ready_ms;
     int64_t stats_ns;
+    int64_t readback_ns, readback_count, readback_max_ns;
+    int64_t poll_ns, poll_count, poll_busy, frame_results;
+    int compact_telemetry; // local comparison mode
     float values[138592]; // Telemetry, 80x80 xy counts, then 160x160 winning RGB nits/P.
 };
 
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
