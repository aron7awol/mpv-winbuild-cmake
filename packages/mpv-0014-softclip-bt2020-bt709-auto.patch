From 1b4b5848d2a1b28b2da44da0371a528b5b50cd77 Mon Sep 17 00:00:00 2001
From: mpv-ht development <mpv-ht@localhost>
Date: Sat, 7 Nov 2026 16:49:48 -0500
Subject: [PATCH] gpu-next: use Softclip for automatic BT.2020 to BT.709


diff --git a/DOCS/man/options.rst b/DOCS/man/options.rst
index ee5c922c10e03d920ffd4b36ea0715487350ebc5..a17e45a9c5c32d6280792b8c3c8f9854a8b4f55d 100644
--- a/DOCS/man/options.rst
+++ b/DOCS/man/options.rst
@@ -7795,13 +7795,18 @@ them.
     target display, after any tone mapping is done.
 
     auto
-        Choose the best mode automatically. (Default)
+        Choose the best mode automatically. Uses ``softclip`` when mapping a
+        BT.2020 source signal to BT.709, and the normal default otherwise.
+        (Default)
     clip
         Hard-clip to the gamut (per-channel). Very low quality, but free.
     perceptual
         Performs a perceptually balanced gamut mapping using a soft knee
         function to roll-off clipped regions, and a hue shifting function to
         preserve saturation. (``--vo=gpu-next`` only)
+    softclip
+        Performs RGB-domain soft clipping against the destination gamut.
+        (``--vo=gpu-next`` only)
     relative
         Performs relative colorimetric clipping, while maintaining an
         exponential relationship between brightness and chromaticity.
diff --git a/video/out/gpu/video.c b/video/out/gpu/video.c
index 642639cfb84f39af95b45292dd206334861e1146..8ed9a6bdad0b0211c7f6242562d7a8785245a6eb 100644
--- a/video/out/gpu/video.c
+++ b/video/out/gpu/video.c
@@ -487,6 +487,7 @@ const struct m_sub_options gl_video_conf = {
             {"auto",        GAMUT_AUTO},
             {"clip",        GAMUT_CLIP},
             {"perceptual",  GAMUT_PERCEPTUAL},
+            {"softclip",    GAMUT_SOFTCLIP},
             {"relative",    GAMUT_RELATIVE},
             {"saturation",  GAMUT_SATURATION},
             {"absolute",    GAMUT_ABSOLUTE},
diff --git a/video/out/gpu/video.h b/video/out/gpu/video.h
index 8ba031b352c2aae28e25d1f0c89b4aebc52b2b48..2f2fc805c0eabe363b6487238383a8b048c799f2 100644
--- a/video/out/gpu/video.h
+++ b/video/out/gpu/video.h
@@ -115,6 +115,7 @@ enum gamut_mode {
     GAMUT_AUTO,
     GAMUT_CLIP,
     GAMUT_PERCEPTUAL,
+    GAMUT_SOFTCLIP,
     GAMUT_RELATIVE,
     GAMUT_SATURATION,
     GAMUT_ABSOLUTE,
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 603940eb98ba84574f6664e1254128787404b5ee..5e817aaf22c163ffd7ae809f82bed7018ab48a26 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1380,6 +1380,23 @@ static void update_tm_viz(struct pl_color_map_params *params,
 static void update_hook_opts_dynamic(struct priv *p, const struct pl_hook *hook,
                                      const struct mp_image *mpi);
 
+static bool use_auto_softclip(const struct gl_video_opts *opts,
+                              struct pl_color_space source_color,
+                              struct pl_color_space target_color)
+{
+    if (opts->tone_map.gamut_mode != GAMUT_AUTO)
+        return false;
+    pl_color_space_infer(&source_color);
+    pl_color_space_infer(&target_color);
+    const struct pl_raw_primaries bt709 =
+        *pl_raw_primaries_get(PL_COLOR_PRIM_BT_709);
+    const bool target_bt709 =
+        opts->target_prim == PL_COLOR_PRIM_BT_709 ||
+        target_color.primaries == PL_COLOR_PRIM_BT_709 ||
+        pl_raw_primaries_equal(&target_color.hdr.prim, &bt709);
+    return source_color.primaries == PL_COLOR_PRIM_BT_2020 && target_bt709;
+}
+
 static bool draw_frame(struct vo *vo, struct vo_frame *frame)
 {
     struct priv *p = vo->priv;
@@ -1725,6 +1742,16 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     apply_crop(&target, p->dst, swframe.fbo->params.w, swframe.fbo->params.h);
     update_tm_viz(&pars->color_map_params, &target);
 
+    // Prefer libplacebo Softclip for real BT.2020-to-BT.709 conversion while
+    // leaving explicit choices and every other automatic pairing unchanged.
+    struct pl_color_map_params automatic_color_map;
+    if (frame->current && use_auto_softclip(opts,
+            frame->current->params.color, target.color)) {
+        automatic_color_map = *params.color_map_params;
+        automatic_color_map.gamut_mapping = &pl_gamut_map_softclip;
+        params.color_map_params = &automatic_color_map;
+    }
+
     struct pl_frame_mix mix = {0};
     if (frame->current) {
         // Update queue state
@@ -2172,6 +2199,13 @@ static void video_screenshot(struct vo *vo, struct voctrl_screenshot *args)
     apply_crop(&target, dst, fbo->params.w, fbo->params.h);
     update_tm_viz(&pars->color_map_params, &target);
 
+    struct pl_color_map_params automatic_color_map;
+    if (use_auto_softclip(opts, image.color, target.color)) {
+        automatic_color_map = *params.color_map_params;
+        automatic_color_map.gamut_mapping = &pl_gamut_map_softclip;
+        params.color_map_params = &automatic_color_map;
+    }
+
     int osd_flags = 0;
     if (!args->subs)
         osd_flags |= OSD_DRAW_OSD_ONLY;
@@ -3091,6 +3125,7 @@ static void update_render_options(struct vo *vo)
         [GAMUT_AUTO]            = pl_color_map_default_params.gamut_mapping,
         [GAMUT_CLIP]            = &pl_gamut_map_clip,
         [GAMUT_PERCEPTUAL]      = &pl_gamut_map_perceptual,
+        [GAMUT_SOFTCLIP]        = &pl_gamut_map_softclip,
         [GAMUT_RELATIVE]        = &pl_gamut_map_relative,
         [GAMUT_SATURATION]      = &pl_gamut_map_saturation,
         [GAMUT_ABSOLUTE]        = &pl_gamut_map_absolute,
