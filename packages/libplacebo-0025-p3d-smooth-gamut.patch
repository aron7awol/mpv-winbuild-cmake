From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mpv-ht <mpv-ht@local>
Date: Sat, 12 Sep 2026 20:00:00 -0400
Subject: [PATCH] gamut: replace hard-boundary P3D with a smooth mapping

Opt-in P3D only. Existing automatic and Softclip behavior is unchanged.
See analysis/ipt-path-gamut/SMOOTH-P3D.md in the packaging repository.

---
diff --git a/src/gamut_mapping.c b/src/gamut_mapping.c
index 9efbcc6a..33a471e6 100644
--- a/src/gamut_mapping.c
+++ b/src/gamut_mapping.c
@@ -744,33 +744,64 @@ static void perceptual(float *lut, const struct pl_gamut_map_params *params)
     }
 }
 
+static void softclip_map(float *lut, const struct pl_gamut_map_params *params);
+
+// The public sampling API follows the same policy as the renderer. Rendering
+// interpolates the *Softclip color LUT*, then recovers P per pixel afterwards;
+// interpolating a P-restored LUT is not equivalent and is not used.
 static void ipt_path(float *lut, const struct pl_gamut_map_params *params)
 {
     struct cache cache;
     struct gamut working;
-    struct pl_gamut_map_params work = *params;
+    struct pl_gamut_map_params work = *params, color = *params;
     const struct pl_raw_primaries *bt2020 = pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
     work.output_gamut = *bt2020;
     get_gamuts(&working, NULL, &cache, &work);
-    pl_matrix3x3 m = pl_get_color_mapping_matrix(bt2020, &params->output_gamut,
-                                                PL_INTENT_RELATIVE_COLORIMETRIC);
-    hp_mat target;
-    for (int i=0;i<3;i++) for (int j=0;j<3;j++) target.m[i][j]=m.m[i][j];
-    hp_ctx ctx=hp_context(target, pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, params->max_luma)/10000.0);
+    const pl_matrix3x3 target = pl_get_color_mapping_matrix(bt2020,
+        &params->output_gamut, PL_INTENT_RELATIVE_COLORIMETRIC);
+    const pl_matrix3x3 inverse = pl_get_color_mapping_matrix(&params->output_gamut,
+        bt2020, PL_INTENT_RELATIVE_COLORIMETRIC);
+    const float peak = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, params->max_luma)/10000.0f;
+    const size_t count = (size_t) params->lut_size_I * params->lut_size_C * params->lut_size_h;
+    float *brightness = pl_alloc(NULL, count * sizeof(*brightness));
+    size_t i = 0;
+    FOREACH_LUT(lut, ipt) {
+        const struct RGB rgb = ipt2rgb(ipt, working);
+        brightness[i++] = hp_p((hp_vec){{rgb.R, rgb.G, rgb.B}});
+    }
+
+    color.function = &pl_gamut_map_softclip;
+    if (!pl_gamut_map_params_noop(&color))
+        softclip_map(lut, &color);
+
+    i = 0;
     FOREACH_LUT(lut, ipt) {
-        struct RGB raw=ipt2rgb(ipt, working);
-        // Keep the original IPT direction at off-source-gamut LUT nodes.
-        // Clipping those nodes first biases interpolation near saturated
-        // source boundaries. hp_p defines the nonnegative metric extension.
-        hp_vec rgb={{raw.R,raw.G,raw.B}};
-        hp_vec mapped=hp_map(ctx,rgb);
-        ipt=rgb2ipt((struct RGB){mapped.v[0],mapped.v[1],mapped.v[2]},working);
+        struct RGB rgb = ipt2rgb(ipt, working);
+        float d[3] = {rgb.R, rgb.G, rgb.B};
+        pl_matrix3x3_apply(&target, d);
+        for (int j = 0; j < 3; j++)
+            d[j] = fmaxf(d[j], 0.0f);
+        const float maximum = fmaxf(d[0], fmaxf(d[1], d[2]));
+        pl_matrix3x3_apply(&inverse, d);
+        const double actual = hp_p((hp_vec){{d[0], d[1], d[2]}});
+        float gain = brightness[i++] / fmax(actual, 1e-30);
+        const float limit = peak / fmaxf(maximum, 1e-30f);
+        if (gain > 1.0f) {
+            // Match the shader: retain at least half of Softclip's remaining
+            // headroom rather than restoring P right up to a hard ceiling.
+            const float boost = gain - 1.0f;
+            const float room = 0.5f * fmaxf(limit - 1.0f, 0.0f);
+            gain = 1.0f + room * (boost / (room + boost));
+        }
+        gain = fminf(gain, limit);
+        ipt = rgb2ipt((struct RGB){d[0]*gain, d[1]*gain, d[2]*gain}, working);
     }
+    pl_free(brightness);
 }
 
 const struct pl_gamut_map_function pl_gamut_map_ipt_path = {
     .name = "ipt-path",
-    .description = "Original-IPT path, Perceptual P (experimental)",
+    .description = "P3D smooth gamut, Perceptual P (experimental)",
     .map = ipt_path,
 };
 
diff --git a/src/gamut_mapping_pipt.h b/src/gamut_mapping_pipt.h
index 764b3ee1..564c5364 100644
--- a/src/gamut_mapping_pipt.h
+++ b/src/gamut_mapping_pipt.h
@@ -1,67 +1,11 @@
-/* Experimental original-IPT (1998) hue path with homogeneous Perceptual P.
+/* Perceptual P shared by P3D's CPU reference and GPU code generation.
  * Copyright (c) 2026 mpv-ht contributors
  * SPDX-License-Identifier: LGPL-2.1-or-later
- *
- * Reuses the HKTest IPT-derived saturation path, not libplacebo's IPTPQc4.
- * Chroma is reduced only to remove negative target RGB. Remaining upper-
- * channel overflow is handled by one RGB scale, deliberately sacrificing P
- * rather than forcing extra desaturation. No perceptual-distance claim.
  */
 #ifndef PL_GAMUT_MAPPING_PIPT_H
 #define PL_GAMUT_MAPPING_PIPT_H
-
 #include <math.h>
-#include <stdbool.h>
-
 typedef struct { double v[3]; } hp_vec;
-typedef struct { double m[3][3]; } hp_mat;
-typedef struct { hp_mat to_lms, from_lms, to_target; double peak; } hp_ctx;
-
-static inline hp_vec hp_mul(hp_mat m, hp_vec v)
-{
-    hp_vec r = {{0}};
-    for (int i = 0; i < 3; i++)
-        for (int j = 0; j < 3; j++) r.v[i] += m.m[i][j] * v.v[j];
-    return r;
-}
-
-static inline hp_mat hp_product(hp_mat a, hp_mat b)
-{
-    hp_mat r = {{{0}}};
-    for (int i = 0; i < 3; i++)
-        for (int j = 0; j < 3; j++)
-            for (int k = 0; k < 3; k++) r.m[i][j] += a.m[i][k] * b.m[k][j];
-    return r;
-}
-
-static inline hp_mat hp_inverse(hp_mat a)
-{
-    const double (*m)[3] = a.m;
-    hp_mat r = {{{m[1][1]*m[2][2]-m[1][2]*m[2][1], m[0][2]*m[2][1]-m[0][1]*m[2][2], m[0][1]*m[1][2]-m[0][2]*m[1][1]},
-                 {m[1][2]*m[2][0]-m[1][0]*m[2][2], m[0][0]*m[2][2]-m[0][2]*m[2][0], m[0][2]*m[1][0]-m[0][0]*m[1][2]},
-                 {m[1][0]*m[2][1]-m[1][1]*m[2][0], m[0][1]*m[2][0]-m[0][0]*m[2][1], m[0][0]*m[1][1]-m[0][1]*m[1][0]}}};
-    double det = m[0][0]*r.m[0][0] + m[0][1]*r.m[1][0] + m[0][2]*r.m[2][0];
-    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) r.m[i][j] /= det;
-    return r;
-}
-
-static inline hp_ctx hp_context(hp_mat to_target, double peak)
-{
-    const hp_mat xyz = {{{.636958048301,.144616903586,.168880975164},
-                        {.262700212011,.677998071519,.059301716470},
-                        {0,.028072693049,1.060985057711}}};
-    const hp_mat lms = {{{.4002,.7075,-.0807},{-.2280,1.1500,.0612},{0,0,.9184}}};
-    hp_ctx c = {.to_lms = hp_product(lms, xyz), .to_target = to_target, .peak = peak};
-    c.from_lms = hp_inverse(c.to_lms);
-    return c;
-}
-
-static inline hp_vec hp_scale(hp_vec v, double gain)
-{
-    for (int j = 0; j < 3; j++) v.v[j] *= gain;
-    return v;
-}
-
 static inline double hp_p(hp_vec c)
 {
     double r=fmax(c.v[0],0), g=fmax(c.v[1],0), b=fmax(c.v[2],0), total=r+g+b;
@@ -73,62 +17,4 @@ static inline double hp_p(hp_vec c)
     double q3=73.1408564899*w-38.0916687975;
     return total*(((q3*p+q2)*p+q1)*p+q0);
 }
-
-static inline hp_vec hp_lmsp(hp_ctx c, hp_vec rgb)
-{
-    hp_vec v=hp_mul(c.to_lms,rgb);
-    for (int j=0;j<3;j++) v.v[j]=copysign(pow(fabs(v.v[j]),.43),v.v[j]);
-    return v;
-}
-
-static inline hp_vec hp_path(hp_ctx c, hp_vec neutral, hp_vec source, double t, double p)
-{
-    hp_vec v;
-    // Mixing LMS' is equivalent to a straight original-IPT segment because
-    // its opponent transform is linear. RGB normalization leaves its centered
-    // IPT hue unchanged, while making P exact at each point on the path.
-    for (int j=0;j<3;j++) {
-        double a=neutral.v[j]+t*(source.v[j]-neutral.v[j]);
-        v.v[j]=copysign(pow(fabs(a),1/.43),a);
-    }
-    v=hp_mul(c.from_lms,v);
-    double actual=hp_p(v);
-    return actual>1e-30 ? hp_scale(v,p/actual) : (hp_vec){{0,0,0}};
-}
-
-static inline bool hp_chroma_fits(hp_ctx c, hp_vec rgb)
-{
-    hp_vec d=hp_mul(c.to_target,rgb);
-    double eps=1e-12*fmax(fabs(rgb.v[0]),fmax(fabs(rgb.v[1]),fabs(rgb.v[2])));
-    return d.v[0]>=-eps && d.v[1]>=-eps && d.v[2]>=-eps;
-}
-
-static inline hp_vec hp_map(hp_ctx c, hp_vec rgb)
-{
-    double p=hp_p(rgb);
-    if (!(p>0) || !isfinite(p) || !(c.peak>0)) return (hp_vec){{0,0,0}};
-    hp_vec mapped=rgb;
-    if (!hp_chroma_fits(c,rgb)) {
-        hp_vec source=hp_lmsp(c,rgb), gray=hp_lmsp(c,(hp_vec){{p,p,p}});
-        double lo=0,hi=1;
-        // Walk inward from the source to the first sampled legal interval.
-        // A neutral-outward search can choose an unnecessarily distant
-        // boundary near IPT's re-entrant primary cusps.
-        for (int i=15;i>=0;i--) {
-            lo=i/16.0;
-            if (hp_chroma_fits(c,hp_path(c,gray,source,lo,p))) break;
-            hi=lo;
-        }
-        for (int i=0;i<24;i++) {
-            double mid=(lo+hi)*.5;
-            if (hp_chroma_fits(c,hp_path(c,gray,source,mid,p))) lo=mid;
-            else hi=mid;
-        }
-        mapped=hp_path(c,gray,source,lo*(1-1e-7),p);
-    }
-    hp_vec dst=hp_mul(c.to_target,mapped);
-    double maximum=fmax(dst.v[0],fmax(dst.v[1],dst.v[2]));
-    if (maximum>c.peak) mapped=hp_scale(mapped,c.peak/maximum);
-    return mapped;
-}
 #endif
